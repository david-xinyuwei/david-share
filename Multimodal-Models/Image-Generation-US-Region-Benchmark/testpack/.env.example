# Optional. The runner works WITHOUT this file: the endpoints below are the defaults and auth is an Entra ID
# bearer token from `az account get-access-token` (key auth is disabled by policy on these two resources).
# Copy to .env only to override something. .env is git-ignored; never commit it.
# Both resources live in subscription MCAPS-Hybrid-REQ-149887-2026-xinyuwei, resource group rg-xinyuwei-3902.

# --- GPT-Image (East US 2) : gpt-image-2, gpt-image-2.5-flare, gpt-image-2.5-sunburst share this resource ---
GPT_ENDPOINT=https://xinyuwei-2026-resource.cognitiveservices.azure.com
# Only if keys are re-enabled on the resource; leave the placeholder for Entra bearer auth.
AZURE_OPENAI_API_KEY=<optional: key from Azure Portal > xinyuwei-2026-resource > Keys and Endpoint>
GPT_API_VERSION=2025-04-01-preview
# One deployment is 2026-04-21, the two 2.5 deployments are 2026-09-08; the runner reads this map per deployment.
GPT_MODEL_VERSIONS={"gpt-image-2":"2026-04-21","gpt-image-2.5-flare":"2026-09-08","gpt-image-2.5-sunburst":"2026-09-08"}

# --- MAI-Image-2.6 (East US) : separate resource ---
MAI_ENDPOINT=https://xinyuwei-2026-eastus-img.cognitiveservices.azure.com
AZURE_API_KEY=<optional: key from Azure Portal > xinyuwei-2026-eastus-img > Keys and Endpoint>
MAI_MODEL_VERSION=2026-07-31

# Which az profile signs the requests (omit to use the default ~/.azure). The signed-in identity needs
# `Cognitive Services User` (MAI) and `Cognitive Services OpenAI User` (GPT), or Owner, on the two accounts.
# AZURE_CONFIG_DIR=C:\Users\<you>\.azure

# Free-text label stored in the run record so the archive says where the client sat.
BENCHMARK_CLIENT_LOCATION=Andre laptop, Seattle WA, residential/office internet; resources in East US / East US 2
