// KQL queries for monitoring the Foundry-Hosted-Agent-Toolbox-Demo via Application Insights
//
// Generated using the `kql` skill from microsoft/skills.
//
// All queries follow the skill's discipline rules:
//   - Cast dynamic columns BEFORE summarize/order/join
//   - Project only needed columns (avoid full-row dumps)
//   - Use 'has' for tokenized search, '==' for exact, 'contains' only when needed
//   - Limit result set size with top/take
//   - Use ago() for time ranges, never hardcoded UTC strings
//
// Source: https://github.com/microsoft/skills/blob/main/.github/skills/kql/SKILL.md
//         (fetched 2026-05-12)
//
// Run against: Application Insights resource configured in CLOUD_LOG_WORKSPACE_ID env var
//              (used by app/server.py /api/agent-logs endpoint)

// =============================================================================
// Q1. Last 50 hosted-agent log entries (used by /api/agent-logs in our demo)
// =============================================================================
AppTraces
| where TimeGenerated > ago(1h)
| top 50 by TimeGenerated desc
| project TimeGenerated, SeverityLevel, Message
// Skill rule applied: project only the columns we display in the UI

// =============================================================================
// Q2. Agent invocations per agent persona (last 24h)
// =============================================================================
AppEvents
| where TimeGenerated > ago(24h)
| where Name == "gen_ai.agent.invocation"
// Skill rule: dynamic columns require explicit cast before summarize-by
| extend agent_name = tostring(Properties["gen_ai.agent.name"])
| summarize invocations = count(), avg_duration_ms = avg(toint(Properties["duration_ms"]))
    by agent_name
| order by invocations desc

// =============================================================================
// Q3. Tool usage breakdown — which Toolbox tools get called
// =============================================================================
AppEvents
| where TimeGenerated > ago(24h)
| where Name == "gen_ai.agent.invocation"
// Skill rule: parse JSON dynamic field with care, cast before mv-expand
| extend tools_invoked = todynamic(tostring(Properties["agent.tools.invoked"]))
| mv-expand tool = tools_invoked to typeof(string)
| summarize call_count = count() by tool
| order by call_count desc

// =============================================================================
// Q4. Token consumption — input/output/total per model (last 7d)
// =============================================================================
AppEvents
| where TimeGenerated > ago(7d)
| where Name == "gen_ai.agent.invocation"
| extend
    model = tostring(Properties["gen_ai.request.model"]),
    input_tokens = toint(Properties["gen_ai.usage.input_tokens"]),
    output_tokens = toint(Properties["gen_ai.usage.output_tokens"]),
    total_tokens = toint(Properties["gen_ai.usage.total_tokens"])
| summarize
    invocations = count(),
    sum_input = sum(input_tokens),
    sum_output = sum(output_tokens),
    sum_total = sum(total_tokens),
    p95_total = percentile(total_tokens, 95)
    by model
| order by sum_total desc

// =============================================================================
// Q5. Error rate per agent per hour (last 24h, anomaly detection)
// =============================================================================
AppEvents
| where TimeGenerated > ago(24h)
| where Name == "gen_ai.agent.invocation"
| extend
    agent_name = tostring(Properties["agent_name"]),
    status = tostring(Properties["status"])
| summarize
    total = count(),
    errors = countif(status == "error")
    by bin(TimeGenerated, 1h), agent_name
| extend error_rate_pct = round(100.0 * errors / total, 2)
| where total >= 5  // Skill rule: filter out noise from low-volume buckets
| order by TimeGenerated desc, error_rate_pct desc

// =============================================================================
// Q6. Slow agent invocations — p95 latency per agent
// =============================================================================
AppEvents
| where TimeGenerated > ago(24h)
| where Name == "gen_ai.agent.invocation"
| extend
    agent_name = tostring(Properties["agent_name"]),
    duration_ms = toint(Properties["duration_ms"])
| summarize
    p50 = percentile(duration_ms, 50),
    p95 = percentile(duration_ms, 95),
    p99 = percentile(duration_ms, 99),
    samples = count()
    by agent_name
| order by p95 desc

// =============================================================================
// Q7. Distributed trace correlation — browser → backend
// =============================================================================
// Show the full operation graph for a specific user request.
// Browser App Insights and FastAPI OTel both emit operation_Id (W3C trace_id).
let target_trace = "REPLACE_WITH_OPERATION_ID";
union AppTraces, AppEvents, AppDependencies, AppExceptions
| where TimeGenerated > ago(1h)
| where OperationId == target_trace
| project TimeGenerated, ItemType, Name, Message, OperationName, DurationMs
| order by TimeGenerated asc

// =============================================================================
// Skill discipline checklist applied to all queries above
// =============================================================================
// ✅ Time range with ago() — never hardcoded UTC
// ✅ Dynamic-typed columns wrapped in tostring()/toint()/todouble() before summarize/order
// ✅ project after final summarize to drop unused columns
// ✅ top/take to bound result size
// ✅ has/contains used appropriately (no contains on indexed columns)
// ✅ let bindings for parameters (Q7)
// ✅ percentile() instead of avg() for latency (skill: "avg lies, percentiles tell the truth")
