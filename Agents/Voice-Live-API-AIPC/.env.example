# ---------- Azure CLI isolation ----------
# Keep this app's Azure CLI cache separate from other projects.
# Example: C:\Users\<you>\.azure-voice-live-aipc
AZURE_CONFIG_DIR=

# ---------- Azure Voice Live (--mode voicelive) ----------
# Foundry 资源 Keys and Endpoint 页面获取
AZURE_VOICELIVE_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/
AZURE_VOICELIVE_MODEL=gpt-realtime
AZURE_VOICELIVE_API_VERSION=2026-04-10
# 留空则使用 az login 的 Entra 令牌（推荐）
AZURE_VOICELIVE_API_KEY=
AZURE_VOICELIVE_VOICE=zh-CN-XiaoxiaoMultilingualNeural

# ---------- Foundry Agent 模式（可选，界面选 voicelive-agent）----------
# 人设与工具定义托管在云端 Agent；本模式强制 Entra 认证，不支持 API Key。
# 本机新增工具后必须同步创建 Agent 新版本，否则云端仍是旧的工具清单。
AZURE_VOICELIVE_AGENT_NAME=
AZURE_VOICELIVE_PROJECT_NAME=
AZURE_VOICELIVE_AGENT_VERSION=

# ---------- Audio echo guard ----------
# The shipped Voice Live session uses server-reference echo cancellation.
# This client-side guard limits microphone uplink while the assistant is speaking.
AUDIO_HALF_DUPLEX=true

# ---------- Azure OpenAI (新闻简报整理 + 壁纸生图 + Realtime 后端) ----------
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
# Optional: set a caller-owned image deployment to register the 25th tool.
AZURE_OPENAI_IMAGE_DEPLOYMENT=

# ---------- Realtime 后端 (--mode realtime) ----------
# 需要先在上面的资源里部署一个 gpt-realtime 系列模型，填部署名
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime
# 模型原生音色：alloy / ash / ballad / coral / echo / sage / shimmer / verse / marin / cedar
AZURE_OPENAI_REALTIME_VOICE=alloy

# ---------- Email delivery ----------
# graph (default) uses a Microsoft Entra public-client app with Mail.Send.
# smtp is available only for providers that still support authenticated SMTP.
MAIL_TRANSPORT=graph
GRAPH_CLIENT_ID=<your-public-client-application-id>
GRAPH_AUTHORITY=https://login.microsoftonline.com/consumers
MAIL_DEFAULT_RECIPIENT=user@example.com
# Every recipient must be allowlisted. Empty means deny all delivery.
MAIL_ALLOWED_RECIPIENTS=user@example.com

# Optional SMTP transport
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- WebIQ（网页搜索 + 壁纸图片搜索）----------
WEBIQ_API_KEY=

# ---------- 新闻源 ----------
# 逗号分隔的 RSS 地址
NEWS_FEEDS=https://news.google.com/rss?hl=zh-CN&gl=CN&ceid=CN:zh-Hans,https://feeds.bbci.co.uk/news/world/rss.xml

# ---------- 壁纸 ----------
# 生成/下载的壁纸落盘目录，换壁纸只允许使用该目录内文件
WALLPAPER_DIR=
AZURE_OPENAI_IMAGE_SIZE=1536x1024

# ---------- Camera snapshots ----------
# Leave empty to use artifacts\snapshots under the application directory.
SNAPSHOT_DIR=
