[Unit]
Description=Encrypted tunnel to the Qira Sweden Central benchmark runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/qira-benchmark/tunnel.env
ExecStart=/usr/bin/ssh -NT \
  -i /etc/qira-benchmark/qira-runner-ed25519 \
  -p ${QIRA_RUNNER_SSH_PORT} \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=accept-new \
  -L 127.0.0.1:8514:127.0.0.1:8513 \
  ${QIRA_RUNNER_TARGET}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
