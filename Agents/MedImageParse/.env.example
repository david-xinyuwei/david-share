# Environment variables for local development
# Copy this file to .env and fill in your values

# Azure ML Endpoints
AZURE_OPENAI_ENDPOINT_2D=https://your-endpoint-2d.swedencentral.inference.ml.azure.com/score
AZURE_OPENAI_KEY_2D=your-2d-model-key-here

AZURE_OPENAI_ENDPOINT_3D=https://your-endpoint-3d.swedencentral.inference.ml.azure.com/score
AZURE_OPENAI_KEY_3D=your-3d-model-key-here

# Application Insights (auto-configured in Azure)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional: Key Vault name (auto-configured in Azure)
AZURE_KEY_VAULT_NAME=
