AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# Backward-compatible alias used by earlier scripts and manifests.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4-1-mini
# Optional app-level default for newly created demo agents. If unset, the app
# falls back to AZURE_AI_MODEL_DEPLOYMENT_NAME.
DEFAULT_AGENT_MODEL=gpt-4-1-mini
TOOLBOX_NAME=agent-tools

# Optional: use AzureCliCredential for local multi-tenant testing.
AZURE_AUTH_MODE=cli
HOST=0.0.0.0
PORT=8088
AGENT_NAME=hosted-agent-toolbox-demo
ENABLE_DIRECT_WEB_SEARCH=true

# Optional: enable the direct image generation tool. Requires an image-capable
# Foundry deployment (e.g. gpt-image-1).
AZURE_AI_IMAGE_DEPLOYMENT_NAME=gpt-image-1
# Optional alias consumed by the web app image endpoint. If unset, the app falls
# back to AZURE_AI_IMAGE_DEPLOYMENT_NAME.
IMAGE_GENERATION_MODEL=gpt-image-1
ENABLE_DIRECT_IMAGE_GENERATE=false

# Optional: only needed when verifying a version-specific endpoint directly.
TOOLBOX_MCP_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/agent-tools/mcp?api-version=v1
TOOLBOX_APPROVAL_MODE=never_require

# Optional SDK toolbox creation flags used by scripts/create_toolbox.py.
TOOLBOX_DESCRIPTION=Hosted Agent shared tools

# Foundry Agent lifecycle: when set, "Create Agent" in the UI creates a real
# Foundry agent resource. For hosted agents, provide the ACR image URL of an
# already-deployed agent container.  Without this the app falls back to prompt
# agent creation (no container needed).
FOUNDRY_ACR_IMAGE=

AZURE_AI_SEARCH_CONNECTION_ID=
AZURE_AI_SEARCH_INDEX=
MCP_SERVER_LABEL=
MCP_SERVER_URL=
MCP_PROJECT_CONNECTION_ID=
MCP_REQUIRE_APPROVAL=never

# Optional: file_search vector store IDs (comma-separated).
# Create a vector store first via POST {project_endpoint}/openai/v1/vector_stores.
FILE_SEARCH_VECTOR_STORE_IDS=
VECTOR_STORE_ID=

# ---- Demo Web App (app/server.py) env vars ----
# Local hosted agent URL (only needed when running local container)
AGENT_URL=http://localhost:8088
# Foundry cloud hosted agent /responses endpoint (set to enable cloud mode)
CLOUD_AGENT_URL=
# Set to 1 to hide the local endpoint option in UI (use when no local agent is running)
DISABLE_LOCAL_ENDPOINT=0
# Whisper model deployment name for voice input
WHISPER_DEPLOYMENT=whisper
# Log Analytics workspace customer ID (for Foundry AppTraces log panel)
CLOUD_LOG_WORKSPACE_ID=
# Per-query timeout for the quick Evaluate Agent panel. Keep above code_interpreter P95.
EVALUATION_QUERY_TIMEOUT_SECONDS=30
# Optional: submit the local quick evaluation summary to Foundry Evaluation API.
ENABLE_FOUNDRY_EVAL_API=0
# Optional evaluator deployment. This is intentionally separate from an agent's
# inference model and falls back to DEFAULT_AGENT_MODEL when unset.
EVALUATION_MODEL_DEPLOYMENT=gpt-4-1-mini
# Backward-compatible evaluator deployment alias used by earlier scripts.
AZURE_AI_EVALUATION_DEPLOYMENT_NAME=

# Microsoft skills demo settings. The app loads the catalog from
# https://github.com/microsoft/skills, then stores only selected SKILL.md files per agent.
SKILLS_CACHE_TTL_SECONDS=86400
MAX_SKILLS_PER_AGENT=5
MAX_SKILL_PROMPT_CHARS=12000
MAX_TOTAL_SKILL_PROMPT_CHARS=30000

# ---- Optional Toolbox catalog integrations ----
# Web Search with Bing Custom Search domains.
BING_CUSTOM_SEARCH_PROJECT_CONNECTION_ID=
BING_CUSTOM_SEARCH_INSTANCE_NAME=

# OpenAPI tool. OPENAPI_AUTH_TYPE: anonymous, project_connection, api_key,
# bearer, managed_identity.
OPENAPI_SPEC_PATH=
OPENAPI_SPEC_JSON=
OPENAPI_TOOL_NAME=openapi_api
OPENAPI_TOOL_DESCRIPTION=External REST API exposed through OpenAPI
OPENAPI_AUTH_TYPE=anonymous
OPENAPI_PROJECT_CONNECTION_ID=
OPENAPI_MANAGED_IDENTITY_AUDIENCE=

# Agent-to-Agent (A2A) tool.
A2A_AGENT_NAME=remote_agent
A2A_AGENT_DESCRIPTION=Remote A2A-compatible agent endpoint
A2A_AGENT_BASE_URL=
A2A_PROJECT_CONNECTION_ID=

# MCP-backed catalog entries.
FOUNDRY_IQ_MCP_ENDPOINT=
FOUNDRY_IQ_PROJECT_CONNECTION_ID=
FOUNDRY_IQ_SERVER_LABEL=foundry_iq
AZURE_DEVOPS_MCP_SERVER_URL=
AZURE_DEVOPS_PROJECT_CONNECTION_ID=
AZURE_DEVOPS_MCP_SERVER_LABEL=azure_devops
AZURE_DEVOPS_MCP_REQUIRE_APPROVAL=always
CUSTOM_CODE_INTERPRETER_MCP_URL=
CUSTOM_CODE_INTERPRETER_CONNECTION_ID=
CUSTOM_CODE_INTERPRETER_SERVER_LABEL=custom_code_interpreter

# ---- Service Principal auth (for VMs without az CLI / Managed Identity) ----
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ---- Foundry Memory (preview) ----
# Set MEMORY_STORE_NAME to enable long-term cross-session memory.
# Create a memory store first in Foundry portal or via SDK.
# Leave empty to run without memory (stateless mode).
MEMORY_STORE_NAME=
MEMORY_PROJECT_ENDPOINT=
# Use 0 for an interactive demo proof; increase for production-style delayed updates.
MEMORY_UPDATE_DELAY_SECONDS=0
