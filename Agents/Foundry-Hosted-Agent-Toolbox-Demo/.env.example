FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4-1-mini
TOOLBOX_NAME=agent-tools

# Optional: use AzureCliCredential for local multi-tenant testing.
AZURE_AUTH_MODE=cli
PORT=8088
ENABLE_DIRECT_WEB_SEARCH=true

# Optional: enable the direct image generation tool. Requires an image-capable
# Foundry deployment (e.g. gpt-image-1).
AZURE_AI_IMAGE_DEPLOYMENT_NAME=gpt-image-1
ENABLE_DIRECT_IMAGE_GENERATE=false

# Optional: only needed when verifying a version-specific endpoint directly.
TOOLBOX_MCP_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/agent-tools/mcp?api-version=v1
TOOLBOX_APPROVAL_MODE=never_require

# Optional SDK toolbox creation flags used by scripts/create_toolbox.py.
TOOLBOX_DESCRIPTION=Hosted Agent shared tools
AZURE_AI_SEARCH_CONNECTION_ID=
AZURE_AI_SEARCH_INDEX=
MCP_SERVER_LABEL=
MCP_SERVER_URL=
MCP_PROJECT_CONNECTION_ID=

# Optional: file_search vector store IDs (comma-separated).
# Create a vector store first via POST {project_endpoint}/openai/v1/vector_stores.
FILE_SEARCH_VECTOR_STORE_IDS=
