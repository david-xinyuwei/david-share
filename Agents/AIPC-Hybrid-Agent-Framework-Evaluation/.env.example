# Portal cloud model — used by LangChain / LangGraph scenarios on the Linux Portal VM
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# AIPC CodeAct model — used by the Windows Sandbox API / MAF Hyperlight provider
AOAI_ENDPOINT=https://<your-apim>.azure-api.net
AOAI_KEY=<your-apim-key>
AOAI_MODEL=gpt-5.4

# Optional real travel APIs. If empty, the portal returns explicit "unavailable" results, never mock data.
SERPAPI_API_KEY=

# Ollama (local model on AIPC) — install from https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# AIPC Sandbox API (Portal → AIPC remote call)
AIPC_SANDBOX_URL=http://<aipc-ip>:8507

# Windows AIPC paths. Defaults work for the sample aipcadmin user, but can be overridden.
AIPC_APP_DIR=C:\Users\aipcadmin\Desktop
AIPC_HOST_DATA_DIR=C:\Users\aipcadmin\Desktop
AIPC_RUNTIME_DIR=C:\Users\aipcadmin\Desktop
AIPC_SCREENSHOT_PATH=C:\Users\aipcadmin\Desktop\last_screenshot.png
PYTHON_EXE=C:\Program Files\Python312\python.exe
NSSM_EXE=C:\Users\aipcadmin\Desktop\nssm.exe

# LangSmith (optional — for LangChain/LangGraph tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
