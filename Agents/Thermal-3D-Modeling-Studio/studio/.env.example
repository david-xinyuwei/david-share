# Copy to .env and fill in. Never commit .env.
# Azure OpenAI in Microsoft Foundry: the resource endpoint and the chat-completions deployment (REQUIRED, no default).
AOAI_ENDPOINT=https://<your-resource>.openai.azure.com
AOAI_DEPLOYMENT=gpt-6-astra
# none | low | medium | high | xhigh; the default when the UI's reasoning selector is untouched ("off" = do not send it).
# gpt-6-astra-2026-09-03 refuses none (2026-11-14); a value the deployment refuses is sent as the nearest one it accepts.
AOAI_REASONING_EFFORT=low
AOAI_MAX_TOKENS=24000
# Transparent SDK retries on 408/429/5xx (each retry is a billed attempt).
AOAI_MAX_RETRIES=1
HISTORY_TURNS=3
# Track C/D images: an image deployment on the same resource (for example gpt-image-2.5-sunburst). Empty = render tab hidden.
AOAI_IMAGE_DEPLOYMENT=
# Track D optional second provider: MAI-Image-2.6 on a Foundry resource (https://<name>.services.ai.azure.com).
# Leave MAI_API_KEY empty to use the Entra token of this host (the identity needs Cognitive Services User on that resource).
MAI_ENDPOINT=
MAI_API_KEY=
MAI_MODEL=MAI-Image-2.6
# Public HTTPS address behind nginx; plain-HTTP requests from outside are redirected there. Empty on a local dev server.
PUBLIC_BASE_URL=

# Entra ID: client id of the VM's user-assigned managed identity. Empty locally: `az login` is used.
AZURE_CLIENT_ID=
# Only for resources that allow API keys; empty = Entra ID token.
AOAI_API_KEY=

# Sign-in (PORTAL_PASSWORD is REQUIRED; sign-in stays disabled until it is set)
PORTAL_USERNAME=studio
PORTAL_PASSWORD=change-me
PORTAL_SESSION_SECRET=change-me-random-hex
# Optional owner account: same access, 30-day session instead of 12 hours.
PORTAL_OWNER_USERNAME=
PORTAL_OWNER_PASSWORD=

# Track B (CadQuery -> STEP): OCCT time limit per attempt, GPT-6 attempts per job, finished jobs kept under cad_out/
CAD_TIMEOUT_S=150
CAD_MAX_ATTEMPTS=3
CAD_KEEP_JOBS=40

# SSE heartbeat while the model or OCCT is silent (Azure public IPs drop idle TCP flows after 4 minutes by default).
SSE_HEARTBEAT_S=15
# Requests beyond these limits get an immediate, explained error instead of queuing.
MAX_CONCURRENT_GENERATIONS=4
MAX_CONCURRENT_CAD=2

# Every signed-in user runs on the connection above; the browser never receives a key or token.
HOST_CONNECTION_FOR_ALL=1
REQUIRE_BYOK=0
