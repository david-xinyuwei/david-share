{"ok": true, "summary": "Built a four-level packaging model with switchable carton cut-away, pallet and container views. Standard cartons measure 385 × 275 × 340 mm; compact cartons measure 365 × 265 × 320 mm. The three schemes use transparent, uniform-grid orientation enumeration, not a heuristic packing solver. Standard palletisation carries 1,200 notebooks per container, floor loading carries 2,800, and compact palletisation carries 1,500. Pallet height and gross-weight limits are checked, including carton board and pallet tare. Utilisation counts nominal retail-box volume only; packaging estimates exclude tape and labels. Retail-box dimensions serve as nominal packing envelopes, with wall thickness unresolved. Weight distribution, securing, container payload limits and operational loading clearances are not evaluated.", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Notebook packaging and loading</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;left:12px;top:12px;max-width:300px;padding:12px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;line-height:1.65}\nh3{margin:0 0 5px;font-size:14px}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:11px;margin:2px 1px}\nbutton:hover,button.active{border-color:#b11f4b}\n#buttons{line-height:1.2}\n#error{position:absolute;top:48%;left:15%;right:15%;text-align:center;color:#b00020;background:#fff}\n#status{font-size:11px;color:#70451d}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h3 id=\"title\">Notebook outbound loading</h3>\n<div id=\"metrics\"></div>\n<div id=\"layout\"></div>\n<div>Ivory: retail · Tan: carton · Brown: pallet</div>\n<div>Blue outline: container · Pink: unused space</div>\n<div id=\"status\">Notebook asset loading…</div>\n<div id=\"buttons\"></div>\n</div>\n<div id=\"error\"></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nimport { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nconst P = {\n retail:[355,245,62],compact:[335,235,58],units:5,clearance:10,board:5,\n pallet:[1200,1000,150],maxHeight:1800,maxWeight:1000,palletMass:22,\n container:[12032,2352,2698],floorHeight:2600,boardDensity:0.75,\n gross:[2.4,2.4,2.25],cushion:[0.180,0.180,0.120],retailMass:[0.260,0.260,0.230],\n carbon:1200,notebook:[301,14.5,220],railWidth:90,deck:20,\n colors:{retail:'#f5f5f4',edge:'#b11f4b',carton:'#c8a165',wood:'#a16207',void:'#ed9b9b',cushion:'#e9e3d4'},\n names:['① Standard pallets','② Floor loading','③ Compact pallets']\n}; // Dimensions in mm; masses in kg; board density in kg/m².\nconst showError = text => document.getElementById('error').textContent='Rendering error: '+text;\nwindow.addEventListener('error',e=>showError(e.message));\ntry {\n const permutations=a=>[[a[0],a[1],a[2]],[a[1],a[0],a[2]],[a[0],a[2],a[1]],[a[2],a[0],a[1]],[a[1],a[2],a[0]],[a[2],a[1],a[0]]];\n function bestGrid(space,options){\n  return options.map(d=>({d,n:d.map((v,i)=>Math.floor(space[i]/v))}))\n   .map(o=>({...o,count:o.n.reduce((a,b)=>a*b,1)})).reduce((a,b)=>b.count>a.count?b:a);\n }\n function compute(s){\n  const retail=s===2?P.compact:P.retail,carton=[retail[0]+2*(P.clearance+P.board),retail[1]+2*(P.clearance+P.board),retail[2]*P.units+2*(P.clearance+P.board)];\n  const [a,b,c]=carton,boardMass=2*(a*b+a*c+b*c)/1e6*P.boardDensity;\n  const layer=bestGrid([P.pallet[0],P.pallet[1],c],[[a,b,c],[b,a,c]]);\n  const heightLayers=Math.floor((P.maxHeight-P.pallet[2])/c);\n  const weightCartons=Math.floor((P.maxWeight-P.palletMass)/(P.units*P.gross[s]+boardMass));\n  const layers=Math.min(heightLayers,Math.floor(weightCartons/layer.count));\n  const perPallet=layer.count*layers*P.units;\n  const pallets=bestGrid([P.container[0],P.container[1],P.pallet[2]],[[P.pallet[0],P.pallet[1],P.pallet[2]],[P.pallet[1],P.pallet[0],P.pallet[2]]]);\n  const floor=bestGrid([P.container[0],P.container[1],P.floorHeight],permutations(carton));\n  const total=s===1?floor.count*P.units:pallets.count*perPallet;\n  const volume=total*retail.reduce((x,y)=>x*y,1)/P.container.reduce((x,y)=>x*y,1)*100;\n  const mass=(boardMass/P.units+P.cushion[s]+P.retailMass[s]+(s===1?0:P.palletMass/perPallet))*1000;\n  return {s,retail,carton,boardMass,layer,layers,perPallet,pallets,floor,total,volume,mass,\n   palletGross:P.palletMass+perPallet/P.units*(P.units*P.gross[s]+boardMass)};\n }\n const results=[0,1,2].map(compute);\n function metrics(r){return [\n  {label:'Units per carton',value:String(P.units),unit:'',note:'Assumed short-edge stacking'},\n  {label:'Units per pallet',value:r.s===1?'— (floor loading)':String(r.perPallet),unit:'',note:'Assumed full layers; 1,000 kg limit'},\n  {label:'Units per container',value:String(r.total),unit:'',note:'Assumed uniform grids; no securing'},\n  {label:'Container volume utilisation (%)',value:r.volume.toFixed(2),unit:'%',note:'Nominal retail volume / internal volume'},\n  {label:'Packaging mass per unit (g)',value:r.mass.toFixed(1),unit:'g',note:'Assumed board, cushions, box, pallet'},\n  {label:'Sea-freight CO₂ per unit (kg CO₂e)',value:(P.carbon/r.total).toFixed(3),unit:'kg CO₂e',note:'Assumed 1,200 kg CO₂e per container'}\n ];}\n const scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\n const renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\n renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);\n renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.localClippingEnabled=true;document.body.appendChild(renderer.domElement);\n scene.environment=new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(),0.04).texture;\n scene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,0.6));\n const light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(2000,6000,3000);scene.add(light);\n const camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\n const controls=new OrbitControls(camera,renderer.domElement);controls.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1;\n controls.addEventListener('start',()=>controls.autoRotate=false);\n const modelGroup=new THREE.Group();scene.add(modelGroup);\n const mat=(color,opacity=1)=>new THREE.MeshStandardMaterial({color,metalness:0,roughness:0.6,transparent:opacity<1,opacity,depthWrite:opacity===1});\n const materials={retail:mat(P.colors.retail),carton:mat(P.colors.carton),wood:mat(P.colors.wood),cushion:mat(P.colors.cushion),void:mat(P.colors.void,0.15),container:mat('#8eafc5',0.12)};\n const edgeMat=new THREE.LineBasicMaterial({color:P.colors.edge});\n function box(parent,d,p,m,edges=false){\n  const mesh=new THREE.Mesh(new THREE.BoxGeometry(...d),m);mesh.position.set(...p);parent.add(mesh);\n  if(edges)mesh.add(new THREE.LineSegments(new THREE.EdgesGeometry(mesh.geometry),edgeMat));return mesh;\n }\n function instances(parent,d,positions,m){\n  const mesh=new THREE.InstancedMesh(new THREE.BoxGeometry(...d),m,positions.length),matrix=new THREE.Matrix4();\n  positions.forEach((p,i)=>mesh.setMatrixAt(i,matrix.makeTranslation(...p)));\n  mesh.instanceMatrix.needsUpdate=true;mesh.computeBoundingSphere();parent.add(mesh);return mesh;\n }\n let scheme=0,level=2,section=true,exploded=false,laptop=null,laptopHost=null;\n function fit(){\n  const bounds=new THREE.Box3().setFromObject(modelGroup,true),size=bounds.getSize(new THREE.Vector3()),center=bounds.getCenter(new THREE.Vector3());\n  const angle=Math.min(camera.fov*Math.PI/360,Math.atan(Math.tan(camera.fov*Math.PI/360)*camera.aspect));\n  const distance=size.length()/2/Math.sin(angle)/0.77;\n  camera.position.copy(center).add(new THREE.Vector3(1,.7,1.2).normalize().multiplyScalar(distance));\n  camera.far=Math.max(20000,distance*3);camera.updateProjectionMatrix();controls.target.copy(center);controls.update();\n }\n function clear(){\n  if(laptop)laptop.removeFromParent();\n  modelGroup.traverse(o=>{if(o.geometry)o.geometry.dispose();});modelGroup.clear();\n }\n function palletGeometry(parent,origins,d){\n  const [l,w,h]=d,deck=[],rails=[];\n  origins.forEach(([x,y,z])=>{\n   deck.push([x+l/2,y+h-P.deck/2,z+w/2],[x+l/2,y+P.deck/2,z+w/2]);\n   for(let i=0;i<3;i++)rails.push([x+l/2,y+h/2,z+P.railWidth/2+i*(w-P.railWidth)/2]);\n  });\n  instances(parent,[l,P.deck,w],deck,materials.wood);\n  instances(parent,[l,h-2*P.deck,P.railWidth],rails,materials.wood);\n }\n function unused(d,used){\n  const [l,w,h]=d,[x,z,y]=used;\n  if(l>x)box(modelGroup,[l-x,h,w],[(l+x)/2,h/2,w/2],materials.void);\n  if(w>z)box(modelGroup,[x,h,w-z],[x/2,h/2,(w+z)/2],materials.void);\n  if(h>y)box(modelGroup,[x,h-y,z],[x/2,(h+y)/2,z/2],materials.void);\n }\n function build(){\n  clear();const r=results[scheme];laptopHost=null;\n  if(level===0){\n   const [a,b,c]=r.carton,[l,w,h]=r.retail,t=P.board,shell=new THREE.Group();modelGroup.add(shell);\n   const panels=[[[a,t,b],[0,t/2,0]],[[a,t,b],[0,c-t/2,0]],[[t,c,b],[-(a-t)/2,c/2,0]],[[t,c,b],[(a-t)/2,c/2,0]],[[a,c,t],[0,c/2,-(b-t)/2]],[[a,c,t],[0,c/2,(b-t)/2]]];\n   panels.forEach(([d,p],i)=>{if(!section||![1,3,5].includes(i))instances(shell,d,[p],materials.carton);});\n   for(let i=0;i<P.units;i++){\n    const y=t+P.clearance+i*(h+(exploded?25:0));\n    if(i<4){box(modelGroup,[l,h,w],[0,y+h/2,0],materials.retail,true);continue;}\n    const tray=new THREE.Group();tray.position.y=y;modelGroup.add(tray);\n    box(tray,[l,2,w],[0,1,0],materials.retail,true);\n    box(tray,[l,h,2],[0,h/2,-w/2+1],materials.retail,true);\n    box(tray,[2,h,w],[-l/2+1,h/2,0],materials.retail,true);\n    box(tray,[2,h,w],[l/2-1,h/2,0],materials.retail,true);\n    const lid=box(tray,[l,2,w],[0,h+w*.47,-w*.68],materials.retail,true);lid.rotation.x=-Math.PI*.38;\n    const [nl,nh,nw]=P.notebook,side=(l-nl)/2,end=(w-nw)/2;\n    box(tray,[side,nh+8,w],[-(nl+side)/2,10+nh/2,0],materials.cushion);\n    box(tray,[side,nh+8,w],[(nl+side)/2,10+nh/2,0],materials.cushion);\n    for(const sign of [-1,1])box(tray,[nl,nh+8,end],[0,10+nh/2,sign*(nw+end)/2],materials.cushion);\n    laptopHost=new THREE.Group();laptopHost.position.y=10;tray.add(laptopHost);if(laptop)laptopHost.add(laptop);\n   }\n  }else{\n   let origins=[],pd=r.pallets.d,cd=r.layer.d;\n   if(level===1){pd=[...P.pallet];origins=[[0,0,0]];}\n   else{\n    const [l,w,h]=P.container;box(modelGroup,[l,h,w],[l/2,h/2,w/2],materials.container,true);\n    if(scheme!==1)for(let i=0;i<r.pallets.n[0];i++)for(let j=0;j<r.pallets.n[1];j++)origins.push([i*pd[0],0,j*pd[1]]);\n   }\n   const positions=[];\n   if(level===2&&scheme===1){\n    cd=r.floor.d;for(let i=0;i<r.floor.n[0];i++)for(let j=0;j<r.floor.n[1];j++)for(let k=0;k<r.floor.n[2];k++)positions.push([(i+.5)*cd[0],(k+.5)*cd[2],(j+.5)*cd[1]]);\n    unused(P.container,r.floor.n.map((n,i)=>n*cd[i]));\n   }else{\n    const rotated=pd[0]!==P.pallet[0],nx=r.layer.n[0],nz=r.layer.n[1];\n    palletGeometry(modelGroup,origins,pd);\n    origins.forEach(([x,y,z])=>{for(let i=0;i<nx;i++)for(let j=0;j<nz;j++)for(let k=0;k<r.layers;k++){\n     const u=(i+.5)*cd[0],v=(j+.5)*cd[1];\n     positions.push([x+(rotated?v:u),P.pallet[2]+(k+.5)*cd[2]+(exploded?k*35:0),z+(rotated?u:v)]);\n    }});\n    if(rotated)cd=[cd[1],cd[0],cd[2]];\n    if(level===2){\n     unused(P.container,[r.pallets.n[0]*pd[0],r.pallets.n[1]*pd[1],P.pallet[2]+r.layers*cd[2]]);\n     origins.forEach(([x,y,z])=>{\n      const ux=(rotated?nz:nx)*cd[0],uz=(rotated?nx:nz)*cd[1],height=r.layers*cd[2];\n      if(pd[0]>ux)box(modelGroup,[pd[0]-ux,height,pd[1]],[x+(pd[0]+ux)/2,P.pallet[2]+height/2,z+pd[1]/2],materials.void);\n      if(pd[1]>uz)box(modelGroup,[ux,height,pd[1]-uz],[x+ux/2,P.pallet[2]+height/2,z+(pd[1]+uz)/2],materials.void);\n     });\n    }\n   }\n   instances(modelGroup,[cd[0],cd[2],cd[1]],positions,materials.carton);\n  }\n  window.__metrics=metrics(r);document.getElementById('title').textContent=P.names[scheme];\n  document.getElementById('metrics').innerHTML=window.__metrics.map((m,i)=>'<div>'+(['Units/carton','Units/pallet','Units/container','Retail volume','Packaging/unit','Sea CO₂/unit'][i])+': '+m.value+' '+m.unit+(i===2?' ('+((r.total/results[0].total-1)*100>=0?'+':'')+((r.total/results[0].total-1)*100).toFixed(1)+'%)':'')+'</div>').join('');\n  document.getElementById('layout').textContent=level===0?r.carton.join(' × ')+' mm; lid open; adapter omitted':scheme===1&&level===2?'Grid '+r.floor.n.join(' × ')+'; door +X':r.layer.count+'/layer × '+r.layers+'; '+r.palletGross.toFixed(1)+' kg/pallet'+(scheme===1?' (reference only)':'');\n  fit();\n }\n const button=(text,action)=>{const b=document.createElement('button');b.textContent=text;b.onclick=action;document.getElementById('buttons').appendChild(b);};\n P.names.forEach((name,i)=>button(name,()=>{scheme=i;build();}));\n ['Carton cut-away','Single pallet','Full container'].forEach((name,i)=>button(name,()=>{level=i;build();}));\n button('Section / Full',()=>{section=!section;level=0;build();});\n button('Exploded view',()=>{exploded=!exploded;build();});\n button('Auto-rotate',()=>controls.autoRotate=!controls.autoRotate);\n window.__scene=scene;window.__camera=camera;window.__renderer=renderer;window.__controls=controls;window.__model=modelGroup;\n window.__schemes=results.map(r=>({name:P.names[r.s],metrics:metrics(r),carton:r.carton,layer:r.layer,floor:r.floor,palletGross:r.palletGross}));\n build();\n new GLTFLoader().load('/static/assets/notebook/laptop14_closed.glb',gltf=>{\n  laptop=gltf.scene;\n  laptop.traverse(o=>{if(!o.isMesh)return;const name=o.name.toLowerCase();let color='#cfd0cc',metalness=.85,roughness=.32;\n   if(name.startsWith('keys')){color='#2a2b2e';metalness=.1;roughness=.55;}\n   if(name.startsWith('touchpad')){color='#dcdcd8';metalness=.3;roughness=.25;}\n   if(name.startsWith('hinge_')||name.startsWith('feet')){color='#1c1c1e';metalness=0;roughness=.6;}\n   o.material=new THREE.MeshStandardMaterial({color,metalness,roughness});\n  });\n  if(laptopHost)laptopHost.add(laptop);document.getElementById('status').textContent='Uniform grids; no securing or payload check.';\n },undefined,()=>{\n  laptop=new THREE.Group();box(laptop,P.notebook,[0,P.notebook[1]/2,0],mat('#cfd0cc',.55));\n  if(laptopHost)laptopHost.add(laptop);document.getElementById('status').textContent='Notebook asset unavailable; envelope shown.';\n });\n window.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;renderer.setSize(innerWidth,innerHeight);fit();});\n renderer.setAnimationLoop(()=>{controls.update();renderer.render(scene,camera);});\n}catch(error){showError(error.message);}\n</script>\n</body>\n</html>", "metrics": [{"label": "Units per carton", "value": "5", "unit": "", "note": "Assumed short-edge stacking"}, {"label": "Units per pallet", "value": "60", "unit": "", "note": "Assumed full layers; 1,000 kg limit"}, {"label": "Units per container", "value": "1200", "unit": "", "note": "Assumed uniform grids; no securing"}, {"label": "Container volume utilisation (%)", "value": "21.18", "unit": "%", "note": "Nominal retail volume / internal volume"}, {"label": "Packaging mass per unit (g)", "value": "905.7", "unit": "g", "note": "Assumed board, cushions, box, pallet"}, {"label": "Sea-freight CO₂ per unit (kg CO₂e)", "value": "1.000", "unit": "kg CO₂e", "note": "Assumed 1,200 kg CO₂e per container"}], "suggestions": ["Compare mixed-orientation layouts with these uniform-grid schemes.", "Add carton compression limits, securing gaps and container payload checks.", "Model the adapter compartment and validate compact-box cushioning clearances."], "raw": "<<<SUMMARY>>>\nBuilt a four-level packaging model with switchable carton cut-away, pallet and container views. Standard cartons measure 385 × 275 × 340 mm; compact cartons measure 365 × 265 × 320 mm. The three schemes use transparent, uniform-grid orientation enumeration, not a heuristic packing solver. Standard palletisation carries 1,200 notebooks per container, floor loading carries 2,800, and compact palletisation carries 1,500. Pallet height and gross-weight limits are checked, including carton board and pallet tare. Utilisation counts nominal retail-box volume only; packaging estimates exclude tape and labels. Retail-box dimensions serve as nominal packing envelopes, with wall thickness unresolved. Weight distribution, securing, container payload limits and operational loading clearances are not evaluated.\n<<<HTML>>>\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Notebook packaging and loading</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;left:12px;top:12px;max-width:300px;padding:12px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;line-height:1.65}\nh3{margin:0 0 5px;font-size:14px}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:11px;margin:2px 1px}\nbutton:hover,button.active{border-color:#b11f4b}\n#buttons{line-height:1.2}\n#error{position:absolute;top:48%;left:15%;right:15%;text-align:center;color:#b00020;background:#fff}\n#status{font-size:11px;color:#70451d}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h3 id=\"title\">Notebook outbound loading</h3>\n<div id=\"metrics\"></div>\n<div id=\"layout\"></div>\n<div>Ivory: retail · Tan: carton · Brown: pallet</div>\n<div>Blue outline: container · Pink: unused space</div>\n<div id=\"status\">Notebook asset loading…</div>\n<div id=\"buttons\"></div>\n</div>\n<div id=\"error\"></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nimport { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nconst P = {\n retail:[355,245,62],compact:[335,235,58],units:5,clearance:10,board:5,\n pallet:[1200,1000,150],maxHeight:1800,maxWeight:1000,palletMass:22,\n container:[12032,2352,2698],floorHeight:2600,boardDensity:0.75,\n gross:[2.4,2.4,2.25],cushion:[0.180,0.180,0.120],retailMass:[0.260,0.260,0.230],\n carbon:1200,notebook:[301,14.5,220],railWidth:90,deck:20,\n colors:{retail:'#f5f5f4',edge:'#b11f4b',carton:'#c8a165',wood:'#a16207',void:'#ed9b9b',cushion:'#e9e3d4'},\n names:['① Standard pallets','② Floor loading','③ Compact pallets']\n}; // Dimensions in mm; masses in kg; board density in kg/m².\nconst showError = text => document.getElementById('error').textContent='Rendering error: '+text;\nwindow.addEventListener('error',e=>showError(e.message));\ntry {\n const permutations=a=>[[a[0],a[1],a[2]],[a[1],a[0],a[2]],[a[0],a[2],a[1]],[a[2],a[0],a[1]],[a[1],a[2],a[0]],[a[2],a[1],a[0]]];\n function bestGrid(space,options){\n  return options.map(d=>({d,n:d.map((v,i)=>Math.floor(space[i]/v))}))\n   .map(o=>({...o,count:o.n.reduce((a,b)=>a*b,1)})).reduce((a,b)=>b.count>a.count?b:a);\n }\n function compute(s){\n  const retail=s===2?P.compact:P.retail,carton=[retail[0]+2*(P.clearance+P.board),retail[1]+2*(P.clearance+P.board),retail[2]*P.units+2*(P.clearance+P.board)];\n  const [a,b,c]=carton,boardMass=2*(a*b+a*c+b*c)/1e6*P.boardDensity;\n  const layer=bestGrid([P.pallet[0],P.pallet[1],c],[[a,b,c],[b,a,c]]);\n  const heightLayers=Math.floor((P.maxHeight-P.pallet[2])/c);\n  const weightCartons=Math.floor((P.maxWeight-P.palletMass)/(P.units*P.gross[s]+boardMass));\n  const layers=Math.min(heightLayers,Math.floor(weightCartons/layer.count));\n  const perPallet=layer.count*layers*P.units;\n  const pallets=bestGrid([P.container[0],P.container[1],P.pallet[2]],[[P.pallet[0],P.pallet[1],P.pallet[2]],[P.pallet[1],P.pallet[0],P.pallet[2]]]);\n  const floor=bestGrid([P.container[0],P.container[1],P.floorHeight],permutations(carton));\n  const total=s===1?floor.count*P.units:pallets.count*perPallet;\n  const volume=total*retail.reduce((x,y)=>x*y,1)/P.container.reduce((x,y)=>x*y,1)*100;\n  const mass=(boardMass/P.units+P.cushion[s]+P.retailMass[s]+(s===1?0:P.palletMass/perPallet))*1000;\n  return {s,retail,carton,boardMass,layer,layers,perPallet,pallets,floor,total,volume,mass,\n   palletGross:P.palletMass+perPallet/P.units*(P.units*P.gross[s]+boardMass)};\n }\n const results=[0,1,2].map(compute);\n function metrics(r){return [\n  {label:'Units per carton',value:String(P.units),unit:'',note:'Assumed short-edge stacking'},\n  {label:'Units per pallet',value:r.s===1?'— (floor loading)':String(r.perPallet),unit:'',note:'Assumed full layers; 1,000 kg limit'},\n  {label:'Units per container',value:String(r.total),unit:'',note:'Assumed uniform grids; no securing'},\n  {label:'Container volume utilisation (%)',value:r.volume.toFixed(2),unit:'%',note:'Nominal retail volume / internal volume'},\n  {label:'Packaging mass per unit (g)',value:r.mass.toFixed(1),unit:'g',note:'Assumed board, cushions, box, pallet'},\n  {label:'Sea-freight CO₂ per unit (kg CO₂e)',value:(P.carbon/r.total).toFixed(3),unit:'kg CO₂e',note:'Assumed 1,200 kg CO₂e per container'}\n ];}\n const scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\n const renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\n renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);\n renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.localClippingEnabled=true;document.body.appendChild(renderer.domElement);\n scene.environment=new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(),0.04).texture;\n scene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,0.6));\n const light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(2000,6000,3000);scene.add(light);\n const camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\n const controls=new OrbitControls(camera,renderer.domElement);controls.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1;\n controls.addEventListener('start',()=>controls.autoRotate=false);\n const modelGroup=new THREE.Group();scene.add(modelGroup);\n const mat=(color,opacity=1)=>new THREE.MeshStandardMaterial({color,metalness:0,roughness:0.6,transparent:opacity<1,opacity,depthWrite:opacity===1});\n const materials={retail:mat(P.colors.retail),carton:mat(P.colors.carton),wood:mat(P.colors.wood),cushion:mat(P.colors.cushion),void:mat(P.colors.void,0.15),container:mat('#8eafc5',0.12)};\n const edgeMat=new THREE.LineBasicMaterial({color:P.colors.edge});\n function box(parent,d,p,m,edges=false){\n  const mesh=new THREE.Mesh(new THREE.BoxGeometry(...d),m);mesh.position.set(...p);parent.add(mesh);\n  if(edges)mesh.add(new THREE.LineSegments(new THREE.EdgesGeometry(mesh.geometry),edgeMat));return mesh;\n }\n function instances(parent,d,positions,m){\n  const mesh=new THREE.InstancedMesh(new THREE.BoxGeometry(...d),m,positions.length),matrix=new THREE.Matrix4();\n  positions.forEach((p,i)=>mesh.setMatrixAt(i,matrix.makeTranslation(...p)));\n  mesh.instanceMatrix.needsUpdate=true;mesh.computeBoundingSphere();parent.add(mesh);return mesh;\n }\n let scheme=0,level=2,section=true,exploded=false,laptop=null,laptopHost=null;\n function fit(){\n  const bounds=new THREE.Box3().setFromObject(modelGroup,true),size=bounds.getSize(new THREE.Vector3()),center=bounds.getCenter(new THREE.Vector3());\n  const angle=Math.min(camera.fov*Math.PI/360,Math.atan(Math.tan(camera.fov*Math.PI/360)*camera.aspect));\n  const distance=size.length()/2/Math.sin(angle)/0.77;\n  camera.position.copy(center).add(new THREE.Vector3(1,.7,1.2).normalize().multiplyScalar(distance));\n  camera.far=Math.max(20000,distance*3);camera.updateProjectionMatrix();controls.target.copy(center);controls.update();\n }\n function clear(){\n  if(laptop)laptop.removeFromParent();\n  modelGroup.traverse(o=>{if(o.geometry)o.geometry.dispose();});modelGroup.clear();\n }\n function palletGeometry(parent,origins,d){\n  const [l,w,h]=d,deck=[],rails=[];\n  origins.forEach(([x,y,z])=>{\n   deck.push([x+l/2,y+h-P.deck/2,z+w/2],[x+l/2,y+P.deck/2,z+w/2]);\n   for(let i=0;i<3;i++)rails.push([x+l/2,y+h/2,z+P.railWidth/2+i*(w-P.railWidth)/2]);\n  });\n  instances(parent,[l,P.deck,w],deck,materials.wood);\n  instances(parent,[l,h-2*P.deck,P.railWidth],rails,materials.wood);\n }\n function unused(d,used){\n  const [l,w,h]=d,[x,z,y]=used;\n  if(l>x)box(modelGroup,[l-x,h,w],[(l+x)/2,h/2,w/2],materials.void);\n  if(w>z)box(modelGroup,[x,h,w-z],[x/2,h/2,(w+z)/2],materials.void);\n  if(h>y)box(modelGroup,[x,h-y,z],[x/2,(h+y)/2,z/2],materials.void);\n }\n function build(){\n  clear();const r=results[scheme];laptopHost=null;\n  if(level===0){\n   const [a,b,c]=r.carton,[l,w,h]=r.retail,t=P.board,shell=new THREE.Group();modelGroup.add(shell);\n   const panels=[[[a,t,b],[0,t/2,0]],[[a,t,b],[0,c-t/2,0]],[[t,c,b],[-(a-t)/2,c/2,0]],[[t,c,b],[(a-t)/2,c/2,0]],[[a,c,t],[0,c/2,-(b-t)/2]],[[a,c,t],[0,c/2,(b-t)/2]]];\n   panels.forEach(([d,p],i)=>{if(!section||![1,3,5].includes(i))instances(shell,d,[p],materials.carton);});\n   for(let i=0;i<P.units;i++){\n    const y=t+P.clearance+i*(h+(exploded?25:0));\n    if(i<4){box(modelGroup,[l,h,w],[0,y+h/2,0],materials.retail,true);continue;}\n    const tray=new THREE.Group();tray.position.y=y;modelGroup.add(tray);\n    box(tray,[l,2,w],[0,1,0],materials.retail,true);\n    box(tray,[l,h,2],[0,h/2,-w/2+1],materials.retail,true);\n    box(tray,[2,h,w],[-l/2+1,h/2,0],materials.retail,true);\n    box(tray,[2,h,w],[l/2-1,h/2,0],materials.retail,true);\n    const lid=box(tray,[l,2,w],[0,h+w*.47,-w*.68],materials.retail,true);lid.rotation.x=-Math.PI*.38;\n    const [nl,nh,nw]=P.notebook,side=(l-nl)/2,end=(w-nw)/2;\n    box(tray,[side,nh+8,w],[-(nl+side)/2,10+nh/2,0],materials.cushion);\n    box(tray,[side,nh+8,w],[(nl+side)/2,10+nh/2,0],materials.cushion);\n    for(const sign of [-1,1])box(tray,[nl,nh+8,end],[0,10+nh/2,sign*(nw+end)/2],materials.cushion);\n    laptopHost=new THREE.Group();laptopHost.position.y=10;tray.add(laptopHost);if(laptop)laptopHost.add(laptop);\n   }\n  }else{\n   let origins=[],pd=r.pallets.d,cd=r.layer.d;\n   if(level===1){pd=[...P.pallet];origins=[[0,0,0]];}\n   else{\n    const [l,w,h]=P.container;box(modelGroup,[l,h,w],[l/2,h/2,w/2],materials.container,true);\n    if(scheme!==1)for(let i=0;i<r.pallets.n[0];i++)for(let j=0;j<r.pallets.n[1];j++)origins.push([i*pd[0],0,j*pd[1]]);\n   }\n   const positions=[];\n   if(level===2&&scheme===1){\n    cd=r.floor.d;for(let i=0;i<r.floor.n[0];i++)for(let j=0;j<r.floor.n[1];j++)for(let k=0;k<r.floor.n[2];k++)positions.push([(i+.5)*cd[0],(k+.5)*cd[2],(j+.5)*cd[1]]);\n    unused(P.container,r.floor.n.map((n,i)=>n*cd[i]));\n   }else{\n    const rotated=pd[0]!==P.pallet[0],nx=r.layer.n[0],nz=r.layer.n[1];\n    palletGeometry(modelGroup,origins,pd);\n    origins.forEach(([x,y,z])=>{for(let i=0;i<nx;i++)for(let j=0;j<nz;j++)for(let k=0;k<r.layers;k++){\n     const u=(i+.5)*cd[0],v=(j+.5)*cd[1];\n     positions.push([x+(rotated?v:u),P.pallet[2]+(k+.5)*cd[2]+(exploded?k*35:0),z+(rotated?u:v)]);\n    }});\n    if(rotated)cd=[cd[1],cd[0],cd[2]];\n    if(level===2){\n     unused(P.container,[r.pallets.n[0]*pd[0],r.pallets.n[1]*pd[1],P.pallet[2]+r.layers*cd[2]]);\n     origins.forEach(([x,y,z])=>{\n      const ux=(rotated?nz:nx)*cd[0],uz=(rotated?nx:nz)*cd[1],height=r.layers*cd[2];\n      if(pd[0]>ux)box(modelGroup,[pd[0]-ux,height,pd[1]],[x+(pd[0]+ux)/2,P.pallet[2]+height/2,z+pd[1]/2],materials.void);\n      if(pd[1]>uz)box(modelGroup,[ux,height,pd[1]-uz],[x+ux/2,P.pallet[2]+height/2,z+(pd[1]+uz)/2],materials.void);\n     });\n    }\n   }\n   instances(modelGroup,[cd[0],cd[2],cd[1]],positions,materials.carton);\n  }\n  window.__metrics=metrics(r);document.getElementById('title').textContent=P.names[scheme];\n  document.getElementById('metrics').innerHTML=window.__metrics.map((m,i)=>'<div>'+(['Units/carton','Units/pallet','Units/container','Retail volume','Packaging/unit','Sea CO₂/unit'][i])+': '+m.value+' '+m.unit+(i===2?' ('+((r.total/results[0].total-1)*100>=0?'+':'')+((r.total/results[0].total-1)*100).toFixed(1)+'%)':'')+'</div>').join('');\n  document.getElementById('layout').textContent=level===0?r.carton.join(' × ')+' mm; lid open; adapter omitted':scheme===1&&level===2?'Grid '+r.floor.n.join(' × ')+'; door +X':r.layer.count+'/layer × '+r.layers+'; '+r.palletGross.toFixed(1)+' kg/pallet'+(scheme===1?' (reference only)':'');\n  fit();\n }\n const button=(text,action)=>{const b=document.createElement('button');b.textContent=text;b.onclick=action;document.getElementById('buttons').appendChild(b);};\n P.names.forEach((name,i)=>button(name,()=>{scheme=i;build();}));\n ['Carton cut-away','Single pallet','Full container'].forEach((name,i)=>button(name,()=>{level=i;build();}));\n button('Section / Full',()=>{section=!section;level=0;build();});\n button('Exploded view',()=>{exploded=!exploded;build();});\n button('Auto-rotate',()=>controls.autoRotate=!controls.autoRotate);\n window.__scene=scene;window.__camera=camera;window.__renderer=renderer;window.__controls=controls;window.__model=modelGroup;\n window.__schemes=results.map(r=>({name:P.names[r.s],metrics:metrics(r),carton:r.carton,layer:r.layer,floor:r.floor,palletGross:r.palletGross}));\n build();\n new GLTFLoader().load('/static/assets/notebook/laptop14_closed.glb',glt