{"ok": true, "summary": "已建立312×217 mm、R8的顶盖与两半压铸模具概念，含0.8 mm主壁、网格筋、六个螺柱及顶部塑料镶件。胶槽以定位带示意，M2孔留待机加工，质量按实心凸台估算。支持剖切、爆炸及开模顶出；所有特征沿脱模方向，暂不需滑块。1°斜度作为设计要求，未逐面生成；未做模流、凝固与强度分析。", "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>顶盖与压铸模具概念</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}#panel{position:absolute;left:12px;top:12px;max-width:300px;padding:12px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;line-height:1.65}\nh3{margin:0 0 5px;font-size:14px}.buttons{display:flex;gap:4px;flex-wrap:wrap;margin-top:6px}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}button:hover{border-color:#b11f4b}\n#error{position:absolute;top:45%;left:15%;right:15%;color:#b00020;text-align:center;background:#fff}\n#status{font-size:11px;color:#71512c}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h3>14 英寸镁合金顶盖 · 模具概念</h3>\n<div>312×217 · R8 · 壁厚0.8 · 翻边6.5 mm</div>\n<div>筋0.8×2 / 间距45 · 6×φ4.5凸台</div>\n<div>天线带10 · 胶槽定位带3 mm · 斜度1°</div>\n<div>是否需要滑块：否（所有特征沿脱模方向）</div>\n<div id=\"m1\"></div>\n<div id=\"m2\"></div>\n<div id=\"m3\"></div>\n<div>灰：镁合金　黑：PC+GF　蓝：胶槽定位</div>\n<div>透明灰：模具　金：浇排系统　右侧：装机参考</div>\n<div class=\"buttons\"><button id=\"cut\">剖切视图</button><button id=\"explode\">爆炸视图</button><button id=\"rotate\">自动旋转</button><button id=\"mode\">模具视图</button><button id=\"open\">开模</button><button id=\"ref\">隐藏参考整机</button></div>\n<small id=\"status\">实心凸台计重；蓝带非真实切槽；模具未扣型腔。</small>\n</div>\n<div id=\"error\" hidden></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nimport { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nconst P = {\n // 尺寸均为mm；高度以主壁外表面为零\n w:312,d:217,r:8,wall:.8,flangeH:6.5,flangeT:1,\n ribW:.8,ribH:2,pitch:45,bossD:4.5,bossH:3.5,bossCount:6,\n antenna:10,grooveW:3,draft:1,bossXs:[-135,-121,-107,107,121,135],bossZ:99,\n // 工程估算采用圆角面积、周长；筋长扣除翻边及天线带\n mgDensity:1.81,plasticDensity:1.40,pressure:60,safety:1.2,projFactor:1.25,\n dieMargin:150,dieHalf:250,cycle:45,shift:8,oee:.85,price:28,runnerRatio:.35,recycle:.4,\n openStroke:120,ejectStroke:15,animation:.8,referenceX:420,\n gateW:64,gateNeck:16,gateL:32,gateT:2,biscuitR:18,biscuitH:10,\n overflowW:18,overflowL:14,overflowH:3,ventW:3,ventL:24,ventH:.4,\n ejectR:3,ejectL:65,explodeInsert:35,explodeRibs:18,explodeBosses:28\n};\nfunction fail(message){const el=document.getElementById('error');el.hidden=false;el.textContent='模型错误：'+message;}\nwindow.addEventListener('error',e=>fail(e.message));\ntry {\nconst renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;\nrenderer.localClippingEnabled=true;\ndocument.body.appendChild(renderer.domElement);\nconst scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\nscene.environment=new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(),.04).texture;\nscene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\nconst light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(250,600,350);scene.add(light);\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\nconst controls=new OrbitControls(camera,renderer.domElement);\ncontrols.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1;\ncontrols.addEventListener('start',()=>controls.autoRotate=false);\nconst modelGroup=new THREE.Group();scene.add(modelGroup);\nconst tooling=new THREE.Group();modelGroup.add(tooling);\nconst casting=new THREE.Group();tooling.add(casting);\nfunction group(name,parent){const g=new THREE.Group();g.name=name;parent.add(g);return g;}\nconst cover=group('cover',casting),ribs=group('ribs',casting),bosses=group('bosses',casting),insert=group('insert',casting);\nconst fixed=group('die_fixed',tooling),moving=group('die_moving',tooling);\nconst gate=group('gate',tooling),overflows=group('overflows',tooling),reference=group('reference',modelGroup);\nreference.position.x=P.referenceX;\nconst metal=(color,extra={})=>new THREE.MeshStandardMaterial({color,metalness:.85,roughness:.35,...extra});\nconst mg=metal('#b8bec7',{metalness:.6}),plastic=metal('#2b2b2b',{metalness:0,roughness:.6});\nconst gold=metal('#c9a227'),steel=metal('#9aa3ab');\nconst blue=metal('#3b82f6',{metalness:0,transparent:true,opacity:.55,depthWrite:false});\nconst fixedMat=metal('#64748b',{transparent:true,opacity:.25,depthWrite:false});\nconst movingMat=metal('#475569',{transparent:true,opacity:.25,depthWrite:false});\nfunction box(parent,w,h,d,x,y,z,mat){\n const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);m.position.set(x,y,z);parent.add(m);return m;\n}\nfunction cylinder(parent,r,h,x,y,z,mat){\n const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,24),mat);m.position.set(x,y,z);parent.add(m);return m;\n}\nfunction rounded(w,d,r){\n const s=new THREE.Shape(),x=-w/2,z=-d/2;\n s.moveTo(x+r,z);s.lineTo(x+w-r,z);s.quadraticCurveTo(x+w,z,x+w,z+r);\n s.lineTo(x+w,z+d-r);s.quadraticCurveTo(x+w,z+d,x+w-r,z+d);\n s.lineTo(x+r,z+d);s.quadraticCurveTo(x,z+d,x,z+d-r);\n s.lineTo(x,z+r);s.quadraticCurveTo(x,z,x+r,z);return s;\n}\nfunction slab(parent,shape,h,y,mat){\n const geo=new THREE.ExtrudeGeometry(shape,{depth:h,bevelEnabled:false,curveSegments:12});\n geo.rotateX(Math.PI/2);geo.translate(0,y+h,0);\n const mesh=new THREE.Mesh(geo,mat);parent.add(mesh);return mesh;\n}\nconst antennaEdge=-P.d/2+P.antenna;\nconst antennaPlane=new THREE.Plane(new THREE.Vector3(0,0,1),-antennaEdge);\nconst plasticPlane=new THREE.Plane(new THREE.Vector3(0,0,-1),antennaEdge);\nmg.clippingPlanes=[antennaPlane];plastic.clippingPlanes=[plasticPlane];\nslab(cover,rounded(P.w,P.d,P.r),P.wall,0,mg);\nslab(insert,rounded(P.w,P.d,P.r),P.wall,0,plastic);\nconst ring=rounded(P.w,P.d,P.r);\nring.holes.push(new THREE.Path(rounded(P.w-2*P.flangeT,P.d-2*P.flangeT,P.r-P.flangeT).getPoints(48)));\nslab(cover,ring,P.flangeH,P.wall,mg);\nslab(insert,ring,P.flangeH,P.wall,plastic);\nconst nx=Math.floor((P.w-2*P.flangeT)/P.pitch);\nconst nz=Math.floor((P.d-P.antenna-2*P.flangeT)/P.pitch);\nconst ribLX=P.w-2*P.flangeT,ribLZ=P.d-P.antenna-2*P.flangeT;\nconst ribMesh=new THREE.InstancedMesh(new THREE.BoxGeometry(1,1,1),mg,nx+nz);\nconst dummy=new THREE.Object3D();\nfor(let i=0;i<nx+nz;i++){\n const alongZ=i<nx,j=alongZ?i:i-nx;\n dummy.position.set(alongZ?(j-(nx-1)/2)*P.pitch:0,P.wall+P.ribH/2,alongZ?P.antenna/2:(j-(nz-1)/2)*P.pitch+P.antenna/2);\n dummy.scale.set(alongZ?P.ribW:ribLX,P.ribH,alongZ?ribLZ:P.ribW);\n dummy.updateMatrix();ribMesh.setMatrixAt(i,dummy.matrix);\n}\nribMesh.instanceMatrix.needsUpdate=true;ribMesh.computeBoundingSphere();ribs.add(ribMesh);\nP.bossXs.forEach(x=>cylinder(bosses,P.bossD/2,P.bossH,x,P.wall+P.bossH/2,P.bossZ,mg));\nconst groove=rounded(P.w-2*P.flangeT,P.d-2*P.flangeT,P.r-P.flangeT);\ngroove.holes.push(new THREE.Path(rounded(P.w-2*(P.flangeT+P.grooveW),P.d-2*(P.flangeT+P.grooveW),Math.max(.1,P.r-P.flangeT-P.grooveW)).getPoints(48)));\nslab(cover,groove,.08,P.wall+.03,blue);\nconst partY=P.wall+P.flangeH,dieW=P.w+2*P.dieMargin,dieD=P.d+2*P.dieMargin;\nbox(fixed,dieW,P.dieHalf,dieD,0,partY+P.dieHalf/2,0,fixedMat);\nbox(moving,dieW,P.dieHalf,dieD,0,partY-P.dieHalf/2,0,movingMat);\nconst pins=group('ejectors',moving);\n[-1,1].forEach(x=>[-1,1].forEach(z=>cylinder(pins,P.ejectR,P.ejectL,x*P.w/3,-P.ejectL/2,z*P.d/3,steel)));\nconst fan=new THREE.Shape();fan.moveTo(-P.gateW/2,P.d/2);fan.lineTo(P.gateW/2,P.d/2);\nfan.lineTo(P.gateNeck/2,P.d/2+P.gateL);fan.lineTo(-P.gateNeck/2,P.d/2+P.gateL);fan.closePath();\nslab(gate,fan,P.gateT,P.wall,gold);\ncylinder(gate,P.biscuitR,P.biscuitH,0,P.wall,P.d/2+P.gateL+P.biscuitR/2,gold);\nfor(let i=0;i<4;i++){\n const x=(i-1.5)*P.w/5;\n box(overflows,P.overflowW,P.overflowH,P.overflowL,x,P.wall,-P.d/2-P.overflowL/2,gold);\n box(overflows,P.ventW,P.ventH,P.ventL,x,P.wall,-P.d/2-P.overflowL-P.ventL/2,gold);\n}\nconst linePoints=[[-dieW/2,partY,-dieD/2],[dieW/2,partY,-dieD/2],[dieW/2,partY,dieD/2],[-dieW/2,partY,dieD/2]].map(a=>new THREE.Vector3(...a));\nconst partLine=new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(linePoints),new THREE.LineBasicMaterial({color:'#b11f4b'}));tooling.add(partLine);\nconst arrow=new THREE.ArrowHelper(new THREE.Vector3(0,1,0),new THREE.Vector3(-P.w/2-25,partY,0),85,0xb11f4b,14,7);tooling.add(arrow);\nfunction compute(){\n const area=P.w*P.d-(4-Math.PI)*P.r**2;\n const perimeter=2*(P.w+P.d)-8*P.r+2*Math.PI*P.r;\n const antennaArea=P.w*P.antenna-2*(1-Math.PI/4)*P.r**2;\n const volume=(area-antennaArea)*P.wall+perimeter*P.flangeH*P.flangeT+(nx*ribLZ+nz*ribLX)*P.ribW*P.ribH+P.bossCount*Math.PI*(P.bossD/2)**2*P.bossH;\n const mass=volume*P.mgDensity/1000,proj=area*P.projFactor;\n return [\n {label:'净质量',value:mass.toFixed(2),unit:'g',note:'镁件；实心凸台与全周翻边近似，不含塑料'},\n {label:'投影面积',value:(proj/100).toFixed(2),unit:'cm²',note:'圆角外形面积×1.25，含浇排系统'},\n {label:'锁模力估算',value:(P.pressure*proj*P.safety/9810).toFixed(1),unit:'t',note:'假设比压60 MPa，安全系数1.2'},\n {label:'模具外形估算',value:`${dieW} × ${dieD} × ${2*P.dieHalf}`,unit:'mm',note:'每边模框150；两半各250，不含模架附件'},\n {label:'单班产量估算',value:(P.shift*3600/P.cycle*P.oee).toFixed(0),unit:'件/8h',note:'假设一模一件、周期45 s、OEE 85%'},\n {label:'材料成本',value:(mass/1000*P.price*(1+(1-P.recycle)*P.runnerRatio)).toFixed(2),unit:'元/件',note:'假设28元/kg、浇道35%、回用40%；仅镁料'}\n ];\n}\nwindow.__metrics=compute();\nconst ms=window.__metrics;\ndocument.getElementById('m1').textContent=`镁件 ${ms[0].value} g · 投影 ${ms[1].value} cm²`;\ndocument.getElementById('m2').textContent=`锁模 ${ms[2].value} t · 模具 ${ms[3].value} mm`;\ndocument.getElementById('m3').textContent=`45 s/模 · ${ms[4].value}件/班 · 镁料${ms[5].value}元`;\nlet dieMode=false,opened=false,exploded=false,section=false,current=0,startValue=0,target=0,startTime=0;\nconst dieParts=[fixed,moving,gate,overflows,partLine];\nfunction visibility(){dieParts.forEach(g=>g.visible=dieMode);document.getElementById('open').disabled=!dieMode;}\nfunction fit(){\n tooling.updateMatrixWorld(true);\n const bounds=new THREE.Box3().setFromObject(tooling,true),center=bounds.getCenter(new THREE.Vector3()),size=bounds.getSize(new THREE.Vector3());\n const radius=size.length()/2,angle=Math.min(camera.fov*Math.PI/360,Math.atan(Math.tan(camera.fov*Math.PI/360)*camera.aspect));\n const distance=radius/Math.sin(angle)/.7;\n camera.position.copy(center).add(new THREE.Vector3(1,.7,1.2).normalize().multiplyScalar(distance));\n controls.target.copy(center);controls.update();\n}\nfit();visibility();\ndocument.getElementById('mode').onclick=e=>{dieMode=!dieMode;visibility();e.target.textContent=dieMode?'零件视图':'模具视图';};\ndocument.getElementById('open').onclick=e=>{opened=!opened;startValue=current;target=opened?1:0;startTime=performance.now();e.target.textContent=opened?'合模':'开模';};\ndocument.getElementById('explode').onclick=e=>{exploded=!exploded;e.target.textContent=exploded?'还原装配':'爆炸视图';};\ndocument.getElementById('rotate').onclick=()=>controls.autoRotate=!controls.autoRotate;\ndocument.getElementById('ref').onclick=e=>{reference.visible=!reference.visible;e.target.textContent=reference.visible?'隐藏参考整机':'显示参考整机';};\nconst cutPlane=new THREE.Plane(new THREE.Vector3(-1,0,0),0);\ndocument.getElementById('cut').onclick=e=>{\n section=!section;[mg,plastic,gold,steel,blue,fixedMat,movingMat].forEach(mat=>{\n const base=mat===mg?[antennaPlane]:mat===plastic?[plasticPlane]:[];\n mat.clippingPlanes=section?[...base,cutPlane]:base;mat.needsUpdate=true;\n });e.target.textContent=section?'完整视图':'剖切视图';\n};\nwindow.__scene=scene;window.__camera=camera;window.__renderer=renderer;window.__controls=controls;window.__model=modelGroup;\nfunction planarUV(geo){\n geo.computeBoundingBox();const b=geo.boundingBox,s=b.getSize(new THREE.Vector3());\n const axes=['x','y','z'].sort((a,c)=>s[c]-s[a]),pos=geo.attributes.position,uv=new Float32Array(pos.count*2),v=new THREE.Vector3();\n for(let i=0;i<pos.count;i++){v.fromBufferAttribute(pos,i);uv[i*2]=(v[axes[0]]-b.min[axes[0]])/(s[axes[0]]||1);uv[i*2+1]=(v[axes[1]]-b.min[axes[1]])/(s[axes[1]]||1);}\n geo.setAttribute('uv',new THREE.BufferAttribute(uv,2));\n}\nconst canvas=document.createElement('canvas');canvas.width=768;canvas.height=512;\nconst ctx=canvas.getContext('2d'),gradient=ctx.createLinearGradient(0,0,768,512);\ngradient.addColorStop(0,'#0b1a3a');gradient.addColorStop(1,'#1e3a8a');ctx.fillStyle=gradient;ctx.fillRect(0,0,768,512);\n[[230,190,260,'rgba(56,189,248,.75)'],[560,230,240,'rgba(232,121,249,.55)'],[410,430,210,'rgba(250,204,21,.35)']].forEach(([x,y,r,c])=>{const g=ctx.createRadialGradient(x,y,0,x,y,r);g.addColorStop(0,c);g.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=g;ctx.fillRect(0,0,768,512);});\nconst texture=new THREE.CanvasTexture(canvas);texture.colorSpace=THREE.SRGBColorSpace;\nconst notebookMats={base:metal('#cfd0cc',{roughness:.32}),lid:metal('#cfd0cc',{roughness:.32}),keys:metal('#2a2b2e',{metalness:.1,roughness:.55}),touchpad:metal('#dcdcd8',{metalness:.3,roughness:.25}),hinge_:metal('#1c1c1e',{metalness:0,roughness:.6}),feet:metal('#1c1c1e',{metalness:0,roughness:.6}),screen:metal('#ffffff',{metalness:0,map:texture,emissiveMap:texture,emissive:'#ffffff',emissiveIntensity:.6,roughness:.2})};\nnew GLTFLoader().load('/static/assets/notebook/laptop14_open.glb',gltf=>{\n try{gltf.scene.traverse(obj=>{if(!obj.isMesh)return;let node=obj,key;\n while(node&&!key){key=Object.keys(notebookMats).find(k=>node.name.toLowerCase().startsWith(k));node=node.parent;}\n obj.material=key?notebookMats[key]:notebookMats.base;if(key==='screen')planarUV(obj.geometry);\n });reference.add(gltf.scene);}catch(error){fail(error.message);}\n},undefined,()=>{box(reference,300,14.5,214,0,7.25,0,metal('#cfd0cc',{transparent:true,opacity:.35}));document.getElementById('status').textContent='参考素材加载失败，方盒替代；模具未扣型腔。';});\nwindow.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});\nfunction animate(now){\n requestAnimationFrame(animate);\n const t=Math.min(1,(now-startTime)/(P.animation*1000)),smooth=t*t*(3-2*t);\n current=startValue+(target-startValue)*smooth;\n fixed.position.y=current*P.openStroke;casting.position.y=dieMode?current*P.ejectStroke:0;pins.position.y=current*P.ejectStroke;\n const ex=exploded&&!dieMode?1:0;insert.position.y=ex*P.explodeInsert;ribs.position.y=ex*P.explodeRibs;bosses.position.y=ex*P.explodeBosses;\n controls.update();renderer.render(scene,camera);\n}\nrequestAnimationFrame(animate);\n}catch(error){fail(error.message);}\n</script>\n</body>\n</html>", "metrics": [{"label": "净质量", "value": "116.92", "unit": "g", "note": "镁件；实心凸台与全周翻边近似，不含塑料"}, {"label": "投影面积", "value": "845.61", "unit": "cm²", "note": "圆角外形面积×1.25，含浇排系统"}, {"label": "锁模力估算", "value": "620.6", "unit": "t", "note": "假设比压60 MPa，安全系数1.2"}, {"label": "模具外形估算", "value": "612 × 517 × 500", "unit": "mm", "note": "每边模框150；两半各250，不含模架附件"}, {"label": "单班产量估算", "value": "544", "unit": "件/8h", "note": "假设一模一件、周期45 s、OEE 85%"}, {"label": "材料成本", "value": "3.96", "unit": "元/件", "note": "假设28元/kg、浇道35%、回用40%；仅镁料"}], "suggestions": ["细化1°拔模、真实胶槽及M2底孔", "比较0.8与1.0毫米壁厚的质量成本", "细化型腔与天线截断处浇排方案"], "raw": "<<<SUMMARY>>>\n已建立312×217 mm、R8的顶盖与两半压铸模具概念，含0.8 mm主壁、网格筋、六个螺柱及顶部塑料镶件。胶槽以定位带示意，M2孔留待机加工，质量按实心凸台估算。支持剖切、爆炸及开模顶出；所有特征沿脱模方向，暂不需滑块。1°斜度作为设计要求，未逐面生成；未做模流、凝固与强度分析。\n<<<HTML>>>\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>顶盖与压铸模具概念</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}#panel{position:absolute;left:12px;top:12px;max-width:300px;padding:12px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;line-height:1.65}\nh3{margin:0 0 5px;font-size:14px}.buttons{display:flex;gap:4px;flex-wrap:wrap;margin-top:6px}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}button:hover{border-color:#b11f4b}\n#error{position:absolute;top:45%;left:15%;right:15%;color:#b00020;text-align:center;background:#fff}\n#status{font-size:11px;color:#71512c}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h3>14 英寸镁合金顶盖 · 模具概念</h3>\n<div>312×217 · R8 · 壁厚0.8 · 翻边6.5 mm</div>\n<div>筋0.8×2 / 间距45 · 6×φ4.5凸台</div>\n<div>天线带10 · 胶槽定位带3 mm · 斜度1°</div>\n<div>是否需要滑块：否（所有特征沿脱模方向）</div>\n<div id=\"m1\"></div>\n<div id=\"m2\"></div>\n<div id=\"m3\"></div>\n<div>灰：镁合金　黑：PC+GF　蓝：胶槽定位</div>\n<div>透明灰：模具　金：浇排系统　右侧：装机参考</div>\n<div class=\"buttons\"><button id=\"cut\">剖切视图</button><button id=\"explode\">爆炸视图</button><button id=\"rotate\">自动旋转</button><button id=\"mode\">模具视图</button><button id=\"open\">开模</button><button id=\"ref\">隐藏参考整机</button></div>\n<small id=\"status\">实心凸台计重；蓝带非真实切槽；模具未扣型腔。</small>\n</div>\n<div id=\"error\" hidden></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nimport { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nconst P = {\n // 尺寸均为mm；高度以主壁外表面为零\n w:312,d:217,r:8,wall:.8,flangeH:6.5,flangeT:1,\n ribW:.8,ribH:2,pitch:45,bossD:4.5,bossH:3.5,bossCount:6,\n antenna:10,grooveW:3,draft:1,bossXs:[-135,-121,-107,107,121,135],bossZ:99,\n // 工程估算采用圆角面积、周长；筋长扣除翻边及天线带\n mgDensity:1.81,plasticDensity:1.40,pressure:60,safety:1.2,projFactor:1.25,\n dieMargin:150,dieHalf:250,cycle:45,shift:8,oee:.85,price:28,runnerRatio:.35,recycle:.4,\n openStroke:120,ejectStroke:15,animation:.8,referenceX:420,\n gateW:64,gateNeck:16,gateL:32,gateT:2,biscuitR:18,biscuitH:10,\n overflowW:18,overflowL:14,overflowH:3,ventW:3,ventL:24,ventH:.4,\n ejectR:3,ejectL:65,explodeInsert:35,explodeRibs:18,explodeBosses:28\n};\nfunction fail(message){const el=document.getElementById('error');el.hidden=false;el.textContent='模型错误：'+message;}\nwindow.addEventListener('error',e=>fail(e.message));\ntry {\nconst renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;\nrenderer.localClippingEnabled=true;\ndocument.body.appendChild(renderer.domElement);\nconst scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\nscene.environment=new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(),.04).texture;\nscene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\nconst light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(250,600,350);scene.add(light);\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\nconst controls=new OrbitControls(camera,renderer.domElement);\ncontrols.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1;\ncontrols.addEventListener('start',()=>controls.autoRotate=false);\nconst modelGroup=new THREE.Group();scene.add(modelGroup);\nconst tooling=new THREE.Group();modelGroup.add(tooling);\nconst casting=new THREE.Group();tooling.add(casting);\nfunction group(name,parent){const g=new THREE.Group();g.name=name;parent.add(g);return g;}\nconst cover=group('cover',casting),ribs=group('ribs',casting),bosses=group('bosses',casting),insert=group('insert',casting);\nconst fixed=group('die_fixed',tooling),moving=group('die_moving',tooling);\nconst gate=group('gate',tooling),overflows=group('overflows',tooling),reference=group('reference',modelGroup);\nreference.position.x=P.referenceX;\nconst metal=(color,extra={})=>new THREE.MeshStandardMaterial({color,metalness:.85,roughness:.35,...extra});\nconst mg=metal('#b8bec7',{metalness:.6}),plastic=metal('#2b2b2b',{metalness:0,roughness:.6});\nconst gold=metal('#c9a227'),steel=metal('#9aa3ab');\nconst blue=metal('#3b82f6',{metalness:0,transparent:true,opacity:.55,depthWrite:false});\nconst fixedMat=metal('#64748b',{transparent:true,opacity:.25,depthWrite:false});\nconst movingMat=metal('#475569',{transparent:true,opacity:.25,depthWrite:false});\nfunction box(parent,w,h,d,x,y,z,mat){\n const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);m.position.set(x,y,z);parent.add(m);return m;\n}\nfunction cylinder(parent,r,h,x,y,z,mat){\n const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,24),mat);m.position.set(x,y,z);parent.add(m);return m;\n}\nfunction rounded(w,d,r){\n const s=new THREE.Shape(),x=-w/2,z=-d/2;\n s.moveTo(x+r,z);s.lineTo(x+w-r,z);s.quadraticCurveTo(x+w,z,x+w,z+r);\n s.lineTo(x+w,z+d-r);s.quadraticCurveTo(x+w,z+d,x+w-r,z+d);\n s.lineTo(x+r,z+d);s.quadraticCurveTo(x,z+d,x,z+d-r);\n s.lineTo(x,z+r);s.quadraticCurveTo(x,z,x+r,z);return s;\n}\nfunction slab(parent,shape,h,y,mat){\n const geo=new THREE.ExtrudeGeometry(shape,{depth:h,bevelEnabled:false,curveSegments:12});\n geo.rotateX(Math.PI/2);geo.translate(0,y+h,0);\n const mesh=new THREE.Mesh(geo,mat);parent.add(mesh);return mesh;\n}\nconst antennaEdge=-P.d/2+P.antenna;\nconst antennaPlane=new THREE.Plane(new THREE.Vector3(0,0,1),-antennaEdge);\nconst plasticPlane=new THREE.Plane(new THREE.Vector3(0,0,-1),antennaEdge);\nmg.clippingPlanes=[antennaPlane];plastic.clippingPlanes=[plasticPlane];\nslab(cover,rounded(P.w,P.d,P.r),P.wall,0,mg);\nslab(insert,rounded(P.w,P.d,P.r),P.wall,0,plastic);\nconst ring=rounded(P.w,P.d,P.r);\nring.holes.push(new THREE.Path(rounded(P.w-2*P.flangeT,P.d-2*P.flangeT,P.r-P.flangeT).getPoints(48)));\nslab(cover,ring,P.flangeH,P.wall,mg);\nslab(insert,ring,P.flangeH,P.wall,plastic);\nconst nx=Math.floor((P.w-2*P.flangeT)/P.pitch);\nconst nz=Math.floor((P.d-P.antenna-2*P.flangeT)/P.pitch);\nconst ribLX=P.w-2*P.flangeT,ribLZ=P.d-P.antenna-2*P.flangeT;\nconst ribMesh=new THREE.InstancedMesh(new THREE.BoxGeometry(1,1,1),mg,nx+nz);\nconst dummy=new THREE.Object3D();\nfor(let i=0;i<nx+nz;i++){\n const alongZ=i<nx,j=alongZ?i:i-nx;\n dummy.position.set(alongZ?(j-(nx-1)/2)*P.pitch:0,P.wall+P.ribH/2,alongZ?P.antenna/2:(j-(nz-1)/2)*P.pitch+P.antenna/2);\n dummy.scale.set(alongZ?P.ribW:ribLX,P.ribH,alongZ?ribLZ:P.ribW);\n dummy.updateMatrix();ribMesh.setMatrixAt(i,dummy.matrix);\n}\nribMesh.instanceMatrix.needsUpdate=true;ribMesh.computeBoundingSphere();ribs.add(ribMesh);\nP.bossXs.forEach(x=>cylinder(bosses,P.bossD/2,P.bossH,x,P.wall+P.bossH/2,P.bossZ,mg));\nconst groove=rounded(P.w-2*P.flangeT,P.d-2*P.flangeT,P.r-P.flangeT);\ngroove.holes.push(new THREE.Path(rounded(P.w-2*(P.flangeT+P.grooveW),P.d-2*(P.flangeT+P.grooveW),Math.max(.1,P.r-P.flangeT-P.grooveW)).getPoints(48)));\nslab(cover,groove,.08,P.wall+.03,blue);\nconst partY=P.wall+P.flangeH,dieW=P.w+2*P.dieMargin,dieD=P.d+2*P.dieMargin;\nbox(fixed,dieW,P.dieHalf,dieD,0,partY+P.dieHalf/2,0,fixedMat);\nbox(moving,dieW,P.dieHalf,dieD,0,partY-P.dieHalf/2,0,movingMat);\nconst pins=group('ejectors',moving);\n[-1,1].forEach(x=>[-1,1].forEach(z=>cylinder(pins,P.ejectR,P.ejectL,x*P.w/3,-P.ejectL/2,z*P.d/3,steel)));\nconst fan=new THREE.Shape();fan.moveTo(-P.gateW/2,P.d/2);fan.lineTo(P.gateW/2,P.d/2);\nfan.lineTo(P.gateNeck/2,P.d/2+P.gateL);fan.lineTo(-P.gateNeck/2,P.d/2+P.gateL);fan.closePath();\nslab(gate,fan,P.gateT,P.wall,gold);\ncylinder(gate,P.biscuitR,P.biscuitH,0,P.wall,P.d/2+P.gateL+P.biscuitR/2,gold);\nfor(let i=0;i<4;i++){\n const x=(i-1.5)*P.w/5;\n box(overflows,P.overflowW,P.overflowH,P.overflowL,x,P.wall,-P.d/2-P.overflowL/2,gold);\n box(overflows,P.ventW,P.ventH,P.ventL,x,P.wall,-P.d/2-P.overflowL-P.ventL/2,gold);\n}\nconst linePoints=[[-dieW/2,partY,-dieD/2],[dieW/2,partY,-dieD/2],[dieW/2,partY,dieD/2],[-dieW/2,partY,dieD/2]].map(a=>new THREE.Vector3(...a));\nconst partLine=new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(linePoints),new THREE.LineBasicMaterial({color:'#b11f4b'}));tooling.add(partLine);\nconst arrow=new THREE.ArrowHelper(new THREE.Vector3(0,1,0),new THREE.Vector3(-P.w/2-25,partY,0),85,0xb11f4b,14,7);tooling.add(arrow);\nfunction compute(){\n const area=P.w*P.d-(4-Math.PI)*P.r**2;\n const perimeter=2*(P.w+P.d)-8*P.r+2*Math.PI*P.r;\n const antennaArea=P.w*P.antenna-2*(1-Math.PI/4)*P.r**2;\n const volume=(area-antennaArea)*P.wall+perimeter*P.flangeH*P.flangeT+(nx*ribLZ+nz*ribLX)*P.ribW*P.ribH+P.bossCount*Math.PI*(P.bossD/2)**2*P.bossH;\n const mass=volume*P.mgDensity/1000,proj=area*P.projFactor;\n return [\n {label:'净质量',value:mass.toFixed(2),unit:'g',note:'镁件；实心凸台与全周翻边近似，不含塑料'},\n {label:'投影面积',value:(proj/100).toFixed(2),unit:'cm²',note:'圆角外形面积×1.25，含浇排系统'},\n {label:'锁模力估算',value:(P.pressure*proj*P.safety/9810).toFixed(1),unit:'t',note:'假设比压60 MPa，安全系数1.2'},\n {label:'模具外形估算',value:`${dieW} × ${dieD} × ${2*P.dieHalf}`,unit:'mm',note:'每边模框150；两半各250，不含模架附件'},\n {label:'单班产量估算',value:(P.shift*3600/P.cycle*P.oee).toFixed(0),unit:'件/8h',note:'假设一模一件、周期45 s、OEE 85%'},\n {label:'材料成本',value:(mass/1000*P.price*(1+(1-P.recycle)*P.runnerRatio)).toFixed(2),unit:'元/件',note:'假设28元/kg、浇道35%、回用40%；仅镁料'}\n ];\n}\nwindow.__metrics=compute();\nconst ms=window.__metrics;\ndocument.getElementById('m1').textContent=`镁件 ${ms[0].value} g · 投影 ${ms[1].value} cm²`;\ndocument.getElementById('m2').textContent=`锁模 ${ms[2].value} t · 模具 ${ms[3].value} mm`;\ndocument.getElementById('m3').textContent=`45 s/模 · ${ms[4].value}件/班 · 镁料${ms[5].value}元`;\nlet dieMode=false,opened=false,exp