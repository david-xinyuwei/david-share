{"ok": true, "summary": "已构建含线边仓、配送小车、传送带及装配、测试、老化、包装工位的交互产线，支持班制与自动化升级切换、编号聚焦和阶段轮播。线体按实际尺度布置，设备与工件采用示意比例。这是系统级示意与节拍估算，非离散事件仿真；稼动率、并行能力和巡检折算人数为可修改假设，在制品按指定等效时间公式估算，另提示老化实际占用差异。", "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>总装产线数字孪生</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;top:10px;left:10px;max-width:300px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;padding:10px;font-size:12px;line-height:1.65}\nh3{margin:0;font-size:14px}.row{margin:3px 0}button{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover{border-color:#b11f4b}button.active{color:#b11f4b;border-color:#b11f4b}\n#hint{color:#666;font-size:11px}#error{position:absolute;top:45%;left:15%;right:15%;color:#b00020;background:white;text-align:center;z-index:20}\n#detail{position:absolute;right:10px;bottom:12px;max-width:350px;padding:10px;background:#ffffffe6;border:1px solid #dedede;border-radius:8px;font-size:12px;line-height:1.7}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h3>笔记本总装产线 · U 形</h3>\n<div class=\"row\" id=\"modes\"><button>① 单班</button> <button>② 双班</button> <button>③ 升级</button></div>\n<div id=\"production\"></div>\n<div id=\"numbers\"></div>\n<div id=\"balance\"></div>\n<div id=\"people\"></div>\n<div id=\"bottleneck\" style=\"color:#b11f4b\"></div>\n<div id=\"stage\"></div>\n<div id=\"stageText\"></div>\n<div>蓝：工件　橙：AGV　灰：设备　紫红：瓶颈</div>\n<div class=\"row\"><button id=\"cut\">剖切视图</button> <button id=\"rotate\">自动旋转</button> <button id=\"pause\">暂停</button> <button id=\"reset\">全线</button></div>\n<div id=\"hint\">工件放大 3× 示意 · 正在加载合盖工件</div>\n</div>\n<div id=\"detail\">点击工位编号查看类别、标准作业时间与用途。</div>\n<div id=\"error\" hidden></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nimport { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nimport { mergeGeometries } from 'three/addons/utils/BufferGeometryUtils.js';\nconst P = {\n  // 尺寸 mm，时间 s；U 形中心线累计长 60000\n  leg:26000,span:8000,beltWidth:1100,beltHeight:900,beltThick:220,\n  table:[1900,850,1700],stationOffset:2050,warehouse:[7200,2400,2200],\n  warehousePos:[0,1200,7200],agv:[1200,450,850],unit:[301,14.5,220],unitScale:3,\n  rack:[2300,2500,1800],rackLevels:5,markerSize:850,workpieceCap:40,\n  shiftHours:8,secondsPerHour:3600,agingSeconds:7200,animationRate:30,travelSeconds:120,\n  // 人工人数；机器人及 AOI 按共享巡检折算；升级辅助站各计 0.5 人\n  times:[22,34,26,28,30,32,26,24,180,7200,28,30,24,12],\n  staff:[1,2,.5,1,2,2,.5,.5,2,2,2,1,.5,1],\n  names:['底壳上线','主板与散热装配','自动锁螺钉','电池与扬声器','屏幕与转轴','键盘与合盖','自动锁螺钉','外观 AOI','测试','老化','软件与终检','贴标与包装','装箱码垛','成品下线'],\n  categories:['人工工位','人工工位','机器人','人工工位','人工工位','人工工位','机器人','AOI','测试机台','老化架','人工工位','人工工位','机器人','人工工位'],\n  marks:['①','②','③','④','⑤','⑥','⑦','⑧','⑨','⑩','⑪','⑫','⑬','⑭'],\n  modes:[\n    {name:'单班 800 台',shifts:1,target:800,oee:.85,test:6,rack:240,upgrade:false,aoi:'全检（假设）'},\n    {name:'双班 1800 台',shifts:2,target:1800,oee:.85,test:9,rack:300,upgrade:false,aoi:'全检（假设）'},\n    {name:'自动化升级',shifts:2,target:1800,oee:.88,test:9,rack:300,upgrade:true,aoi:'全检'}\n  ],\n  upgrades:{3:22,5:24,11:20},upgradeStaff:.5,\n  colors:{al:'#d4d9e0',plastic:'#2b2b2b',units:'#0ea5e9',agv:'#f59e0b',hot:'#b11f4b'},\n  stageSeconds:5,agvCycle:24,agvOffsets:[0,.33,.66]\n};\nconst $=id=>document.getElementById(id);\nfunction showError(message){$('error').hidden=false;$('error').textContent='场景错误：'+message;}\nwindow.addEventListener('error',e=>showError(e.message));\ntry {\nconst scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\nconst renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.localClippingEnabled=true;\ndocument.body.prepend(renderer.domElement);\nconst pmrem=new THREE.PMREMGenerator(renderer);\nscene.environment=pmrem.fromScene(new RoomEnvironment(),.04).texture;\nscene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\nconst light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(5000,16000,8000);scene.add(light);\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\n// 保持相机规定参数，拟合全线时按实际尺度扩展远裁面\nconst controls=new OrbitControls(camera,renderer.domElement);\ncontrols.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1;\nconst model=new THREE.Group();scene.add(model);\nconst parts={},sprites=[],robots=[],shells=[],agvs=[],testSlots=[],rackSlots=[];\nlet modeIndex=0,result,stageIndex=0,stageClock=0,paused=false,focusId=null,tween=null,elapsed=0,cut=false;\nfunction material(color,metal=.2,opacity=1){\n return new THREE.MeshStandardMaterial({color,metalness:metal,roughness:.6,transparent:opacity<1,opacity});\n}\nfunction box(parent,size,pos,color,opacity=1){\n const mesh=new THREE.Mesh(new THREE.BoxGeometry(...size),material(color,.2,opacity));\n mesh.position.set(...pos);parent.add(mesh);return mesh;\n}\nfunction group(id,pos){const g=new THREE.Group();g.name=id;g.position.set(...pos);model.add(g);parts[id]=g;return g;}\nfunction marker(g,n,y){\n const c=document.createElement('canvas');c.width=c.height=128;const ctx=c.getContext('2d');\n ctx.fillStyle='white';ctx.beginPath();ctx.arc(64,64,57,0,Math.PI*2);ctx.fill();\n ctx.strokeStyle=P.colors.hot;ctx.lineWidth=1;ctx.stroke();ctx.fillStyle='#30333a';\n ctx.font='bold 54px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(n,64,65);\n const s=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),depthTest:false}));\n s.scale.setScalar(P.markerSize);s.position.set(0,y,0);s.userData.id=g.name;g.add(s);sprites.push(s);\n}\nconst pathPoints=[[-P.leg/2,0,-P.span/2],[P.leg/2,0,-P.span/2],[P.leg/2,0,P.span/2],[-P.leg/2,0,P.span/2]];\nconst pathLength=2*P.leg+P.span;\nfunction pathAt(d){\n d=THREE.MathUtils.clamp(d,0,pathLength);\n if(d<P.leg)return {p:new THREE.Vector3(-P.leg/2+d,P.beltHeight,-P.span/2),angle:0};\n if(d<P.leg+P.span)return {p:new THREE.Vector3(P.leg/2,P.beltHeight,-P.span/2+d-P.leg),angle:-Math.PI/2};\n return {p:new THREE.Vector3(P.leg/2-(d-P.leg-P.span),P.beltHeight,P.span/2),angle:Math.PI};\n}\nconst conveyor=group('conveyor',[0,0,0]);\nbox(conveyor,[P.leg,P.beltThick,P.beltWidth],[0,P.beltHeight-P.beltThick/2,-P.span/2],'#445467');\nbox(conveyor,[P.leg,P.beltThick,P.beltWidth],[0,P.beltHeight-P.beltThick/2,P.span/2],'#445467');\nbox(conveyor,[P.beltWidth,P.beltThick,P.span-P.beltWidth],[P.leg/2,P.beltHeight-P.beltThick/2,0],'#445467');\nfor(const z of [-P.span/2,P.span/2])for(let x=-12000;x<=12000;x+=4000)box(conveyor,[180,680,700],[x,340,z],P.colors.al);\nconst stations=[],hotspots=[];\nfunction robot(g,x=0){\n const base=new THREE.Group();base.position.set(x,P.table[1],0);g.add(base);\n box(base,[460,220,460],[0,110,0],P.colors.plastic);\n const pivot=new THREE.Group();pivot.position.y=220;base.add(pivot);\n box(pivot,[230,850,230],[0,420,0],'#d4d9e0');\n box(pivot,[850,210,230],[350,830,0],'#d4d9e0');\n box(pivot,[130,260,150],[730,660,0],P.colors.hot);robots.push(pivot);return base;\n}\nfunction person(g){\n const human=new THREE.Group();human.position.set(0,0,1050);g.add(human);\n const body=new THREE.Mesh(new THREE.CapsuleGeometry(170,650,4,8),material('#1f4e79'));\n body.position.y=1000;human.add(body);\n const head=new THREE.Mesh(new THREE.SphereGeometry(160,10,8),material('#c8b39d'));head.position.y=1590;human.add(head);\n for(const x of [-120,120])box(human,[130,650,150],[x,330,0],P.colors.plastic);\n return human;\n}\nfor(let i=0;i<14;i++){\n const distance=1100+i*(pathLength-2200)/13,point=pathAt(distance);\n const outward=distance<P.leg?[0,0,-P.stationOffset]:distance<P.leg+P.span?[P.stationOffset,0,0]:[0,0,P.stationOffset];\n const id='st'+String(i+1).padStart(2,'0'),g=group(id,[point.p.x+outward[0],0,point.p.z+outward[2]]);\n if(distance<P.leg)g.rotation.y=Math.PI;else if(distance<P.leg+P.span)g.rotation.y=Math.PI/2;\n box(g,P.table,[0,P.table[1]/2,0],P.colors.al);\n const top=box(g,[1800,50,1600],[0,875,0],P.colors.plastic);shells.push(top);\n const entry={g,distance,human:null,assist:null};\n const category=P.categories[i];\n if(category==='机器人')robot(g);\n else if(category==='人工工位'){entry.human=person(g);if([3,5,11].includes(i)){entry.assist=robot(g);entry.assist.visible=false;}}\n else if(category==='测试机台'){\n  for(let j=0;j<9;j++){const m=box(g,[480,400,360],[(j%3-1)*560,1100,Math.floor(j/3)*470-470],'#1f4e79');testSlots.push(m);}\n }else if(category==='老化架'){\n  box(g,[P.rack[0],120,P.rack[2]],[0,940,0],P.colors.al);\n  for(let k=0;k<P.rackLevels;k++){\n   box(g,[P.rack[0],65,P.rack[2]],[0,1050+k*350,0],P.colors.al);\n   for(let j=0;j<6;j++)rackSlots.push(box(g,[270,120,600],[(j-2.5)*350,1150+k*350,0],'#1f4e79'));\n  }\n  for(const x of [-1100,1100])box(g,[80,1800,1700],[x,1800,0],P.colors.al);\n }else{\n  box(g,[1600,1200,180],[0,1450,-600],P.colors.al);\n  box(g,[450,220,450],[0,1900,0],'#1f4e79');\n }\n marker(g,i+1,i===9?3450:2600);\n stations.push(entry);\n hotspots.push({id,n:i+1,label:P.marks[i]+' '+P.names[i],part:category,note:i===9?'架式老化，台位按模式调整。':'按顺序完成'+P.names[i]+'。'});\n}\nconst warehouse=group('warehouse',P.warehousePos);\nbox(warehouse,P.warehouse,[0,0,0],'#9aa3ab',.22);\nfor(let i=0;i<8;i++)box(warehouse,[650,550,850],[(i-3.5)*820,-700,0],'#b8aa8c');\nmarker(warehouse,15,2100);\nhotspots.push({id:'warehouse',n:15,label:'线边仓',part:'人工工位',note:'配套线边仓，供 AGV 取料与补料。'});\nfor(let i=0;i<3;i++){\n const g=group('agv_'+(i+1),[0,0,0]);\n box(g,P.agv,[0,P.agv[1]/2,0],P.colors.agv);box(g,[850,350,650],[0,625,0],'#b8aa8c');\n for(const x of [-460,460])for(const z of [-350,350])box(g,[240,200,100],[x,130,z],P.colors.plastic);\n marker(g,16+i,1500);\n const dest=stations[[0,5,13][i]].g.position;\n const points=[new THREE.Vector3(-2400+i*2400,0,7200),new THREE.Vector3(-16500-i*700,0,7200),new THREE.Vector3(-16500-i*700,0,dest.z),new THREE.Vector3(dest.x,0,dest.z+1800)];\n const curve=new THREE.CatmullRomCurve3(points);\n const line=new THREE.Line(new THREE.BufferGeometry().setFromPoints(curve.getPoints(70)),new THREE.LineBasicMaterial({color:P.colors.agv,transparent:true,opacity:.4}));\n model.add(line);agvs.push({g,curve,line});\n hotspots.push({id:g.name,n:16+i,label:'配送 AGV '+(i+1),part:'AGV',note:'沿独立示意路径往返配送，不含避障调度。'});\n}\nconst grid=new THREE.GridHelper(50000,50,'#d7d3ce','#e5e1db');grid.position.y=-10;scene.add(grid);\nlet unitMesh=new THREE.InstancedMesh(new THREE.BoxGeometry(...P.unit),material(P.colors.units,0,.65),P.workpieceCap);\nunitMesh.name='flow_units';model.add(unitMesh);\nconst dummy=new THREE.Object3D(),zero=new THREE.Matrix4().makeScale(0,0,0);\nfor(let i=0;i<P.workpieceCap;i++)unitMesh.setMatrixAt(i,zero);\nunitMesh.instanceMatrix.needsUpdate=true;unitMesh.computeBoundingSphere();\nfunction compute(mode){\n const effective=P.times.map((time,i)=>(mode.upgrade&&P.upgrades[i]!==undefined?P.upgrades[i]:time)/(i===8?mode.test:i===9?mode.rack:1));\n const available=P.shiftHours*P.secondsPerHour*mode.shifts,takt=available*mode.oee/mode.target;\n const max=Math.max(...effective),sum=effective.reduce((a,b)=>a+b,0),b=effective.indexOf(max);\n const staff=P.staff.reduce((a,n,i)=>a+(mode.upgrade&&P.upgrades[i]!==undefined?P.upgradeStaff:n),0);\n const wip=Math.ceil(sum/takt),balance=sum/(14*max)*100;\n const capacity=available*mode.oee/max,hourly=mode.target/(P.shiftHours*mode.shifts*staff);\n const agingPhysical=mode.target/available*P.agingSeconds;\n const values=[takt.toFixed(2),balance.toFixed(2),P.marks[b]+' '+P.names[b],String(wip),staff.toFixed(1),(mode.oee*100).toFixed(1)];\n const labels=['节拍时间','线平衡率','瓶颈工位','在制品数量','操作员人数','OEE 估算'],units=['s/台','%','','台','人','%'];\n return {effective,takt,max,sum,b,staff,wip,balance,capacity,hourly,agingPhysical,metrics:labels.map((label,i)=>({label,value:values[i],unit:units[i],note:'以页面实时计算为准'}))};\n}\nconst stages=[\n {title:'上料',text:'D 壳与主板从线边仓由 AGV 配送上线。',ids:['warehouse','agv_1','agv_2','agv_3','st01'],range:[0,4000]},\n {title:'装配',text:'②–⑦完成装配、合盖及自动锁螺钉。',ids:['st02','st03','st04','st05','st06','st07'],range:[4000,30000]},\n {title:'测试老化',text:'AOI 全检后进入并行功能测试与架式老化。',ids:['st08','st09','st10'],range:[30000,44000]},\n {title:'包装出货',text:'终检、贴标包装、协作码垛，成品由 AGV 转运。',ids:['st11','st12','st13','st14','agv_3'],range:[44000,60000]}\n];\nfunction highlight(){\n const active=stages[stageIndex].ids,bid='st'+String(result.b+1).padStart(2,'0');\n Object.entries(parts).forEach(([id,g])=>g.traverse(o=>{\n  if(!o.isMesh)return;\n  const m=o.material;if(m.userData.originalOpacity===undefined)m.userData.originalOpacity=m.opacity;\n  const selected=focusId?id===focusId:active.includes(id);\n  m.opacity=m.userData.originalOpacity*(focusId?(selected?1:.25):(selected||id===bid?1:.4));\n  m.transparent=m.opacity<1;m.depthWrite=m.opacity>=1;\n  m.emissive.set(id===bid||selected?P.colors.hot:'#000000');\n  m.emissiveIntensity=id===bid?.5:focusId&&selected?.25:selected?.10:0;\n }));\n agvs.forEach(a=>a.line.material.opacity=active.includes(a.g.name)?.7:.15);\n}\nfunction details(id){\n if(!id){$('detail').textContent='WIP 为指定等效时间口径（含老化摊销），不代表老化架实际存量。点击编号查看工位。';return;}\n const h=hotspots.find(x=>x.id===id),idx=stations.findIndex(x=>x.g.name===id);\n $('detail').textContent=h.label+' · '+h.part+'｜'+h.note+(idx>=0?' 有效作业 '+result.effective[idx].toFixed(2)+' s/台。':'')+\n (idx===9?' 老化 '+P.agingSeconds/3600+' h；目标平均占用约 '+result.agingPhysical.toFixed(0)+' 台。':'');\n}\nfunction changeMode(i){\n modeIndex=i;const m=P.modes[i];result=compute(m);window.__metrics=result.metrics;\n window.__production={target:m.target,capacity:result.capacity,perPersonHour:result.hourly,agingOccupancy:result.agingPhysical};\n stations.forEach((s,j)=>{if(s.assist){s.assist.visible=m.upgrade;s.human.visible=!m.upgrade;hotspots[j].part=m.upgrade?'机器人':'人工工位';}});\n testSlots.forEach((s,j)=>s.visible=j<m.test);rackSlots.forEach((s,j)=>s.visible=j<m.rack/10);\n $('production').textContent='60 m · '+m.name+' / '+(m.shifts*P.shiftHours)+' h · OEE '+(m.oee*100).toFixed(0)+'%';\n $('numbers').textContent='节拍 '+result.takt.toFixed(2)+' s/台 · WIP ≈ '+result.wip+' 台';\n $('balance').textContent='平衡率 '+result.balance.toFixed(2)+'% · 能力约 '+Math.floor(result.capacity)+' 台/期';\n $('people').textContent='操作员 '+result.staff.toFixed(1)+' 人/班 · 人均 '+result.hourly.toFixed(2)+' 台/h';\n $('bottleneck').textContent='瓶颈 '+P.marks[result.b]+' '+P.names[result.b]+' '+result.max+' s > 节拍（目标未达）';\n [...$('modes').children].forEach((b,j)=>b.classList.toggle('active',j===i));\n highlight();details(focusId);buildTimeline();\n}\nlet timeline=[],cycle=1;\nfunction buildTimeline(){\n timeline=[];let time=0,last=0;\n stations.forEach((s,i)=>{\n  const move=(s.distance-last)/pathLength*P.travelSeconds;\n  timeline.push({a:time,b:time+move,from:last,to:s.distance});time+=move;\n  timeline.push({a:time,b:time+result.effective[i],from:s.distance,to:s.distance});time+=result.effective[i];last=s.distance;\n });\n timeline.push({a:time,b:time+(pathLength-last)/pathLength*P.travelSeconds,from:last,to:pathLength});\n cycle=timeline[timeline.length-1].b;\n}\nwindow.__hotspots=hotspots;\nwindow.__stages=stages.map(({title,text})=>({title,text}));\nwindow.__setStage=i=>{\n stageIndex=((i%stages.length)+stages.length)%stages.length;stageClock=0;\n $('stage').textContent='阶段 '+(stageIndex+1)+'/4 · '+stages[stageIndex].title;\n $('stageText').textContent=stages[stageIndex].text;highlight();\n if(typeof window.__notifyStage==='function')window.__notifyStage(stageIndex);\n};\nconst bounds=new THREE.Box3().setFromObject(model,true),center=bounds.getCenter(new THREE.Vector3()),size=bounds.getSize(new THREE.Vector3());\nconst direction=new THREE.Vector3(1,.7,1.2).normalize();\nlet home;\nfunction fit(){\n const radius=size.length()/2,fov=THREE.MathUtils.degToRad(40),half=Math.min(fov/2,Math.atan(Math.tan(fov/2)*camera.aspect));\n const distance=radius/Math.sin(half)/.7;home=center.clone().addScaledVector(direction,distance);\n camera.far=Math.max(20000,distance+radius*4);camera.updateProjectionMatrix();\n camera.position.copy(home);controls.target.copy(center);controls.update();\n}\nfit();\nwindow.__focus=id=>{\n if(id&&!parts[id])return;focusId=id||null;controls.autoRotate=false;\n let target=center.clone(),position=home.clone();\n if(id){\n  const b=new THREE.Box3().setFromObject(parts[id],true);target=b.getCenter(new THREE.Vector3());\n  const extent=Math.max(...b.getSize(new THREE.Vector3()).toArray());\n  position=target.clone().addScaledVector(direction,extent*2.5);\n }\n tween={start:performance.now(),from:camera.position.clone(),to:position,oldTarget:controls.target.clone(),target};\n highlight();details(id);\n};\nchangeMode(0);window.__setStage(0);\nwindow.__scene=scene;window.__camera=camera;window.__renderer=renderer;window.__controls=controls;window.__model=model;\n[...$('modes').children].forEach((b,i)=>b.onclick=()=>changeMode(i));\n$('rotate').onclick=()=>controls.autoRotate=!controls.autoRotate;\n$('pause').onclick=()=>{paused=!paused;$('pause').textContent=paused?'继续':'暂停';};\n$('reset').onclick=()=>window.__focus(null);\n$('cut').onclick=()=>{cut=!cut;shells.forEach(s=>s.visible=!cut);warehouse.children[0].visible=!cut;$('cut').textContent=cut?'完整视图':'剖切视图';};\ncontrols.addEventListener('start',()=>{controls.autoRotate=false;tween=null;});\nconst raycaster=new THREE.Raycaster(),mouse=new THREE.Vector2();let down;\nrenderer.domElement.addEventListener('pointerdown',e=>down=[e.clientX,e.clientY]);\nrenderer.domElement.addEventListener('pointerup',e=>{\n if(!down||Math.hypot(e.clientX-down[0],e.clientY-down[1])>5)return;\n mouse.set(e.clientX/innerWidth*2-1,1-e.clientY/innerHeight*2);raycaster.setFromCamera(mouse,camera);\n const hit=raycaster.intersectObjects(sprites)[0];if(hit)window.__focus(hit.object.userData.id);\n});\nwindow.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;renderer.setSize(innerWidth,innerHeight);camera.updateProjectionMatrix();if(!focusId)fit();});\nnew GLTFLoader().load('/static/assets/notebook/laptop14_closed.glb',gltf=>{\n try{\n  gltf.scene.updateMatrixWorld(true);const geometries=[];\n  gltf.scene.traverse(mesh=>{\n   if(!mesh.isMesh)return;\n   let g=mesh.geometry.clone();g.applyMatrix4(mesh.matrixWorld);\n   if(g.index){const old=g;g=g.toNonIndexed();old.dispose();}\n   for(const key of Object.keys(g.attributes))if(key!=='position'&&key!=='normal')g.deleteAttribute(key);\n   if(!g.attributes.normal)g.computeVertexNormals();g.clearGroups();geometries.push(g);\n  });\n  if(!geometries.length)throw new Error('工件网格为空');\n  const merged=mergeGeometries(geometries,false);geometries.forEach(g=>g.dispose());\n  if(!merged)throw new Error('工件合并失败');\n  // 实例复用复杂素材；网格过大时抽取面以约束总面数\n  const maxFaces=Math.floor(420000/P.workpieceCap),faces=merged.attributes.position.count/3;\n  let geometry=merged;\n  if(faces>maxFaces){\n   const values=[];for(let k=0;k<maxFaces;k++){const f=Math.floor(k*faces/maxFaces);for(let j=0;j<3;j++){const p=merged.attributes.position;values.push(p.getX(f*3+j),p.getY(f*3+j),p.getZ(f*3+j));}}\n   geometry=new THREE.BufferGeometry();geometry.setAttribute('position',new THREE.Float32BufferAttribute(values,3));geometry.computeVertexNormals();merged.dispose();\n  }\n  model.remove(unitMesh);unitMesh.geometry.dispose();unitMesh.material.dispose();\n  unitMesh=new THREE.InstancedMesh(geometry,new THREE.MeshStandardMaterial({color:'#cfd0cc',metalness:.85,roughness:.32}),P.workpieceCap);\n  unitMesh.name='flow_units';for(let j=0;j<P.workpieceCap;j++)unitMesh.setMatrixAt(j,zero);\n  unitMesh.instanceMatrix.needsUpdate=true;unitMesh.computeBoundingSphere();model.add(unitMesh);\n  $('hint').textContent='工件放大 3× 示意 · 动画加速，非实际物流节拍';\n }catch(error){$('hint').textContent='工件放大 3× · 素材处理失败，保留方块：'+error.message;}\n},undefined,()=>{$('hint').textContent='工件放大 3× · 素材加载失败，保留半透明方块';});\nlet previous=performance.now();\nfunction animate(now){\n requestAnimationFrame(animate);const dt=Math.min((now-previous)/1000,.1);previous=now;elapsed+=dt;\n if(!paused){stageClock+=dt;if(stageClock>=P.stageSeconds)window.__setStage(stageIndex+1);}\n for(let i=0;i<P.workpieceCap;i++){\n  if(i>=result.wip){unitMesh.setMatrixAt(i,zero);continue;}\n  const t=(elapsed*P.animationRate+i*cycle/result.wip)%cycle,seg=timeline.find(s=>t<=s.b)||timeline[timeline.length-1];\n  const d=THREE.MathUtils.lerp(seg.from,seg.to,(t-seg.a)/Math.max(.0001,seg.b-seg.a)),loc=pathAt(d);\n  dummy.position.copy(loc.p);dummy.position.y+=30;dummy.rotation.set(0,loc.angle,0);dummy.scale.setScalar(P.unitScale);dummy.updateMatrix();\n  unitMesh.setMatrixAt(i,dummy.matrix);\n  const active=d>=stages[stageIndex].range[0]&&d<=stages[stageIndex].range[1];\n  unitMesh.setColorAt(i,new THREE.Color(active?'#ffffff':'#7a98ac'));\n }\n unitMesh.instanceMatrix.needsUpdate=true;if(unitMesh.instanceColor)unitMesh.instanceColor.needsUpdate=true;unitMesh.computeBoundingSphere();\n robots.forEach((r,i)=>r.rotation.y=Math.sin(elapsed*.65+i)*.55);\n agvs.forEach((a,i)=>{\n  const phase=(elapsed/P.agvCycle+P.agvOffsets[i])%1,u=phase<.5?phase*2:2-phase*2;\n  a.g.position.copy(a.curve.getPointAt(u));const tangent=a.curve.getTangentAt(u);\n  a.g.rotation.y=Math.atan2(-tangent.z,tangent.x)+(phase<.5?0:Math.PI);\n });\n if(tween){\n  const f=Math.min(1,(now-tween.start)/600),s=f*f*(3-2*f);\n  camera.position.lerpVectors(tween.from,tween.to,s);controls.target.lerpVectors(tween.oldTarget,tween.target,s);\n  if(f===1)tween=null;\n }\n controls.update();renderer.render(scene,camera);\n}\nrequestAnimationFrame(animate);\n}catch(error){showError(error.message);}\n</script>\n</body>\n</html>", "metrics": [{"label": "节拍时间", "value": "30.60", "unit": "s/台", "note": "以页面实时计算为准"}, {"label": "线平衡率", "value": "83.19", "unit": "%", "note": "以页面实时计算为准"}, {"label": "瓶颈工位", "value": "② 主板与散热装配", "unit": "", "note": "以页面实时计算为准"}, {"label": "在制品数量", "value": "13", "unit": "台", "note": "以页面实时计算为准"}, {"label": "操作员人数", "value": "18.0", "unit": "人", "note": "以页面实时计算为准"}, {"label": "OEE 估算", "value": "85.0", "unit": "%", "note": "以页面实时计算为准"}], "suggestions": ["优化主板装配瓶颈，对比三模式达产能力", "将老化实际占用纳入在制品与缓存估算", "增加工位阻塞、故障与AGV避障仿真"], "raw": "<<<SUMMARY>>>\n已构建含线边仓、配送小车、传送带及装配、测试、老化、包装工位的交互产线，支持班制与自动化升级切换、编号聚焦和阶段轮播。线体按实际尺度布置，设备与工件采用示意比例。这是系统级示意与节拍估算，非离散事件仿真；稼动率、并行能力和巡检折算人数为可修改假设，在制品按指定等效时间公式估算，另提示老化实际占用差异。\n<<<HTML>>>\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>总装产线数字孪生</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;top:10px;left:10px;max-width:300px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;padding:10px;font-size:12px;line-height:1.65}\nh3{margin:0;font-size:14px}.row{margin:3px 0}button{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover{border-color:#b11f4b}button.active{color:#b11f4b;border-color:#b11f4b}\n#hint{color:#666;font-size:11px}#error{position:absolute;top:45%;left:15%;right:15%;color:#b00020;background:white;text-align:center;z-index:20}\n#detail{position:absolute;right:10px;bottom:12px;max-width:350px;padding:10px;background:#ffffffe6;border:1px solid #dedede;border-radius:8px;font-size:12px;line-height:1.7}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h3>笔记本总装产线 · U 形</h3>\n<div class=\"row\" id=\"modes\"><button>① 单班</button> <button>② 双班</button> <button>③ 升级</button></div>\n<div id=\"production\"></div>\n<div id=\"numbers\"></div>\n<div id=\"balance\"></div>\n<div id=\"people\"></div>\n<div id=\"bottleneck\" style=\"color:#b11f4b\"></div>\n<div id=\"stage\"></div>\n<div id=\"stageText\"></div>\n<div>蓝：工件　橙：AGV　灰：设备　紫红：瓶颈</div>\n<div class=\"row\"><button id=\"cut\">剖切视图</button> <button id=\"rotate\">自动旋转</button> <button id=\"pause\">暂停</button> <button id=\"reset\">全线</button></div>\n<div id=\"hint\">工件放大 3× 示意 · 正在加载合盖工件</div>\n</div>\n<div id=\"detail\">点击工位编号查看类别、标准作业时间与用途。</div>\n<div id=\"error\" hidden></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nimport { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nimport { mergeGeometries } from 'three/addons/utils/BufferGeometryUtils.js';\nconst P = {\n  // 尺寸 mm，时间 s；U 形中心线累计长 60000\n  leg:26000,span:8000,beltWidth:1100,beltHeight:900,beltThick:220,\n  table:[1900,850,1700],stationOffset:2050,warehouse:[7200,2400,2200],\n  warehousePos:[0,1200,7200],agv:[1200,450,850],unit:[301,14.5,220],unitScale:3,\n  rack:[2300,2500,1800],rackLevels:5,markerSize:850,workpieceCap:40,\n  shiftHours:8,secondsPerHour:3600,agingSeconds:7200,animationRate:30,travelSeconds:120,\n  // 人工人数；机器人及 AOI 按共享巡检折算；升级辅助站各计 0.5 人\n  times:[22,34,26,28,30,32,26,24,180,7200,28,30,24,12],\n  staff:[1,2,.5,1,2,2,.5,.5,2,2,2,1,.5,1],\n  names:['底壳上线','主板与散热装配','自动锁螺钉','电池与扬声器','屏幕与转轴','键盘与合盖','自动锁螺钉','外观 AOI','测试','老化','软件与终检','贴标与包装','装箱码垛','成品下线'],\n  categories:['人工工位','人工工位','机器人','人工工位','人工工位','人工工位','机器人','AOI','测试机台','老化架','人工工位','人工工位','机器人','人工工位'],\n  marks:['①','②','③','④','⑤','⑥','⑦','⑧','⑨','⑩','⑪','⑫','⑬','⑭'],\n  modes:[\n    {name:'单班 800 台',shifts:1,target:800,oee:.85,test:6,rack:240,upgrade:false,aoi:'全检（假设）'},\n    {name:'双班 1800 台',shifts:2,target:1800,oee:.85,test:9,rack:300,upgrade:false,aoi:'全检（假设）'},\n    {name:'自动化升级',shifts:2,target:1800,oee:.88,test:9,rack:300,upgrade:true,aoi:'全检'}\n  ],\n  upgrades:{3:22,5:24,11:20},upgradeStaff:.5,\n  colors:{al:'#d4d9e0',plastic:'#2b2b2b',units:'#0ea5e9',agv:'#f59e0b',hot:'#b11f4b'},\n  stageSeconds:5,agvCycle:24,agvOffsets:[0,.33,.66]\n};\nconst $=id=>document.getElementById(id);\nfunction showError(message){$('error').hidden=false;$('error').textContent='场景错误：'+message;}\nwindow.addEventListener('error',e=>showError(e.message));\ntry {\nconst scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\nconst renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.localClippingEnabled=true;\ndocument.body.prepend(renderer.domElement);\nconst pmrem=new THREE.PMREMGenerator(renderer);\nscene.environment=pmrem.fromScene(new RoomEnvironment(),.04).texture;\nscene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\nconst light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(5000,16000,8000);scene.add(light);\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\n// 保持相机规定参数，拟合全线时按实际尺度扩展远裁面\nconst controls=new OrbitControls(camera,renderer.domElement);\ncontrols.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1;\nconst model=new THREE.Group();scene.add(model);\nconst parts={},sprites=[],robots=[],shells=[],agvs=[],testSlots=[],rackSlots=[];\nlet modeIndex=0,result,stageIndex=0,stageClock=0,paused=false,focusId=null,tween=null,elapsed=0,cut=false;\nfunction material(color,metal=.2,opacity=1){\n return new THREE.MeshStandardMaterial({color,metalness:metal,roughness:.6,transparent:opacity<1,opacity});\n}\nfunction box(parent,size,pos,color,opacity=1){\n const mesh=new THREE.Mesh(new THREE.BoxGeometry(...size),material(color,.2,opacity));\n mesh.position.set(...pos);parent.add(mesh);return mesh;\n}\nfunction group(id,pos){const g=new THREE.Group();g.name=id;g.position.set(...pos);model.add(g);parts[id]=g;return g;}\nfunction marker(g,n,y){\n const c=document.createElement('canvas');c.width=c.height=128;const ctx=c.getContext('2d');\n ctx.fillStyle='white';ctx.beginPath();ctx.arc(64,64,57,0,Math.PI*2);ctx.fill();\n ctx.strokeStyle=P.colors.hot;ctx.lineWidth=1;ctx.stroke();ctx.fillStyle='#30333a';\n ctx.font='bold 54px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(n,64,65);\n const s=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),depthTest:false}));\n s.scale.setScalar(P.markerSize);s.position.set(0,y,0);s.userData.id=g.name;g.add(s);sprites.push(s);\n}\nconst pathPoints=[[-P.leg/2,0,-P.span/2],[P.leg/2,0,-P.span/2],[P.leg/2,0,P.span/2],[-P.leg/2,0,P.span/2]];\nconst pathLength=2*P.leg+P.span;\nfunction pathAt(d){\n d=THREE.MathUtils.clamp(d,0,pathLength);\n if(d<P.leg)return {p:new THREE.Vector3(-P.leg/2+d,P.beltHeight,-P.span/2),angle:0};\n if(d<P.leg+P.span)return {p:new THREE.Vector3(P.leg/2,P.beltHeight,-P.span/2+d-P.leg),angle:-Math.PI/2};\n return {p:new THREE.Vector3(P.leg/2-(d-P.leg-P.span),P.beltHeight,P.span/2),angle:Math.PI};\n}\nconst conveyor=group('conveyor',[0,0,0]);\nbox(conveyor,[P.leg,P.beltThick,P.beltWidth],[0,P.beltHeight-P.beltThick/2,-P.span/2],'#445467');\nbox(conveyor,[P.leg,P.beltThick,P.beltWidth],[0,P.beltHeight-P.beltThick/2,P.span/2],'#445467');\nbox(conveyor,[P.beltWidth,P.beltThick,P.span-P.beltWidth],[P.leg/2,P.beltHeight-P.beltThick/2,0],'#445467');\nfor(const z of [-P.span/2,P.span/2])for(let x=-12000;x<=12000;x+=4000)box(conveyor,[180,680,700],[x,340,z],P.colors.al);\nconst stations=[],hotspots=[];\nfunction robot(g,x=0){\n const base=new THREE.Group();base.position.set(x,P.table[1],0);g.add(base);\n box(base,[460,220,460],[0,110,0],P.colors.plastic);\n const pivot=new THREE.Group();pivot.position.y=220;base.add(pivot);\n box(pivot,[230,850,230],[0,420,0],'#d4d9e0');\n box(pivot,[850,210,230],[350,830,0],'#d4d9e0');\n box(pivot,[130,260,150],[730,660,0],P.colors.hot);robots.push(pivot);return base;\n}\nfunction person(g){\n const human=new THREE.Group();human.position.set(0,0,1050);g.add(human);\n const body=new THREE.Mesh(new THREE.CapsuleGeometry(170,650,4,8),material('#1f4e79'));\n body.position.y=1000;human.add(body);\n const head=new THREE.Mesh(new THREE.SphereGeometry(160,10,8),material('#c8b39d'));head.position.y=1590;human.add(head);\n for(const x of [-120,120])box(human,[130,650,150],[x,330,0],P.colors.plastic);\n return human;\n}\nfor(let i=0;i<14;i++){\n const distance=1100+i*(pathLength-2200)/13,point=pathAt(distance);\n const outward=distance<P.leg?[0,0,-P.stationOffset]:distance<P.leg+P.span?[P.stationOffset,0,0]:[0,0,P.stationOffset];\n const id='st'+String(i+1).padStart(2,'0'),g=group(id,[point.p.x+outward[0],0,point.p.z+outward[2]]);\n if(distance<P.leg)g.rotation.y=Math.PI;else if(distance<P.leg+P.span)g.rotation.y=Math.PI/2;\n box(g,P.table,[0,P.table[1]/2,0],P.colors.al);\n const top=box(g,[1800,50,1600],[0,875,0],P.colors.plastic);shells.push(top);\n const entry={g,distance,human:null,assist:null};\n const category=P.categories[i];\n if(category==='机器人')robot(g);\n else if(category==='人工工位'){entry.human=person(g);if([3,5,11].includes(i)){entry.assist=robot(g);entry.assist.visible=false;}}\n else if(category==='测试机台'){\n  for(let j=0;j<9;j++){const m=box(g,[480,400,360],[(j%3-1)*560,1100,Math.floor(j/3)*470-470],'#1f4e79');testSlots.push(m);}\n }else if(category==='老化架'){\n  box(g,[P.rack[0],120,P.rack[2]],[0,940,0],P.colors.al);\n  for(let k=0;k<P.rackLevels;k++){\n   box(g,[P.rack[0],65,P.rack[2]],[0,1050+k*350,0],P.colors.al);\n   for(let j=0;j<6;j++)rackSlots.push(box(g,[270,120,600],[(j-2.5)*350,1150+k*350,0],'#1f4e79'));\n  }\n  for(const x of [-1100,1100])box(g,[80,1800,1700],[x,1800,0],P.colors.al);\n }else{\n  box(g,[1600,1200,180],[0,1450,-600],P.colors.al);\n  box(g,[450,220,450],[0,1900,0],'#1f4e79');\n }\n marker(g,i+1,i===9?3450:2600);\n stations.push(entry);\n hotspots.push({id,n:i+1,label:P.marks[i]+' '+P.names[i],part:category,note:i===9?'架式老化，台位按模式调整。':'按顺序完成'+P.names[i]+'。'});\n}\nconst warehouse=group('warehouse',P.warehousePos);\nbox(warehouse,P.warehouse,[0,0,0],'#9aa3ab',.22);\nfor(let i=0;i<8;i++)box(warehouse,[650,550,850],[(i-3.5)*820,-700,0],'#b8aa8c');\nmarker(warehouse,15,2100);\nhotspots.push({id:'warehouse',n:15,label:'线边仓',part:'人工工位',note:'配套线边仓，供 AGV 取料与补料。'});\nfor(let i=0;i<3;i++){\n const g=group('agv_'+(i+1),[0,0,0]);\n box(g,P.agv,[0,P.agv[1]/2,0],P.colors.agv);box(g,[850,350,650],[0,625,0],'#b8aa8c');\n for(const x of [-460,460])for(const z of [-350,350])box(g,[240,200,100],[x,130,z],P.colors.plastic);\n marker(g,16+i,1500);\n const dest=stations[[0,5,13][i]].g.position;\n const points=[new THREE.Vector3(-2400+i*2400,0,7200),new THREE.Vector3(-16500-i*700,0,7200),new THREE.Vector3(-16500-i*700,0,dest.z),new THREE.Vector3(dest.x,0,dest.z+1800)];\n const curve=new THREE.CatmullRomCurve3(points);\n const line=new THREE.Line(new THREE.BufferGeometry().setFromPoints(curve.getPoints(70)),new THREE.LineBasicMaterial({color:P.colors.agv,transparent:true,opacity:.4}));\n model.add(line);agvs.push({g,curve,line});\n hotspots.push({id:g.name,n:16+i,label:'配送 AGV '+(i+1),part:'AGV',note:'沿独立示意路径往返配送，不含避障调度。'});\n}\nconst grid=new THREE.GridHelper(50000,50,'#d7d3ce','#e5e1db');grid.position.y=-10;scene.add(grid);\nlet unitMesh=new THREE.InstancedMesh(new THREE.BoxGeometry(...P.unit),material(P.colors.units,0,.65),P.workpieceCap);\nunitMesh.name='flow_units';model.add(unitMesh);\nconst dummy=new THREE.Object3D(),zero=new THREE.Matrix4().makeScale(0,0,0);\nfor(let i=0;i<P.workpieceCap;i++)unitMesh.setMatrixAt(i,zero);\nunitMesh.instanceMatrix.needsUpdate=true;unitMesh.computeBoundingSphere();\nfunction compute(mode){\n const effective=P.times.map((time,i)=>(mode.upgrade&&P.upgrades[i]!==undefined?P.upgrades[i]:time)/(i===8?mode.test:i===9?mode.rack:1));\n const available=P.shiftHours*P.secondsPerHour*mode.shifts,takt=available*mode.oee/mode.target;\n const max=Math.max(...effective),sum=effective.reduce((a,b)=>a+b,0),b=effective.indexOf(max);\n const staff=P.staff.reduce((a,n,i)=>a+(mode.upgrade&&P.upgrades[i]!==undefined?P.upgradeStaff:n),0);\n const wip=Math.ceil(sum/takt),balance=sum/(14*max)*100;\n const capacity=available*mode.oee/max,hourly=mode.target/(P.shiftHours*mode.shifts*staff);\n const agingPhysical=mode.target/available*P.agingSeconds;\n const values=[takt.toFixed(2),balance.toFixed(2),P.marks[b]+' '+P.names[b],String(wip),staff.toFixed(1),(mode.oee*100).toFixed(1)];\n const labels=['节拍时间','线平衡率','瓶颈工位','在制品数量','操作员人数','OEE 估算'],units=['s/台','%','','台','人','%'];\n return {effective,takt,max,sum,b,staff,wip,balance,capacity,hourly,agingPhysical,metrics:labels.map((label,i)=>({label,value:values[i],unit:units[i],note:'以页面实时计算为准'}))};\n}\nconst stages=[\n {title:'上料',text:'D 壳与主板从线边仓由 AGV 配送上线。',ids:['warehouse','agv_1','agv_2','agv_3','st01'],range:[0,4000]},\n {title:'装配',text:'②–⑦完成装配、合盖及自动锁螺钉。',ids:['st02','st03','st04','st05','st06','st07'],range:[4000,30000]},\n {title:'测试老化',text:'AOI 全检后进入并行功能测试与架式老化。',ids:['st08','st09','st10'],range:[30000,44000]},\n {title:'包装出货',text:'终检、贴标包装、协作码垛，成品由 AGV 转运。',ids:['st11','st12','st13','st14','agv_3'],range:[44000,60000]}\n];\nfunction highlight(){\n const active=stages[stageIndex].ids,bid='st'+String(result.b+1).padStart(2,'0');\n Object.entries(parts).forEach(([id,g])=>g.traverse(o=>{\n  if(!o.isMesh)return;\n  const m=o.material;if(m.userData.originalOpacity===undefined)m.userData.originalOpacity=m.opacity;\n  const selected=focusId?id===focusId:active.in