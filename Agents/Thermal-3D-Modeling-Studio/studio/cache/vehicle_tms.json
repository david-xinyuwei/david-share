{"ok": true, "summary": "已建立纯电整车热管理交互示意，包含底部电池冷却板、前电驱与油冷器、座舱换热器、前端双换热器及风扇、冷媒部件和集成阀泵模块。支持夏季制冷、冬季余热热泵、快充强冷和电池加热，联动串并联流路、粒子方向及部件热点。采用通用车壳参考而非车型复刻，部件几何为示意比例；工程量采用集总参数估算，物性、阻力及热泵温度均为可修改假设。", "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>整车热管理系统</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;top:10px;left:10px;max-width:300px;padding:10px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;z-index:2}\n.row{margin:5px 0;line-height:1.45}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover,button.active{border-color:#b11f4b}\n#actions{display:flex;flex-wrap:wrap;gap:3px}\n#err{position:absolute;top:45%;left:15%;right:15%;color:#c00;text-align:center;background:#fff;z-index:5}\nsmall{color:#626262}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<div class=\"row\"><b>纯电 SUV · 整车热管理示意</b></div>\n<div class=\"row\" id=\"spec\"></div>\n<div class=\"row\" id=\"loads\"></div>\n<div class=\"row\" id=\"flows\"></div>\n<div class=\"row\" id=\"temps\"></div>\n<div class=\"row\" id=\"power\"></div>\n<div class=\"row\" id=\"state\"></div>\n<div class=\"row\">● <span style=\"color:#0f766e\">电池液</span> / <span style=\"color:#22c55e\">电驱液</span> / <span style=\"color:#2563eb\">冷媒</span> / <span style=\"color:#dc2626\">热端</span></div>\n<div class=\"row\"><span style=\"color:#9aa3ab\">■ 金属</span> · 黑色塑料 · 蓝色腔体；点击编号聚焦</div>\n<div class=\"row\" id=\"stage\"></div>\n<div class=\"row\" id=\"actions\"><button data-mode=\"0\">①夏季</button><button data-mode=\"1\">②冬季热泵</button><button data-mode=\"2\">③快充</button><button data-mode=\"3\">④电池加热</button><button id=\"cut\">剖切视图</button><button id=\"explode\">爆炸视图</button><button id=\"rotate\">自动旋转</button><button id=\"pause\">暂停</button><button id=\"home\">全局</button></div>\n<div class=\"row\"><small id=\"hint\">车壳异步加载；红色表示热端，非温度场仿真。</small></div>\n</div>\n<div id=\"err\" hidden></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nconst P = {\n // 尺寸 mm，负荷 kW，流量 L/min；系统级假设\n voltage:800,capacity:100,charge:250,rho:1069,cp:3280,eta:.92,\n flowB:12,flowE:15,dpB:45,dpE:60,copFactor:.45,evapCool:5,condCool:55,\n evapWinter:-15,evapRecovery:5,condHeat:50,approach:5,particleCount:40,\n particleRadius:13,speed:.045,stageSeconds:5,explodeDistance:180,\n body:[4600,1450,1850],batterySize:[2100,170,1320],itmSize:[400,220,460],\n motorRadius:145,motorLength:390,frontSize:[65,620,1250],hvacSize:[350,260,600],\n pumpRadius:60,pumpLength:100,valveRadius:85,valveHeight:100,portRadius:17,\n compRadius:90,compLength:240,exvRadius:30,exvLength:90,\n positions:{battery:[-150,235,0],edrive:[1300,420,0],itm:[780,400,-260],\n pump1:[650,445,-390],pump2:[870,445,-390],valve9:[770,490,-160],\n chiller:[800,430,250],condenser:[2100,700,0],ltr:[1980,700,0],\n compressor:[1550,550,-380],exv1:[1140,650,380],exv2:[1100,390,330],\n hvac:[950,800,0],ptc:[700,740,370],fan:[1870,700,0]},\n modes:[\n {name:\"夏季制冷\",bat:2,mech:40,cabin:4,series:false,heat:false,ref:true,ptc:0,rpm:[2600,3000],valve:\"并联 B→chiller / E→散热器\"},\n {name:\"冬季余热热泵\",bat:.5,mech:25,cabin:5,batteryHeat:1,series:true,heat:true,ref:true,ptc:0,rpm:[1800,2400],valve:\"串联 E→B→chiller，旁通散热器\"},\n {name:\"快充强冷\",bat:12,mech:0,cabin:0,series:false,heat:false,ref:true,ptc:0,rpm:[3200,1200],valve:\"并联 B→chiller，座舱膨胀阀关闭\"},\n {name:\"冬季电池加热\",bat:0,mech:25,cabin:0,batteryHeat:3,series:true,heat:true,ref:false,ptc:1,rpm:[1600,2200],valve:\"串联 E→PTC→B，冷媒停机\"}\n ],\n loops:[\n {id:\"battery_loop\",label:\"电池冷却液\",color:\"#0f766e\",radius:9,flow_lpm:12,closed:true,\n points:[[650,445,-390],[450,290,-570],[-1050,290,-570],[-1050,290,570],[450,290,570],[800,430,250],[770,490,-160]]},\n {id:\"edrive_loop\",label:\"电驱冷却液\",color:\"#22c55e\",radius:10,flow_lpm:15,closed:true,\n points:[[870,445,-390],[1300,420,-240],[1470,540,300],[1900,450,550],[1980,900,550],[1980,900,-550],[1900,440,-550],[770,490,-160]]},\n {id:\"refrigerant\",label:\"冷媒主干\",color:\"#2563eb\",radius:6,flow_lpm:6,closed:true,\n points:[[1550,550,-380],[2100,480,-520],[2100,950,-520],[2100,950,520],[1140,650,380],[950,800,230],[950,850,-230],[1550,700,-380]]}\n ],\n // 冷媒支路为拓扑示意，不用容积流量推算两相质量流率\n refBranch:[[1140,650,380],[1100,390,330],[800,430,250],[1050,500,-500],[1550,550,-380]],\n seriesPoints:[[870,445,-390],[1300,420,-240],[1450,530,270],[770,490,-160],\n [700,740,370],[450,290,570],[-1050,290,570],[-1050,290,-570],\n [450,290,-570],[650,445,-390],[800,430,250]],\n stages:[\n {title:\"热量采集\",text:\"电池、电驱与座舱按工况产生热量或接收热量。\",ids:[\"battery\",\"edrive\",\"hvac\"],loops:[\"battery_loop\",\"edrive_loop\"]},\n {title:\"流路调节\",text:\"九通阀重排串并联，两台水泵驱动冷却液。\",ids:[\"itm\",\"valve9\",\"pump1\",\"pump2\",\"exv1\",\"exv2\"],loops:[\"battery_loop\",\"edrive_loop\"]},\n {title:\"热量交换\",text:\"板换与前端、座舱换热器交换热量，按需补热。\",ids:[\"chiller\",\"condenser\",\"ltr\",\"hvac\",\"ptc\",\"compressor\",\"fan\"],loops:[\"refrigerant\"]},\n {title:\"循环运行\",text:\"介质持续循环，阀泵与压缩机维持目标工况。\",ids:[],loops:[\"battery_loop\",\"edrive_loop\",\"refrigerant\"]}\n ]\n};\nfunction showError(message){const el=document.getElementById('err');el.hidden=false;el.textContent='模型错误：'+message}\nwindow.addEventListener('error',e=>showError(e.message));\ntry{\nconst scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\nconst renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.localClippingEnabled=true;\ndocument.body.appendChild(renderer.domElement);\nscene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\nconst light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(1500,3500,2200);scene.add(light);\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\nconst controls=new OrbitControls(camera,renderer.domElement);controls.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1;\ncontrols.addEventListener('start',()=>{controls.autoRotate=false;transition=null});\nconst modelGroup=new THREE.Group(),partsGroup=new THREE.Group(),pipesGroup=new THREE.Group(),car=new THREE.Group();\ncar.name=\"car\";modelGroup.add(partsGroup,pipesGroup,car);scene.add(modelGroup);\nconst grid=new THREE.GridHelper(6000,30,0xd8d5d0,0xe9e5df);grid.position.y=-5;scene.add(grid);\nconst parts={},sprites=[],shells=[],flowObjects=[];let modeIndex=0,stageIndex=0,paused=false,stageTime=0,focusId=null,transition=null,cut=false,exploded=false;\nfunction mat(color,plastic=false){return new THREE.MeshStandardMaterial({color,metalness:plastic?0:.2,roughness:.6})}\nfunction mesh(g,geometry,color,pos=[0,0,0],plastic=false){\n const o=new THREE.Mesh(geometry,mat(color,plastic));o.position.set(...pos);g.add(o);return o;\n}\nfunction box(g,size,color,pos=[0,0,0]){return mesh(g,new THREE.BoxGeometry(...size),color,pos)}\nfunction cyl(g,r,h,color,pos=[0,0,0]){return mesh(g,new THREE.CylinderGeometry(r,r,h,24),color,pos)}\nfunction part(id,label,category,note){\n const g=new THREE.Group();g.name=id;g.position.set(...P.positions[id]);partsGroup.add(g);parts[id]=g;\n g.userData={label,category,note,home:g.position.clone()};return g;\n}\nlet g=part(\"battery\",\"电池包与底部冷却板\",\"电池冷却板\",\"采集电池热量，冬季接收加热功率。\");\nshells.push(box(g,P.batterySize,\"#9aa3ab\"));box(g,[2050,18,1270],\"#3b82f6\",[0,-96,0]);\nfor(let i=0;i<12;i++)box(g,[150,105,1190],\"#1f4e79\",[-910+i*165,0,0]);\ng=part(\"edrive\",\"前电驱与油冷器\",\"油冷器\",\"电机与逆变器热量经油冷器转入冷却液。\");\nconst motor=cyl(g,P.motorRadius,P.motorLength,\"#9aa3ab\");motor.rotation.x=Math.PI/2;\nbox(g,[300,100,310],\"#d4d9e0\",[0,180,0]);box(g,[220,70,230],\"#c9a227\",[0,-155,0]);\ng=part(\"itm\",\"热管理集成模块\",\"热管理集成模块\",\"集成九通阀、双泵与连接歧管。\");\nconst itmShell=box(g,P.itmSize,\"#2b2b2b\");itmShell.material.transparent=true;itmShell.material.opacity=.35;shells.push(itmShell);\nfor(let i=0;i<3;i++)box(g,[330,18,22],\"#3b82f6\",[0,-60+i*45,0]);\nfor(const id of [\"pump1\",\"pump2\"]){\n g=part(id,id===\"pump1\"?\"电池侧电子水泵\":\"电驱侧电子水泵\",\"电子水泵\",\"按工况调速，串联工况两泵共同承担阻力。\");\n cyl(g,P.pumpRadius,P.pumpLength,\"#1f4e79\");box(g,[90,55,80],\"#2b2b2b\",[0,65,0]);\n}\ng=part(\"valve9\",\"九通电子水阀\",\"电子水阀（多通）\",\"切换串并联及散热器、板换旁通流路。\");\ncyl(g,P.valveRadius,P.valveHeight,\"#2b2b2b\");\nfor(let i=0;i<9;i++){const a=i*Math.PI*2/9;const port=cyl(g,P.portRadius,65,\"#9aa3ab\",[Math.cos(a)*100,0,Math.sin(a)*100]);port.rotation.z=Math.PI/2;port.rotation.y=-a}\ng=part(\"chiller\",\"冷媒冷却液板换\",\"板式换热器\",\"制冷时冷却电池，热泵时回收冷却液余热。\");\nfor(let i=0;i<14;i++)box(g,[230,6,190],i%2?\"#d4d9e0\":\"#9aa3ab\",[0,i*8-52,0]);\nfor(const id of [\"condenser\",\"ltr\"]){\n g=part(id,id===\"condenser\"?\"前端微通道换热器\":\"低温散热器\",id===\"condenser\"?\"微通道换热器\":\"配套部件\",id===\"condenser\"?\"制冷冷凝放热，热泵工况切换为蒸发吸热。\":\"电驱冷却液向环境排热，冬季旁通。\");\n for(let i=0;i<28;i++)box(g,[P.frontSize[0],12,P.frontSize[2]],\"#d4d9e0\",[0,-290+i*22,0]);\n box(g,[75,620,45],\"#9aa3ab\",[0,0,-640]);box(g,[75,620,45],\"#9aa3ab\",[0,0,640]);\n}\ng=part(\"fan\",\"前端双风扇\",\"配套部件\",\"驱动空气穿过前端换热器。\");\nfor(const z of [-340,340]){\n const ring=mesh(g,new THREE.TorusGeometry(245,16,8,36),\"#2b2b2b\",[0,0,z],true);ring.rotation.y=Math.PI/2;\n for(let j=0;j<5;j++){const blade=box(g,[22,380,60],\"#2b2b2b\",[0,0,z]);blade.rotation.x=j*Math.PI/5}\n}\ng=part(\"compressor\",\"电动压缩机\",\"配套部件\",\"建立冷媒压差；冬季电池补热工况停机。\");\nconst comp=cyl(g,P.compRadius,P.compLength,\"#9aa3ab\");comp.rotation.z=Math.PI/2;\nfor(const id of [\"exv1\",\"exv2\"]){\n g=part(id,id===\"exv1\"?\"座舱电子膨胀阀\":\"板换电子膨胀阀\",\"电子膨胀阀\",\"调节对应支路冷媒供给；热泵节流位置示意。\");\n cyl(g,P.exvRadius,P.exvLength,\"#c9a227\");cyl(g,36,40,\"#1f4e79\",[0,65,0]);\n}\ng=part(\"hvac\",\"座舱蒸发器与暖风芯体\",\"配套部件\",\"制冷吸收座舱热量，热泵内冷凝器向座舱放热。\");\nconst hvacShell=box(g,P.hvacSize,\"#2b2b2b\");shells.push(hvacShell);\nbox(g,[310,220,60],\"#3b82f6\",[0,0,-170]);box(g,[310,220,60],\"#b87333\",[0,0,170]);\ng=part(\"ptc\",\"冷却液 PTC 加热器\",\"配套部件\",\"电驱余热不足时补足电池加热需求。\");\nbox(g,[210,100,150],\"#9aa3ab\");box(g,[150,25,100],\"#1f4e79\",[0,65,0]);\npartsGroup.updateMatrixWorld(true);\nfunction numberSprite(n){\n const c=document.createElement('canvas');c.width=c.height=64;const ctx=c.getContext('2d');\n ctx.beginPath();ctx.arc(32,32,27,0,Math.PI*2);ctx.fillStyle=\"white\";ctx.fill();ctx.lineWidth=1;ctx.strokeStyle=\"#b11f4b\";ctx.stroke();\n ctx.fillStyle=\"#303038\";ctx.font=\"bold 26px sans-serif\";ctx.textAlign=\"center\";ctx.textBaseline=\"middle\";ctx.fillText(n,32,33);\n return new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),depthTest:false}));\n}\nwindow.__hotspots=Object.entries(parts).map(([id,p],i)=>{\n const b=new THREE.Box3().setFromObject(p,true);const s=numberSprite(i+1);s.position.set(0,b.max.y-p.position.y+85,0);s.scale.set(92,92,1);s.userData.id=id;p.add(s);sprites.push(s);\n p.traverse(o=>{if(o.isMesh)o.userData.baseOpacity=o.material.opacity});\n return {id,n:i+1,label:p.userData.label,part:p.userData.category,note:p.userData.note};\n});\nfunction makeFlow(def,points,tag=def.id){\n const curve=new THREE.CatmullRomCurve3(points.map(p=>new THREE.Vector3(...p)),def.closed,\"centripetal\");\n const geo=new THREE.TubeGeometry(curve,180,def.radius,8,def.closed),colors=[];\n const base=new THREE.Color(def.color),hot=new THREE.Color(\"#dc2626\");\n for(let i=0;i<geo.attributes.position.count;i++){const t=Math.floor(i/9)/180;const col=base.clone().lerp(hot,t>.18&&t<.45?.7:0);colors.push(col.r,col.g,col.b)}\n geo.setAttribute(\"color\",new THREE.Float32BufferAttribute(colors,3));\n const tube=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({vertexColors:true,metalness:.2,roughness:.6,transparent:true,opacity:.65}));pipesGroup.add(tube);\n const dots=new THREE.InstancedMesh(new THREE.SphereGeometry(P.particleRadius,8,6),mat(def.color),P.particleCount);\n const matrix=new THREE.Matrix4();for(let i=0;i<P.particleCount;i++){matrix.makeTranslation(...curve.getPointAt(i/P.particleCount).toArray());dots.setMatrixAt(i,matrix)}\n dots.instanceMatrix.needsUpdate=true;dots.computeBoundingSphere();pipesGroup.add(dots);\n flowObjects.push({id:def.id,tag,curve,tube,dots,flow:def.flow_lpm,t:0,direction:1,enabled:true,base});\n}\nfunction rebuild(){\n for(const f of flowObjects){pipesGroup.remove(f.tube,f.dots);f.tube.geometry.dispose();f.tube.material.dispose();f.dots.geometry.dispose();f.dots.material.dispose()}\n flowObjects.length=0;const m=P.modes[modeIndex];\n if(m.series)makeFlow({...P.loops[0],flow_lpm:P.flowE},P.seriesPoints,\"series\");\n else{makeFlow(P.loops[0],P.loops[0].points);makeFlow(P.loops[1],P.loops[1].points)}\n makeFlow(P.loops[2],P.loops[2].points,\"refMain\");\n makeFlow({...P.loops[2],closed:false},P.refBranch,\"refBranch\");\n for(const f of flowObjects)if(f.id===\"refrigerant\"){\n f.direction=m.heat?-1:1;f.enabled=m.ref&&(f.tag!==\"refMain\"||modeIndex!==2);\n // 快充保留压缩机与前端主干，关闭座舱段\n if(modeIndex===2&&f.tag===\"refMain\"){f.enabled=true;f.curve=new THREE.CatmullRomCurve3([[1550,550,-380],[2100,480,-520],[2100,950,-520],[2100,950,520],[1140,650,380]].map(p=>new THREE.Vector3(...p)),false);f.tube.geometry.dispose();f.tube.geometry=new THREE.TubeGeometry(f.curve,100,6,8,false);f.tube.material.vertexColors=false;f.tube.material.color.set(\"#2563eb\")}\n f.tube.visible=f.dots.visible=f.enabled;\n }\n}\nfunction compute(m){\n const qe=m.mech*(1-P.eta),fb=m.series?P.flowE:P.flowB,fe=P.flowE;\n const thermalB=m.batteryHeat?-m.batteryHeat:m.bat;\n const dtB=thermalB/(P.rho*(fb/60000)*P.cp/1000),dtE=qe/(P.rho*(fe/60000)*P.cp/1000);\n const evap=m.heat?P.evapRecovery:P.evapCool,cond=m.heat?P.condHeat:P.condCool;\n const copHeat=P.copFactor*(cond+273.15)/(cond-evap),copCool=copHeat-1;\n const qr=m.ref?(m.heat?m.cabin+m.batteryHeat:m.bat+m.cabin):0;\n const compressor=m.ref?qr/(m.heat?copHeat:copCool):0;\n const source=m.heat&&m.ref?qr-compressor:0;\n const recovered=m.heat?Math.min(qe,source+(m.ref?0:m.batteryHeat)):0;\n const ambient=m.heat&&m.ref?Math.max(0,source-qe-m.bat):0;\n const hydraulic=P.dpB*1000*(fb/60000)+P.dpE*1000*(fe/60000);\n const metrics=[\n {label:\"电池回路热负荷\",value:m.bat.toFixed(2),unit:\"kW\",note:\"以页面实时计算为准\"},\n {label:\"电驱回路热负荷\",value:qe.toFixed(2),unit:\"kW\",note:\"以页面实时计算为准\"},\n {label:\"冷媒回路制冷/制热量\",value:qr.toFixed(2),unit:\"kW\",note:\"以页面实时计算为准\"},\n {label:\"冷却液总流量\",value:(m.series?fb:fb+fe).toFixed(2),unit:\"L/min\",note:\"以页面实时计算为准\"},\n {label:\"电池回路进出口温差\",value:dtB.toFixed(2),unit:\"K\",note:\"以页面实时计算为准\"},\n {label:\"热泵 COP 估算\",value:(m.ref?copHeat:0).toFixed(2),unit:\"\",note:\"以页面实时计算为准\"}\n ];\n window.__metrics=metrics;\n document.getElementById(\"spec\").textContent=`${P.voltage} V / ${P.capacity} kWh · ${m.name} · 快充 ${P.charge} kW`;\n document.getElementById(\"loads\").textContent=`发热 B/E：${m.bat.toFixed(1)}/${qe.toFixed(1)} kW；冷媒${m.heat?\"制热\":\"制冷\"} ${qr.toFixed(1)} kW`;\n document.getElementById(\"flows\").textContent=`流量 B/E：${fb}/${fe} L/min；${m.series?\"串联单流路\":\"并联合计\"} ${metrics[3].value} L/min`;\n document.getElementById(\"temps\").textContent=`液体 ΔT B/E：${dtB.toFixed(2)}/${dtE.toFixed(2)} K；板换端差假设 ${P.approach} K`;\n document.getElementById(\"power\").textContent=`泵水力 ${hydraulic.toFixed(1)} W；PTC ${m.ptc} kW；${m.ref?`COP热 ${copHeat.toFixed(2)}${m.heat?\"（基线 \"+(P.copFactor*(P.condHeat+273.15)/(P.condHeat-P.evapWinter)).toFixed(2)+\"）\":\" / 冷 \"+copCool.toFixed(2)}`:\"压缩机停机，COP不适用（记0）\"}`;\n document.getElementById(\"state\").textContent=`${m.valve}；泵 ${m.rpm.join(\"/\")} rpm（设定）。${m.heat?`电池需热 ${m.batteryHeat} kW，电驱回收 ${recovered.toFixed(2)} kW${m.ref?`；蒸发温度提升至 ${evap}℃，环境补热 ${ambient.toFixed(2)} kW`:\"\"}`:\"冷媒流量为动画示意，未计算两相物性。\"}`;\n return metrics;\n}\nfunction styleScene(){\n const stage=P.stages[stageIndex],m=P.modes[modeIndex];\n for(const [id,p] of Object.entries(parts)){\n const selected=focusId&&(id===focusId||(focusId===\"itm\"&&[\"pump1\",\"pump2\",\"valve9\"].includes(id)));\n const activeStage=!stage.ids.length||stage.ids.includes(id);\n const activeMode=[\"pump1\",\"pump2\",\"valve9\"].includes(id)||(id===\"ptc\"&&m.ptc>0)||(id===\"compressor\"&&m.ref);\n p.traverse(o=>{if(!o.isMesh)return;const mt=o.material;mt.transparent=true;mt.opacity=(o.userData.baseOpacity??1)*(focusId?(selected?1:.25):(activeStage?1:.4));mt.emissive.set(selected||activeMode?\"#b11f4b\":\"#000000\");mt.emissiveIntensity=selected?.25:activeMode?.16:0});\n }\n for(const f of flowObjects){const active=stage.loops.includes(f.id)||f.tag===\"series\"&&stage.loops.includes(\"edrive_loop\");f.tube.material.opacity=focusId?.25:active?.75:.15;f.dots.material.opacity=active?1:.25;f.dots.material.transparent=true;f.dots.material.color.set(P.modes[modeIndex].heat&&f.id===\"refrigerant\"?\"#dc2626\":f.base)}\n}\nwindow.__stages=P.stages.map(({title,text})=>({title,text}));\nwindow.__setStage=i=>{\n stageIndex=((Number(i)||0)%P.stages.length+P.stages.length)%P.stages.length;stageTime=0;\n const s=P.stages[stageIndex];document.getElementById(\"stage\").textContent=`阶段 ${stageIndex+1}/${P.stages.length} · ${s.title}：${s.text}`;\n styleScene();if(typeof window.__notifyStage===\"function\")window.__notifyStage(stageIndex);\n};\nrebuild();compute(P.modes[0]);window.__setStage(0);\nconst bounds=new THREE.Box3().setFromObject(partsGroup,true),center=bounds.getCenter(new THREE.Vector3()),size=bounds.getSize(new THREE.Vector3());\nconst direction=new THREE.Vector3(1,.7,1.2).normalize();\nfunction globalPosition(){const half=Math.atan(Math.tan(THREE.MathUtils.degToRad(20))*Math.min(1,camera.aspect));return center.clone().addScaledVector(direction,size.length()/2/Math.sin(half)/.7)}\nlet homePosition=globalPosition();camera.position.copy(homePosition);controls.target.copy(center);controls.update();\nwindow.__focus=id=>{\n if(id!==null&&!parts[id])return;focusId=id;controls.autoRotate=false;\n let target=center.clone(),end=homePosition.clone();\n if(id){const b=new THREE.Box3().setFromObject(parts[id],true);target=b.getCenter(new THREE.Vector3());end=target.clone().addScaledVector(direction,Math.max(350,b.getSize(new THREE.Vector3()).length()*2.5))}\n transition={time:0,from:camera.position.clone(),to:end,targetFrom:controls.target.clone(),targetTo:target};styleScene();\n};\nconst raycaster=new THREE.Raycaster(),pointer=new THREE.Vector2();let down=null;\nrenderer.domElement.addEventListener(\"pointerdown\",e=>{down=[e.clientX,e.clientY]});\nrenderer.domElement.addEventListener(\"pointerup\",e=>{\n if(!down||Math.hypot(e.clientX-down[0],e.clientY-down[1])>5)return;\n pointer.set(e.clientX/innerWidth*2-1,1-e.clientY/innerHeight*2);raycaster.setFromCamera(pointer,camera);\n const hits=raycaster.intersectObjects(sprites);if(hits.length)window.__focus(hits[0].object.userData.id);\n});\ndocument.querySelectorAll(\"[data-mode]\").forEach(b=>b.onclick=()=>{\n modeIndex=Number(b.dataset.mode);rebuild();compute(P.modes[modeIndex]);styleScene();\n document.querySelectorAll(\"[data-mode]\").forEach(el=>el.classList.toggle(\"active\",el===b));\n});\ndocument.querySelector(\"[data-mode='0']\").classList.add(\"active\");\ndocument.getElementById(\"rotate\").onclick=()=>{controls.autoRotate=!controls.autoRotate};\ndocument.getElementById(\"pause\").onclick=e=>{paused=!paused;e.target.textContent=paused?\"继续\":\"暂停\"};\ndocument.getElementById(\"home\").onclick=()=>window.__focus(null);\ndocument.getElementById(\"cut\").onclick=e=>{cut=!cut;shells.forEach(o=>o.visible=!cut);car.visible=!cut;e.target.textContent=cut?\"完整视图\":\"剖切视图\"};\ndocument.getElementById(\"explode\").onclick=e=>{\n exploded=!exploded;\n for(const [id,p] of Object.entries(parts)){p.position.copy(p.userData.home);if(exploded){const v=p.position.clone().sub(center).normalize();p.position.addScaledVector(v,P.explodeDistance);if([\"pump1\",\"pump2\",\"valve9\"].includes(id))p.position.y+=P.explodeDistance}}\n e.target.textContent=exploded?\"装配视图\":\"爆炸视图\";document.getElementById(\"hint\").textContent=exploded?\"爆炸仅供辨认部件；管路保留装配位置。\":\"系统级拓扑示意；编号可聚焦，拖动可停止旋转。\";\n};\nwindow.__scene=scene;window.__camera=camera;window.__renderer=renderer;window.__controls=controls;window.__model=modelGroup;\nnew GLTFLoader().load('/static/assets/car/sedan.glb',gltf=>{\n gltf.scene.traverse(o=>{if(!o.isMesh)return;let node=o,isBody=false,isWheel=false;while(node){isBody||=node.name.startsWith(\"body\");isWheel||=node.name.startsWith(\"wheel_\");node=node.parent}\n if(isWheel)o.material=mat(\"#252525\",true);\n else if(isBody)o.material=new THREE.MeshStandardMaterial({color:\"#9fb4d8\",metalness:.2,roughness:.6,transparent:true,opacity:.12,depthWrite:false,side:THREE.DoubleSide});\n });car.add(gltf.scene);\n},undefined,()=>{\n const fallback=new THREE.Mesh(new THREE.BoxGeometry(...P.body),new THREE.MeshBasicMaterial({color:\"#9fb4d8\",wireframe:true,transparent:true,opacity:.18,depthWrite:false}));\n fallback.position.y=P.body[1]/2;car.add(fallback);document.getElementById(\"hint\").textContent=\"车壳加载失败，已用线框包络替代；不影响系统交互。\";\n});\nwindow.addEventListener(\"resize\",()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);homePosition=globalPosition()});\nconst clock=new THREE.Clock(),matrix=new THREE.Matrix4();\nfunction animate(){\n requestAnimationFrame(animate);const dt=Math.min(clock.getDelta(),.08);\n if(!paused){stageTime+=dt;if(stageTime>=P.stageSeconds)window.__setStage(stageIndex+1)}\n for(const f of flowObjects){if(!f.enabled)continue;f.t=(f.t+dt*P.speed*f.flow/P.flowB*f.direction+1)%1;\n for(let i=0;i<P.particleCount;i++){const u=(f.t+i/P.particleCount)%1;matrix.makeTranslation(...f.curve.getPointAt(u).toArray());f.dots.setMatrixAt(i,matrix)}\n f.dots.instanceMatrix.needsUpdate=true;f.dots.computeBoundingSphere();\n }\n if(transition){transition.time+=dt;const a=Math.min(1,transition.time/.6),s=a*a*(3-2*a);camera.position.lerpVectors(transition.from,transition.to,s);controls.target.lerpVectors(transition.targetFrom,transition.targetTo,s);if(a===1)transition=null}\n controls.update();renderer.render(scene,camera);\n}\nanimate();\n}catch(error){showError(error.message)}\n</script>\n</body>\n</html>", "metrics": [{"label": "电池回路热负荷", "value": "2.00", "unit": "kW", "note": "以页面实时计算为准"}, {"label": "电驱回路热负荷", "value": "3.20", "unit": "kW", "note": "以页面实时计算为准"}, {"label": "冷媒回路制冷/制热量", "value": "6.00", "unit": "kW", "note": "以页面实时计算为准"}, {"label": "冷却液总流量", "value": "27.00", "unit": "L/min", "note": "以页面实时计算为准"}, {"label": "电池回路进出口温差", "value": "2.85", "unit": "K", "note": "以页面实时计算为准"}, {"label": "热泵 COP 估算", "value": "2.95", "unit": "", "note": "以页面实时计算为准"}], "suggestions": ["增加九通阀端口编号与四工况连接表", "对比不同环境温度下的热泵与补热功率", "按实际泵曲线校核快充流量和电池温升"], "raw": "<<<SUMMARY>>>\n已建立纯电整车热管理交互示意，包含底部电池冷却板、前电驱与油冷器、座舱换热器、前端双换热器及风扇、冷媒部件和集成阀泵模块。支持夏季制冷、冬季余热热泵、快充强冷和电池加热，联动串并联流路、粒子方向及部件热点。采用通用车壳参考而非车型复刻，部件几何为示意比例；工程量采用集总参数估算，物性、阻力及热泵温度均为可修改假设。\n<<<HTML>>>\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>整车热管理系统</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;top:10px;left:10px;max-width:300px;padding:10px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;z-index:2}\n.row{margin:5px 0;line-height:1.45}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover,button.active{border-color:#b11f4b}\n#actions{display:flex;flex-wrap:wrap;gap:3px}\n#err{position:absolute;top:45%;left:15%;right:15%;color:#c00;text-align:center;background:#fff;z-index:5}\nsmall{color:#626262}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<div class=\"row\"><b>纯电 SUV · 整车热管理示意</b></div>\n<div class=\"row\" id=\"spec\"></div>\n<div class=\"row\" id=\"loads\"></div>\n<div class=\"row\" id=\"flows\"></div>\n<div class=\"row\" id=\"temps\"></div>\n<div class=\"row\" id=\"power\"></div>\n<div class=\"row\" id=\"state\"></div>\n<div class=\"row\">● <span style=\"color:#0f766e\">电池液</span> / <span style=\"color:#22c55e\">电驱液</span> / <span style=\"color:#2563eb\">冷媒</span> / <span style=\"color:#dc2626\">热端</span></div>\n<div class=\"row\"><span style=\"color:#9aa3ab\">■ 金属</span> · 黑色塑料 · 蓝色腔体；点击编号聚焦</div>\n<div class=\"row\" id=\"stage\"></div>\n<div class=\"row\" id=\"actions\"><button data-mode=\"0\">①夏季</button><button data-mode=\"1\">②冬季热泵</button><button data-mode=\"2\">③快充</button><button data-mode=\"3\">④电池加热</button><button id=\"cut\">剖切视图</button><button id=\"explode\">爆炸视图</button><button id=\"rotate\">自动旋转</button><button id=\"pause\">暂停</button><button id=\"home\">全局</button></div>\n<div class=\"row\"><small id=\"hint\">车壳异步加载；红色表示热端，非温度场仿真。</small></div>\n</div>\n<div id=\"err\" hidden></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nconst P = {\n // 尺寸 mm，负荷 kW，流量 L/min；系统级假设\n voltage:800,capacity:100,charge:250,rho:1069,cp:3280,eta:.92,\n flowB:12,flowE:15,dpB:45,dpE:60,copFactor:.45,evapCool:5,condCool:55,\n evapWinter:-15,evapRecovery:5,condHeat:50,approach:5,particleCount:40,\n particleRadius:13,speed:.045,stageSeconds:5,explodeDistance:180,\n body:[4600,1450,1850],batterySize:[2100,170,1320],itm