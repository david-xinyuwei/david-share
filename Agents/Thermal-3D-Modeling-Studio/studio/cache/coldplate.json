{"ok": true, "summary": "已建立320×180×12 mm铝合金水冷板，按6条平行直段、5个半圆弯串联形成S形流道，同一短边布置进出口。流道宽10、深6 mm，中心距25 mm，弯曲中心半径12.5 mm；上下盖各厚3 mm，满足最小壁厚要求。φ12快插接头按长24 mm、内径8 mm铝套筒简化，不含锁止结构。模型支持开盖剖切与爆炸查看，换热面积按板内流道全部湿润壁面计算。", "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>新能源车电池包铝合金水冷板</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif;background:#f7f4ef}\ncanvas{display:block;width:100%;height:100%}\n#panel{position:absolute;left:14px;top:14px;max-width:300px;width:calc(100vw - 54px);box-sizing:border-box;padding:14px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;color:#34383e;max-height:calc(100vh - 28px);overflow:auto}\nh1{font-size:16px;margin:0 0 5px;font-weight:650}\n.subtitle{font-size:12px;color:#777;margin-bottom:12px}\n.section{border-top:1px solid #e5e5e5;padding-top:9px;margin-top:9px}\n.row{display:flex;justify-content:space-between;gap:12px;margin:5px 0}\n.row span:last-child{text-align:right;font-variant-numeric:tabular-nums}\n.legend{display:flex;align-items:center;gap:7px;margin:6px 0}\n.swatch{width:13px;height:13px;border-radius:3px;border:1px solid rgba(0,0,0,.15)}\n.buttons{display:flex;flex-wrap:wrap;gap:6px;margin-top:11px}\nbutton{font:inherit;background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;color:#34383e}\nbutton:hover{border-color:#b11f4b}\nbutton.active{color:#b11f4b;border-color:#b11f4b}\n.note{font-size:12px;line-height:1.65;color:#74777b;margin-top:9px}\n#error{display:none;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);max-width:85vw;padding:18px;background:rgba(255,255,255,.96);border:1px solid #d33;border-radius:8px;color:#c32020;z-index:20;white-space:pre-wrap}\n</style>\n<script>\nwindow.__showError=function(message){\n  var box=document.getElementById('error');\n  if(!box){box=document.createElement('div');box.id='error';document.body.appendChild(box);}\n  box.textContent='模型加载错误：'+message;\n  box.style.display='block';\n};\nwindow.addEventListener('error',function(e){window.__showError(e.message || '未知错误');});\nwindow.addEventListener('unhandledrejection',function(e){\n  window.__showError(e.reason && e.reason.message ? e.reason.message : String(e.reason));\n});\n</script>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\" /static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h1>电池包铝合金水冷板</h1>\n<div class=\"subtitle\">6道串联 S 形流道 · 单位 mm</div>\n<div id=\"parameters\"></div>\n<div class=\"section\" id=\"quantities\"></div>\n<div class=\"section\">\n<div class=\"legend\"><span class=\"swatch\" style=\"background:#c9ced6\"></span>铝合金板体 / 简化快插套筒</div>\n<div class=\"legend\"><span class=\"swatch\" style=\"background:rgba(59,130,246,.55)\"></span>冷却液 / 流道空间</div>\n</div>\n<div class=\"buttons\">\n<button id=\"cut\">完整视图</button>\n<button id=\"explode\">爆炸视图</button>\n<button id=\"rotate\">自动旋转：开</button>\n<button id=\"reset\">居中查看</button>\n</div>\n<div class=\"note\" id=\"state\"></div>\n<div class=\"note\">默认开盖剖切，板体采用真实空腔几何。拖动旋转、滚轮缩放、右键平移。蓝色表示流体空间，不是实体嵌件。</div>\n<div class=\"note\">接头仅作φ12套筒外形与通孔示意；锁止、密封及焊接结构需按实际接头图纸细化。估算不含加工余量、焊料及密封件。</div>\n</div>\n<div id=\"error\"></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\n\n// 所有工程尺寸单位为 mm；密度单位为 g/cm³。\nconst P = {\n  plate: {\n    length: 320,             // 板体长度\n    width: 180,              // 板体宽度\n    thickness: 12,           // 板体总厚度\n    minimumWall: 1.5         // 要求的最小实体壁厚，开口除外\n  },\n  channel: {\n    runs: 6,                // 六条平行直段，五个半圆回弯串联\n    width: 10,              // 流道矩形截面宽度\n    depth: 6,               // 流道深度\n    pitch: 25,              // 相邻直段中心距，假设\n    turnX: 135,             // 回弯圆心距板体长度方向中心，假设\n    arcSegments: 48         // 每个半圆的显示离散数\n  },\n  connector: {\n    count: 2,               // 同一短边进出口\n    outerDiameter: 12,      // 简化铝套筒外径\n    innerDiameter: 8,       // 假设通孔直径\n    length: 24,             // 假设外伸长度\n    segments: 64            // 圆周离散数\n  },\n  material: {\n    aluminumDensity: 2.70,  // 铝材密度，g/cm³\n    aluminumColor: '#c9ced6',\n    fluidColor: '#3b82f6',\n    metalness: 0.78,\n    roughness: 0.38,\n    fluidOpacity: 0.55\n  },\n  view: {\n    topLift: 32,            // 爆炸图上盖位移\n    bottomDrop: 24,         // 爆炸图下盖位移\n    connectorPull: 32,      // 爆炸图接头外拉距离\n    fov: 40,\n    framing: 0.70\n  }\n};\n\ntry {\n  // 将 import map 保持为部署端要求的固定路径。\n  const L = P.plate.length;\n  const W = P.plate.width;\n  const H = P.plate.thickness;\n  const cw = P.channel.width;\n  const cd = P.channel.depth;\n  const n = P.channel.runs;\n  const radius = P.channel.pitch / 2;\n  const skin = (H - cd) / 2;\n  const firstY = -(n - 1) * P.channel.pitch / 2;\n  const lastY = -firstY;\n  const endWall = L / 2 - P.channel.turnX - radius - cw / 2;\n  const sideWall = W / 2 - lastY - cw / 2;\n  const ribWidth = P.channel.pitch - cw;\n  const minWall = Math.min(skin, endWall, sideWall, ribWidth);\n  if (n < 2 || n % 2 !== 0) throw new Error('同侧接口需要偶数条串联直段。');\n  if (radius <= cw / 2) throw new Error('回弯半径必须大于流道半宽。');\n  if (minWall < P.plate.minimumWall) throw new Error('流道布置不满足最小壁厚要求。');\n  if (P.connector.innerDiameter >= P.connector.outerDiameter) throw new Error('接头内径必须小于外径。');\n\n  // 解析工程量：弯道按精确半圆计算，不使用离散网格估算。\n  const straightLength = n * 2 * P.channel.turnX + 2 * (L / 2 - P.channel.turnX);\n  const bendLength = (n - 1) * Math.PI * radius;\n  const channelLength = straightLength + bendLength;\n  const channelVolume = channelLength * cw * cd;\n  const plateVolume = L * W * H - channelVolume;\n  const connectorVolume = P.connector.count * Math.PI / 4 *\n    (P.connector.outerDiameter ** 2 - P.connector.innerDiameter ** 2) * P.connector.length;\n  const plateMass = plateVolume * P.material.aluminumDensity / 1e6;\n  const connectorMass = connectorVolume * P.material.aluminumDensity / 1e6;\n  const totalMass = plateMass + connectorMass;\n  const wetArea = 2 * (cw + cd) * channelLength;\n  const floorArea = cw * channelLength;\n  const envelopeLength = L + P.connector.length;\n\n  function row(label, value) {\n    return '<div class=\"row\"><span>' + label + '</span><span>' + value + '</span></div>';\n  }\n  document.getElementById('parameters').innerHTML =\n    row('板体外形', `${L} × ${W} × ${H}`) +\n    row('流道截面', `${cw} × ${cd}`) +\n    row('串联直段 / 回弯', `${n} 道 / ${n - 1} 个`) +\n    row('中心距 / 弯曲中心半径', `${P.channel.pitch} / ${radius}`) +\n    row('上下盖厚度', `${skin} / ${skin}`) +\n    row('最小板体壁厚', `${minWall.toFixed(1)} ≥ ${P.plate.minimumWall}`) +\n    row('接头外径 / 假设内径', `φ${P.connector.outerDiameter} / φ${P.connector.innerDiameter}`);\n  document.getElementById('quantities').innerHTML =\n    row('板体铝材质量', `${plateMass.toFixed(3)} kg`) +\n    row('含接头铝材质量', `${totalMass.toFixed(3)} kg`) +\n    row('板内流道总长', `${channelLength.toFixed(2)} mm`) +\n    row('流道湿润壁面面积', `${(wetArea / 1e6).toFixed(5)} m²`) +\n    row('单侧流道底面面积', `${(floorArea / 1e6).toFixed(5)} m²`) +\n    row('板内冷却液容积', `${(channelVolume / 1000).toFixed(2)} mL`) +\n    row('含接头包络', `${envelopeLength} × ${W} × ${H}`);\n\n  const scene = new THREE.Scene();\n  scene.background = new THREE.Color('#f7f4ef');\n  const renderer = new THREE.WebGLRenderer({antialias:true, preserveDrawingBuffer:true});\n  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));\n  renderer.setSize(window.innerWidth, window.innerHeight);\n  renderer.localClippingEnabled = true;\n  renderer.outputColorSpace = THREE.SRGBColorSpace;\n  renderer.toneMapping = THREE.ACESFilmicToneMapping;\n  document.body.appendChild(renderer.domElement);\n\n  const camera = new THREE.PerspectiveCamera(P.view.fov, window.innerWidth / window.innerHeight, 0.1, 10000);\n  camera.up.set(0, 0, 1);\n  const controls = new OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true;\n  controls.autoRotate = true;\n  controls.autoRotateSpeed = 1.2;\n\n  scene.add(new THREE.HemisphereLight(0xffffff, 0xa0a3ac, 2.1));\n  const key = new THREE.DirectionalLight(0xffffff, 3.2);\n  key.position.set(-L, -W, L * 2);\n  scene.add(key);\n  const fill = new THREE.DirectionalLight(0xdbe8ff, 1.5);\n  fill.position.set(L, W, H * 8);\n  scene.add(fill);\n\n  const aluminum = new THREE.MeshStandardMaterial({\n    color: P.material.aluminumColor,\n    metalness: P.material.metalness,\n    roughness: P.material.roughness,\n    side: THREE.DoubleSide\n  });\n  const fluidMaterial = new THREE.MeshStandardMaterial({\n    color: P.material.fluidColor,\n    metalness: 0.6,\n    roughness: 0.35,\n    transparent: true,\n    opacity: P.material.fluidOpacity,\n    depthWrite: false,\n    side: THREE.DoubleSide\n  });\n  const model = new THREE.Group();\n  model.name = '电池包铝合金水冷板总成';\n  scene.add(model);\n  const parts = [];\n\n  function addPart(name, offset) {\n    const group = new THREE.Group();\n    group.name = name;\n    model.add(group);\n    parts.push({group, base: group.position.clone(), offset});\n    return group;\n  }\n  function addBox(group, name, sx, sy, sz, x, y, z) {\n    const mesh = new THREE.Mesh(new THREE.BoxGeometry(sx, sy, sz), aluminum);\n    mesh.name = name;\n    mesh.position.set(x, y, z);\n    group.add(mesh);\n    return mesh;\n  }\n  function makeShape(points) {\n    const shape = new THREE.Shape();\n    shape.moveTo(points[0].x, points[0].y);\n    for (let i = 1; i < points.length; i++) shape.lineTo(points[i].x, points[i].y);\n    shape.closePath();\n    return shape;\n  }\n  function extrude(shape, depth, material, name) {\n    const geometry = new THREE.ExtrudeGeometry(shape, {\n      depth, steps: 1, bevelEnabled: false, curveSegments: P.connector.segments\n    });\n    const mesh = new THREE.Mesh(geometry, material);\n    mesh.name = name;\n    return mesh;\n  }\n\n  const bottom = addPart('下盖板', new THREE.Vector3(0, 0, -P.view.bottomDrop));\n  addBox(bottom, '3mm下盖', L, W, skin, 0, 0, skin / 2);\n  const middle = addPart('带真实空腔的流道芯层', new THREE.Vector3());\n  const top = addPart('上盖板', new THREE.Vector3(0, 0, P.view.topLift));\n  addBox(top, '3mm上盖', L, W, skin, 0, 0, H - skin / 2);\n\n  // 中心线及其精确法线：直段平移、弯段采用同心圆偏置。\n  const leftBoundary = [];\n  const rightBoundary = [];\n  function addStation(x, y, tx, ty) {\n    const nx = -ty;\n    const ny = tx;\n    leftBoundary.push(new THREE.Vector2(x + nx * cw / 2, y + ny * cw / 2));\n    rightBoundary.push(new THREE.Vector2(x - nx * cw / 2, y - ny * cw / 2));\n  }\n  addStation(-L / 2, firstY, 1, 0);\n  for (let i = 0; i < n; i++) {\n    const direction = i % 2 === 0 ? 1 : -1;\n    const y = firstY + i * P.channel.pitch;\n    const endX = i === n - 1 ? -L / 2 : direction * P.channel.turnX;\n    addStation(endX, y, direction, 0);\n    if (i < n - 1) {\n      const centerY = y + radius;\n      for (let j = 1; j <= P.channel.arcSegments; j++) {\n        const angle = -Math.PI / 2 + direction * Math.PI * j / P.channel.arcSegments;\n        const x = endX + radius * Math.cos(angle);\n        const ay = centerY + radius * Math.sin(angle);\n        const tx = -direction * Math.sin(angle);\n        const ty = direction * Math.cos(angle);\n        addStation(x, ay, tx, ty);\n      }\n    }\n  }\n\n  // 通道贯通同一外边界，将芯层分成两个实体区域，避免接触外边的非法孔洞。\n  const innerShape = makeShape(leftBoundary);\n  const outerPoints = rightBoundary.slice();\n  outerPoints.push(\n    new THREE.Vector2(-L / 2, W / 2),\n    new THREE.Vector2(L / 2, W / 2),\n    new THREE.Vector2(L / 2, -W / 2),\n    new THREE.Vector2(-L / 2, -W / 2)\n  );\n  const outerShape = makeShape(outerPoints);\n  const innerSolid = extrude(innerShape, cd, aluminum, '内侧串联隔肋实体');\n  const outerSolid = extrude(outerShape, cd, aluminum, '外框与外侧隔肋实体');\n  innerSolid.position.z = skin;\n  outerSolid.position.z = skin;\n  middle.add(innerSolid, outerSolid);\n\n  const channelShape = makeShape(leftBoundary.concat(rightBoundary.slice().reverse()));\n  const fluid = extrude(channelShape, cd, fluidMaterial, '板内连续S形冷却液');\n  fluid.position.z = skin;\n  fluid.renderOrder = 2;\n  middle.add(fluid);\n\n  // 快插头采用中空铝套筒简化，朝同一短边外伸。\n  function makeConnector(y, index) {\n    const part = addPart(index === 0 ? '入口快插套筒' : '出口快插套筒',\n      new THREE.Vector3(-P.view.connectorPull, 0, 0));\n    const sleeveShape = new THREE.Shape();\n    sleeveShape.absarc(0, 0, P.connector.outerDiameter / 2, 0, Math.PI * 2, false);\n    const bore = new THREE.Path();\n    bore.absarc(0, 0, P.connector.innerDiameter / 2, 0, Math.PI * 2, true);\n    sleeveShape.holes.push(bore);\n    const sleeve = extrude(sleeveShape, P.connector.length, aluminum, 'φ12铝制中空套筒');\n    sleeve.rotation.y = -Math.PI / 2;\n    sleeve.position.set(-L / 2, y, H / 2);\n    part.add(sleeve);\n\n    const liquid = new THREE.Mesh(\n      new THREE.CylinderGeometry(P.connector.innerDiameter / 2,\n        P.connector.innerDiameter / 2, P.connector.length, P.connector.segments),\n      fluidMaterial\n    );\n    liquid.name = '接头内冷却液';\n    liquid.rotation.z = Math.PI / 2;\n    liquid.position.set(-L / 2 - P.connector.length / 2, y, H / 2);\n    liquid.renderOrder = 2;\n    part.add(liquid);\n  }\n  makeConnector(firstY, 0);\n  makeConnector(lastY, 1);\n\n  // 包围盒自动取景：Z为板厚方向，单位仍为mm。\n  function frameModel() {\n    const box = new THREE.Box3().setFromObject(model);\n    const center = box.getCenter(new THREE.Vector3());\n    const sphere = box.getBoundingSphere(new THREE.Sphere());\n    const verticalHalfAngle = THREE.MathUtils.degToRad(camera.fov / 2);\n    const horizontalHalfAngle = Math.atan(Math.tan(verticalHalfAngle) * camera.aspect);\n    const distance = sphere.radius / Math.sin(Math.min(verticalHalfAngle, horizontalHalfAngle)) / P.view.framing;\n    const direction = new THREE.Vector3(-1.15, -1.2, 1.6).normalize();\n    camera.position.copy(center).addScaledVector(direction, distance);\n    camera.near = Math.max(0.1, distance / 1000);\n    camera.far = distance * 20;\n    camera.updateProjectionMatrix();\n    controls.target.copy(center);\n    controls.minDistance = sphere.radius * 0.35;\n    controls.maxDistance = distance * 4;\n    controls.update();\n  }\n\n  let cutaway = true;\n  let exploded = false;\n  const cutButton = document.getElementById('cut');\n  const explodeButton = document.getElementById('explode');\n  const rotateButton = document.getElementById('rotate');\n\n  function updateView() {\n    // 移除上壳式剖切：显示真实腔壁、底面及蓝色流体空间。\n    top.visible = !cutaway;\n    cutButton.textContent = cutaway ? '完整视图' : '剖切视图';\n    cutButton.classList.toggle('active', cutaway);\n    explodeButton.textContent = exploded ? '装配视图' : '爆炸视图';\n    explodeButton.classList.toggle('active', exploded);\n    for (const part of parts) {\n      part.group.position.copy(part.base);\n      if (exploded) part.group.position.add(part.offset);\n    }\n    document.getElementById('state').textContent =\n      (cutaway ? '当前：开盖剖切，隐藏上盖。' : '当前：完整视图。') +\n      (exploded ? '部件已按装配方向展开。' : '部件处于装配位置。') +\n      ' 换热面积不含接头通孔及进出口开口。';\n  }\n  function updateRotateButton() {\n    rotateButton.textContent = '自动旋转：' + (controls.autoRotate ? '开' : '关');\n    rotateButton.classList.toggle('active', controls.autoRotate);\n  }\n  cutButton.addEventListener('click', () => {\n    cutaway = !cutaway;\n    updateView();\n  });\n  explodeButton.addEventListener('click', () => {\n    exploded = !exploded;\n    if (exploded) cutaway = false;\n    updateView();\n    frameModel();\n  });\n  rotateButton.addEventListener('click', () => {\n    controls.autoRotate = !controls.autoRotate;\n    updateRotateButton();\n  });\n  controls.addEventListener('start', () => {\n    controls.autoRotate = false;\n    updateRotateButton();\n  });\n  document.getElementById('reset').addEventListener('click', frameModel);\n  window.addEventListener('resize', () => {\n    camera.aspect = window.innerWidth / window.innerHeight;\n    renderer.setSize(window.innerWidth, window.innerHeight);\n    frameModel();\n  });\n\n  window.__scene = scene;\n  window.__camera = camera;\n  window.__renderer = renderer;\n  window.__controls = controls;\n  window.__model = model;\n  window.__parameters = P;\n  window.__engineering = {\n    straightLength, bendLength, channelLength, channelVolume,\n    plateVolume, connectorVolume, plateMass, connectorMass, totalMass,\n    wetArea, floorArea, minWall\n  };\n\n  updateView();\n  updateRotateButton();\n  frameModel();\n  const clock = new THREE.Clock();\n  function animate() {\n    requestAnimationFrame(animate);\n    controls.update(Math.min(clock.getDelta(), 0.1));\n    renderer.render(scene, camera);\n  }\n  animate();\n} catch (error) {\n  window.__showError(error.message);\n}\n</script>\n</body>\n</html>", "metrics": [{"label": "板体铝材质量", "value": "1.564", "unit": "kg", "note": "外形体积691200 mm³减去流道体积111980.97 mm³；铝密度2.70 g/cm³。"}, {"label": "含接头铝材质量", "value": "1.572", "unit": "kg", "note": "增加2只假设铝制套筒，外径12、内径8、长度24 mm，合计约0.00814 kg；不含锁止及密封件。"}, {"label": "板内流道总长", "value": "1866.35", "unit": "mm", "note": "按中心线计算：2×295+4×270+5×π×12.5；不含接头通孔长度。"}, {"label": "流道湿润壁面换热面积", "value": "0.05972", "unit": "m²", "note": "全部四壁面积：2×(10+6)×1866.34954 mm²；不含进出口开口与接头，不等同于有效热性能。"}, {"label": "单侧流道底面面积", "value": "0.01866", "unit": "m²", "note": "10×1866.34954 mm²；为一侧水平湿润壁面面积，不是电池接触面积。"}, {"label": "板内冷却液容积", "value": "111.98", "unit": "mL", "note": "流道宽10×深6×中心线长1866.34954 mm；不含接头内腔。"}, {"label": "最小板体壁厚", "value": "3.0", "unit": "mm", "note": "上下盖各3；回弯至端边7.5；流道至长边22.5；相邻直道间隔肋15 mm；接口开口除外。"}, {"label": "含接头外形包络", "value": "344×180×12", "unit": "mm", "note": "板体320×180×12 mm，两接头在同一短边各外伸24 mm；装配状态。"}], "suggestions": ["将串联流道改为双回路并比较压降", "增加安装孔与电池接触面定位结构", "按实际快插图纸细化密封与锁止结构"], "raw": "<<<SUMMARY>>>\n已建立320×180×12 mm铝合金水冷板，按6条平行直段、5个半圆弯串联形成S形流道，同一短边布置进出口。流道宽10、深6 mm，中心距25 mm，弯曲中心半径12.5 mm；上下盖各厚3 mm，满足最小壁厚要求。φ12快插接头按长24 mm、内径8 mm铝套筒简化，不含锁止结构。模型支持开盖剖切与爆炸查看，换热面积按板内流道全部湿润壁面计算。\n<<<HTML>>>\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>新能源车电池包铝合金水冷板</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif;background:#f7f4ef}\ncanvas{display:block;width:100%;height:100%}\n#panel{position:absolute;left:14px;top:14px;max-width:300px;width:calc(100vw - 54px);box-sizing:border-box;padding:14px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;color:#34383e;max-height:calc(100vh - 28px);overflow:auto}\nh1{font-size:16px;margin:0 0 5px;font-weight:650}\n.subtitle{font-size:12px;color:#777;margin-bottom:12px}\n.section{border-top:1px solid #e5e5e5;padding-top:9px;margin-top:9px}\n.row{display:flex;justify-content:space-between;gap:12px;margin:5px 0}\n.row span:last-child{text-align:right;font-variant-numeric:tabular-nums}\n.legend{display:flex;align-items:center;gap:7px;margin:6px 0}\n.swatch{width:13px;height:13px;border-radius:3px;border:1px solid rgba(0,0,0,.15)}\n.buttons{display:flex;flex-wrap:wrap;gap:6px;margin-top:11px}\nbutton{font:inherit;background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;color:#34383e}\nbutton:hover{border-color:#b11f4b}\nbutton.active{color:#b11f4b;border-color:#b11f4b}\n.note{font-size:12px;line-height:1.65;color:#74777b;margin-top:9px}\n#error{display:none;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);max-width:85vw;padding:18px;background:rgba(255,255,255,.96);border:1px solid #d33;border-radius:8px;color:#c32020;z-index:20;white-space:pre-wrap}\n</style>\n<script>\nwindow.__showError=function(message){\n  var box=document.getElementById('error');\n  if(!box){box=document.createElement('div');box.id='error';document.body.appendChild(box);}\n  box.textContent='模型加载错误：'+message;\n  box.style.display='block';\n};\nwindow.addEventListener('error',function(e){window.__showError(e.message || '未知错误');});\nwindow.addEventListener('unhandledrejection',function(e){\n  window.__showError(e.reason && e.reason.message ? e.reason.message : String(e.reason));\n});\n</script>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\" /static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h1>电池包铝合金水冷板</h1>\n<div class=\"subtitle\">6道串联 S 形流道 · 单位 mm</div>\n<div id=\"parameters\"></div>\n<div class=\"section\" id=\"quantities\"></div>\n<div class=\"section\">\n<div class=\"legend\"><span class=\"swatch\" style=\"background:#c9ced6\"></span>铝合金板体 / 简化快插套筒</div>\n<div class=\"legend\"><span class=\"swatch\" style=\"background:rgba(59,130,246,.55)\"></span>冷却液 / 流道空间</div>\n</div>\n<div class=\"buttons\">\n<button id=\"cut\">完整视图</button>\n<button id=\"explode\">爆炸视图</button>\n<button id=\"rotate\">自动旋转：开</button>\n<button id=\"reset\">居中查看</button>\n</div>\n<div class=\"note\" id=\"state\"></div>\n<div class=\"note\">默认开盖剖切，板体采用真实空腔几何。拖动旋转、滚轮缩放、右键平移。蓝色表示流体空间，不是实体嵌件。</div>\n<div class=\"note\">接头仅作φ12套筒外形与通孔示意；锁止、密封及焊接结构需按实际接头图纸细化。估算不含加工余量、焊料及密封件。</div>\n</div>\n<div id=\"error\"></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\n\n// 所有工程尺寸单位为 mm；密度单位为 g/cm³。\nconst P = {\n  plate: {\n    length: 320,             // 板体长度\n    width: 180,              // 板体宽度\n    thickness: 12,           // 板体总厚度\n    minimumWall: 1.5         // 要求的最小实体壁厚，开口除外\n  },\n  channel: {\n    runs: 6,                // 六条平行直段，五个半圆回弯串联\n    width: 10,              // 流道矩形截面宽度\n    depth: 6,               // 流道深度\n    pitch: 25,              // 相邻直段中心距，假设\n    turnX: 135,             // 回弯圆心距板体长度方向中心，假设\n    arcSegments: 48         // 每个半圆的显示离散数\n  },\n  connector: {\n    count: 2,               // 同一短边进出口\n    outerDiameter: 12,      // 简化铝套筒外径\n    innerDiameter: 8,       // 假设通孔直径\n    length: 24,             // 假设外伸长度\n    segments: 64            // 圆周离散数\n  },\n  material: {\n    aluminumDensity: 2.70,  // 铝材密度，g/cm³\n    aluminumColor: '#c9ced6',\n    fluidColor: '#3b82f6',\n    metalness: 0.78,\n    roughness: 0.38,\n    fluidOpacity: 0.55\n  },\n  view: {\n    topLift: 32,            // 爆炸图上盖位移\n    bottomDrop: 24,         // 爆炸图下盖位移\n    connectorPull: 32,      // 爆炸图接头外拉距离\n    fov: 40,\n    framing: 0.70\n  }\n};\n\ntry {\n  // 将 import map 保持为部署端要求的固定路径。\n  const L = P.plate.length;\n  const W = P.plate.width;\n  const H = P.plate.thickness;\n  const cw = P.channel.width;\n  const cd = P.channel.depth;\n  const n = P.channel.runs;\n  const radius = P.channel.pitch / 2;\n  const skin = (H - cd) / 2;\n  const firstY = -(n - 1) * P.channel.pitch / 2;\n  const lastY = -firstY;\n  const endWall = L / 2 - P.channel.turnX - radius - cw / 2;\n  const sideWall = W / 2 - lastY - cw / 2;\n  const ribWidth = P.channel.pitch - cw;\n  const minWall = Math.min(skin, endWall, sideWall, ribWidth);\n  if (n < 2 || n % 2 !== 0) throw new Error('同侧接口需要偶数条串联直段。');\n  if (radius <= cw / 2) throw new Error('回弯半径必须大于流道半宽。');\n  if (minWall < P.plate.minimumWall) throw new Error('流道布置不满足最小壁厚要求。');\n  if (P.connector.innerDiameter >= P.connector.outerDiameter) throw new Error('接头内径必须小于外径。');\n\n  // 解析工程量：弯道按精确半圆计算，不使用离散网格估算。\n  const straightLength = n * 2 * P.channel.turnX + 2 * (L / 2 - P.channel.turnX);\n  const bendLength = (n - 1) * Math.PI * radius;\n  const channelLength = straightLength + bendLength;\n  const channelVolume = channelLength * cw * cd;\n  const plateVolume = L * W * H - channelVolume;\n  const connectorVolume = P.connector.count * Math.PI / 4 *\n    (P.connector.outerDiameter ** 2 - P.connector.innerDiameter ** 2) * P.connector.length;\n  const plateMass = plateVolume * P.material.aluminumDensity / 1e6;\n  const connectorMass = connectorVolume * P.material.aluminumDensity / 1e6;\n  const totalMass = plateMass + connectorMass;\n  const wetArea = 2 * (cw + cd) * channelLength;\n  const floorArea = cw * channelLength;\n  const envelopeLength = L + P.connector.length;\n\n  function row(label, value) {\n    return '<div class=\"row\"><span>' + label + '</span><span>' + value + '</span></div>';\n  }\n  document.getElementById('parameters').innerHTML =\n    row('板体外形', `${L} × ${W} × ${H}`) +\n    row('流道截面', `${cw} × ${cd}`) +\n    row('串联直段 / 回弯', `${n} 道 / ${n - 1} 个`) +\n    row('中心距 / 弯曲中心半径', `${P.channel.pitch} / ${radius}`) +\n    row('上下盖厚度', `${skin} / ${skin}`) +\n    row('最小板体壁厚', `${minWall.toFixed(1)} ≥ ${P.plate.minimumWall}`) +\n    row('接头外径 / 假设内径', `φ${P.connector.outerDiameter} / φ${P.connector.innerDiameter}`);\n  document.getElementById('quantities').innerHTML =\n    row('板体铝材质量', `${plateMass.toFixed(3)} kg`) +\n    row('含接头铝材质量', `${totalMass.toFixed(3)} kg`) +\n    row('板内流道总长', `${channelLength.toFixed(2)} mm`) +\n    row('流道湿润壁面面积', `${(wetArea / 1e6).toFixed(5)} m²`) +\n    row('单侧流道底面面积', `${(floorArea / 1e6).toFixed(5)} m²`) +\n    row('板内冷却液容积', `${(channelVolume / 1000).toFixed(2)} mL`) +\n    row('含接头包络', `${envelopeLength} × ${W} × ${H}`);\n\n  const scene = new THREE.Scene();\n  scene.background = new THREE.Color('#f7f4ef');\n  const renderer = new THREE.WebGLRenderer({antialias:true, preserveDrawingBuffer:true});\n  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));\n  renderer.setSize(window.innerWidth, window.innerHeight);\n  renderer.localClippingEnabled = true;\n  renderer.outputColorSpace = THREE.SRGBColorSpace;\n  renderer.toneMapping = THREE.ACESFilmicToneMapping;\n  document.body.appendChild(renderer.domElement);\n\n  const camera = new THREE.PerspectiveCamera(P.view.fov, window.innerWidth / window.innerHeight, 0.1, 10000);\n  camera.up.set(0, 0, 1);\n  const controls = new OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true;\n  controls.autoRotate = true;\n  controls.autoRotateSpeed = 1.2;\n\n  scene.add(new THREE.HemisphereLight(0xffffff, 0xa0a3ac, 2.1));\n  const key = new THREE.DirectionalLight(0xffffff, 3.2);\n  key.position.set(-L, -W, L * 2);\n  scene.add(key);\n  const fill = new THREE.DirectionalLight(0xdbe8ff, 1.5);\n  fill.position.set(L, W, H * 8);\n  scene.add(fill);\n\n  const aluminum = new THREE.MeshStandardMaterial({\n    color: P.material.aluminumColor,\n    metalness: P.material.metalness,\n    roughness: P.material.roughness,\n    side: THREE.DoubleSide\n  });\n  const fluidMaterial = new THREE.MeshStandardMaterial({\n    color: P.material.fluidColor,\n    metalness: 0.6,\n    roughness: 0.35,\n    transparent: true,\n    opacity: P.material.fluidOpacity,\n    depthWrite: false,\n    side: THREE.DoubleSide\n  });\n  const model = new THREE.Group();\n  model.name = '电池包铝合金水冷板总成';\n  scene.add(model);\n  const parts = [];\n\n  function addPart(name, offset) {\n    const group = new THREE.Group();\n    group.name = name;\n    model.add(group);\n    parts.push({group, base: group.position.clone(), offset});\n    return group;\n  }\n  function addBox(group, name, sx, sy, sz, x, y, z) {\n    const mesh = new THREE.Mesh(new THREE.BoxGeometry(sx, sy, sz), aluminum);\n    mesh.name = name;\n    mesh.position.set(x, y, z);\n    group.add(mesh);\n    return mesh;\n  }\n  function makeShape(points) {\n    const shape = new THREE.Shape();\n    shape.moveTo(points[0].x, points[0].y);\n    for (let i = 1; i < points.length; i++) shape.lineTo(points[i].x, points[i].y);\n    shape.closePath();\n    return shape;\n  }\n  function extrude(shape, depth, material, name) {\n    const geometry = new THREE.ExtrudeGeometry(shape, {\n      depth, steps: 1, bevelEnabled: false, curveSegments: P.connector.segments\n    });\n    const mesh = new THREE.Mesh(geometry, material);\n    mesh.name = name;\n    return mesh;\n  }\n\n  const bottom = addPart('下盖板', new THREE.Vector3(0, 0, -P.view.bottomDrop));\n  addBox(bottom, '3mm下盖', L, W, skin, 0, 0, skin / 2);\n  const middle = addPart('带真实空腔的流道芯层', new THREE.Vector3());\n  const top = addPart('上盖板', new THREE.Vector3(0, 0, P.view.topLift));\n  addBox(top, '3mm上盖', L, W, skin, 0, 0, H - skin / 2);\n\n  // 中心线及其精确法线：直段平移、弯段采用同心圆偏置。\n  const leftBoundary = [];\n  const rightBoundary = [];\n  function addStation(x, y, tx, ty) {\n    const nx = -ty;\n    const ny = tx;\n    leftBoundary.push(new THREE.Vector2(x + nx * cw / 2, y + ny * cw / 2));\n    rightBoundary.push(new THREE.Vector2(x - nx * cw / 2, y - ny * cw / 2));\n  }\n  addStation(-L / 2, firstY, 1, 0);\n  for (let i = 0; i < n; i++) {\n    const direction = i % 2 === 0 ? 1 : -1;\n    const y = firstY + i * P.channel.pitch;\n    const endX = i === n - 1 ? -L / 2 : direction * P.channel.turnX;\n    addStation(endX, y, direction, 0);\n    if (i < n - 1) {\n      const centerY = y + radius;\n      for (let j = 1; j <= P.channel.arcSegments; j++) {\n        const angle = -Math.PI / 2 + direction * Math.PI * j / P.channel.arcSegments;\n        const x = endX + radius * Math.cos(angle);\n        const ay = centerY + radius * Math.sin(angle);\n        const tx = -direction * Math.sin(angle);\n        const ty = direction * Math.cos(angle);\n        addStation(x, ay, tx, ty);\n      }\n    }\n  }\n\n  // 通道贯通同一外边界，将芯层分成两个实体区域，避免接触外边的非法孔洞。\n  const innerShape = makeShape(leftBoundary);\n  const outerPoints = rightBoundary.slice();\n  outerPoints.push(\n    new THREE.Vector2(-L / 2, W / 2),\n    new THREE.Vector2(L / 2, W / 2),\n    new THREE.Vector2(L / 2, -W / 2),\n    new THREE.Vector2(-L / 2, -W / 2)\n  );\n  const outerShape = makeShape(outerPoints);\n  const innerSolid = extrude(innerShape, cd, aluminum, '内侧串联隔肋实体');\n  const outerSolid = extrude(outerShape, cd, aluminum, '外框与外侧隔肋实体');\n  innerSolid.position.z = skin;\n  outerSolid.position.z = skin;\n  middle.add(innerSolid, outerSolid);\n\n  const channelShape = makeShape(leftBoundary.concat(rightBoundary.slice().reverse()));\n  const fluid = extrude(channelShape, cd, fluidMaterial, '板内连续S形冷却液');\n  fluid.position.z = skin;\n  fluid.renderOrder = 2;\n  middle.add(fluid);\n\n  // 快插头采用中空铝套筒简化，朝同一短边外伸。\n  function makeConnector(y, index) {\n    const part = addPart(index === 0 ? '入口快插套筒' : '出口快插套筒',\n      new THREE.Vector3(-P.view.connectorPull, 0, 0));\n    const sleeveShape = new THREE.Shape();\n    sleeveShape.absarc(0, 0, P.connector.outerDiameter / 2, 0, Math.PI * 2, false);\n    const bore = new THREE.Path();\n    bore.absarc(0, 0, P.connector.innerDiameter / 2, 0, Math.PI * 2, true);\n    sleeveShape.holes.push(bore);\n    const sleeve = extrude(sleeveShape, P.connector.length, aluminum, 'φ12铝制中空套筒');\n    sleeve.rotation.y = -Math.PI / 2;\n    sleeve.position.set(-L / 2, y, H / 2);\n    part.add(sleeve);\n\n    const liquid = new THREE.Mesh(\n      new THREE.CylinderGeometry(P.connector.innerDiameter / 2,\n        P.connector.innerDiameter / 2, P.connector.length, P.connector.segments),\n      fluidMaterial\n    );\n    liquid.name = '接头内冷却液';\n    liquid.rotation.z = Math.PI / 2;\n    liquid.position.set(-L / 2 - P.connector.length / 2, y, H / 2);\n    liquid.renderOrder = 2;\n    part.add(liquid);\n  }\n  makeConnector(firstY, 0);\n  makeConnector(lastY, 1);\n\n  // 包围盒自动取景：Z为板厚方向，单位仍为mm。\n  function frameModel() {\n    const box = new THREE.Box3().setFromObject(model);\n    const center = box.getCenter(new THREE.Vector3());\n    const sphere = box.getBoundingSphere(new THREE.Sphere());\n    const verticalHalfAngle = THREE.MathUtils.degToRad(camera.fov / 2);\n    const horizontalHalfAngle = Math.atan(Math.tan(verticalHalfAngle) * camera.aspect);\n    const distance = sphere.radius / Math.sin(Math.min(verticalHalfAngle, horizontalHalfAngle)) / P.view.framing;\n    const direction = new THREE.Vector3(-1.15, -1.2, 1.6).normalize();\n    camera.position.copy(center).addScaledVector(direction, distance);\n    camera.near = Math.max(0.1, distance / 1000);\n    camera.far = distance * 20;\n    camera.updateProjectionMatrix();\n    controls.target.copy(center);\n    controls.minD