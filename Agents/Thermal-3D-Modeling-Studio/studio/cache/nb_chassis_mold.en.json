ference']){\n const group=new THREE.Group();group.name=name;groups[name]=group;\n (name==='reference'?scene:modelGroup).add(group);\n}\nconst mat=(color,metalness=0.85,extra={})=>new THREE.MeshStandardMaterial({color,metalness,roughness:0.35,...extra});\nconst mg=mat('#b8bec7',0.6),plastic=mat('#2b2b2b',0,{roughness:0.6});\nconst gold=mat('#c9a227'),steel=mat('#9aa3ab');\nconst fixedMat=mat('#64748b',0.2,{transparent:true,opacity:0.25,depthWrite:false});\nconst movingMat=mat('#475569',0.2,{transparent:true,opacity:0.25,depthWrite:false});\nconst blue=mat('#3b82f6',0,{transparent:true,opacity:0.55,depthWrite:false});\nfunction rounded(w,d,r){\n const s=new THREE.Shape(),x=-w/2,z=-d/2;\n s.moveTo(x+r,z);s.lineTo(x+w-r,z);s.quadraticCurveTo(x+w,z,x+w,z+r);\n s.lineTo(x+w,z+d-r);s.quadraticCurveTo(x+w,z+d,x+w-r,z+d);\n s.lineTo(x+r,z+d);s.quadraticCurveTo(x,z+d,x,z+d-r);\n s.lineTo(x,z+r);s.quadraticCurveTo(x,z,x+r,z);return s;\n}\nfunction extrude(shape,height,material,parent,y=0){\n const geo=new THREE.ExtrudeGeometry(shape,{depth:height,bevelEnabled:false,curveSegments:16});\n geo.rotateX(-Math.PI/2);const mesh=new THREE.Mesh(geo,material);mesh.position.y=y;parent.add(mesh);return mesh;\n}\nfunction box(w,h,d,material,parent,x=0,y=0,z=0){\n const mesh=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material);mesh.position.set(x,y,z);parent.add(mesh);return mesh;\n}\nconst full=rounded(P.width,P.depth,P.radius),halfD=P.depth/2;\nconst wallMat=mg.clone(),insertMat=plastic.clone();\nwallMat.clippingPlanes=[new THREE.Plane(new THREE.Vector3(0,0,1),halfD-P.antenna)];\ninsertMat.clippingPlanes=[new THREE.Plane(new THREE.Vector3(0,0,-1),-halfD+P.antenna)];\nextrude(full,P.wall,wallMat,groups.cover);\nextrude(full,P.wall,insertMat,groups.insert);\nconst ring=rounded(P.width,P.depth,P.radius);\nring.holes.push(new THREE.Path(rounded(P.width-2*P.flangeThickness,P.depth-2*P.flangeThickness,P.radius-P.flangeThickness).getPoints(64)));\nextrude(ring,P.flangeHeight,mg,groups.cover,P.wall);\nconst nx=Math.floor((P.width-2*P.flangeThickness)/P.ribPitch);\nconst nz=Math.floor((P.depth-P.antenna-2*P.flangeThickness)/P.ribPitch);\nconst lx=P.width-2*P.flangeThickness,lz=P.depth-P.antenna-2*P.flangeThickness;\nconst ribMesh=new THREE.InstancedMesh(new THREE.BoxGeometry(1,1,1),mg,nx+nz);\nconst temp=new THREE.Object3D();\nfor(let i=0;i<nx+nz;i++){\n const vertical=i<nx,k=vertical?i:i-nx;\n temp.position.set(vertical?(k-(nx-1)/2)*P.ribPitch:0,P.wall+P.ribHeight/2,vertical?P.antenna/2:(k-(nz-1)/2)*P.ribPitch+P.antenna/2);\n temp.scale.set(vertical?P.ribWidth:lx,P.ribHeight,vertical?lz:P.ribWidth);\n temp.updateMatrix();ribMesh.setMatrixAt(i,temp.matrix);\n}\nribMesh.instanceMatrix.needsUpdate=true;ribMesh.computeBoundingSphere();groups.ribs.add(ribMesh);\nfor(const x of P.bossX){\n const boss=new THREE.Mesh(new THREE.CylinderGeometry(P.bossDiameter/2,P.bossDiameter/2,P.bossHeight,32),mg);\n boss.position.set(x,P.wall+P.bossHeight/2,P.bossZ);groups.bosses.add(boss);\n}\nconst track=rounded(P.width-2*P.adhesiveInset,P.depth-2*(P.antenna+P.adhesiveInset),P.radius);\ntrack.holes.push(new THREE.Path(rounded(P.width-2*(P.adhesiveInset+P.adhesiveWidth),P.depth-2*(P.antenna+P.adhesiveInset+P.adhesiveWidth),P.radius-P.adhesiveWidth).getPoints(64)));\nconst trackMesh=new THREE.Mesh(new THREE.ShapeGeometry(track,32),blue);\ntrackMesh.rotation.x=-Math.PI/2;trackMesh.position.y=P.wall+0.02;groups.cover.add(trackMesh);\nconst partY=P.wall+P.flangeHeight,mw=P.width+2*P.frameMargin,md=P.depth+2*P.frameMargin;\nbox(mw,P.halfHeight,md,fixedMat,groups.die_fixed,0,partY+P.halfHeight/2);\nbox(mw,P.halfHeight,md,movingMat,groups.die_moving,0,partY-P.halfHeight/2);\nconst ejectors=[];\nfor(const x of [-P.width/3,P.width/3])for(const z of [-P.depth/4,P.depth/4]){\n const pin=new THREE.Mesh(new THREE.CylinderGeometry(P.ejectorRadius,P.ejectorRadius,P.ejectorLength,20),steel);\n pin.position.set(x,-P.ejectorLength/2,z);groups.die_moving.add(pin);ejectors.push(pin);\n}\nconst fan=new THREE.Shape();fan.moveTo(-P.gateSpread/2,0);fan.lineTo(P.gateSpread/2,0);\nfan.lineTo(P.gateNeck/2,-P.gateLength);fan.lineTo(-P.gateNeck/2,-P.gateLength);fan.closePath();\nconst gateMesh=extrude(fan,P.gateThickness,gold,groups.gate);gateMesh.position.z=halfD;\nconst biscuit=new THREE.Mesh(new THREE.CylinderGeometry(P.biscuitRadius,P.biscuitRadius,P.biscuitHeight,32),gold);\nbiscuit.position.set(0,0,halfD+P.gateLength+P.biscuitRadius/2);groups.gate.add(biscuit);\nfor(let i=0;i<4;i++){\n const x=(i-1.5)*P.width/5;\n box(P.overflowWidth,P.overflowThickness,P.overflowLength,gold,groups.overflows,x,P.wall,-halfD-P.overflowLength/2);\n box(P.ventWidth,P.ventThickness,P.ventLength,gold,groups.overflows,x,P.wall,-halfD-P.overflowLength-P.ventLength/2);\n}\nconst toolingGuide=new THREE.Group();modelGroup.add(toolingGuide);\nconst planeGeo=new THREE.BufferGeometry().setFromPoints([[-mw/2,partY,-md/2],[mw/2,partY,-md/2],[mw/2,partY,md/2],[-mw/2,partY,md/2],[-mw/2,partY,-md/2]].map(v=>new THREE.Vector3(...v)));\ntoolingGuide.add(new THREE.Line(planeGeo,new THREE.LineBasicMaterial({color:'#b11f4b'})));\ntoolingGuide.add(new THREE.ArrowHelper(new THREE.Vector3(0,1,0),new THREE.Vector3(-P.width/2-30,partY,0),85,0xb11f4b,15,7));\nfunction compute(){\n const area=P.width*P.depth-(4-Math.PI)*P.radius**2;\n const antennaArea=P.width*P.antenna-(2-Math.PI/2)*P.radius**2;\n const perimeter=2*(P.width+P.depth-4*P.radius)+2*Math.PI*P.radius;\n const volume=(area-antennaArea)*P.wall+perimeter*P.flangeHeight*P.flangeThickness+(nx*lz+nz*lx)*P.ribWidth*P.ribHeight+P.bossCount*Math.PI*(P.bossDiameter/2)**2*P.bossHeight;\n const mass=volume/1000*P.mgDensity,projected=area*1.25;\n return [\n {label:'Net mass (g)',value:mass.toFixed(2),unit:'g',note:'AZ91D only; additive feature volumes'},\n {label:'Projected area (cm²)',value:(projected/100).toFixed(2),unit:'cm²',note:'Rounded outline × 1.25 feed allowance'},\n {label:'Clamping-force estimate (t)',value:(P.pressure*projected*P.safety/P.gravity/1000).toFixed(1),unit:'t',note:'60 MPa; safety 1.2; divide N by 9810'},\n {label:'Mold outline estimate (mm)',value:`${mw} × ${md} × ${2*P.halfHeight}`,unit:'mm',note:'150 mm per side; two 250 mm halves'},\n {label:'Single-shift output (pcs / 8 h)',value:Math.floor(P.shiftHours*3600/P.cycle*P.oee).toFixed(0),unit:'pcs / 8 h',note:'45 s cycle; 8 h shift; OEE 85%'},\n {label:'Material cost (CNY / pc)',value:(mass/1000*P.priceKg*(1+(1-P.recovery)*P.runnerRatio)).toFixed(2),unit:'CNY / pc',note:'28 CNY/kg; 35% feed; 40% recovered'}\n ];\n}\nconst metrics=compute();window.__metrics=metrics;\ndocument.getElementById('mass').textContent=`AZ91D ${metrics[0].value} g · clamp ${metrics[2].value} t`;\ndocument.getElementById('production').textContent=`45 s cycle · ${metrics[4].value} pcs/shift · ${metrics[5].value} CNY/pc`;\nconst bounds=new THREE.Box3().setFromObject(modelGroup,true),center=bounds.getCenter(new THREE.Vector3()),size=bounds.getSize(new THREE.Vector3());\nfunction frame(){const angle=Math.min(camera.fov*Math.PI/360,Math.atan(Math.tan(camera.fov*Math.PI/360)*camera.aspect));camera.position.copy(center).add(new THREE.Vector3(1,.7,1.2).normalize().multiplyScalar(size.length()/2/Math.sin(angle)/.7));controls.target.copy(center);}\nframe();\nlet mold=false,opened=false,exploded=false,section=false,travel=0,startTravel=0,targetTravel=0,startTime=0;\nfunction updateMode(){for(const name of ['die_fixed','die_moving','gate','overflows'])groups[name].visible=mold;toolingGuide.visible=mold;document.getElementById('mold').textContent=mold?'Part view':'Mold view';}\nupdateMode();\ndocument.getElementById('mold').onclick=()=>{mold=!mold;updateMode();};\ndocument.getElementById('open').onclick=()=>{mold=true;updateMode();opened=!opened;startTravel=travel;targetTravel=opened?1:0;startTime=performance.now();document.getElementById('open').textContent=opened?'Close mold':'Open mold';};\ndocument.getElementById('explode').onclick=()=>{exploded=!exploded;document.getElementById(