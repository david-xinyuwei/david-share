{"ok": true, "summary": "已构建双风扇散热系统，包含双热源、界面材料、铜均热板、压扁热管、铜翅片、石墨片及透明机身，并提供工况切换、气流动画、编号热点和分阶段讲解。几何为示意比例，模组按高度约束堆叠；机身素材外形与目标厚度存在差异。温度与噪声采用集总参数估算，非 CFD；安静及均衡采用功耗墙，质量含热管壳体但不含工质，结果以页面实时计算为准。", "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>轻薄本双风扇散热系统</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;left:12px;top:12px;max-width:300px;padding:12px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;line-height:1.65}\nh3{margin:0 0 5px;font-size:14px}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover,button.active{border-color:#b11f4b}\n#buttons{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}\n#err{position:absolute;top:45%;left:15%;right:15%;color:#b91c1c;text-align:center;background:#fff}\n#hint{color:#7c5962;font-size:11px}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h3>双风扇散热模组 · 系统装配</h3>\n<div>空间 300×200 · 高度≤9 mm · 目标机厚15.9</div>\n<div id=\"loads\"></div>\n<div id=\"thermal\"></div>\n<div id=\"temps\"></div>\n<div id=\"mass\"></div>\n<div id=\"chain\"></div>\n<div>铜色：铜件　深灰：风扇／石墨　蓝：电子件</div>\n<div>天蓝→红：气流　橙色：导热方向（示意）</div>\n<div id=\"stage\"></div>\n<div id=\"hint\">拖动观察；点击编号聚焦；双击空白恢复</div>\n<div id=\"buttons\">\n<button data-mode=\"quiet\">安静</button><button data-mode=\"balanced\">均衡</button><button data-mode=\"performance\">性能</button>\n<button id=\"cut\">剖切视图</button><button id=\"explode\">爆炸视图</button><button id=\"rotate\">自动旋转</button>\n<button id=\"shell\">机身实体</button><button id=\"pause\">暂停</button><button id=\"reset\">全局</button>\n</div>\n</div>\n<div id=\"err\" hidden></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nimport { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nconst P = {\n // 尺寸mm；密度g/cm³；热阻K/W；默认安静模式\n space:[300,200],targetThickness:15.9,heightLimit:9,bottom:2,\n vc:[130,.6,85],vcCenter:[0,6.3,-42.5],cpu:[40,1.8,30],gpu:[29,1.8,29],\n cpuCenter:[-28,5,-48],gpuCenter:[30,5,-48],timThickness:.1,\n finWidth:60,finDepth:10,finHeight:9,finThick:.10,finGap:.35,finZ:-95,\n fanDiameter:48,fanHeight:7,fanX:100,fanZ:-65,bladeCount:28,\n hpDiameter:6,hpHeight:2,hpWall:.3,hpCount:2,hpY:7.8,\n graphite:[280,.1,180],graphiteY:2.05,copperDensity:8.96,graphiteDensity:2.1,\n fanMass:22,hardwareMass:15,vcSolidFraction:.5,\n ambient:25,airDensity:1.16,airCp:1005,cfmToM3s:4.72e-4,fanCfm:2.6,referenceRpm:5600,\n hBase:45,hRpm:.0065,rTimCpu:.02,rTimGpu:.06,rVc:.08,rHp:.05,\n noiseBase:18,noiseSlope:28,noiseRef:1000,tempLimit:95,\n modes:{quiet:{label:'安静',rpm:2800,cpu:28,gpu:35},\n balanced:{label:'均衡',rpm:4200,cpu:28,gpu:35},\n performance:{label:'性能',rpm:5600,cpu:45,gpu:60}},\n hpPaths:[\n [[-42,7.8,-45],[-62,7.8,-58],[-66,7.8,-79],[-82,7.8,-91],[-120,7.8,-91]],\n [[42,7.8,-45],[62,7.8,-58],[66,7.8,-79],[82,7.8,-91],[120,7.8,-91]]],\n // radius为可视化导风轮廓半径；空气不是封闭液路\n loops:[\n {id:'airflow_left',label:'左侧气流',color:'#38bdf8',radius:2.5,flow_lpm:0,closed:false,points:[[-100,-4,-53],[-100,1,-58],[-100,6,-65],[-100,7,-82],[-100,7,-96],[-100,8,-112]]},\n {id:'airflow_right',label:'右侧气流',color:'#38bdf8',radius:2.5,flow_lpm:0,closed:false,points:[[100,-4,-53],[100,1,-58],[100,6,-65],[100,7,-82],[100,7,-96],[100,8,-112]]},\n {id:'heat_cpu',label:'CPU导热',color:'#f97316',radius:.65,flow_lpm:0,closed:false,points:[[-28,5,-48],[-28,6.3,-48],[-42,7.8,-45],[-62,7.8,-58],[-66,7.8,-79],[-82,7.8,-91],[-120,7.8,-91]]},\n {id:'heat_gpu',label:'GPU导热',color:'#f97316',radius:.65,flow_lpm:0,closed:false,points:[[30,5,-48],[30,6.3,-48],[42,7.8,-45],[62,7.8,-58],[66,7.8,-79],[82,7.8,-91],[120,7.8,-91]]}],\n particleCount:36,stageSeconds:5\n};\nconst showError = message => {const el=document.getElementById('err');el.hidden=false;el.textContent='模型错误：'+message;};\nwindow.addEventListener('error',e=>showError(e.message));\ntry {\nconst $=id=>document.getElementById(id);\nconst scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\nconst renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.localClippingEnabled=true;\ndocument.body.prepend(renderer.domElement);\nconst pmrem=new THREE.PMREMGenerator(renderer);\nscene.environment=pmrem.fromScene(new RoomEnvironment(),.04).texture;\nscene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\nconst light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(120,300,160);scene.add(light);\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\nconst controls=new OrbitControls(camera,renderer.domElement);\ncontrols.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1;\ncontrols.addEventListener('start',()=>{controls.autoRotate=false;flight=null;});\nconst modelGroup=new THREE.Group();scene.add(modelGroup);\nconst parts={},markers=[],rotors=[],flows=[],baseMeshes=[];\nlet mode=P.modes.quiet,stageIndex=0,paused=false,stageTime=0,focused=null,exploded=false,cut=false,transparent=true,flight=null;\nconst material=(color,metal=.85)=>new THREE.MeshStandardMaterial({color,metalness:metal,roughness:metal? .35:.6});\nfunction part(id,label,type,note){\n const g=new THREE.Group();g.name=id;parts[id]=g;modelGroup.add(g);\n hotspots.push({id,n:hotspots.length+1,label,part:type,note});return g;\n}\nconst hotspots=[];\nfunction box(g,size,pos,color,metal=.85){\n const m=new THREE.Mesh(new THREE.BoxGeometry(...size),material(color,metal));m.position.set(...pos);g.add(m);return m;\n}\nfunction cylinder(g,r,h,pos,color){\n const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,48),material(color,0));m.position.set(...pos);g.add(m);return m;\n}\npart('cpu','CPU封装','热源','性能模式施加CPU满载功耗');\npart('gpu','独显GPU封装','热源','性能模式施加GPU满载功耗');\nbox(parts.cpu,P.cpu,P.cpuCenter,'#1f4e79',0);box(parts.gpu,P.gpu,P.gpuCenter,'#1f4e79',0);\npart('tim_cpu','液态金属界面','导热界面材料','降低CPU到均热板的接触热阻');\npart('tim_gpu','导热膏界面','导热界面材料','填充GPU与均热板接触间隙');\nbox(parts.tim_cpu,[P.cpu[0],P.timThickness,P.cpu[2]],[-28,5.95,-48],'#9aa3ab');\nbox(parts.tim_gpu,[P.gpu[0],P.timThickness,P.gpu[2]],[30,5.95,-48],'#b9b5ae',0);\npart('vc','铜均热板','均热板','相变扩散双热源热量；按半实心计质量');\nbox(parts.vc,P.vc,P.vcCenter,'#b87333');\nconst hpCurves=P.hpPaths.map(points=>new THREE.CatmullRomCurve3(points.map(p=>new THREE.Vector3(...p)),false,'centripetal'));\nconst hpWidth=(Math.PI*P.hpDiameter-(Math.PI-2)*P.hpHeight)/2;\nfunction heatPipe(g,curve){\n const shape=new THREE.Shape(),w=hpWidth,h=P.hpHeight,r=h/2;\n shape.moveTo(-w/2+r,-r);shape.lineTo(w/2-r,-r);\n shape.absarc(w/2-r,0,r,-Math.PI/2,Math.PI/2,false);shape.lineTo(-w/2+r,r);\n shape.absarc(-w/2+r,0,r,Math.PI/2,Math.PI*1.5,false);\n // 平面中心线固定竖直法向，避免压扁截面沿弯管扭转\n const frames={tangents:[],normals:[],binormals:[]},steps=100;\n for(let i=0;i<=steps;i++){const t=curve.getTangentAt(i/steps),b=new THREE.Vector3(0,1,0);frames.tangents.push(t);frames.normals.push(b.clone().cross(t).normalize());frames.binormals.push(b);}\n const original=curve.computeFrenetFrames;curve.computeFrenetFrames=()=>frames;\n const geo=new THREE.ExtrudeGeometry(shape,{steps,bevelEnabled:false,extrudePath:curve,curveSegments:8});\n curve.computeFrenetFrames=original;g.add(new THREE.Mesh(geo,material('#b87333')));\n}\nconst finCount=Math.floor(P.finWidth/(P.finThick+P.finGap));\nconst matrix=new THREE.Matrix4();\nfor(let side=0;side<2;side++){\n const suffix=side?'right':'left',x=side?P.fanX:-P.fanX;\n const hp=part('hp_'+suffix,(side?'右':'左')+'压扁热管','热管','烧结铜管输热至后侧翅片；两管并联');\n heatPipe(hp,hpCurves[side]);\n const fins=part('fins_'+suffix,(side?'右':'左')+'铜翅片组','翅片组','薄铜片扩大空气侧换热面积');\n const inst=new THREE.InstancedMesh(new THREE.BoxGeometry(P.finThick,P.finHeight,P.finDepth),material('#b87333'),finCount);\n for(let i=0;i<finCount;i++){matrix.makeTranslation(x-P.finWidth/2+P.finThick/2+i*(P.finThick+P.finGap),P.bottom+P.finHeight/2,P.finZ);inst.setMatrixAt(i,matrix);}\n inst.instanceMatrix.needsUpdate=true;inst.computeBoundingSphere();fins.add(inst);\n const fan=part('fan_'+suffix,(side?'右':'左')+'离心风扇','风扇','底部吸气，转轴侧排气；转速随工况变化');\n const ring=new THREE.Mesh(new THREE.CylinderGeometry(P.fanDiameter/2,P.fanDiameter/2,P.fanHeight,64,1,true),material('#2b2b2b',0));\n ring.position.set(x,P.bottom+P.fanHeight/2,P.fanZ);fan.add(ring);\n cylinder(fan,P.fanDiameter/2,.35,[x,P.bottom+.175,P.fanZ],'#2b2b2b');\n const rotor=new THREE.Group();rotor.position.set(x,5.5,P.fanZ);fan.add(rotor);rotors.push(rotor);\n cylinder(rotor,7,4,[0,0,0],'#2b2b2b');\n for(let j=0;j<P.bladeCount;j++){\n const a=j/P.bladeCount*Math.PI*2,b=box(rotor,[1,4,13],[Math.sin(a)*15,0,Math.cos(a)*15],'#43464c',0);b.rotation.y=a+.4;\n }\n}\npart('graphite','D壳内侧石墨片','石墨片','铺展机身热量；进风区域预留开口');\nconst graphiteShape=new THREE.Shape();\nconst gw=P.graphite[0]/2,gd=P.graphite[2]/2;\ngraphiteShape.moveTo(-gw,-gd);graphiteShape.lineTo(gw,-gd);graphiteShape.lineTo(gw,gd);graphiteShape.lineTo(-gw,gd);graphiteShape.closePath();\nfor(const x of [-P.fanX,P.fanX]){const hole=new THREE.Path();hole.absarc(x,P.fanZ,P.fanDiameter/2,0,Math.PI*2,true);graphiteShape.holes.push(hole);}\nconst graphiteGeo=new THREE.ExtrudeGeometry(graphiteShape,{depth:P.graphite[1],bevelEnabled:false,curveSegments:48});\ngraphiteGeo.rotateX(Math.PI/2);graphiteGeo.translate(0,P.graphiteY+P.graphite[1]/2,0);\nparts.graphite.add(new THREE.Mesh(graphiteGeo,material('#333438',0)));\npart('chassis','透明轻薄本机身','配套部件','素材仅用于整机定位，不作为目标厚度校核');\nfunction makeMarker(h){\n const g=parts[h.id],bounds=new THREE.Box3().setFromObject(g,true);\n const center=bounds.isEmpty()?new THREE.Vector3(137,15,60):bounds.getCenter(new THREE.Vector3());\n const c=document.createElement('canvas');c.width=c.height=64;const ctx=c.getContext('2d');\n ctx.fillStyle='white';ctx.strokeStyle='#b11f4b';ctx.lineWidth=1;ctx.beginPath();ctx.arc(32,32,27,0,Math.PI*2);ctx.fill();ctx.stroke();\n ctx.fillStyle='#352b30';ctx.font='bold 26px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(h.n,32,33);\n const s=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),depthTest:false}));\n s.position.copy(center);s.position.y=(bounds.isEmpty()?15:bounds.max.y)+7+(h.n%3)*3;s.scale.set(10,10,1);s.userData.id=h.id;s.renderOrder=10;g.add(s);markers.push(s);\n}\nhotspots.forEach(makeMarker);\nfor(const loop of P.loops){\n const curve=new THREE.CatmullRomCurve3(loop.points.map(p=>new THREE.Vector3(...p)),loop.closed,'centripetal');\n const tube=new THREE.Mesh(new THREE.TubeGeometry(curve,80,loop.radius,8,loop.closed),new THREE.MeshStandardMaterial({color:loop.color,transparent:true,opacity:.16,depthWrite:false,metalness:0,roughness:.6}));\n tube.name=loop.id;modelGroup.add(tube);\n const count=loop.id.startsWith('air')?P.particleCount:30;\n const particles=new THREE.InstancedMesh(new THREE.SphereGeometry(loop.id.startsWith('air')?.85:.5,8,6),material(loop.color,0),count);\n modelGroup.add(particles);flows.push({loop,curve,tube,particles,count,t:0});\n}\nfunction compute(m){\n const q=m.cpu+m.gpu,cfm=2*P.fanCfm*m.rpm/P.referenceRpm,qv=cfm*P.cfmToM3s;\n const area=2*finCount*2*P.finDepth*P.finHeight/1e6,h=P.hBase+P.hRpm*m.rpm;\n const dt=q/(P.airDensity*P.airCp*qv),rf=1/(h*area),rp=P.rHp/P.hpCount;\n const rc=P.rTimCpu+P.rVc+rp,total=rc+rf;\n const tc=P.ambient+.5*dt+q*rf+m.cpu*rc,tg=P.ambient+.5*dt+q*rf+m.gpu*(P.rTimGpu+P.rVc+rp);\n const outer=(hpWidth-P.hpHeight)*P.hpHeight+Math.PI*P.hpHeight**2/4;\n const ih=P.hpHeight-2*P.hpWall,iw=hpWidth-2*P.hpWall;\n const inner=(iw-ih)*ih+Math.PI*ih**2/4;\n const hpVolume=(outer-inner)*hpCurves.reduce((sum,c)=>sum+c.getLength(),0);\n const copperVolume=P.vc.reduce((a,b)=>a*b,1)*P.vcSolidFraction+2*finCount*P.finThick*P.finDepth*P.finHeight+hpVolume;\n const graphiteArea=P.graphite[0]*P.graphite[2]-2*Math.PI*(P.fanDiameter/2)**2;\n const mass=copperVolume/1000*P.copperDensity+2*P.fanMass+P.hardwareMass+graphiteArea*P.graphite[1]/1000*P.graphiteDensity;\n const noise=P.noiseBase+P.noiseSlope*Math.log10(m.rpm/P.noiseRef);\n const note='集总参数估算，以页面实时计算为准';\n const values=[q.toFixed(0),cfm.toFixed(2),(area*1e4).toFixed(2),total.toFixed(3),tc.toFixed(1),mass.toFixed(1)];\n const labels=['散热功率','总风量','翅片换热面积','总热阻','CPU 预估结温','模组质量'],units=['W','CFM','cm²','K/W','℃','g'];\n window.__metrics=labels.map((label,i)=>({label,value:values[i],unit:units[i],note}));\n $('loads').textContent=`${m.label} ${m.rpm} rpm · CPU/GPU ${m.cpu}/${m.gpu} W · ${cfm.toFixed(2)} CFM`;\n $('thermal').textContent=`面积 ${(area*1e4).toFixed(2)} cm² · 空气升温 ${dt.toFixed(1)} K · 出口 ${(P.ambient+dt).toFixed(1)}℃`;\n $('temps').textContent=`CPU ${tc.toFixed(1)}℃ / GPU ${tg.toFixed(1)}℃${Math.max(tc,tg)>P.tempLimit?' · 触发功耗墙':''}`;\n $('temps').style.color=Math.max(tc,tg)>P.tempLimit?'#dc2626':'#222';\n $('mass').textContent=`质量 ${mass.toFixed(1)} g · 噪声 ${noise.toFixed(1)} dBA（经验式）`;\n $('chain').textContent=`热阻 CPU/GPU TIM .02/.06 + VC .08 + 管 .025 + 翅片 ${rf.toFixed(3)} = CPU ${total.toFixed(3)} K/W`;\n P.loops.slice(0,2).forEach(l=>l.flow_lpm=qv*60000/2);\n window.__engineering={...m,airRise:dt,gpuTemperature:tg,noise,heatPipeLength:hpCurves.reduce((s,c)=>s+c.getLength(),0),mass,finCount};\n return window.__metrics;\n}\nconst stages=[\n {title:'芯片导热',text:'界面材料把芯片热量传到均热板。',ids:['cpu','gpu','tim_cpu','tim_gpu','vc'],loops:['heat_cpu','heat_gpu']},\n {title:'均热板 / 热管扩散',text:'相变工质摊开热量并沿热管输送至两侧。',ids:['vc','hp_left','hp_right'],loops:['heat_cpu','heat_gpu']},\n {title:'翅片对流',text:'底部冷空气穿过铜翅片，吸收热量升温。',ids:['fins_left','fins_right'],loops:['airflow_left','airflow_right']},\n {title:'风扇排出',text:'两台风扇驱动热空气从转轴侧排出。',ids:['fan_left','fan_right','fins_left','fins_right'],loops:['airflow_left','airflow_right']}\n];\nfunction styleParts(){\n for(const [id,g] of Object.entries(parts))g.traverse(o=>{\n if(!o.isMesh)return;const m=o.material;if(!m||Array.isArray(m))return;\n if(m.userData.opacity===undefined){m.userData.opacity=m.opacity;m.userData.transparent=m.transparent;m.userData.depthWrite=m.depthWrite;}\n const active=focused?id===focused:stages[stageIndex].ids.includes(id);\n m.opacity=focused?(active?m.userData.opacity:.25):m.userData.opacity;\n m.transparent=m.userData.transparent||!!focused;m.depthWrite=focused&&!active?false:m.userData.depthWrite;\n m.emissive.set(active?'#b11f4b':id.startsWith('fan_')?'#0f766e':'#000000');\n m.emissiveIntensity=active?.25:id.startsWith('fan_')?.15*mode.rpm/P.referenceRpm:0;\n if(id==='cpu'||id==='gpu')m.color.set(mode===P.modes.performance?'#dc493b':'#1f4e79');\n if(id==='chassis'&&m.map){m.emissive.set('#ffffff');m.emissiveIntensity=.6;}\n });\n flows.forEach(f=>{const active=stages[stageIndex].loops.includes(f.loop.id);f.tube.material.opacity=active?.25:.06;f.particles.material.transparent=true;f.particles.material.opacity=active?1:.2;});\n}\nconst globalBox=new THREE.Box3(new THREE.Vector3(-150,0,-110),new THREE.Vector3(150,14.5,110));\nglobalBox.union(new THREE.Box3().setFromObject(modelGroup,true));\nconst homeTarget=globalBox.getCenter(new THREE.Vector3()),homePosition=new THREE.Vector3();\nfunction fitHome(){\n const size=globalBox.getSize(new THREE.Vector3()),fov=THREE.MathUtils.degToRad(camera.fov);\n const distance=size.length()/(2*Math.tan(fov/2)*Math.min(1,camera.aspect))/.70;\n homePosition.copy(homeTarget).add(new THREE.Vector3(1,.7,1.2).normalize().multiplyScalar(distance));\n camera.position.copy(homePosition);controls.target.copy(homeTarget);controls.update();\n}\nfitHome();\nwindow.__hotspots=hotspots;\nwindow.__stages=stages.map(({title,text})=>({title,text}));\nwindow.__focus=id=>{\n if(id!==null&&!parts[id])return;focused=id;controls.autoRotate=false;\n let target=homeTarget.clone(),position=homePosition.clone();\n if(id){const b=new THREE.Box3().setFromObject(parts[id],true);target=b.getCenter(new THREE.Vector3());const s=b.getSize(new THREE.Vector3());\n position=target.clone().add(camera.position.clone().sub(controls.target).normalize().multiplyScalar(Math.max(s.x,s.y,s.z,18)*2.5));}\n flight={start:performance.now(),from:camera.position.clone(),to:position,targetFrom:controls.target.clone(),targetTo:target};styleParts();\n};\nwindow.__setStage=i=>{\n if(!Number.isInteger(i)||i<0||i>=stages.length)return;\n stageIndex=i;stageTime=0;$('stage').textContent=`阶段 ${i+1}/${stages.length} · ${stages[i].title}：${stages[i].text}`;styleParts();\n if(typeof window.__notifyStage==='function')window.__notifyStage(i);\n};\ndocument.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>{\n mode=P.modes[b.dataset.mode];compute(mode);styleParts();\n document.querySelectorAll('[data-mode]').forEach(e=>e.classList.toggle('active',e===b));\n});\ndocument.querySelector('[data-mode=\"quiet\"]').classList.add('active');\n$('pause').onclick=()=>{paused=!paused;$('pause').textContent=paused?'继续':'暂停';};\n$('rotate').onclick=()=>controls.autoRotate=!controls.autoRotate;\n$('reset').onclick=()=>window.__focus(null);\nconst clipPlane=new THREE.Plane(new THREE.Vector3(0,-1,0),7);\n$('cut').onclick=()=>{cut=!cut;modelGroup.traverse(o=>{if(o.isMesh)o.material.clippingPlanes=cut?[clipPlane]:[];});$('cut').textContent=cut?'完整视图':'剖切视图';};\n$('explode').onclick=()=>{\n exploded=!exploded;for(const [id,g] of Object.entries(parts)){\n const y=id==='vc'?24:id.startsWith('hp_')?34:id.startsWith('tim_')?13:id.startsWith('fan_')?17:id.startsWith('fins_')?10:0;\n g.position.y=exploded?y:0;}\n flows.forEach(f=>{f.tube.visible=!exploded;f.particles.visible=!exploded;});\n $('explode').textContent=exploded?'装配视图':'爆炸视图';\n};\n$('shell').onclick=()=>{transparent=!transparent;baseMeshes.forEach(m=>{\n m.material.opacity=transparent?.28:1;m.material.transparent=transparent;m.material.depthWrite=!transparent;\n Object.assign(m.material.userData,{opacity:m.material.opacity,transparent,depthWrite:!transparent});});styleParts();$('shell').textContent=transparent?'机身实体':'机身透明';};\nconst raycaster=new THREE.Raycaster(),pointer=new THREE.Vector2();let down=null;\nrenderer.domElement.addEventListener('pointerdown',e=>down=[e.clientX,e.clientY]);\nrenderer.domElement.addEventListener('pointerup',e=>{\n if(!down||Math.hypot(e.clientX-down[0],e.clientY-down[1])>5)return;\n pointer.set(e.clientX/innerWidth*2-1,-e.clientY/innerHeight*2+1);raycaster.setFromCamera(pointer,camera);\n const hit=raycaster.intersectObjects(markers)[0];if(hit)window.__focus(hit.object.userData.id);\n});\nrenderer.domElement.addEventListener('dblclick',()=>window.__focus(null));\ncompute(mode);window.__setStage(0);\nwindow.__scene=scene;window.__camera=camera;window.__renderer=renderer;window.__controls=controls;window.__model=modelGroup;\nfunction planarUV(g){\n g.computeBoundingBox();const b=g.boundingBox,s=b.getSize(new THREE.Vector3()),axes=['x','y','z'].sort((a,c)=>s[c]-s[a]);\n const pos=g.attributes.position,uv=new Float32Array(pos.count*2),v=new THREE.Vector3();\n for(let i=0;i<pos.count;i++){v.fromBufferAttribute(pos,i);for(let j=0;j<2;j++)uv[2*i+j]=(v[axes[j]]-b.min[axes[j]])/(s[axes[j]]||1);}\n g.setAttribute('uv',new THREE.BufferAttribute(uv,2));\n}\nfunction wallpaper(){\n const c=document.createElement('canvas');c.width=768;c.height=512;const x=c.getContext('2d');\n const gradient=x.createLinearGradient(0,0,768,512);gradient.addColorStop(0,'#0b1a3a');gradient.addColorStop(1,'#1e3a8a');x.fillStyle=gradient;x.fillRect(0,0,768,512);\n [[240,210,240,'rgba(56,189,248,.75)'],[530,250,220,'rgba(232,121,249,.55)'],[430,420,170,'rgba(250,204,21,.35)']].forEach(([a,b,r,col])=>{\n const g=x.createRadialGradient(a,b,0,a,b,r);g.addColorStop(0,col);g.addColorStop(1,'rgba(0,0,0,0)');x.fillStyle=g;x.fillRect(0,0,768,512);});\n const tex=new THREE.CanvasTexture(c);tex.colorSpace=THREE.SRGBColorSpace;return tex;\n}\nnew GLTFLoader().load('/static/assets/notebook/laptop14_open.glb',gltf=>{\n try{\n const tex=wallpaper();gltf.scene.traverse(o=>{\n if(!o.isMesh)return;let n=o.name.toLowerCase(),p=o.parent;\n while(!/^(base|lid|keys|touchpad|screen|hinge_|feet)/.test(n)&&p){n=p.name.toLowerCase();p=p.parent;}\n let m=material('#cfd0cc');m.roughness=.32;\n if(n.startsWith('keys')){m=material('#2a2b2e',.1);m.roughness=.55;}\n if(n.startsWith('touchpad')){m=material('#dcdcd8',.3);m.roughness=.25;}\n if(n.startsWith('hinge_')||n.startsWith('feet'))m=material('#1c1c1e',0);\n if(n.startsWith('screen')){o.geometry=o.geometry.clone();planarUV(o.geometry);m=new THREE.MeshStandardMaterial({map:tex,emissiveMap:tex,emissive:'#ffffff',emissiveIntensity:.6,roughness:.2,metalness:0});}\n if(n.startsWith('base')){m.transparent=transparent;m.opacity=transparent?.28:1;m.depthWrite=!transparent;m.side=THREE.DoubleSide;baseMeshes.push(o);}\n o.material=m;m.clippingPlanes=cut?[clipPlane]:[];\n });parts.chassis.add(gltf.scene);styleParts();\n }catch(e){showError(e.message);}\n},undefined,()=>{\n const fallback=box(parts.chassis,[P.space[0],P.targetThickness,P.space[1]],[0,P.targetThickness/2,0],'#cfd0cc');\n Object.assign(fallback.material,{transparent:true,opacity:.28,depthWrite:false,side:THREE.DoubleSide});baseMeshes.push(fallback);\n $('hint').textContent='机身素材加载失败：已用透明包络替代；厚度非模组。';styleParts();\n});\nconst clock=new THREE.Clock(),cold=new THREE.Color('#38bdf8'),hot=new THREE.Color('#dc2626');\nfunction animate(){\n requestAnimationFrame(animate);const dt=Math.min(clock.getDelta(),.05);\n if(!paused){stageTime+=dt;if(stageTime>=P.stageSeconds)window.__setStage((stageIndex+1)%stages.length);}\n rotors.forEach((r,i)=>r.rotation.y+=(i?-1:1)*dt*mode.rpm/P.referenceRpm*18);\n for(const f of flows){\n const air=f.loop.id.startsWith('air');f.t=(f.t+dt*(air?.23*mode.rpm/P.referenceRpm:.055))%1;\n for(let i=0;i<f.count;i++){\n const t=(f.t+i/f.count)%1,pos=f.curve.getPointAt(t);matrix.makeTranslation(pos.x,pos.y,pos.z);f.particles.setMatrixAt(i,matrix);\n f.particles.setColorAt(i,air?cold.clone().lerp(hot,THREE.MathUtils.smoothstep(t,.62,.96)):new THREE.Color('#f97316'));\n }\n f.particles.instanceMatrix.needsUpdate=true;f.particles.instanceColor.needsUpdate=true;f.particles.computeBoundingSphere();\n }\n if(flight){const t=Math.min((performance.now()-flight.start)/600,1),u=t*t*(3-2*t);\n camera.position.lerpVectors(flight.from,flight.to,u);controls.target.lerpVectors(flight.targetFrom,flight.targetTo,u);if(t===1)flight=null;}\n controls.update();renderer.render(scene,camera);\n}\nwindow.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);if(!focused)fitHome();});\nanimate();\n}catch(error){showError(error.message);}\n</script>\n</body>\n</html>", "metrics": [{"label": "散热功率", "value": "63", "unit": "W", "note": "集总参数估算，以页面实时计算为准"}, {"label": "总风量", "value": "2.60", "unit": "CFM", "note": "集总参数估算，以页面实时计算为准"}, {"label": "翅片换热面积", "value": "478.80", "unit": "cm²", "note": "集总参数估算，以页面实时计算为准"}, {"label": "总热阻", "value": "0.455", "unit": "K/W", "note": "集总参数估算，以页面实时计算为准"}, {"label": "CPU 预估结温", "value": "71.3", "unit": "℃", "note": "集总参数估算，以页面实时计算为准"}, {"label": "模组质量", "value": "106.4", "unit": "g", "note": "集总参数估算，以页面实时计算为准"}], "suggestions": ["对比三种工况并导出热阻与温度表", "加入风扇曲线及格栅阻力修正风量", "校核热管翅片连接与模组高度干涉"], "raw": "<<<SUMMARY>>>\n已构建双风扇散热系统，包含双热源、界面材料、铜均热板、压扁热管、铜翅片、石墨片及透明机身，并提供工况切换、气流动画、编号热点和分阶段讲解。几何为示意比例，模组按高度约束堆叠；机身素材外形与目标厚度存在差异。温度与噪声采用集总参数估算，非 CFD；安静及均衡采用功耗墙，质量含热管壳体但不含工质，结果以页面实时计算为准。\n<<<HTML>>>\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>轻薄本双风扇散热系统</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;left:12px;top:12px;max-width:300px;padding:12px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;line-height:1.65}\nh3{margin:0 0 5px;font-size:14px}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover,button.active{border-color:#b11f4b}\n#buttons{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}\n#err{position:absolute;top:45%;left:15%;right:15%;color:#b91c1c;text-align:center;background:#fff}\n#hint{color:#7c5962;font-size:11px}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h3>双风扇散热模组 · 系统装配</h3>\n<div>空间 300×200 · 高度≤9 mm · 目标机厚15.9</div>\n<div id=\"loads\"></div>\n<div id=\"thermal\"></div>\n<div id=\"temps\"></div>\n<div id=\"mass\"></div>\n<div id=\"chain\"></div>\n<div>铜色：铜件　深灰：风扇／石墨　蓝：电子件</div>\n<div>天蓝→红：气流　橙色：导热方向（示意）</div>\n<div id=\"stage\"></div>\n<div id=\"hint\">拖动观察；点击编号聚焦；双击空白恢复</div>\n<div id=\"buttons\">\n<button data-mode=\"quiet\">安静</button><button data-mode=\"balanced\">均衡</button><button data-mode=\"performance\">性能</button>\n<button id=\"cut\">剖切视图</button><button id=\"explode\">爆炸视图</button><button id=\"rotate\">自动旋转</button>\n<button id=\"shell\">机身实体</button><button id=\"pause\">暂停</button><button id=\"reset\">全局</button>\n</div>\n</div>\n<div id=\"err\" hidden></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nimport { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nconst P = {\n // 尺寸mm；密度g/cm³；热阻K/W；默认安静模式\n space:[300,200],targetThickness:15.9,heightLimit:9,bottom:2,\n vc:[130,.6,85],vcCenter:[0,6.3,-42.5],cpu:[40,1.8,30],gpu:[29,1.8,29],\n cpuCenter:[-28,5,-48],gpuCenter:[30,5,-48],timThickness:.1,\n finWidth:60,finDepth:10,finHeight:9,finThick:.10,finGap:.35,finZ:-95,\n fanDiameter:48,fanHeight:7,fanX:100,fanZ:-65,bladeCount:28,\n hpDiameter:6,hpHeight:2,hpWall:.3,hpCount:2,hpY:7.8,\n graphite:[280,.1,180],graphiteY:2.05,copperDensity:8.96,graphiteDensity:2.1,\n fanMass:22,hardwareMass:15,vcSolidFraction:.5,\n ambient:25,airDensity:1.16,airCp:1005,cfmToM3s:4.72e-4,fanCfm:2.6,referenceRpm:5600,\n hBase:45,hRpm:.0065,rTimCpu:.02,rTimGpu:.06,rVc:.08,rHp:.05,\n noiseBase:18,noiseSlope:28,noiseRef:1000,tempLimit:95,\n modes:{quiet:{label:'安静',rpm:2800,cpu:28,gpu:35},\n balanced:{label:'均衡',rpm:4200,cpu:28,gpu:35},\n performance:{label:'性能',rpm:5600,cpu:45,gpu:60}},\n hpPaths:[\n [[-42,7.8,-45],[-62,7.8,-58],[-66,7.8,-79],[-82,7.8,-91],[-120,7.8,-91]],\n [[42,7.8,-45],[62,7.8,-58],[66,7.8,-79],[82,7.8,-91],[120,7.8,-91]]],\n // radius为可视化导风轮廓半径；空气不是封闭液路\n loops:[\n {id:'airflow_left',label:'左侧气流',color:'#38bdf8',radius:2.5,flow_lpm:0,closed:false,points:[[-100,-4,-53],[-100,1,-58],[-100,6,-65],[-100,7,-82],[-100,7,-96],[-100,8,-112]]},\n {id:'airflow_right',label:'右侧气流',color:'#38bdf8',radius:2.5,flow_lpm:0,closed:false,points:[[100,-4,-53],[100,1,-58],[100,6,-65],[100,7,-82],[100,7,-96],[100,8,-112]]},\n {id:'heat_cpu',label:'CPU导热',color:'#f97316',radius:.65,flow_lpm:0,closed:false,points:[[-28,5,-48],[-28,6.3,-48],[-42,7.8,-45],[-62,7.8,-58],[-66,7.8,-79],[-82,7.8,-91],[-120,7.8,-91]]},\n {id:'heat_gpu',label:'GPU导热',color:'#f97316',radius:.65,flow_lpm:0,closed:false,points:[[30,5,-48],[30,6.3,-48],[42,7.8,-45],[62,7.8,-58],[66,7.8,-79],[82,7.8,-91],[120,7.8,-91]]}],\n particleCount:36,stageSeconds:5\n};\nconst showError = message => {const el=document.getElementById('err');el.hidden=false;el.textContent='模型错误：'+message;};\nwindow.addEventListener('error',e=>showError(e.message));\ntry {\nconst $=id=>document.getElementById(id);\nconst scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\nconst renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.localClippingEnabled=true;\ndocument.body.prepend(renderer.domElement);\nconst pmrem=new THREE.PMREMGenerator(renderer);\nscene.environment=pmrem.fromScene(new RoomEnvironment(),.04).texture;\nscene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\nconst light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(120,300,160);scene.add(light);\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\nconst controls=new OrbitControls(camera,renderer.domElement);\ncontrols.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1;\ncontrols.addEventListener('start',()=>{controls.autoRotate=false;flight=null;});\nconst modelGroup=new THREE.Group();scene.add(modelGroup);\nconst parts={},markers=[],rotors=[],flows=[],baseMeshes=[];\nlet mode=P.modes.quiet,stageIndex=0,paused=false,stageTime=0,focused=null,exploded=false,cut=false,transparent=true,flight=null;\nconst material=(color,metal=.85)=>new THREE.MeshStandardMaterial({color,metalness:metal,roughness:metal? .35:.6});\nfunction part(id,label,type,note){\n const g=new THREE.Group();g.name=id;parts[id]=g;modelGroup.add(g);\n hotspots.push({id,n:hotspots.length+1,label,part:type,note});return g;\n}\nconst hotspots=[];\nfunction box(g,size,pos,color,metal=.85){\n const m=new THREE.Mesh(new THREE.BoxGeometry(...size),material(color,metal));m.position.set(...pos);g.add(m);return m;\n}\nfunction cylinder(g,r,h,pos,color){\n const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,48),material(color,0));m.position.set(...pos);g.add(m);return m;\n}\npart('cpu','CPU封装','热源','性能模式施加CPU满载功耗');\npart('gpu','独显GPU封装','热源','性能模式施加GPU满载功耗');\nbox(parts.cpu,P.cpu,P.cpuCenter,'#1f4e79',0);box(parts.gpu,P.gpu,P.gpuCenter,'#1f4e79',0);\npart('tim_cpu','液态金属界面','导热界面材料','降低CPU到均热板的接触热阻');\npart('tim_gpu','导热膏界面','导热界面材料','填充GPU与均热板接触间隙');\nbox(parts.tim_cpu,[P.cpu[0],P.timThickness,P.cpu[2]],[-28,5.95,-48],'#9aa3ab');\nbox(parts.tim_gpu,[P.gpu[0],P.timThickness,P.gpu[2]],[30,5.95,-48],'#b9b5ae',0);\npart('vc','铜均热板','均热板','相变扩散双热源热量；按半实心计质量');\nbox(parts.vc,P.vc,P.vcCenter,'#b87333');\nconst hpCurves=P.hpPaths.map(points=>new THREE.CatmullRomCurve3(points.map(p=>new THREE.Vector3(...p)),false,'centripetal'));\nconst hpWidth=(Math.PI*P.hpDiameter-(Math.PI-2)*P.hpHeight)/2;\nfunction heatPipe(g,curve){\n const shape=new THREE.Shape(),w=hpWidth,h=P.hpHeight,r=h/2;\n shape.moveTo(-w/2+r,-r);shape.lineTo(w/2-r,-r);\n shape.absarc(w/2-r,0,r,-Math.PI/2,Math.PI/2,false);shape.lineTo(-w/2+r,r);\n shape.absarc(-w/2+r,0,r,Math.PI/2,Math.PI*1.5,false);\n // 平面中心线固定竖直法向，避免压扁截面沿弯管扭转\n const frames={tangents:[],normals:[],binormals:[]},steps=100;\n for(let i=0;i<=steps;i++){const t=curve.getTangentAt(i/steps),b=new THREE.Vector3(0,1,0);frames.tangents.push(t);frames.normals.push(b.clone().cross(t).normalize());frames.binormals.push(b);}\n const original=curve.computeFrenetFrames;curve.computeFrenetFrames=()=>frames;\n const geo=new THREE.ExtrudeGeometry(shape,{steps,bevelEnabled:false,extrudePath:curve,curveSegments:8});\n curve.computeFrenetFrames=original;g.add(new THREE.Mesh(geo,material('#b87333')));\n}\nconst finCount=Math.floor(P.finWidth/(P.finThick+P.finGap));\nconst matrix=new THREE.Matrix4();\nfor(let side=0;side<2;side++){\n const suffix=side?'right':'left',x=side?P.fanX:-P.fanX;\n const hp=part('hp_'+suffix,(side?'右':'左')+'压扁热管','热管','烧结铜管输热至后侧翅片；两管并联');\n heatPipe(hp,hpCurves[side]);\n const fins=part('fins_'+suffix,(side?'右':'左')+'铜翅片组','翅片组','薄铜片扩大空气侧换热面积');\n const inst=new THREE.InstancedMesh(new THREE.BoxGeometry(P.finThick,P.finHeight,P.finDepth),material('#b87333'),finCount);\n for(let i=0;i<finCount;i++){matrix.makeTranslation(x-P.finWidth/2+P.finThick/2+i*(P.finThick+P.finGap),P.bottom+P.finHeight/2,P.finZ);inst.setMatrixAt(i,matrix);}\n inst.instanceMatrix.needsUpdate=true;inst.computeBoundingSphere();fins.add(inst);\n const fan=part('fan_'+suffix,(side?'右':'左')+'离心风扇','风扇','底部吸气，转轴侧排气；转速随工况变化');\n const ring=new THREE.Mesh(new THREE.CylinderGeometry(P.fanDiameter/2,P.fanDiameter/2,P.fanHeight,64,1,true),material('#2b2b2b',0));\n ring.position.set(x,P.bottom+P.fanHeight/2,P.fanZ);fan.add(ring);\n cylinder(fan,P.fanDiameter/2,.35,[x,P.bottom+.175,P.fanZ],'#2b2b2b');\n const rotor=new THREE.Group();rotor.position.set(x,5.5,P.fanZ);fan.add(rotor);rotors.push(rotor);\n cylinder(rotor,7,4,[0,0,0],'#2b2b2b');\n for(let j=0;j<P.bladeCount;j++){\n const a=j/P.bladeCount*Math.PI*2,b=box(rotor,[1,4,13],[Math.sin(a)*15,0,Math.cos(a)*15],'#43464c',0);b.rotation.y=a+.4;\n }\n}\npart('graphite','D壳内侧石墨片','石墨片','铺展机身热量；进风区域预留开口');\nconst graphiteShape=new THREE.Shape();\nconst gw=P.graphite[0]/2,gd=P.graphite[2]/2;\ngraphiteShape.moveTo(-gw,-gd);graphiteShape.lineTo(gw,-gd);graphiteShape.lineTo(gw,gd);graphiteShape.lineTo(-gw,gd);graphiteShape.closePath();\nfor(const x of [-P.fanX,P.fanX]){const hole=new THREE.Path();hole.absarc(x,P.fanZ,P.fanDiameter/2,0,Math.PI*2,true);graphiteShape.holes.push(hole);}\nconst graphiteGeo=new THREE.ExtrudeGeometry(graphiteShape,{depth:P.graphite[1],bevelEnabled:false,curveSegments:48});\ngraphiteGeo.rotateX(Math.PI/2);graphiteGeo.translate(0,P.graphiteY+P.graphite[1]/2,0);\nparts.graphite.add(new THREE.Mesh(graphiteGeo,material('#333438',0)));\npart('chassis','透明轻薄本机身','配套部件','素材仅用于整机定位，不作为目标厚度校核');\nfunction makeMarker(h){\n const g=parts[h.id],bounds=new THREE.Box3().setFromObject(g,true);\n const center=bounds.isEmpty()?new THREE.Vector3(137,15,60):bounds.getCenter(new THREE.Vector3());\n const c=document.createElement('canvas');c.width=c.height=64;const ctx=c.getContext('2d');\n ctx.fillStyle='white';ctx.strokeStyle='#b11f4b';ctx.lineWidth=1;ctx.beginPath();ctx.arc(32,32,27,0,Math.PI*2);ctx.fill();ctx.stroke();\n ctx.fillStyle='#352b30';ctx.font='bold 26px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(h.n,32,33);\n const s=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),depthTest:false}));\n s.position.copy(center);s.position.y=(bounds.isEmpty()?15:bounds.max.y)+7+(h.n%3)*3;s.scale.set(10,10,1);s.userData.id=h.id;s.renderOrder=10;g.add(s);markers.push(s);\n}\nhotspots.forEach(makeMarker);\nfor(const loop of P.loops){\n const curve=new THREE.CatmullRomCurve3(loop.points.map(p=>new THREE.Vector3(...p)),loop.closed,'centripetal');\n const tube=new THREE.Mesh(new THREE.TubeGeometry(curve,80,loop.radius,8,loop.closed),new THREE.MeshStandardMaterial({color:loop.color,transparent:true,opacity:.16,depthWrite:false,metalness:0,roughness:.6}));\n tube.name=loop.id;modelGroup.add(tube);\n const count=loop.id.startsWith('air')?P.particleCount:30;\n const particles=new THREE.InstancedMesh(new THREE.SphereGeometry(loop.id.startsWith('air')?.85:.5,8,6),material(loop.color,0),count);\n modelGroup.add(particles);flows.push({loop,curve,tube,particles,count,t:0});\n}\nfunction compute(m){\n const q=m.cpu+m.gpu,cfm=2*P.fanCfm*m.rpm/P.referenceRpm,qv=cfm*P.cfmToM3s;\n const area=2*finCount*2*P.finDepth*P.finHeight/1e6,h=P.hBase+P.hRpm*m.rpm;\n const dt=q/(P.airDensity*P.airCp*qv),rf=1/(h*area),rp=P.rHp/P.hpCount;\n const rc=P.rTimCpu+P.rVc+rp,total=rc+rf;\n const tc=P.ambient+.5*dt+q*rf+m.cpu*rc,tg=P.ambient+.5*dt+q*rf+m.gpu*(P.rTimGpu+P.rVc+rp);\n const outer=(hpWidth-P.hpHeight)*P.hpHeight+Math.PI*P.hpHeight**2/4;\n const ih=P.hpHeight-2*P.hpWall,iw=hpWidth-2*P.hpWall;\n const inner=(iw-ih)*ih+Math.PI*ih**2/4;\n const hpVolume=(outer-inner)*hpCurves.reduce((sum,c)=>sum+c.getLength(),0);\n const copperVolume=P.vc.reduce((a,b)=>a*b,1)*P.vcSolidFraction+2*finCount*P.finThick*P.finDepth*P.finHeight+hpVolume;\n const graphiteArea=P.graphite[0]*P.graphite[2]-2*Math.PI*(P.fanDiameter/2)**2;\n const mass=copperVolume/1000*P.copperDensity+2*P.fanMass+P.hardwareMass+graphiteArea*P.graphite[1]/1000*P.graphiteDensity;\n const noise=P.noiseBase+P.noiseSlope*Math.log10(m.rpm/P.noiseRef);\n const note='集总参数估算，以页面实时计算为准';\n const values=[q.toFixed(0),cfm.toFixed(2),(area*1e4).toFixed(2),total.toFixed(3),tc.toFixed(1),mass.toFixed(1)];\n const labels=['散热功率','总风量','翅片换热面积','总热阻','CPU 预估结温','模组质量'],units=['W','CFM','cm²','K/W','℃','g'];\n window.__metrics=labels.map((label,i)=>({label,value:values[i],unit:units[i],note}));\n $('loads').textContent=`${m.label} ${m.rpm} rpm · CPU/GPU ${m.cpu}/${m.gpu} W · ${cfm.toFixed(2)} CFM`;\n $('thermal').textContent=`面积 ${(area*1e4).toFixed(2)} cm² · 空气升温 ${dt.toFixed(1)} K · 出口 ${(P.ambient+dt).toFixed(1)}℃`;\n $('temps').textContent=`CPU ${tc.toFixed(1)}℃ / GPU ${tg.toFixed(1)}℃${Math.max(tc,tg)>P.tempLimit?' · 触发功耗墙':''}`;\n $('temps').style.color=Math.max(tc,tg)>P.tempLimit?'#dc2626':'#222';\n $('mass').textContent=`质量 ${mass.toFixed(1)} g · 噪声 ${noise.toFixed(1)} dBA（经验式）`;\n $('chain').textContent=`热阻 CPU/GPU TIM .02/.06 + VC .08 + 管 .025 + 翅片 ${rf.toFixed(3)} = CPU ${total.toFixed(3)} K/W`;\n P.loops.slice(0,2).forEach(l=>l.flow_lpm=qv*60000/2);\n window.__engineering={...m,airRise:dt,gpuTemperature:tg,noise,heatPipeLength:hpCurves.reduce((s,c)=>s+c.getLength(),0),mass,finCount};\n return window.__metrics;\n}\nconst stages=[\n {title:'芯片导热',text:'界面材料把芯片热量传到均热板。',ids:['cpu','gpu','tim_cpu','tim_gpu','vc'],loops:['heat_cpu','heat_gpu']},\n {title:'均热板 / 热管扩散',text:'相变工质摊开热量并沿热管输送至两侧。',ids:['vc','hp_left','hp_right'],loops:['heat_cpu','heat_gpu']},\n {title:'翅片对流',text:'底部冷空气穿过铜翅片，吸收热量升温。',ids:['fins_left','fins_right'],loops:['airflow_left','airflow_right']},\n {title:'风扇排出',text:'两台风扇驱动热空气从转轴侧排出。',ids:['fan_left','fan_right','fins_left','fins_right'],loops:['airflow_left','airflow_right']}\n];\nfunction styleParts(){\n for(const [id,g] of Object.entries(parts))g.traverse(o=>{\n if(!o.isMesh)return;const m=o.material;if(!m||Array.isArray(m))return;\n if(m.userData.opacity===undefined){m.userData.opacity=m.opacity;m.userData.transparent=m.transparent;m.userData.depthWrite=m.depthWrite;}\n const active=focused?id===focused:stages[stageIndex].ids.includes(id);\n m.opacity=focused?(active?m.userData.opacity:.25):m.userData.opacity;\n m.transparent=m.userData.transparent||!!focused;m.depthWrite=focused&&!active?false:m.userData.depthWrite;\n m.emissive.set(active?'#b11f4b':id.startsWith('fan_')?'#0f766e':'#000000');\n m.emissiveIntensity=active?.25:id.startsWith('fan_')?.15*mode.rpm/P.referenceRpm:0;\n if(id==='cpu'||id==='gpu')m.color.set(mode===P.modes.performance?'#dc493b':'#1f4e79');\n if(id==='chassis'&&m.map){m.emissive.set('#ffffff');m.emissiveIntensity=.6;}\n });\n flows.forEach(f=>{const active=stages[stageIndex].loops.includes(f.loop.id);f.tube.material.opacity=active?.25:.06;f.particles.material.transparent=true;f.particles.material.opacity=active?1:.2;});\n}\nconst globalBox=new THREE.Box3(new THREE.Vector3(-150,0,-110),new THREE.Vector3(150,14.5,110));\nglobalBox.union(new THREE.Box3().setFromObject(modelGroup,true));\nconst homeTarget=globalBox.getCenter(new THREE.Vector3()),homePosition=new THREE.Vector3();\nfunction fitHome(){\n const size=globalBox.getSize(new THREE.Vector3()),fov=THREE.MathUtils.degToRad(camera.fov);\n const distance=size.length()/(2*Math.tan(fov/2)*Math.min(1,camera.aspect))/.70;\n homePosition.copy(homeTarget).add(new THREE.Vector3(1,.7,1.2).normalize().multiplyScalar(distance));\n camera.position.copy(homePosition);controls.target.copy(homeTarget);controls.update();\n}\nfitHome();\nwindow.__hotspots=hotspots;\nwindow.__stages=stages.map(({title,text})=>({title,text}));\nwindow.__focus=id=>{\n if(id!==null&&!parts[id])return;focused=id;controls.autoRotate=false;\n let target=homeTarget.clone(),position=homePosition.clone();\n if(id){const b=new THREE.Box3().setFromObject(parts[id],true);target=b.getCenter(new THREE.Vector3(