{"ok": true, "summary": "已建立24根铝扁管微通道芯体，扁管与5750片简化平直翅片均采用实例化建模，同侧设置φ12进出口。管间距按中心距8 mm，翅片净高6.7 mm；集流管长208 mm。质量估算假设扁管10孔、外壁0.25 mm、隔筋0.2 mm，集流管及接管壁厚1 mm。面积为未扣接触面的几何毛面积，质量不含焊料。", "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>微通道换热器芯体</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%}\nbody{font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;left:12px;top:12px;max-width:300px;padding:12px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;line-height:1.8}\nh3{font-size:14px;margin:0 0 4px}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover{border-color:#b11f4b}\n.dot{display:inline-block;width:10px;height:10px;margin-right:5px;border-radius:2px}\n#buttons{display:flex;gap:4px;margin-top:7px}\n#error{display:none;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#b00020;background:white;padding:20px;z-index:9}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h3>微通道换热器芯体 · 铝制</h3>\n<div>24根扁管：300 × 16 × 1.3 mm</div>\n<div>管中心距8；翅片间距1.2 / 厚0.1 mm</div>\n<div>集流管φ20 × 208；同侧接管φ12 mm</div>\n<div id=\"areas\"></div>\n<div id=\"mass\"></div>\n<div>假设：10孔扁管；外壁0.25 / 筋0.2 mm</div>\n<div><span class=\"dot\" style=\"background:#c9ced6\"></span>铝：扁管、翅片、集流管与接管</div>\n<div><span class=\"dot\" style=\"background:#3b82f6\"></span>蓝色：微通道与集流腔示意</div>\n<div id=\"buttons\"><button id=\"cut\">剖切视图</button><button id=\"explode\">爆炸视图</button><button id=\"rotate\">自动旋转</button></div>\n</div>\n<div id=\"error\"></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nconst P = {\n  // 尺寸单位mm；管间距按中心距，翅片间距按节距\n  tubeCount:24,tubeLength:300,tubeWidth:16,tubeHeight:1.3,tubePitch:8,\n  tubeWall:0.25,web:0.2,ports:10,\n  finPitch:1.2,finThickness:0.1,\n  headerDiameter:20,headerLength:208,headerWall:1,capThickness:1,\n  nippleDiameter:12,nippleWall:1,nippleLength:30,nippleOffset:70,\n  // 密度g/cm³；不计焊料、连接开孔扣除与插入重叠\n  density:2.70,aluminum:'#c9ced6',fluid:'#3b82f6',\n  metalness:0.8,roughness:0.38,fluidOpacity:0.55,\n  radialSegments:48,explodeHeader:45,explodeFin:35\n};\nconst showError = message => {\n  const node=document.getElementById('error');\n  node.textContent='模型加载错误：'+message;\n  node.style.display='block';\n};\nwindow.addEventListener('error',e=>showError(e.message));\ntry {\n  const gap=P.tubePitch-P.tubeHeight;\n  const finColumns=Math.floor(P.tubeLength/P.finPitch);\n  const finCount=(P.tubeCount-1)*finColumns;\n  const innerH=P.tubeHeight-2*P.tubeWall;\n  const portW=(P.tubeWidth-2*P.tubeWall-(P.ports-1)*P.web)/P.ports;\n  const tubeSection=P.tubeWidth*P.tubeHeight-P.ports*portW*innerH;\n  const tubeVolume=tubeSection*P.tubeLength*P.tubeCount;\n  const finVolume=finCount*P.finThickness*gap*P.tubeWidth;\n  const r=P.headerDiameter/2,ri=r-P.headerWall;\n  const nr=P.nippleDiameter/2,ni=nr-P.nippleWall;\n  const headerVolume=2*Math.PI*((r*r-ri*ri)*(P.headerLength-2*P.capThickness)+2*r*r*P.capThickness);\n  const nippleVolume=2*Math.PI*(nr*nr-ni*ni)*P.nippleLength;\n  const mass=(tubeVolume+finVolume+headerVolume+nippleVolume)*P.density/1e6;\n  const tubeArea=2*(P.tubeWidth+P.tubeHeight)*P.tubeLength*P.tubeCount/1e6;\n  const finArea=2*finCount*gap*P.tubeWidth/1e6;\n  document.getElementById('areas').textContent=`管 / 翅片面积：${tubeArea.toFixed(5)} / ${finArea.toFixed(4)} m²`;\n  document.getElementById('mass').textContent=`总面积 ${(tubeArea+finArea).toFixed(5)} m² · 铝 ${mass.toFixed(3)} kg`;\n  const scene=new THREE.Scene();\n  scene.background=new THREE.Color('#f7f4ef');\n  const camera=new THREE.PerspectiveCamera(38,innerWidth/innerHeight,0.1,10000);\n  const renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\n  renderer.setPixelRatio(Math.min(devicePixelRatio,2));\n  renderer.setSize(innerWidth,innerHeight);\n  renderer.localClippingEnabled=true;\n  document.body.appendChild(renderer.domElement);\n  const controls=new OrbitControls(camera,renderer.domElement);\n  controls.enableDamping=true;\n  controls.autoRotate=true;\n  controls.autoRotateSpeed=1.2;\n  controls.addEventListener('start',()=>{controls.autoRotate=false;});\n  scene.add(new THREE.HemisphereLight(0xffffff,0x777d86,2));\n  const key=new THREE.DirectionalLight(0xffffff,3);\n  key.position.set(200,350,450);\n  scene.add(key);\n  const fill=new THREE.DirectionalLight(0xffffff,1.5);\n  fill.position.set(-300,60,-250);\n  scene.add(fill);\n  const model=new THREE.Group();\n  scene.add(model);\n  const aluminum=new THREE.MeshStandardMaterial({\n    color:P.aluminum,metalness:P.metalness,roughness:P.roughness,side:THREE.DoubleSide\n  });\n  const liquid=new THREE.MeshStandardMaterial({\n    color:P.fluid,metalness:0.6,roughness:0.4,\n    transparent:true,opacity:P.fluidOpacity,depthWrite:false\n  });\n  const tubeGroup=new THREE.Group();\n  const finGroup=new THREE.Group();\n  model.add(tubeGroup,finGroup);\n  // 二维截面挖出10个微孔，挤出后将长度轴转至X方向\n  const shape=new THREE.Shape();\n  const w=P.tubeWidth/2,h=P.tubeHeight/2;\n  shape.moveTo(-w,-h);shape.lineTo(w,-h);\n  shape.lineTo(w,h);shape.lineTo(-w,h);shape.closePath();\n  for(let j=0;j<P.ports;j++){\n    const a=-w+P.tubeWall+j*(portW+P.web);\n    const hole=new THREE.Path();\n    hole.moveTo(a,-innerH/2);hole.lineTo(a,innerH/2);\n    hole.lineTo(a+portW,innerH/2);hole.lineTo(a+portW,-innerH/2);\n    hole.closePath();shape.holes.push(hole);\n  }\n  const tubeGeo=new THREE.ExtrudeGeometry(shape,{depth:P.tubeLength,bevelEnabled:false,steps:1});\n  tubeGeo.translate(0,0,-P.tubeLength/2);\n  tubeGeo.rotateY(Math.PI/2);\n  const tubes=new THREE.InstancedMesh(tubeGeo,aluminum,P.tubeCount);\n  const channels=new THREE.InstancedMesh(new THREE.BoxGeometry(P.tubeLength,innerH,portW),liquid,P.tubeCount*P.ports);\n  const matrix=new THREE.Matrix4();\n  for(let i=0;i<P.tubeCount;i++){\n    const y=(i-(P.tubeCount-1)/2)*P.tubePitch;\n    tubes.setMatrixAt(i,matrix.makeTranslation(0,y,0));\n    for(let j=0;j<P.ports;j++){\n      const z=w-P.tubeWall-portW/2-j*(portW+P.web);\n      channels.setMatrixAt(i*P.ports+j,matrix.makeTranslation(0,y,z));\n    }\n  }\n  tubeGroup.add(tubes,channels);\n  const fins=new THREE.InstancedMesh(new THREE.BoxGeometry(P.finThickness,gap,P.tubeWidth),aluminum,finCount);\n  let index=0;\n  for(let row=0;row<P.tubeCount-1;row++){\n    const y=(row-(P.tubeCount-2)/2)*P.tubePitch;\n    for(let col=0;col<finColumns;col++){\n      const x=(col-(finColumns-1)/2)*P.finPitch;\n      fins.setMatrixAt(index++,matrix.makeTranslation(x,y,0));\n    }\n  }\n  finGroup.add(fins);\n  function ringGeometry(outer,inner,length){\n    const section=new THREE.Shape();\n    section.absarc(0,0,outer,0,Math.PI*2,false);\n    const hole=new THREE.Path();\n    hole.absarc(0,0,inner,0,Math.PI*2,true);\n    section.holes.push(hole);\n    const geometry=new THREE.ExtrudeGeometry(section,{\n      depth:length,bevelEnabled:false,curveSegments:P.radialSegments/2,steps:1\n    });\n    geometry.translate(0,0,-length/2);\n    return geometry;\n  }\n  const headers=[];\n  for(const side of [-1,1]){\n    const group=new THREE.Group();\n    group.position.x=side*(P.tubeLength/2+r);\n    model.add(group);headers.push(group);\n    const shell=new THREE.Mesh(ringGeometry(r,ri,P.headerLength-2*P.capThickness),aluminum);\n    shell.rotation.x=-Math.PI/2;group.add(shell);\n    for(const end of [-1,1]){\n      const cap=new THREE.Mesh(new THREE.CylinderGeometry(r,r,P.capThickness,P.radialSegments),aluminum);\n      cap.position.y=end*(P.headerLength-P.capThickness)/2;group.add(cap);\n    }\n    const cavity=new THREE.Mesh(new THREE.CylinderGeometry(ri,ri,P.headerLength-2*P.capThickness,P.radialSegments),liquid);\n    group.add(cavity);\n    if(side===-1){\n      for(const end of [-1,1]){\n        const nipple=new THREE.Mesh(ringGeometry(nr,ni,P.nippleLength),aluminum);\n        nipple.rotation.y=Math.PI/2;\n        nipple.position.set(-r-P.nippleLength/2,end*P.nippleOffset,0);\n        group.add(nipple);\n        const bore=new THREE.Mesh(new THREE.CylinderGeometry(ni,ni,P.nippleLength,P.radialSegments),liquid);\n        bore.rotation.z=Math.PI/2;bore.position.copy(nipple.position);group.add(bore);\n      }\n    }\n  }\n  const box=new THREE.Box3().setFromObject(model);\n  const size=box.getSize(new THREE.Vector3());\n  const center=box.getCenter(new THREE.Vector3());\n  const grid=new THREE.GridHelper(600,30,0xd9d5cf,0xe7e2da);\n  grid.position.y=box.min.y-8;scene.add(grid);\n  function fit(){\n    const radius=size.length()/2;\n    const angle=Math.min(camera.fov*Math.PI/360,Math.atan(Math.tan(camera.fov*Math.PI/360)*camera.aspect));\n    const distance=radius/Math.sin(angle)/0.70;\n    camera.position.copy(center).add(new THREE.Vector3(0.75,0.48,1).normalize().multiplyScalar(distance));\n    controls.target.copy(center);camera.updateProjectionMatrix();controls.update();\n  }\n  fit();\n  let cut=false,exploded=false;\n  const plane=new THREE.Plane(new THREE.Vector3(0,0,-1),0);\n  document.getElementById('cut').onclick=()=>{\n    cut=!cut;aluminum.clippingPlanes=cut?[plane]:[];\n    aluminum.needsUpdate=true;\n    document.getElementById('cut').textContent=cut?'完整视图':'剖切视图';\n  };\n  document.getElementById('explode').onclick=()=>{\n    exploded=!exploded;\n    headers.forEach((group,i)=>{group.position.x=(i===0?-1:1)*(P.tubeLength/2+r+(exploded?P.explodeHeader:0));});\n    finGroup.position.z=exploded?P.explodeFin:0;\n    document.getElementById('explode').textContent=exploded?'装配视图':'爆炸视图';\n  };\n  document.getElementById('rotate').onclick=()=>{controls.autoRotate=!controls.autoRotate;};\n  window.__scene=scene;window.__camera=camera;\n  window.__renderer=renderer;window.__controls=controls;window.__model=model;\n  window.addEventListener('resize',()=>{\n    camera.aspect=innerWidth/innerHeight;\n    renderer.setSize(innerWidth,innerHeight);fit();\n  });\n  renderer.setAnimationLoop(()=>{controls.update();renderer.render(scene,camera);});\n}catch(error){showError(error.message);}\n</script>\n</body>\n</html>", "metrics": [{"label": "扁管外表面积", "value": "0.24912", "unit": "m²", "note": "24×300×2×(16+1.3)，不含端面"}, {"label": "翅片面积", "value": "1.23280", "unit": "m²", "note": "5750片×双面×6.7×16，不计薄边"}, {"label": "总换热面积", "value": "1.48192", "unit": "m²", "note": "管与翅片毛面积之和，未扣接触面"}, {"label": "铝材质量", "value": "0.43311", "unit": "kg", "note": "密度2.70；含封盖接管，不含焊料"}, {"label": "简化翅片数量", "value": "5750", "unit": "片", "note": "23个管隙，每隙250片"}, {"label": "装配外形包络", "value": "370 × 208 × 20", "unit": "mm", "note": "含同侧30 mm接管，不含安装支架"}], "suggestions": ["将8 mm改为管净间距并比较面积质量", "改成真实百叶窗翅片并标注开窗参数", "增加集流管插槽与接管贯通孔"], "raw": "<<<SUMMARY>>>\n已建立24根铝扁管微通道芯体，扁管与5750片简化平直翅片均采用实例化建模，同侧设置φ12进出口。管间距按中心距8 mm，翅片净高6.7 mm；集流管长208 mm。质量估算假设扁管10孔、外壁0.25 mm、隔筋0.2 mm，集流管及接管壁厚1 mm。面积为未扣接触面的几何毛面积，质量不含焊料。\n<<<HTML>>>\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>微通道换热器芯体</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%}\nbody{font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;left:12px;top:12px;max-width:300px;padding:12px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;line-height:1.8}\nh3{font-size:14px;margin:0 0 4px}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover{border-color:#b11f4b}\n.dot{display:inline-block;width:10px;height:10px;margin-right:5px;border-radius:2px}\n#buttons{display:flex;gap:4px;margin-top:7px}\n#error{display:none;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#b00020;background:white;padding:20px;z-index:9}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h3>微通道换热器芯体 · 铝制</h3>\n<div>24根扁管：300 × 16 × 1.3 mm</div>\n<div>管中心距8；翅片间距1.2 / 厚0.1 mm</div>\n<div>集流管φ20 × 208；同侧接管φ12 mm</div>\n<div id=\"areas\"></div>\n<div id=\"mass\"></div>\n<div>假设：10孔扁管；外壁0.25 / 筋0.2 mm</div>\n<div><span class=\"dot\" style=\"background:#c9ced6\"></span>铝：扁管、翅片、集流管与接管</div>\n<div><span class=\"dot\" style=\"background:#3b82f6\"></span>蓝色：微通道与集流腔示意</div>\n<div id=\"buttons\"><button id=\"cut\">剖切视图</button><button id=\"explode\">爆炸视图</button><button id=\"rotate\">自动旋转</button></div>\n</div>\n<div id=\"error\"></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nconst P = {\n  // 尺寸单位mm；管间距按中心距，翅片间距按节距\n  tubeCount:24,tubeLength:300,tubeWidth:16,tubeHeight:1.3,tubePitch:8,\n  tubeWall:0.25,web:0.2,ports:10,\n  finPitch:1.2,finThickness:0.1,\n  headerDiameter:20,headerLength:208,headerWall:1,capThickness:1,\n  nippleDiameter:12,nippleWall:1,nippleLength:30,nippleOffset:70,\n  // 密度g/cm³；不计焊料、连接开孔扣除与插入重叠\n  density:2.70,aluminum:'#c9ced6',fluid:'#3b82f6',\n  metalness:0.8,roughness:0.38,fluidOpacity:0.55,\n  radialSegments:48,explodeHeader:45,explodeFin:35\n};\nconst showError = message => {\n  const node=document.getElementById('error');\n  node.textContent='模型加载错误：'+message;\n  node.style.display='block';\n};\nwindow.addEventListener('error',e=>showError(e.message));\ntry {\n  const gap=P.tubePitch-P.tubeHeight;\n  const finColumns=Math.floor(P.tubeLength/P.finPitch);\n  const finCount=(P.tubeCount-1)*finColumns;\n  const innerH=P.tubeHeight-2*P.tubeWall;\n  const portW=(P.tubeWidth-2*P.tubeWall-(P.ports-1)*P.web)/P.ports;\n  const tubeSection=P.tubeWidth*P.tubeHeight-P.ports*portW*innerH;\n  const tubeVolume=tubeSection*P.tubeLength*P.tubeCount;\n  const finVolume=finCount*P.finThickness*gap*P.tubeWidth;\n  const r=P.headerDiameter/2,ri=r-P.headerWall;\n  const nr=P.nippleDiameter/2,ni=nr-P.nippleWall;\n  const headerVolume=2*Math.PI*((r*r-ri*ri)*(P.headerLength-2*P.capThickness)+2*r*r*P.capThickness);\n  const nippleVolume=2*Math.PI*(nr*nr-ni*ni)*P.nippleLength;\n  const mass=(tubeVolume+finVolume+headerVolume+nippleVolume)*P.density/1e6;\n  const tubeArea=2*(P.tubeWidth+P.tubeHeight)*P.tubeLength*P.tubeCount/1e6;\n  const finArea=2*finCount*gap*P.tubeWidth/1e6;\n  document.getElementById('areas').textContent=`管 / 翅片面积：${tubeArea.toFixed(5)} / ${finArea.toFixed(4)} m²`;\n  document.getElementById('mass').textContent=`总面积 ${(tubeArea+finArea).toFixed(5)} m² · 铝 ${mass.toFixed(3)} kg`;\n  const scene=new THREE.Scene();\n  scene.background=new THREE.Color('#f7f4ef');\n  const camera=new THREE.PerspectiveCamera(38,innerWidth/innerHeight,0.1,10000);\n  const renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\n  renderer.setPixelRatio(Math.min(devicePixelRatio,2));\n  renderer.setSize(innerWidth,innerHeight);\n  renderer.localClippingEnabled=true;\n  document.body.appendChild(renderer.domElement);\n  const controls=new OrbitControls(camera,renderer.domElement);\n  controls.enableDamping=true;\n  controls.autoRotate=true;\n  controls.autoRotateSpeed=1.2;\n  controls.addEventListener('start',()=>{controls.autoRotate=false;});\n  scene.add(new THREE.HemisphereLight(0xffffff,0x777d86,2));\n  const key=new THREE.DirectionalLight(0xffffff,3);\n  key.position.set(200,350,450);\n  scene.add(key);\n  const fill=new THREE.DirectionalLight(0xffffff,1.5);\n  fill.position.set(-300,60,-250);\n  scene.add(fill);\n  const model=new THREE.Group();\n  scene.add(model);\n  const aluminum=new THREE.MeshStandardMaterial({\n    color:P.aluminum,metalness:P.metalness,roughness:P.roughness,side:THREE.DoubleSide\n  });\n  const liquid=new THREE.MeshStandardMaterial({\n    color:P.fluid,metalness:0.6,roughness:0.4,\n    transparent:true,opacity:P.fluidOpacity,depthWrite:false\n  });\n  const tubeGroup=new THREE.Group();\n  const finGroup=new THREE.Group();\n  model.add(tubeGroup,finGroup);\n  // 二维截面挖出10个微孔，挤出后将长度轴转至X方向\n  const shape=new THREE.Shape();\n  const w=P.tubeWidth/2,h=P.tubeHeight/2;\n  shape.moveTo(-w,-h);shape.lineTo(w,-h);\n  shape.lineTo(w,h);shape.lineTo(-w,h);shape.closePath();\n  for(let j=0;j<P.ports;j++){\n    const a=-w+P.tubeWall+j*(portW+P.web);\n    const hole=new THREE.Path();\n    hole.moveTo(a,-innerH/2);hole.lineTo(a,innerH/2);\n    hole.lineTo(a+portW,innerH/2);hole.lineTo(a+portW,-innerH/2);\n    hole.closePath();shape.holes.push(hole);\n  }\n  const tubeGeo=new THREE.ExtrudeGeometry(shape,{depth:P.tubeLength,bevelEnabled:false,steps:1});\n  tubeGeo.translate(0,0,-P.tubeLength/2);\n  tubeGeo.rotateY(Math.PI/2);\n  const tubes=new THREE.InstancedMesh(tubeGeo,aluminum,P.tubeCount);\n  const channels=new THREE.InstancedMesh(new THREE.BoxGeometry(P.tubeLength,innerH,portW),liquid,P.tubeCount*P.ports);\n  const matrix=new THREE.Matrix4();\n  for(let i=0;i<P.tubeCount;i++){\n    const y=(i-(P.tubeCount-1)/2)*P.tubePitch;\n    tubes.setMatrixAt(i,matrix.makeTranslation(0,y,0));\n    for(let j=0;j<P.ports;j++){\n      const z=w-P.tubeWall-portW/2-j*(portW+P.web);\n      channels.setMatrixAt(i*P.ports+j,matrix.makeTranslation(0,y,z));\n    }\n  }\n  tubeGroup.add(tubes,channels);\n  const fins=new THREE.InstancedMesh(new THREE.BoxGeometry(P.finThickness,gap,P.tubeWidth),aluminum,finCount);\n  let index=0;\n  for(let row=0;row<P.tubeCount-1;row++){\n    const y=(row-(P.tubeCount-2)/2)*P.tubePitch;\n    for(let col=0;col<finColumns;col++){\n      const x=(col-(finColumns-1)/2)*P.finPitch;\n      fins.setMatrixAt(index++,matrix.makeTranslation(x,y,0));\n    }\n  }\n  finGroup.add(fins);\n  function ringGeometry(outer,inner,length){\n    const section=new THREE.Shape();\n    section.absarc(0,0,outer,0,Math.PI*2,false);\n    const hole=new THREE.Path();\n    hole.absarc(0,0,inner,0,Math.PI*2,true);\n    section.holes.push(hole);\n    const geometry=new THREE.ExtrudeGeometry(section,{\n      depth:length,bevelEnabled:false,curveSegments:P.radialSegments/2,steps:1\n    });\n    geometry.translate(0,0,-length/2);\n    return geometry;\n  }\n  const headers=[];\n  for(const side of [-1,1]){\n    const group=new THREE.Group();\n    group.position.x=side*(P.tubeLength/2+r);\n    model.add(group);headers.push(group);\n    const shell=new THREE.Mesh(ringGeometry(r,ri,P.headerLength-2*P.capThickness),aluminum);\n    shell.rotation.x=-Math.PI/2;group.add(shell);\n    for(const end of [-1,1]){\n      const cap=new THREE.Mesh(new THREE.CylinderGeometry(r,r,P.capThickness,P.radialSegments),aluminum);\n      cap.position.y=end*(P.headerLength-P.capThickness)/2;group.add(cap);\n    }\n    const cavity=new THREE.Mesh(new THREE.CylinderGeometry(ri,ri,P.headerLength-2*P.capThickness,P.radialSegments),liquid);\n    group.add(cavity);\n    if(side===-1){\n      for(const end of [-1,1]){\n        const nipple=new THREE.Mesh(ringGeometry(nr,ni,P.nippleLength),aluminum);\n        nipple.rotation.y=Math.PI/2;\n        nipple.position.set(-r-P.nippleLength/2,end*P.nippleOffset,0);\n        group.add(nipple);\n        const bore=new THREE.Mesh(new THREE.CylinderGeometry(ni,ni,P.nippleLength,P.radialSegments),liquid);\n        bore.rotation.z=Math.PI/2;bore.position.copy(nipple.position);group.add(bore);\n      }\n    }\n  }\n  const box=new THREE.Box3().setFromObject(model);\n  const size=box.getSize(new THREE.Vector3());\n  const center=box.getCenter(new THREE.Vector3());\n  const grid=new THREE.GridHelper(600,30,0xd9d5cf,0xe7e2da);\n  grid.position.y=box.min.y-8;scene.add(grid);\n  function fit(){\n    const radius=size.length()/2;\n    const angle=Math.min(camera.fov*Math.PI/360,Math.atan(Math.tan(camera.fov*Math.PI/360)*camera.aspect));\n    const distance=radius/Math.sin(angle)/0.70;\n    camera.position.copy(center).add(new THREE.Vector3(0.75,0.48,1).normalize().multiplyScalar(distance));\n    controls.target.copy(center);camera.updateProjectionMatrix();controls.update();\n  }\n  fit();\n  let cut=false,exploded=false;\n  const plane=new THREE.Plane(new THREE.Vector3(0,0,-1),0);\n  document.getElementById('cut').onclick=()=>{\n    cut=!cut;aluminum.clippingPlanes=cut?[plane]:[];\n    aluminum.needsUpdate=true;\n    document.getElementById('cut').textContent=cut?'完整视图':'剖切视图';\n  };\n  document.getElementById('explode').onclick=()=>{\n    exploded=!exploded;\n    headers.forEach((group,i)=>{group.position.x=(i===0?-1:1)*(P.tubeLength/2+r+(exploded?P.explodeHeader:0));});\n    finGroup.position.z=exploded?P.explodeFin:0;\n    document.getElementById('explode').textContent=exploded?'装配视图':'爆炸视图';\n  };\n  document.getElementById('rotate').onclick=()=>{controls.autoRotate=!controls.autoRotate;};\n  window.__scene=scene;window.__camera=camera;\n  window.__renderer=renderer;window.__controls=controls;window.__model=model;\n  window.addEventListener('resize',()=>{\n    camera.aspect=innerWidth/innerHeight;\n    renderer.setSize(innerWidth,innerHeight);fit();\n  });\n  renderer.setAnimationLoop(()=>{controls.update();renderer.render(scene,camera);});\n}catch(error){showError(error.message);}\n</script>\n</body>\n</html>\n<<<METRICS>>>\n[\n  {\"label\":\"扁管外表面积\",\"value\":\"0.24912\",\"unit\":\"m²\",\"note\":\"24×300×2×(16+1.3)，不含端面\"},\n  {\"label\":\"翅片面积\",\"value\":\"1.23280\",\"unit\":\"m²\",\"note\":\"5750片×双面×6.7×16，不计薄边\"},\n  {\"label\":\"总换热面积\",\"value\":\"1.48192\",\"unit\":\"m²\",\"note\":\"管与翅片毛面积之和，未扣接触面\"},\n  {\"label\":\"铝材质量\",\"value\":\"0.43311\",\"unit\":\"kg\",\"note\":\"密度2.70；含封盖接管，不含焊料\"},\n  {\"label\":\"简化翅片数量\",\"value\":\"5750\",\"unit\":\"片\",\"note\":\"23个管隙，每隙250片\"},\n  {\"label\":\"装配外形包络\",\"value\":\"370 × 208 × 20\",\"unit\":\"mm\",\"note\":\