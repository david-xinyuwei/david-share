{"ok": true, "summary": "建立三线装配车间交互式三维甘特图，按真实班次暂停并续做，交期由工作小时折算。AI采用交期优先、能力约束及完工最早分配；同族插队须经剩余订单试排确认不新增迟到。相比按接单顺序排产，可避免急单被长单占线；是否节省换型以页面对比为准，不保证所有指标同时最优。假设首单无需换型，后续同族也需准备，换型占用生产日历。", "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>电子膨胀阀装配 APS 排程</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n.panel{position:absolute;top:12px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;padding:10px;font-size:12px;line-height:1.7;max-width:300px}\n#info{left:12px}#detail{right:12px;width:290px;max-height:45%;overflow:auto}\nh3{font-size:14px;margin:0 0 5px}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover{border-color:#b11f4b}\ntable{border-collapse:collapse;width:100%;font-size:11px}\nth,td{text-align:left;padding:3px;border-bottom:1px solid #eee}\n#foot{position:absolute;bottom:10px;left:12px;right:12px;padding:7px;background:#ffffffe0;font-size:12px;border-radius:6px}\n#error{display:none;position:absolute;top:45%;left:10%;width:80%;color:#b91c1c;background:white;padding:16px;z-index:20;text-align:center}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"info\" class=\"panel\">\n<h3 id=\"title\">装配车间 · AI 排程</h3>\n<div id=\"k0\"></div><div id=\"k1\"></div><div id=\"k2\"></div><div id=\"k3\"></div><div id=\"k4\"></div>\n<div><span style=\"color:#2563eb\">■ A族</span>　<span style=\"color:#15803d\">■ B族</span>　<span style=\"color:#d97706\">■ C族</span></div>\n<div>灰：换型/停线　红帽：迟到　紫柱：交期</div>\n<div><button id=\"mode\">AI 排程 / 经验排法</button> <button id=\"details\">显示 / 隐藏明细</button> <button id=\"view\">俯视 / 透视</button></div>\n</div>\n<div id=\"detail\" class=\"panel\"></div>\n<div id=\"foot\">拖动旋转，滚轮缩放；条块按休息拆段，同一订单只计一次。时间从周一08:00起算。</div>\n<div id=\"error\"></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nconst P = {\n  // 时间为日历小时；尺寸为mm，初始无在制品、无需首单换型\n  lines:[{id:'L1',families:['A','B','C']},{id:'L2',families:['A','B','C']},{id:'L3',families:['C']}],\n  orders:[\n    {id:'O01',family:'A',hours:8,due:56},{id:'O02',family:'B',hours:7,due:60},\n    {id:'O03',family:'C',hours:9,due:64},{id:'O04',family:'A',hours:6,due:48},\n    {id:'O05',family:'B',hours:5,due:52},{id:'O06',family:'C',hours:6,due:44},\n    {id:'O07',family:'B',hours:4,due:22},{id:'O08',family:'A',hours:5,due:26},\n    {id:'O09',family:'C',hours:6,due:30},{id:'O10',family:'A',hours:4,due:12},\n    {id:'O11',family:'B',hours:3,due:14},{id:'O12',family:'A',hours:5,due:20}\n  ],\n  change:{A:{A:.5,B:2,C:2},B:{A:2,B:.5,C:2},C:{A:2,B:2,C:.5}},\n  calendar:{day:24,originHour:8,windows:[[0,4],[4.5,12],[12.5,16]]},\n  size:{timeScale:10,rowPitch:70,rowWidth:40,barHeight:14,setupHeight:6,cap:3,dueRadius:1,dueHeight:24,tick:8,labelWidth:65,labelHeight:13},\n  colors:{A:'#2563eb',B:'#15803d',C:'#d97706',setup:'#9aa3ab',late:'#dc2626',due:'#b11f4b'},\n  material:{metalness:.1,roughness:.7,stopOpacity:.18},\n  eps:1e-8\n};\nfunction showError(message){\n  const el=document.getElementById('error');el.style.display='block';el.textContent='排程/渲染错误：'+message;\n}\nwindow.addEventListener('error',e=>showError(e.message));\ntry{\n  // 逐段推进生产及换型，返回可用时间片，不跨休息连续计时\n  function workSegments(t,h){\n    const pieces=[];let left=h,cursor=t;\n    while(left>P.eps){\n      const day=Math.floor(cursor/P.calendar.day);let advanced=false;\n      for(const [a,b] of P.calendar.windows){\n        const start=Math.max(cursor,day*24+a),limit=day*24+b;\n        if(start<limit-P.eps){\n          const take=Math.min(left,limit-start);\n          pieces.push([start,start+take]);left-=take;cursor=start+take;advanced=true;\n          if(left<=P.eps)break;\n        }\n      }\n      if(left>P.eps)cursor=(day+1)*24;\n      if(!advanced && left<=P.eps)break;\n    }\n    return pieces;\n  }\n  function addWorkHours(t,h){const parts=workSegments(t,h);return parts.length?parts.at(-1)[1]:t;}\n  function available(t){\n    let sum=0;\n    for(let d=0;d*24<t;d++)for(const [a,b] of P.calendar.windows)sum+=Math.max(0,Math.min(t,d*24+b)-(d*24+a));\n    return sum;\n  }\n  const orders=P.orders.map(o=>({...o,deadline:addWorkHours(0,o.due)}));\n  const edd=(a,b)=>a.deadline-b.deadline||a.id.localeCompare(b.id);\n  function emptyState(){return P.lines.map(()=>({free:0,last:null}));}\n  function option(order,i,state){\n    const prev=state[i],setup=prev.last?P.change[prev.last][order.family]:0;\n    const prep=workSegments(prev.free,setup),ready=addWorkHours(prev.free,setup);\n    const parts=workSegments(ready,order.hours),end=addWorkHours(ready,order.hours);\n    return {order,line:i,setup,prep,parts,start:parts[0][0],end,late:end>order.deadline+P.eps};\n  }\n  function best(order,state,ai){\n    const choices=P.lines.map((l,i)=>l.families.includes(order.family)?option(order,i,state):null).filter(Boolean);\n    choices.sort((a,b)=>ai?(a.end-b.end||a.line-b.line):(state[a.line].free-state[b.line].free||a.line-b.line));\n    return choices[0];\n  }\n  function commit(job,state){state[job.line]={free:job.end,last:job.order.family};}\n  function simulate(list,initial){\n    const state=initial.map(s=>({...s})),jobs=[];\n    for(const order of [...list].sort(edd)){const job=best(order,state,true);jobs.push(job);commit(job,state);}\n    return jobs;\n  }\n  function schedule(ai){\n    const pending=[...orders].sort(ai?edd:(a,b)=>a.id.localeCompare(b.id)),state=emptyState(),jobs=[];\n    while(pending.length){\n      let chosen=best(pending[0],state,ai);\n      if(ai && pending.length>1){\n        // 仅在省换型且不使原本准时订单变迟时允许同族插队\n        const baseline=simulate(pending,state),baseMap=new Map(baseline.map(j=>[j.order.id,j]));\n        const baseSetup=baseline.reduce((s,j)=>s+j.setup,0),candidates=[];\n        for(let k=1;k<pending.length;k++){\n          const candidate=best(pending[k],state,true);\n          if(state[candidate.line].last!==candidate.order.family)continue;\n          const trialState=state.map(s=>({...s}));commit(candidate,trialState);\n          const trial=[candidate,...simulate(pending.filter(o=>o.id!==candidate.order.id),trialState)];\n          const safe=trial.every(j=>!j.late||baseMap.get(j.order.id).late);\n          const saving=baseSetup-trial.reduce((s,j)=>s+j.setup,0);\n          if(safe && saving>P.eps)candidates.push({candidate,saving});\n        }\n        candidates.sort((a,b)=>b.saving-a.saving||edd(a.candidate.order,b.candidate.order));\n        if(candidates.length)chosen=candidates[0].candidate;\n      }\n      jobs.push(chosen);commit(chosen,state);pending.splice(pending.findIndex(o=>o.id===chosen.order.id),1);\n    }\n    const makespan=Math.max(...jobs.map(j=>j.end)),capacity=available(makespan);\n    const late=jobs.filter(j=>j.late).length,setup=jobs.reduce((s,j)=>s+j.setup,0);\n    const util=P.lines.map((_,i)=>100*jobs.filter(j=>j.line===i).reduce((s,j)=>s+j.order.hours,0)/capacity);\n    return {jobs,makespan,late,setup,rate:100*(jobs.length-late)/jobs.length,util,average:util.reduce((a,b)=>a+b,0)/util.length,capacity};\n  }\n  let aiResult=schedule(true),baseResult=schedule(false),isAI=true,topView=false;\n  const f=n=>n.toFixed(1);\n  function updateMetrics(){\n    const a=aiResult,b=baseResult,note='以页面内实时计算为准';\n    window.__metrics=[\n      {label:'总完工时间 AI/经验',value:f(a.makespan)+' / '+f(b.makespan),unit:'h',note},\n      {label:'准时率 AI/经验',value:f(a.rate)+' / '+f(b.rate),unit:'%',note},\n      {label:'迟到订单 AI/经验',value:a.late+' / '+b.late,unit:'单',note},\n      {label:'换型时间 AI/经验',value:f(a.setup)+' / '+f(b.setup),unit:'h',note},\n      {label:'平均利用率 AI/经验',value:f(a.average)+' / '+f(b.average),unit:'%',note},\n      {label:'各线利用率 AI',value:a.util.map((v,i)=>P.lines[i].id+' '+f(v)).join(' / '),unit:'%',note}\n    ];\n  }\n  const renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\n  renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);\n  document.body.prepend(renderer.domElement);\n  const scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\n  scene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\n  const light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(300,600,400);scene.add(light);\n  const camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\n  const controls=new OrbitControls(camera,renderer.domElement);\n  controls.enableDamping=true;controls.autoRotate=false;controls.autoRotateSpeed=1;\n  controls.addEventListener('start',()=>controls.autoRotate=false);\n  const modelGroup=new THREE.Group();scene.add(modelGroup);\n  Object.assign(window,{__scene:scene,__camera:camera,__renderer:renderer,__controls:controls,__model:modelGroup});\n  const S=P.size;\n  function material(color,transparent=false){\n    return new THREE.MeshStandardMaterial({color,...{metalness:P.material.metalness,roughness:P.material.roughness},transparent,opacity:transparent?P.material.stopOpacity:1,depthWrite:!transparent});\n  }\n  function box(w,h,d,x,y,z,color,transparent=false){\n    const mesh=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material(color,transparent));\n    mesh.position.set(x,y,z);modelGroup.add(mesh);return mesh;\n  }\n  function label(text,x,y,z,width=S.labelWidth){\n    const canvas=document.createElement('canvas');canvas.width=512;canvas.height=96;\n    const ctx=canvas.getContext('2d');ctx.fillStyle='#243449';ctx.font='32px \"Segoe UI\",sans-serif';\n    ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(text,256,48);\n    const texture=new THREE.CanvasTexture(canvas);\n    const sprite=new THREE.Sprite(new THREE.SpriteMaterial({map:texture,depthTest:false,transparent:true}));\n    sprite.position.set(x,y,z);sprite.scale.set(width,S.labelHeight,1);modelGroup.add(sprite);\n  }\n  function stamp(t){\n    const total=Math.round((t+P.calendar.originHour)*60),day=Math.floor(total/1440)+1;\n    return 'D'+day+' '+String(Math.floor(total%1440/60)).padStart(2,'0')+':'+String(total%60).padStart(2,'0');\n  }\n  function fit(){\n    const bounds=new THREE.Box3().setFromObject(modelGroup,true),size=bounds.getSize(new THREE.Vector3()),center=bounds.getCenter(new THREE.Vector3());\n    const direction=topView?new THREE.Vector3(0,1,.001):new THREE.Vector3(.05,.75,1).normalize();\n    const distance=Math.max(size.x/camera.aspect,size.z,size.y)*.5/Math.tan(THREE.MathUtils.degToRad(20))/.8+size.z*.6;\n    camera.up.set(0,1,0);camera.position.copy(center).addScaledVector(direction,distance);\n    controls.target.copy(center);camera.lookAt(center);controls.update();\n  }\n  function clear(){\n    modelGroup.traverse(o=>{o.geometry?.dispose();if(o.material){o.material.map?.dispose();o.material.dispose();}});\n    modelGroup.clear();\n  }\n  function draw(){\n    updateMetrics();clear();const result=isAI?aiResult:baseResult;\n    const horizon=Math.ceil(Math.max(aiResult.makespan,baseResult.makespan,...orders.map(o=>o.deadline))/S.tick)*S.tick;\n    const depth=(P.lines.length-1)*S.rowPitch+S.rowWidth;\n    for(let i=0;i<P.lines.length;i++){\n      box(horizon*S.timeScale,1,S.rowWidth,horizon*S.timeScale/2,-1,i*S.rowPitch,'#e6e4df');\n      label(P.lines[i].id,-30,8,i*S.rowPitch,32);\n    }\n    for(let t=0;t<=horizon;t+=S.tick){\n      box(.5,.5,depth+10,t*S.timeScale,0,S.rowPitch,'#cbd0d5');\n      label(stamp(t),t*S.timeScale,0,depth-5,70);\n    }\n    for(let d=0;d*24<horizon;d++){\n      for(const [a,b] of [[4,4.5],[12,12.5],[16,24]]){\n        const start=d*24+a,end=Math.min(d*24+b,horizon);\n        if(end>start)box((end-start)*S.timeScale,32,depth,(start+end)*S.timeScale/2,15,S.rowPitch,'#333333',true);\n      }\n    }\n    for(const job of result.jobs){\n      const z=job.line*S.rowPitch,c=P.colors[job.order.family];\n      for(const [a,b] of job.prep)box((b-a)*S.timeScale,S.setupHeight,S.rowWidth,(a+b)*S.timeScale/2,S.setupHeight/2,z,P.colors.setup);\n      for(const [a,b] of job.parts){\n        box((b-a)*S.timeScale,S.barHeight,S.rowWidth,(a+b)*S.timeScale/2,S.barHeight/2,z,c);\n        if(job.late)box((b-a)*S.timeScale,S.cap,S.rowWidth,(a+b)*S.timeScale/2,S.barHeight+S.cap/2,z,P.colors.late);\n      }\n      const longest=job.parts.reduce((a,b)=>b[1]-b[0]>a[1]-a[0]?b:a);\n      label(job.order.id,(longest[0]+longest[1])*S.timeScale/2,24,z,32);\n      const pole=new THREE.Mesh(new THREE.CylinderGeometry(S.dueRadius,S.dueRadius,S.dueHeight,8),material(P.colors.due));\n      pole.position.set(job.order.deadline*S.timeScale,S.dueHeight/2,z+S.rowWidth/2-2);modelGroup.add(pole);\n    }\n    document.getElementById('title').textContent='装配车间 · '+(isAI?'AI 排程':'老师傅经验排法');\n    const keys=['总完工时间','准时率','迟到订单','换型时间','平均利用率'];\n    keys.forEach((key,i)=>document.getElementById('k'+i).textContent=key+'（AI / 经验）：'+window.__metrics[i].value+' '+window.__metrics[i].unit);\n    document.getElementById('detail').innerHTML='<b>当前排程明细 · '+(isAI?'AI':'经验')+'</b><table><tr><th>订单/族</th><th>线体</th><th>开始</th><th>结束</th><th>迟到</th></tr>'+\n      [...result.jobs].sort((a,b)=>a.line-b.line||a.start-b.start).map(j=>'<tr><td>'+j.order.id+'/'+j.order.family+'</td><td>'+P.lines[j.line].id+'</td><td>'+stamp(j.start)+'</td><td>'+stamp(j.end)+'</td><td style=\"color:'+(j.late?'#dc2626':'#15803d')+'\">'+(j.late?'是':'否')+'</td></tr>').join('')+'</table><div>生产利用率：'+result.util.map((u,i)=>P.lines[i].id+' '+f(u)+'%').join(' · ')+'</div><div>分母：总完工前每线可用 '+f(result.capacity)+' h；不含休息，分子不含换型。</div>';\n    document.getElementById('foot').textContent='EDD＋安全同族插队＋完工最早；非全局最优。首单换型0h；明细开始为生产开始。X轴10mm/h，D1为周一；交期紫柱可能超出完工时间。拖动旋转 / 滚轮缩放。';\n    fit();\n  }\n  document.getElementById('mode').onclick=()=>{try{isAI=!isAI;aiResult=schedule(true);baseResult=schedule(false);draw();}catch(e){showError(e.message);}};\n  document.getElementById('details').onclick=()=>{const el=document.getElementById('detail');el.hidden=!el.hidden;};\n  document.getElementById('view').onclick=()=>{topView=!topView;fit();};\n  window.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);fit();});\n  draw();\n  renderer.setAnimationLoop(()=>{controls.update();renderer.render(scene,camera);});\n}catch(error){showError(error.message);}\n</script>\n</body>\n</html>", "metrics": [{"label": "总完工时间 AI/经验", "value": "39.0 / 40.0", "unit": "h", "note": "以页面内实时计算为准"}, {"label": "准时率 AI/经验", "value": "100.0 / 75.0", "unit": "%", "note": "以页面内实时计算为准"}, {"label": "迟到订单 AI/经验", "value": "0 / 3", "unit": "单", "note": "以页面内实时计算为准"}, {"label": "换型时间 AI/经验", "value": "7.5 / 10.5", "unit": "h", "note": "以页面内实时计算为准"}, {"label": "平均利用率 AI/经验", "value": "78.2 / 75.6", "unit": "%", "note": "以页面内实时计算为准"}, {"label": "各线利用率 AI", "value": "L1 82.8 / L2 79.3 / L3 72.4", "unit": "%", "note": "以页面内实时计算为准"}], "suggestions": ["增加逐单分配理由和同族插队记录", "模拟L2周一晚班故障后的重排", "对比交期优先与换型最少两种策略"], "raw": "<<<SUMMARY>>>\n建立三线装配车间交互式三维甘特图，按真实班次暂停并续做，交期由工作小时折算。AI采用交期优先、能力约束及完工最早分配；同族插队须经剩余订单试排确认不新增迟到。相比按接单顺序排产，可避免急单被长单占线；是否节省换型以页面对比为准，不保证所有指标同时最优。假设首单无需换型，后续同族也需准备，换型占用生产日历。\n<<<HTML>>>\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>电子膨胀阀装配 APS 排程</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n.panel{position:absolute;top:12px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;padding:10px;font-size:12px;line-height:1.7;max-width:300px}\n#info{left:12px}#detail{right:12px;width:290px;max-height:45%;overflow:auto}\nh3{font-size:14px;margin:0 0 5px}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover{border-color:#b11f4b}\ntable{border-collapse:collapse;width:100%;font-size:11px}\nth,td{text-align:left;padding:3px;border-bottom:1px solid #eee}\n#foot{position:absolute;bottom:10px;left:12px;right:12px;padding:7px;background:#ffffffe0;font-size:12px;border-radius:6px}\n#error{display:none;position:absolute;top:45%;left:10%;width:80%;color:#b91c1c;background:white;padding:16px;z-index:20;text-align:center}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"info\" class=\"panel\">\n<h3 id=\"title\">装配车间 · AI 排程</h3>\n<div id=\"k0\"></div><div id=\"k1\"></div><div id=\"k2\"></div><div id=\"k3\"></div><div id=\"k4\"></div>\n<div><span style=\"color:#2563eb\">■ A族</span>　<span style=\"color:#15803d\">■ B族</span>　<span style=\"color:#d97706\">■ C族</span></div>\n<div>灰：换型/停线　红帽：迟到　紫柱：交期</div>\n<div><button id=\"mode\">AI 排程 / 经验排法</button> <button id=\"details\">显示 / 隐藏明细</button> <button id=\"view\">俯视 / 透视</button></div>\n</div>\n<div id=\"detail\" class=\"panel\"></div>\n<div id=\"foot\">拖动旋转，滚轮缩放；条块按休息拆段，同一订单只计一次。时间从周一08:00起算。</div>\n<div id=\"error\"></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nconst P = {\n  // 时间为日历小时；尺寸为mm，初始无在制品、无需首单换型\n  lines:[{id:'L1',families:['A','B','C']},{id:'L2',families:['A','B','C']},{id:'L3',families:['C']}],\n  orders:[\n    {id:'O01',family:'A',hours:8,due:56},{id:'O02',family:'B',hours:7,due:60},\n    {id:'O03',family:'C',hours:9,due:64},{id:'O04',family:'A',hours:6,due:48},\n    {id:'O05',family:'B',hours:5,due:52},{id:'O06',family:'C',hours:6,due:44},\n    {id:'O07',family:'B',hours:4,due:22},{id:'O08',family:'A',hours:5,due:26},\n    {id:'O09',family:'C',hours:6,due:30},{id:'O10',family:'A',hours:4,due:12},\n    {id:'O11',family:'B',hours:3,due:14},{id:'O12',family:'A',hours:5,due:20}\n  ],\n  change:{A:{A:.5,B:2,C:2},B:{A:2,B:.5,C:2},C:{A:2,B:2,C:.5}},\n  calendar:{day:24,originHour:8,windows:[[0,4],[4.5,12],[12.5,16]]},\n  size:{timeScale:10,rowPitch:70,rowWidth:40,barHeight:14,setupHeight:6,cap:3,dueRadius:1,dueHeight:24,tick:8,labelWidth:65,labelHeight:13},\n  colors:{A:'#2563eb',B:'#15803d',C:'#d97706',setup:'#9aa3ab',late:'#dc2626',due:'#b11f4b'},\n  material:{metalness:.1,roughness:.7,stopOpacity:.18},\n  eps:1e-8\n};\nfunction showError(message){\n  const el=document.getElementById('error');el.style.display='block';el.textContent='排程/渲染错误：'+message;\n}\nwindow.addEventListener('error',e=>showError(e.message));\ntry{\n  // 逐段推进生产及换型，返回可用时间片，不跨休息连续计时\n  function workSegments(t,h){\n    const pieces=[];let left=h,cursor=t;\n    while(left>P.eps){\n      const day=Math.floor(cursor/P.calendar.day);let advanced=false;\n      for(const [a,b] of P.calendar.windows){\n        const start=Math.max(cursor,day*24+a),limit=day*24+b;\n        if(start<limit-P.eps){\n          const take=Math.min(left,limit-start);\n          pieces.push([start,start+take]);left-=take;cursor=start+take;advanced=true;\n          if(left<=P.eps)break;\n        }\n      }\n      if(left>P.eps)cursor=(day+1)*24;\n      if(!advanced && left<=P.eps)break;\n    }\n    return pieces;\n  }\n  function addWorkHours(t,h){const parts=workSegments(t,h);return parts.length?parts.at(-1)[1]:t;}\n  function available(t){\n    let sum=0;\n    for(let d=0;d*24<t;d++)for(const [a,b] of P.calendar.windows)sum+=Math.max(0,Math.min(t,d*24+b)-(d*24+a));\n    return sum;\n  }\n  const orders=P.orders.map(o=>({...o,deadline:addWorkHours(0,o.due)}));\n  const edd=(a,b)=>a.deadline-b.deadline||a.id.localeCompare(b.id);\n  function emptyState(){return P.lines.map(()=>({free:0,last:null}));}\n  function option(order,i,state){\n    const prev=state[i],setup=prev.last?P.change[prev.last][order.family]:0;\n    const prep=workSegments(prev.free,setup),ready=addWorkHours(prev.free,setup);\n    const parts=workSegments(ready,order.hours),end=addWorkHours(ready,order.hours);\n    return {order,line:i,setup,prep,parts,start:parts[0][0],end,late:end>order.deadline+P.eps};\n  }\n  function best(order,state,ai){\n    const choices=P.lines.map((l,i)=>l.families.includes(order.family)?option(order,i,state):null).filter(Boolean);\n    choices.sort((a,b)=>ai?(a.end-b.end||a.line-b.line):(state[a.line].free-state[b.line].free||a.line-b.line));\n    return choices[0];\n  }\n  function commit(job,state){state[job.line]={free:job.end,last:job.order.family};}\n  function simulate(list,initial){\n    const state=initial.map(s=>({...s})),jobs=[];\n    for(const order of [...list].sort(edd)){const job=best(order,state,true);jobs.push(job);commit(job,state);}\n    return jobs;\n  }\n  function schedule(ai){\n    const pending=[...orders].sort(ai?edd:(a,b)=>a.id.localeCompare(b.id)),state=emptyState(),jobs=[];\n    while(pending.length){\n      let chosen=best(pending[0],state,ai);\n      if(ai && pending.length>1){\n        // 仅在省换型且不使原本准时订单变迟时允许同族插队\n        const baseline=simulate(pending,state),baseMap=new Map(baseline.map(j=>[j.order.id,j]));\n        const baseSetup=baseline.reduce((s,j)=>s+j.setup,0),candidates=[];\n        for(let k=1;k<pending.length;k++){\n          const candidate=best(pending[k],state,true);\n          if(state[candidate.line].last!==candidate.order.family)continue;\n          const trialState=state.map(s=>({...s}));commit(candidate,trialState);\n          const trial=[candidate,...simulate(pending.filter(o=>o.id!==candidate.order.id),trialState)];\n          const safe=trial.every(j=>!j.late||baseMap.get(j.order.id).late);\n          const saving=baseSetup-trial.reduce((s,j)=>s+j.setup,0);\n          if(safe && saving>P.eps)candidates.push({candidate,saving});\n        }\n        candidates.sort((a,b)=>b.saving-a.saving||edd(a.candidate.order,b.candidate.order));\n        if(candidates.length)chosen=candidates[0].candidate;\n      }\n      jobs.push(chosen);commit(chosen,state);pending.splice(pending.findIndex(o=>o.id===chosen.order.id),1);\n    }\n    const makespan=Math.max(...jobs.map(j=>j.end)),capacity=available(makespan);\n    const late=jobs.filter(j=>j.late).length,setup=jobs.reduce((s,j)=>s+j.setup,0);\n    const util=P.lines.map((_,i)=>100*jobs.filter(j=>j.line===i).reduce((s,j)=>s+j.order.hours,0)/capacity);\n    return {jobs,makespan,late,setup,rate:100*(jobs.length-late)/jobs.length,util,average:util.reduce((a,b)=>a+b,0)/util.length,capacity};\n  }\n  let aiResult=schedule(true),baseResult=schedule(false),isAI=true,topView=false;\n  const f=n=>n.toFixed(1);\n  function updateMetrics(){\n    const a=aiResult,b=baseResult,note='以页面内实时计算为准';\n    window.__metrics=[\n      {label:'总完工时间 AI/经验',value:f(a.makespan)+' / '+f(b.makespan),unit:'h',note},\n      {label:'准时率 AI/经验',value:f(a.rate)+' / '+f(b.rate),unit:'%',note},\n      {label:'迟到订单 AI/经验',value:a.late+' / '+b.late,unit:'单',note},\n      {label:'换型时间 AI/经验',value:f(a.setup)+' / '+f(b.setup),unit:'h',note},\n      {label:'平均利用率 AI/经验',value:f(a.average)+' / '+f(b.average),unit:'%',note},\n      {label:'各线利用率 AI',value:a.util.map((v,i)=>P.lines[i].id+' '+f(v)).join(' / '),unit:'%',note}\n    ];\n  }\n  const renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\n  renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);\n  document.body.prepend(renderer.domElement);\n  const scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\n  scene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\n  const light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(300,600,400);scene.add(light);\n  const camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\n  const controls=new OrbitControls(camera,renderer.domElement);\n  controls.enableDamping=true;controls.autoRotate=false;controls.autoRotateSpeed=1;\n  controls.addEventListener('start',()=>controls.autoRotate=false);\n  const modelGroup=new THREE.Group();scene.add(modelGroup);\n  Object.assign(window,{__scene:scene,__camera:camera,__renderer:renderer,__controls:controls,__model:modelGroup});\n  const S=P.size;\n  function material(color,transparent=false){\n    return new THREE.MeshStandardMaterial({color,...{metalness:P.material.metalness,roughness:P.material.roughness},transparent,opacity:transparent?P.material.stopOpacity:1,depthWrite:!transparent});\n  }\n  function box(w,h,d,x,y,z,color,transparent=false){\n    const mesh=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material(color,transparent));\n    mesh.position.set(x,y,z);modelGroup.add(mesh);return mesh;\n  }\n  function label(text,x,y,z,width=S.labelWidth){\n    const canvas=document.createElement('canvas');canvas.width=512;canvas.height=96;\n    const ctx=canvas.getContext('2d');ctx.fillStyle='#243449';ctx.font='32px \"Segoe UI\",sans-serif';\n    ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(text,256,48);\n    const texture=new THREE.CanvasTexture(canvas);\n    const sprite=new THREE.Sprite(new THREE.SpriteMaterial({map:texture,depthTest:false,transparent:true}));\n    sprite.position.set(x,y,z);sprite.scale.set(width,S.labelHeight,1);modelGroup.add(sprite);\n  }\n  function stamp(t){\n    const total=Math.round((t+P.calendar.originHour)*60),day=Math.floor(total/1440)+1;\n    return 'D'+day+' '+String(Math.floor(total%1440/60)).padStart(2,'0')+':'+String(total%60).padStart(2,'0');\n  }\n  function fit(){\n    const bounds=new THREE.Box3().setFromObject(modelGroup,true),size=bounds.getSize(new THREE.Vector3()),center=bounds.getCenter(new THREE.Vector3());\n    const direction=topView?new THREE.Vector3(0,1,.001):new THREE.Vector3(.05,.75,1).normalize();\n    const distance=Math.max(size.x/camera.aspect,size.z,size.y)*.5/Math.tan(THREE.MathUtils.degToRad(20))/.8+size.z*.6;\n    camera.up.set(0,1,0);camera.position.copy(center).addScaledVector(direction,distance);\n    controls.target.copy(center);camera.lookAt(center);controls.update();\n  }\n  function clear(){\n    modelGroup.traverse(o=>{o.geometry?.dispose();if(o.material){o.material.map?.dispose();o.material.dispose();}});\n    modelGroup.clear();\n  }\n  function draw(){\n    updateMetrics();clear();const result=isAI?aiResult:baseResult;\n    const horizon=Math.ceil(Math.max(aiResult.makespan,baseResult.makespan,...orders.map(o=>o.deadline))/S.tick)*S.tick;\n    const depth=(P.lines.length-1)*S.rowPitch+S.rowWidth;\n    for(let i=0;i<P.lines.length;i++){\n      box(horizon*S.timeScale,1,S.rowWidth,horizon*S.timeScale/2,-1,i*S.rowPitch,'#e6e4df');\n      label(P.lines[i].id,-30,8,i*S.rowPitch,32);\n    }\n    for(let t=0;t<=horizon;t+=S.tick){\n      box(.5,.5,depth+10,t*S.timeScale,0,S.rowPitch,'#cbd0d5');\n      label(stamp(t),t*S.timeScale,0,depth-5,70);\n    }\n    for(let d=0;d*24<horizon;d++){\n      for(const [a,b] of [[4,4.5],[12,12.5],[16,24]]){\n        const start=d*24+a,end=Math.min(d*24+b,horizon);\n        if(end>start)box((end-start)*S.timeScale,32,depth,(start+end)*S.timeScale/2,15,S.rowPitch,'#333333',true);\n      }\n    }\n    for(const job of result.jobs){\n      const z=job.line*S.rowPitch,c=P.colors[job.order.family];\n      for(const [a,b] of job.prep)box((b-a)*S.timeScale,S.setupHeight,S.rowWidth,(a+b)*S.timeScale/2,S.setupHeight/2,z,P.colors.setup);\n      for(const [a,b] of job.parts){\n        box((b-a)*S.timeScale,S.barHeight,S.rowWidth,(a+b)*S.timeScale/2,S.barHeight/2,z,c);\n        if(job.late)box((b-a)*S.timeScale,S.cap,S.rowWidth,(a+b)*S.timeScale/2,S.barHeight+S.cap/2,z,P.colors.late);\n      }\n      const longest=job.parts.reduce((a,b)=>b[1]-b[0]>a[1]-a[0]?b:a);\n      label(job.order.id,(longest[0]+longest[1])*S.timeScale/2,24,z,32);\n      const pole=new THREE.Mesh(new THREE.CylinderGeometry(S.dueRadius,S.dueRadius,S.dueHeight,8),material(P.colors.due));\n      pole.position.set(job.order.deadline*S.timeScale,S.dueHeight/2,z+S.rowWidth/2-2);modelGroup.add(pole);\n    }\n    document.getElementById('title').textContent='装配车间 · '+(isAI?'AI 排程':'老师傅经验排法');\n    const keys=['总完工时间','准时率','迟到订单','换型时间','平均利用率'];\n    keys.forEach((key,i)=>document.getElementById('k'+i).textContent=key+'（AI / 经验）：'+window.__metrics[i].value+' '+window.__metrics[i].unit);\n    document.getElementById('detail').innerHTML='<b>当前排程明细 · '+(isAI?'AI':'经验')+'</b><table><tr><th>订单/族</th><th>线体</th><th>开始</th><th>结束</th><th>迟到</th></tr>'+\n      [...result.jobs].sort((a,b)=>a.line-b.line||a.start-b.start).map(j=>'<tr><td>'+j.order.id+'/'+j.order.family+'</td><td>'+P.lines[j.line].id+'</td><td>'+stamp(j.start)+'</td><td>'+stamp(j.end)+'</td><td style=\"color:'+(j.late?'#dc2626':'#15803d')+'\">'+(j.late?'是':'否')+'</td></tr>').join('')+'</table><div>生产利用率：'+result.util.map((u,i)=>P.lines[i].id+' '+f(u)+'%').join(' · ')+'</div><div>分母：总完工前每线可用 '+f(result.capacity)+' h；不含休息，分子不含换型。</div>';\n    document.getElementById('foot').textContent='EDD＋安全同族插队＋完工最早；非全局最优。首单换型0h；明细开始为生产开始。X轴10mm/h，D1为周一；交期紫柱可能超出完工时间。拖动旋转 / 滚轮缩放。';\n    fit();\n  }\n  document.getElementById('mode').onclick=()=>{try{isAI=!isAI;aiResult=schedule(true);baseResult=schedule(false);draw();}catch(e){showError(e.message);}};\n  document.getElementById('details').onclick=()=>{const el=document.getElementById('detail');el.hidden=!el.hidden;};\n  document.getElementById('view').onclick=()=>{topView=!topView;fit();};\n  window.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);fit();});\n  draw();\n  renderer.setAnimationLoop(()=>{controls.update();renderer.render(scene,camera);});\n}catch(error){showError(error.message);}\n</script>\n</body>\n</html>\n<<<METRICS>>>\n[{\"label\":\"总完工时间 AI/经验\",\"value\":\"39.0 / 40.0\",\"unit\":\"h\",\"note\":\"以页面内实时计算为准\"},{\"label\":\"准时率 AI/经验\",\"value\":\"100.0 