{"ok": true, "summary": "已建立电子膨胀阀装配模型，包含φ32×60 mm黄铜阀体、φ9.52 mm侧进底出铜管、φ28×35 mm步进电机组件及针阀与φ1.6 mm节流孔。假设铜管壁厚0.8 mm、外露长各30 mm，阀体内腔φ16 mm；剖切显示阀芯和蓝色流道。质量按简化净实体估算，整阀高度125 mm，不含引线。", "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>电子膨胀阀 · 热管理建模工坊</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;left:12px;top:12px;max-width:300px;padding:12px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;line-height:1.65}\nh3{margin:0 0 5px;font-size:15px}\n.legend span{display:inline-block;width:10px;height:10px;margin-right:5px;border:1px solid #aaa}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover{border-color:#b11f4b}\n.buttons{display:flex;gap:4px;margin-top:8px}\n#error{display:none;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#bc1832;background:white;padding:18px;z-index:10}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h3>空调用电子膨胀阀</h3>\n<div>阀体 φ32 × 60 mm；内腔 φ16 mm</div>\n<div>铜管 φ9.52 × 0.8；外露各30 mm</div>\n<div>电机 φ28 × 35；节流孔 φ1.6 mm</div>\n<div id=\"mass\"></div>\n<div id=\"height\"></div>\n<div class=\"legend\"><span style=\"background:#c9a227\"></span>黄铜阀体　<span style=\"background:#b87333\"></span>铜管/绕组</div>\n<div class=\"legend\"><span style=\"background:#8d949a\"></span>不锈钢阀芯　<span style=\"background:#2b2b2b\"></span>塑料外壳</div>\n<div class=\"legend\"><span style=\"background:#3b82f6\"></span>流道示意；剖切保留阀芯及绕组</div>\n<div class=\"buttons\"><button id=\"cut\">剖切视图</button><button id=\"explode\">爆炸视图</button><button id=\"rotate\">自动旋转</button></div>\n</div>\n<div id=\"error\"></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nconst P = {\n  // 长度单位 mm；内腔、管长及电机内部尺寸为工程假设\n  bodyD:32,bodyH:60,cavityD:16,cavityBottom:14,cavityTop:54,\n  portD:9.52,pipeWall:0.8,sideLength:30,bottomLength:30,sideY:32,\n  outletDepth:8,orificeD:1.6,seatTop:14,\n  motorD:28,motorH:35,shellWall:2,\n  windingOuterD:23,windingInnerD:12,windingH:25,\n  rotorD:10,rotorH:26,stemD:3,stemBottom:19,stemTop:65,\n  needleTipY:13.4,needleTipD:0.3,needleBaseD:3,\n  // 密度 g/cm³；质量仅计算阀体与两根铜管\n  brassDensity:8.5,copperDensity:8.96,\n  metalness:0.78,roughness:0.36,\n  colors:{brass:'#c9a227',copper:'#b87333',steel:'#8d949a',plastic:'#2b2b2b',fluid:'#3b82f6'},\n  segments:64,explodeMotor:24,explodeSide:22,explodeBottom:20\n};\nfunction showError(message){\n  const box=document.getElementById('error');\n  box.style.display='block';box.textContent='模型加载失败：'+message;\n}\nwindow.addEventListener('error',e=>showError(e.message));\ntry{\n  const scene=new THREE.Scene();\n  scene.background=new THREE.Color('#f7f4ef');\n  const renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\n  renderer.setPixelRatio(Math.min(devicePixelRatio,2));\n  renderer.setSize(innerWidth,innerHeight);\n  renderer.localClippingEnabled=true;\n  document.body.appendChild(renderer.domElement);\n  const camera=new THREE.PerspectiveCamera(38,innerWidth/innerHeight,0.1,3000);\n  const controls=new OrbitControls(camera,renderer.domElement);\n  controls.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1.2;\n  controls.addEventListener('start',()=>{controls.autoRotate=false;syncRotate();});\n  scene.add(new THREE.HemisphereLight(0xffffff,0x8a8172,2.5));\n  const light=new THREE.DirectionalLight(0xffffff,3);\n  light.position.set(100,180,140);scene.add(light);\n  const fill=new THREE.DirectionalLight(0xffffff,1.5);\n  fill.position.set(-100,40,-80);scene.add(fill);\n  const model=new THREE.Group();scene.add(model);\n  const mats={};\n  Object.entries(P.colors).forEach(([key,color])=>{\n    mats[key]=new THREE.MeshStandardMaterial({color,metalness:P.metalness,roughness:P.roughness,side:THREE.DoubleSide});\n  });\n  mats.fluid.transparent=true;mats.fluid.opacity=.55;mats.fluid.depthWrite=false;\n  const shellMat=mats.plastic.clone();\n  const pipeMat=mats.copper.clone();\n  const body=new THREE.Group(),motor=new THREE.Group(),sidePipe=new THREE.Group(),bottomPipe=new THREE.Group();\n  model.add(body,motor,sidePipe,bottomPipe);\n  const r=P.bodyD/2,cr=P.cavityD/2,pr=P.portD/2,ir=pr-P.pipeWall;\n  function lathe(points,material,parent){\n    const geo=new THREE.LatheGeometry(points.map(v=>new THREE.Vector2(v[0],v[1])),P.segments);\n    const mesh=new THREE.Mesh(geo,material);parent.add(mesh);return mesh;\n  }\n  function ring(ro,ri,h,material,parent){\n    return lathe([[ri,0],[ro,0],[ro,h],[ri,h],[ri,0]],material,parent);\n  }\n  function cylinder(rt,rb,h,material,parent,y,x=0){\n    const mesh=new THREE.Mesh(new THREE.CylinderGeometry(rt,rb,h,P.segments),material);\n    mesh.position.set(x,y,0);parent.add(mesh);return mesh;\n  }\n  // 阀体回转截面：底部出液腔、节流孔、上部内腔\n  lathe([[pr,0],[r,0],[r,P.bodyH],[0,P.bodyH],[0,P.cavityTop],\n    [cr,P.cavityTop],[cr,P.seatTop],[P.orificeD/2,P.seatTop],\n    [P.orificeD/2,P.outletDepth],[pr,P.outletDepth],[pr,0]],mats.brass,body);\n  // 侧孔用材质空间裁切，保留精确圆柱交界\n  mats.brass.onBeforeCompile=shader=>{\n    shader.vertexShader='varying vec3 vBodyPosition;\\n'+shader.vertexShader;\n    shader.vertexShader=shader.vertexShader.replace('#include <begin_vertex>','#include <begin_vertex>\\nvBodyPosition=position;');\n    shader.fragmentShader='varying vec3 vBodyPosition;\\n'+shader.fragmentShader;\n    shader.fragmentShader=shader.fragmentShader.replace('#include <clipping_planes_fragment>',\n      '#include <clipping_planes_fragment>\\nif(vBodyPosition.x>0.0 && length(vec2(vBodyPosition.y-'+P.sideY.toFixed(4)+',vBodyPosition.z))<'+pr.toFixed(4)+') discard;');\n  };\n  // 侧孔壁面：圆柱端部裁到内外同轴圆柱，避免悬空端面\n  const portWallMat=mats.brass.clone();\n  portWallMat.onBeforeCompile=shader=>{\n    shader.vertexShader='varying vec3 vPortWorld;\\n'+shader.vertexShader;\n    shader.vertexShader=shader.vertexShader.replace('#include <begin_vertex>',\n      '#include <begin_vertex>\\nvPortWorld=(modelMatrix*vec4(position,1.0)).xyz;');\n    shader.fragmentShader='varying vec3 vPortWorld;\\n'+shader.fragmentShader;\n    shader.fragmentShader=shader.fragmentShader.replace('#include <clipping_planes_fragment>',\n      '#include <clipping_planes_fragment>\\nfloat rr=length(vPortWorld.xz);if(rr<'+cr.toFixed(4)+'||rr>'+r.toFixed(4)+') discard;');\n  };\n  const portWall=new THREE.Mesh(new THREE.CylinderGeometry(pr,pr,r,P.segments,1,true),portWallMat);\n  portWall.rotation.z=-Math.PI/2;portWall.position.set(r/2,P.sideY,0);body.add(portWall);\n  const sideTube=ring(pr,ir,P.sideLength,pipeMat,sidePipe);\n  sideTube.rotation.z=-Math.PI/2;sidePipe.position.set(r,P.sideY,0);\n  ring(pr,ir,P.bottomLength,pipeMat,bottomPipe);bottomPipe.position.y=-P.bottomLength;\n  motor.position.y=P.bodyH;\n  lathe([[P.motorD/2-P.shellWall,0],[P.motorD/2,0],[P.motorD/2,P.motorH],\n    [0,P.motorH],[0,P.motorH-P.shellWall],[P.motorD/2-P.shellWall,P.motorH-P.shellWall],\n    [P.motorD/2-P.shellWall,0]],shellMat,motor);\n  const winding=ring(P.windingOuterD/2,P.windingInnerD/2,P.windingH,mats.copper,motor);\n  winding.position.y=(P.motorH-P.windingH)/2;\n  cylinder(P.rotorD/2,P.rotorD/2,P.rotorH,mats.steel,motor,P.motorH/2);\n  const needle=new THREE.Group();model.add(needle);\n  cylinder(P.stemD/2,P.stemD/2,P.stemTop-P.stemBottom,mats.steel,needle,(P.stemTop+P.stemBottom)/2);\n  cylinder(P.needleBaseD/2,P.needleTipD/2,P.stemBottom-P.needleTipY,mats.steel,needle,(P.stemBottom+P.needleTipY)/2);\n  cylinder(cr,cr,P.cavityTop-P.cavityBottom,mats.fluid,body,(P.cavityTop+P.cavityBottom)/2);\n  cylinder(P.orificeD/2,P.orificeD/2,P.seatTop-P.outletDepth,mats.fluid,body,(P.seatTop+P.outletDepth)/2);\n  cylinder(pr,pr,P.outletDepth,mats.fluid,body,P.outletDepth/2);\n  cylinder(ir,ir,P.bottomLength,mats.fluid,bottomPipe,P.bottomLength/2);\n  const incoming=cylinder(ir,ir,P.sideLength+r,mats.fluid,sidePipe,0);\n  incoming.rotation.z=-Math.PI/2;incoming.position.set((P.sideLength-r)/2,0,0);\n  // 数值积分：侧孔与阀体环形壁的真实相交体积，排除已扣内腔\n  let sideRemoved=0;\n  const n=2000,dz=2*pr/n;\n  for(let i=0;i<n;i++){\n    const z=-pr+(i+.5)*dz;\n    sideRemoved+=2*Math.sqrt(pr*pr-z*z)*(Math.sqrt(r*r-z*z)-Math.sqrt(cr*cr-z*z))*dz;\n  }\n  const brassVolume=Math.PI*r*r*P.bodyH-Math.PI*cr*cr*(P.cavityTop-P.cavityBottom)\n    -Math.PI*pr*pr*P.outletDepth-Math.PI*(P.orificeD/2)**2*(P.seatTop-P.outletDepth)-sideRemoved;\n  const copperVolume=Math.PI*(pr*pr-ir*ir)*(P.sideLength+P.bottomLength);\n  const brassMass=brassVolume*P.brassDensity/1000,copperMass=copperVolume*P.copperDensity/1000;\n  const totalHeight=P.bodyH+P.motorH+P.bottomLength;\n  document.getElementById('mass').textContent=`黄铜 ${brassMass.toFixed(1)} g；铜管 ${copperMass.toFixed(2)} g`;\n  document.getElementById('height').textContent=`整阀高 ${totalHeight} mm；管长不计插入段`;\n  const grid=new THREE.GridHelper(220,22,0xd5d0c7,0xe7e1d8);\n  grid.position.y=-P.bottomLength-.5;scene.add(grid);\n  function fit(){\n    const box=new THREE.Box3().setFromObject(model),size=box.getSize(new THREE.Vector3()),center=box.getCenter(new THREE.Vector3());\n    const radius=size.length()/2;\n    const halfFov=Math.min(THREE.MathUtils.degToRad(camera.fov/2),Math.atan(Math.tan(THREE.MathUtils.degToRad(camera.fov/2))*camera.aspect));\n    const distance=radius/Math.sin(halfFov)/.70;\n    camera.position.copy(center).add(new THREE.Vector3(1,.65,1.5).normalize().multiplyScalar(distance));\n    camera.near=.1;camera.far=distance*10;camera.updateProjectionMatrix();\n    controls.target.copy(center);controls.update();\n  }\n  let cut=false,exploded=false;\n  const plane=new THREE.Plane(new THREE.Vector3(0,0,-1),0);\n  const cutMaterials=[mats.brass,portWallMat,shellMat,pipeMat,mats.fluid];\n  document.getElementById('cut').onclick=()=>{\n    cut=!cut;cutMaterials.forEach(mat=>{mat.clippingPlanes=cut?[plane]:[];mat.needsUpdate=true;});\n    document.getElementById('cut').textContent=cut?'完整视图':'剖切视图';\n  };\n  document.getElementById('explode').onclick=()=>{\n    exploded=!exploded;motor.position.y=P.bodyH+(exploded?P.explodeMotor:0);\n    sidePipe.position.x=r+(exploded?P.explodeSide:0);\n    bottomPipe.position.y=-P.bottomLength-(exploded?P.explodeBottom:0);\n    document.getElementById('explode').textContent=exploded?'装配视图':'爆炸视图';fit();\n  };\n  function syncRotate(){document.getElementById('rotate').style.borderColor=controls.autoRotate?'#b11f4b':'#dedede';}\n  document.getElementById('rotate').onclick=()=>{controls.autoRotate=!controls.autoRotate;syncRotate();};\n  window.addEventListener('resize',()=>{\n    renderer.setSize(innerWidth,innerHeight);camera.aspect=innerWidth/innerHeight;fit();\n  });\n  window.__scene=scene;window.__camera=camera;window.__renderer=renderer;window.__controls=controls;window.__model=model;\n  fit();syncRotate();\n  renderer.setAnimationLoop(()=>{controls.update();renderer.render(scene,camera);});\n}catch(error){showError(error.message);}\n</script>\n</body>\n</html>", "metrics": [{"label": "黄铜阀体质量", "value": "332.1", "unit": "g", "note": "密度8.50；扣内腔、出口腔及侧孔"}, {"label": "两根铜管质量", "value": "11.78", "unit": "g", "note": "密度8.96；壁厚0.8，各长30 mm"}, {"label": "整阀高度", "value": "125", "unit": "mm", "note": "阀体60＋电机35＋底管30"}, {"label": "铜管总长", "value": "60", "unit": "mm", "note": "仅外露直管，不计插入及焊料"}, {"label": "节流孔名义面积", "value": "2.011", "unit": "mm²", "note": "按φ1.6计算，未扣针阀遮挡"}], "suggestions": ["将铜管增加5毫米插入段并重算质量", "对比φ1.6与φ2.0节流孔面积", "增加针阀行程调节与开度演示"], "raw": "<<<SUMMARY>>>\n已建立电子膨胀阀装配模型，包含φ32×60 mm黄铜阀体、φ9.52 mm侧进底出铜管、φ28×35 mm步进电机组件及针阀与φ1.6 mm节流孔。假设铜管壁厚0.8 mm、外露长各30 mm，阀体内腔φ16 mm；剖切显示阀芯和蓝色流道。质量按简化净实体估算，整阀高度125 mm，不含引线。\n<<<HTML>>>\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>电子膨胀阀 · 热管理建模工坊</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;left:12px;top:12px;max-width:300px;padding:12px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;font-size:12px;line-height:1.65}\nh3{margin:0 0 5px;font-size:15px}\n.legend span{display:inline-block;width:10px;height:10px;margin-right:5px;border:1px solid #aaa}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover{border-color:#b11f4b}\n.buttons{display:flex;gap:4px;margin-top:8px}\n#error{display:none;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#bc1832;background:white;padding:18px;z-index:10}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<h3>空调用电子膨胀阀</h3>\n<div>阀体 φ32 × 60 mm；内腔 φ16 mm</div>\n<div>铜管 φ9.52 × 0.8；外露各30 mm</div>\n<div>电机 φ28 × 35；节流孔 φ1.6 mm</div>\n<div id=\"mass\"></div>\n<div id=\"height\"></div>\n<div class=\"legend\"><span style=\"background:#c9a227\"></span>黄铜阀体　<span style=\"background:#b87333\"></span>铜管/绕组</div>\n<div class=\"legend\"><span style=\"background:#8d949a\"></span>不锈钢阀芯　<span style=\"background:#2b2b2b\"></span>塑料外壳</div>\n<div class=\"legend\"><span style=\"background:#3b82f6\"></span>流道示意；剖切保留阀芯及绕组</div>\n<div class=\"buttons\"><button id=\"cut\">剖切视图</button><button id=\"explode\">爆炸视图</button><button id=\"rotate\">自动旋转</button></div>\n</div>\n<div id=\"error\"></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nconst P = {\n  // 长度单位 mm；内腔、管长及电机内部尺寸为工程假设\n  bodyD:32,bodyH:60,cavityD:16,cavityBottom:14,cavityTop:54,\n  portD:9.52,pipeWall:0.8,sideLength:30,bottomLength:30,sideY:32,\n  outletDepth:8,orificeD:1.6,seatTop:14,\n  motorD:28,motorH:35,shellWall:2,\n  windingOuterD:23,windingInnerD:12,windingH:25,\n  rotorD:10,rotorH:26,stemD:3,stemBottom:19,stemTop:65,\n  needleTipY:13.4,needleTipD:0.3,needleBaseD:3,\n  // 密度 g/cm³；质量仅计算阀体与两根铜管\n  brassDensity:8.5,copperDensity:8.96,\n  metalness:0.78,roughness:0.36,\n  colors:{brass:'#c9a227',copper:'#b87333',steel:'#8d949a',plastic:'#2b2b2b',fluid:'#3b82f6'},\n  segments:64,explodeMotor:24,explodeSide:22,explodeBottom:20\n};\nfunction showError(message){\n  const box=document.getElementById('error');\n  box.style.display='block';box.textContent='模型加载失败：'+message;\n}\nwindow.addEventListener('error',e=>showError(e.message));\ntry{\n  const scene=new THREE.Scene();\n  scene.background=new THREE.Color('#f7f4ef');\n  const renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\n  renderer.setPixelRatio(Math.min(devicePixelRatio,2));\n  renderer.setSize(innerWidth,innerHeight);\n  renderer.localClippingEnabled=true;\n  document.body.appendChild(renderer.domElement);\n  const camera=new THREE.PerspectiveCamera(38,innerWidth/innerHeight,0.1,3000);\n  const controls=new OrbitControls(camera,renderer.domElement);\n  controls.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1.2;\n  controls.addEventListener('start',()=>{controls.autoRotate=false;syncRotate();});\n  scene.add(new THREE.HemisphereLight(0xffffff,0x8a8172,2.5));\n  const light=new THREE.DirectionalLight(0xffffff,3);\n  light.position.set(100,180,140);scene.add(light);\n  const fill=new THREE.DirectionalLight(0xffffff,1.5);\n  fill.position.set(-100,40,-80);scene.add(fill);\n  const model=new THREE.Group();scene.add(model);\n  const mats={};\n  Object.entries(P.colors).forEach(([key,color])=>{\n    mats[key]=new THREE.MeshStandardMaterial({color,metalness:P.metalness,roughness:P.roughness,side:THREE.DoubleSide});\n  });\n  mats.fluid.transparent=true;mats.fluid.opacity=.55;mats.fluid.depthWrite=false;\n  const shellMat=mats.plastic.clone();\n  const pipeMat=mats.copper.clone();\n  const body=new THREE.Group(),motor=new THREE.Group(),sidePipe=new THREE.Group(),bottomPipe=new THREE.Group();\n  model.add(body,motor,sidePipe,bottomPipe);\n  const r=P.bodyD/2,cr=P.cavityD/2,pr=P.portD/2,ir=pr-P.pipeWall;\n  function lathe(points,material,parent){\n    const geo=new THREE.LatheGeometry(points.map(v=>new THREE.Vector2(v[0],v[1])),P.segments);\n    const mesh=new THREE.Mesh(geo,material);parent.add(mesh);return mesh;\n  }\n  function ring(ro,ri,h,material,parent){\n    return lathe([[ri,0],[ro,0],[ro,h],[ri,h],[ri,0]],material,parent);\n  }\n  function cylinder(rt,rb,h,material,parent,y,x=0){\n    const mesh=new THREE.Mesh(new THREE.CylinderGeometry(rt,rb,h,P.segments),material);\n    mesh.position.set(x,y,0);parent.add(mesh);return mesh;\n  }\n  // 阀体回转截面：底部出液腔、节流孔、上部内腔\n  lathe([[pr,0],[r,0],[r,P.bodyH],[0,P.bodyH],[0,P.cavityTop],\n    [cr,P.cavityTop],[cr,P.seatTop],[P.orificeD/2,P.seatTop],\n    [P.orificeD/2,P.outletDepth],[pr,P.outletDepth],[pr,0]],mats.brass,body);\n  // 侧孔用材质空间裁切，保留精确圆柱交界\n  mats.brass.onBeforeCompile=shader=>{\n    shader.vertexShader='varying vec3 vBodyPosition;\\n'+shader.vertexShader;\n    shader.vertexShader=shader.vertexShader.replace('#include <begin_vertex>','#include <begin_vertex>\\nvBodyPosition=position;');\n    shader.fragmentShader='varying vec3 vBodyPosition;\\n'+shader.fragmentShader;\n    shader.fragmentShader=shader.fragmentShader.replace('#include <clipping_planes_fragment>',\n      '#include <clipping_planes_fragment>\\nif(vBodyPosition.x>0.0 && length(vec2(vBodyPosition.y-'+P.sideY.toFixed(4)+',vBodyPosition.z))<'+pr.toFixed(4)+') discard;');\n  };\n  // 侧孔壁面：圆柱端部裁到内外同轴圆柱，避免悬空端面\n  const portWallMat=mats.brass.clone();\n  portWallMat.onBeforeCompile=shader=>{\n    shader.vertexShader='varying vec3 vPo