{"ok": true, "summary": "已构建列级 CDU 与成列液冷机柜的交互系统，包含板换、主备泵、调节阀、过滤补液、传感器及供回液主管，支路示意快接、隔离阀和冷板。支持正常、备泵接管、漏液隔离和温水冷却工况，并提供热点聚焦与阶段讲解。本模型为系统级示意与集总参数估算，部件几何采用示意比例；按定热负荷、定设计温差及固定系统阻力计算，不代表瞬态仿真或设备选型结果。", "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>AIDC 列级 CDU 系统</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;left:12px;top:12px;max-width:300px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;padding:10px;font-size:12px;color:#263343}\n.row{margin:5px 0;line-height:1.5}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover,button.active{border-color:#b11f4b}\n#buttons{display:flex;flex-wrap:wrap;gap:4px}\n#err{display:none;position:absolute;top:45%;left:15%;right:15%;color:#b00020;background:white;padding:20px;text-align:center}\n#hint{position:absolute;bottom:12px;right:12px;background:#ffffffd9;padding:7px;border-radius:6px;font-size:12px}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<div class=\"row\"><b>AIDC 列级 CDU · 系统级示意</b></div>\n<div id=\"modes\" class=\"row\"></div>\n<div id=\"heat\" class=\"row\"></div>\n<div id=\"thermal\" class=\"row\"></div>\n<div id=\"power\" class=\"row\"></div>\n<div id=\"primary\" class=\"row\"></div>\n<div id=\"status\" class=\"row\"></div>\n<div class=\"row\"><span style=\"color:#7c3aed\">● 一次水</span>　<span style=\"color:#0891b2\">● 供液</span>　<span style=\"color:#dc2626\">● 回液</span></div>\n<div class=\"row\">灰：金属设备　深蓝：电子件　编号：部件热点</div>\n<div id=\"stage\" class=\"row\"></div>\n<div id=\"buttons\"><button id=\"cut\">剖切视图</button><button id=\"rotate\">自动旋转</button><button id=\"pause\">暂停</button><button id=\"reset\">全局</button></div>\n</div>\n<div id=\"hint\">拖动旋转 · 滚轮缩放 · 点击编号聚焦；管线与设备为示意连接</div>\n<div id=\"err\"></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nconst P = {\n // 尺寸单位 mm；密度 kg/m³，比热 J/(kg·K)，压差 Pa\n racks:8, rackKW:150, rho:1020, cp:3900, primaryRho:998, primaryCp:4180,\n supplyC:32, primaryC:18, warmC:32, deltaS:10, deltaP:12, designApproach:4,\n pressure:250000, efficiency:.65, switchSeconds:2, normalValve:55, warmValve:95,\n rackW:600,rackH:1900,rackD:850,pitch:760,rackStart:1600,\n cduW:1100,cduH:2100,cduD:950,hxW:380,hxH:800,hxD:340,\n pumpR:125,pumpL:280,tankR:110,tankH:420,filterR:85,filterH:280,\n valveR:70,valveL:120,sensorR:35,sensorH:90,plateW:430,plateH:24,plateD:390,\n plateCount:8,plateStep:180,plateBase:300,supplyY:380,returnY:1500,headerZ:680,\n headerR:45,branchR:18,primaryR:40,particleR:15,particles:30,speed:.038,\n shellOpacity:.12,stageSeconds:5,focusSeconds:.6,tubeSegments:40,radialSegments:8,\n colors:{primary:'#7c3aed',supply:'#0891b2',hot:'#dc2626',al:'#d4d9e0',steel:'#9aa3ab',electronic:'#1f4e79'},\n modes:[\n {name:'① 正常',active:8,pump:1,warm:false,valve:55},\n {name:'② 备泵',active:8,pump:2,warm:false,valve:55},\n {name:'③ 隔离',active:7,pump:1,warm:false,valve:55},\n {name:'④ 温水',active:8,pump:1,warm:true,valve:95}],\n loops:[]\n};\nconst errorBox=document.getElementById('err');\nfunction showError(message){errorBox.style.display='block';errorBox.textContent='模型错误：'+message;}\nwindow.addEventListener('error',e=>showError(e.message));\ntry {\nconst scene=new THREE.Scene();\nscene.background=new THREE.Color('#f7f4ef');\nconst renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));\nrenderer.setSize(innerWidth,innerHeight);\ndocument.body.appendChild(renderer.domElement);\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\nconst controls=new OrbitControls(camera,renderer.domElement);\ncontrols.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1;\nscene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\nconst light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(2000,5000,3500);scene.add(light);\nconst fill=new THREE.DirectionalLight(0xffffff,.8);fill.position.set(-3000,2000,-2000);scene.add(fill);\nconst model=new THREE.Group();scene.add(model);\nconst parts={},sprites=[],flows=[],shells=[],hotspots=[];\nlet modeIndex=0,stageIndex=0,paused=false,stageClock=0,focused=null,transition=null,cut=false;\nconst V=a=>new THREE.Vector3(...a);\nfunction material(color,opacity=1){return new THREE.MeshStandardMaterial({color,metalness:.2,roughness:.6,transparent:opacity<1,opacity,depthWrite:opacity===1});}\nfunction box(g,w,h,d,x,y,z,color,opacity=1){\n const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material(color,opacity));\n m.position.set(x,y,z);m.userData.baseOpacity=opacity;g.add(m);return m;\n}\nfunction cyl(g,r,h,x,y,z,color,axis='y'){\n const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,16),material(color));\n if(axis==='x')m.rotation.z=Math.PI/2;if(axis==='z')m.rotation.x=Math.PI/2;\n m.position.set(x,y,z);m.userData.baseOpacity=1;g.add(m);return m;\n}\nfunction component(id,label,part,note,x,y,z){\n const g=new THREE.Group();g.name=id;g.position.set(x,y,z);model.add(g);parts[id]=g;\n hotspots.push({id,n:hotspots.length+1,label,part,note});return g;\n}\nconst cdu=new THREE.Group();cdu.name='cdu_shell';model.add(cdu);\nshells.push(box(cdu,P.cduW,P.cduH,P.cduD,0,P.cduH/2,0,P.colors.steel,P.shellOpacity));\nconst hx=component('hx','钎焊板式换热器','板式换热器','隔离两侧介质并把机柜热量传给设施水',-220,1200,0);\nbox(hx,P.hxW,P.hxH,P.hxD,0,0,0,P.colors.al);\nfor(let i=0;i<18;i++)box(hx,P.hxW+8,P.hxH,4,0,0,-P.hxD/2+i*P.hxD/17,P.colors.steel);\nfor(let i=1;i<=2;i++){\n const g=component('pump'+i,'变频电子水泵 '+i,'电子水泵',i===1?'正常运行主泵，为二次侧提供压头':'备用泵，主泵故障后自动接管',i===1?-230:230,300,0);\n cyl(g,P.pumpR,P.pumpL,0,0,0,P.colors.electronic,'z');\n box(g,220,45,300,0,-P.pumpR,0,P.colors.steel);\n}\nconst pv=component('pvalve','一次侧比例调节阀','电子水阀','调节一次侧流量以稳定二次侧供液温度',-620,1150,0);\ncyl(pv,P.valveR,P.valveL,0,0,0,P.colors.steel,'y');box(pv,110,130,100,0,100,0,P.colors.electronic);\nconst filter=component('filter','二次侧过滤器','配套过滤器','截留颗粒，保护冷板及调节元件',400,620,220);\ncyl(filter,P.filterR,P.filterH,0,0,0,P.colors.steel);\nconst tank=component('tank','膨胀 / 补液罐','配套补液罐','容纳热膨胀并维持系统液位',270,1600,-50);\ncyl(tank,P.tankR,P.tankH,0,0,0,P.colors.al);\nconst sensors=component('sensors','供回液温压流传感器','配套传感器','监测两侧主管温度、压力与流量',670,850,P.headerZ);\nfor(let i=0;i<3;i++)cyl(sensors,P.sensorR,P.sensorH,0,i*110,0,P.colors.electronic,'z');\nconst facility=component('facility','设施水接口','一次侧设施水接口','一次侧进水与回水接入设施冷源',-1000,800,0);\nbox(facility,260,450,300,0,0,0,P.colors.steel);\nconst endX=P.rackStart+(P.racks-1)*P.pitch;\nfor(const [id,label,y,color] of [['manifold_s','二次侧供液主管',P.supplyY,P.colors.supply],['manifold_r','二次侧回液主管',P.returnY,P.colors.hot]]){\n const g=component(id,label,'热管理集成模块','向机柜分配冷却液或收集升温回液',(endX+700)/2,y,P.headerZ);\n cyl(g,P.headerR*.95,endX-700+160,0,0,0,color,'x');\n}\nfor(let i=1;i<=P.racks;i++){\n const x=P.rackStart+(i-1)*P.pitch;\n const g=component('rack'+i,'机柜 '+i+' · GPU 冷板','液冷冷板','冷板吸收 GPU 热量，经快接及隔离阀连接主管',x,0,0);\n shells.push(box(g,P.rackW,P.rackH,P.rackD,0,P.rackH/2,0,P.colors.steel,P.shellOpacity));\n for(const sx of [-1,1])box(g,25,P.rackH,25,sx*(P.rackW/2-15),P.rackH/2,P.rackD/2,P.colors.steel);\n for(const y of [P.supplyY,P.returnY]){\n  cyl(g,P.branchR*1.6,60,0,y,P.headerZ-65,P.colors.steel,'z');\n  cyl(g,P.valveR*.55,P.valveL*.65,0,y,P.headerZ-145,P.colors.electronic,'z');\n }\n for(const z of [-125,125])cyl(g,P.branchR,P.plateStep*(P.plateCount-1)+160,0,P.plateBase+P.plateStep*(P.plateCount-1)/2,z,P.colors.supply);\n}\nconst plates=new THREE.InstancedMesh(new THREE.BoxGeometry(P.plateW,P.plateH,P.plateD),material(P.colors.al),P.racks*P.plateCount);\nconst matrix=new THREE.Matrix4();\nfor(let i=0;i<P.racks;i++)for(let j=0;j<P.plateCount;j++){\n matrix.makeTranslation(P.rackStart+i*P.pitch,P.plateBase+j*P.plateStep,0);plates.setMatrixAt(i*P.plateCount+j,matrix);\n plates.setColorAt(i*P.plateCount+j,new THREE.Color('white'));\n}\nplates.instanceMatrix.needsUpdate=true;plates.computeBoundingSphere();model.add(plates);\nconst rv=component('rvalve5','机柜 5 隔离电子水阀','电子水阀','漏液工况关闭支路，停止机柜供回液',P.rackStart+4*P.pitch,P.supplyY,P.headerZ-145);\nbox(rv,100,110,95,0,75,0,P.colors.electronic);\nfunction addLoop(id,label,color,radius,points,closed,kind,rack=0){\n const loop={id,label,color,radius,flow_lpm:0,points,closed,kind,rack};P.loops.push(loop);\n const curve=new THREE.CatmullRomCurve3(points.map(V),closed,'centripetal');\n const tube=new THREE.Mesh(new THREE.TubeGeometry(curve,P.tubeSegments,radius,P.radialSegments,closed),material(color,.55));\n tube.name=id;model.add(tube);\n const dots=new THREE.InstancedMesh(new THREE.SphereGeometry(P.particleR,6,4),material(color),P.particles);\n for(let i=0;i<P.particles;i++){matrix.makeTranslation(...curve.getPointAt(i/P.particles).toArray());dots.setMatrixAt(i,matrix);}\n dots.instanceMatrix.needsUpdate=true;dots.computeBoundingSphere();model.add(dots);\n flows.push({loop,curve,tube,dots,t:0,active:true});\n}\naddLoop('primary','设施水回路',P.colors.primary,P.primaryR,[[-1000,700,0],[-620,700,0],[-620,1150,0],[-220,1100,-190],[-220,1500,-190],[-1000,1500,-190]],true,'primary');\naddLoop('secondary_supply','二次侧供液',P.colors.supply,P.headerR,[[400,620,220],[650,P.supplyY,P.headerZ],[P.rackStart,P.supplyY,P.headerZ],[endX,P.supplyY,P.headerZ]],false,'supply');\naddLoop('secondary_return','二次侧回液',P.colors.hot,P.headerR,[[endX,P.returnY,P.headerZ],[P.rackStart,P.returnY,P.headerZ],[650,P.returnY,P.headerZ],[-220,1400,190],[-220,950,190]],false,'return');\nfor(let i=1;i<=2;i++)addLoop('pump_path'+i,'泵 '+i+' 通路',P.colors.supply,P.headerR,[[-220,950,190],[i===1?-230:230,600,100],[i===1?-230:230,300,160],[400,400,220],[400,620,220]],false,'pump',i);\nfor(let i=1;i<=P.racks;i++){\n const x=P.rackStart+(i-1)*P.pitch;\n addLoop('rack_branch'+i,'机柜 '+i+' 支路',P.colors.supply,P.branchR,[[x,P.supplyY,P.headerZ],[x,P.supplyY,125],[x,P.plateBase,125],[x,P.plateBase,-125],[x,P.returnY,-125],[x,P.returnY,P.headerZ]],false,'rack',i);\n}\n // 供液到回液沿支路渐变；每条回路保留独立参数及动画\nfor(const f of flows){\n const pos=f.tube.geometry.attributes.position,colors=[];\n for(let i=0;i<pos.count;i++){\n  const t=i/(pos.count-1),c=new THREE.Color(f.loop.color);\n  if(f.loop.kind==='rack')c.lerp(new THREE.Color(P.colors.hot),t);\n  if(f.loop.kind==='primary')c.lerp(new THREE.Color(P.colors.hot),Math.max(0,(t-.55)*.8));\n  colors.push(c.r,c.g,c.b);\n }\n f.tube.geometry.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));\n f.tube.material.vertexColors=true;f.tube.material.color.set('white');\n}\nfor(const h of hotspots){\n const g=parts[h.id],b=new THREE.Box3().setFromObject(g,true),p=b.getCenter(new THREE.Vector3());p.y=b.max.y+95;\n const canvas=document.createElement('canvas');canvas.width=64;canvas.height=64;const ctx=canvas.getContext('2d');\n ctx.beginPath();ctx.arc(32,32,29,0,Math.PI*2);ctx.fillStyle='white';ctx.fill();ctx.strokeStyle='#b11f4b';ctx.lineWidth=1;ctx.stroke();\n ctx.fillStyle='#263343';ctx.font='bold 27px Segoe UI';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(h.n,32,33);\n const sprite=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(canvas),depthTest:false}));\n sprite.position.copy(g.worldToLocal(p));sprite.scale.set(130,130,1);sprite.userData.id=h.id;g.add(sprite);sprites.push(sprite);\n}\nwindow.__hotspots=hotspots;\nwindow.__stages=[\n {title:'机柜吸热',text:'冷板带走 GPU 热量，支路冷却液升温。'},\n {title:'回液汇流',text:'各机柜热回液经回液主管汇集到 CDU。'},\n {title:'板换换热',text:'二次侧热量通过板片传递给一次侧水。'},\n {title:'一次侧排热',text:'比例阀调节设施水流量，设施冷源带走热量。'},\n {title:'供液分配',text:'运行泵加压，经滤器、主管分配到机柜。'}];\nconst stageParts=[hotspots.filter(h=>h.id.startsWith('rack')).map(h=>h.id),['manifold_r','sensors'],['hx'],['hx','pvalve','facility'],['pump1','pump2','filter','manifold_s','tank','rvalve5']];\nconst stageKinds=[['rack'],['return','rack'],['return','primary','pump'],['primary'],['pump','supply','rack']];\nconst bounds=new THREE.Box3().setFromObject(model,true),center=bounds.getCenter(new THREE.Vector3()),size=bounds.getSize(new THREE.Vector3());\nconst direction=new THREE.Vector3(1,.7,1.2).normalize();\nfunction globalPosition(){\n const vf=THREE.MathUtils.degToRad(camera.fov/2),hf=Math.atan(Math.tan(vf)*camera.aspect);\n return center.clone().addScaledVector(direction,size.length()/2/Math.sin(Math.min(vf,hf))/.78);\n}\ncamera.position.copy(globalPosition());controls.target.copy(center);controls.update();\nconst grid=new THREE.GridHelper(12000,40,0xd5d0c8,0xe7e2da);grid.position.set(center.x,-15,0);scene.add(grid);\nfunction restyle(){\n const m=P.modes[modeIndex];\n for(const [id,g] of Object.entries(parts))g.traverse(o=>{\n  if(!o.isMesh)return;\n  const active=stageParts[stageIndex].includes(id),selected=focused===id;\n  const opacity=focused?(selected?1:.25):(active?1:.48);\n  o.material.opacity=o.userData.baseOpacity*opacity;o.material.transparent=o.material.opacity<1;o.material.depthWrite=o.material.opacity===1;\n  o.material.emissive.set(selected?'#b11f4b':id==='rvalve5'&&modeIndex===2?'#dc2626':id==='pump'+m.pump?'#0f766e':id==='pvalve'&&m.warm?'#dc2626':active?'#b11f4b':'#000000');\n  o.material.emissiveIntensity=selected?.25:.3;\n });\n for(const f of flows){\n  const a=stageKinds[stageIndex].includes(f.loop.kind);\n  f.tube.material.opacity=f.active?(a?.65:.16):.07;f.dots.material.opacity=a?1:.3;f.dots.material.transparent=true;\n }\n for(let i=0;i<P.racks;i++)for(let j=0;j<P.plateCount;j++){\n  const active=focused?focused==='rack'+(i+1):stageIndex===0;\n  plates.setColorAt(i*P.plateCount+j,new THREE.Color(active?'#ffffff':'#68747f'));\n }\n plates.instanceColor.needsUpdate=true;\n}\nwindow.__setStage=i=>{\n stageIndex=((i%window.__stages.length)+window.__stages.length)%window.__stages.length;stageClock=0;\n const s=window.__stages[stageIndex];document.getElementById('stage').textContent=`阶段 ${stageIndex+1}/5 · ${s.title}：${s.text}`;\n restyle();if(typeof window.__notifyStage==='function')window.__notifyStage(stageIndex);\n};\nwindow.__focus=id=>{\n if(id!==null&&!parts[id])return;focused=id;controls.autoRotate=false;\n let target=center.clone(),position=globalPosition();\n if(id){\n  const b=new THREE.Box3().setFromObject(parts[id],true);target=b.getCenter(new THREE.Vector3());\n  position=target.clone().addScaledVector(direction,Math.max(b.getSize(new THREE.Vector3()).length()*2.5,650));\n  const h=hotspots.find(h=>h.id===id);document.getElementById('hint').textContent=`${h.n} · ${h.label}｜${h.part}：${h.note}`;\n }else document.getElementById('hint').textContent='拖动旋转 · 滚轮缩放 · 点击编号聚焦';\n transition={time:0,from:camera.position.clone(),targetFrom:controls.target.clone(),position,target};restyle();\n};\nfunction compute(mode){\n const load=mode.active*P.rackKW,q=load*1000/(P.rho*P.cp*P.deltaS),flow=q*60000;\n const pi=mode.warm?P.warmC:P.primaryC,si=mode.warm?pi+P.designApproach:P.supplyC;\n const primaryQ=load*1000/(P.primaryRho*P.primaryCp*P.deltaP),hyd=P.pressure*q/1000,shaft=hyd/P.efficiency;\n const values=[load.toFixed(0),flow.toFixed(1),P.deltaS.toFixed(1),(si-pi).toFixed(1),hyd.toFixed(2),(shaft/load*100).toFixed(2)];\n const labels=['总热负荷','二次侧流量','二次侧供回液温差','板换 approach 温差','泵水力功率','泵功占 IT 负荷'];\n const units=['kW','L/min','K','K','kW','%'];\n const metrics=labels.map((label,i)=>({label,value:values[i],unit:units[i],note:'以页面实时计算为准'}));\n return {load,q,flow,pi,si,primaryFlow:primaryQ*60000,hyd,shaft,metrics};\n}\nfunction setMode(i){\n modeIndex=i;const m=P.modes[i],r=compute(m);window.__metrics=r.metrics;window.__operatingPoint=r;\n document.getElementById('heat').textContent=`热负荷 ${r.load} kW · 二次流量 ${r.flow.toFixed(1)} L/min`;\n document.getElementById('thermal').textContent=`供/回 ${r.si}/${r.si+P.deltaS} ℃ · ΔT ${P.deltaS} K · approach ${(r.si-r.pi).toFixed(1)} K`;\n document.getElementById('power').textContent=`水力 ${r.hyd.toFixed(2)} kW · 轴功 ${r.shaft.toFixed(2)} kW · 占 IT ${(r.shaft/r.load*100).toFixed(2)}%`;\n document.getElementById('primary').textContent=`一次 ${r.pi}/${r.pi+P.deltaP} ℃ · ${r.primaryFlow.toFixed(1)} L/min · 阀 ${m.valve}%`;\n const branch=(r.flow/m.active).toFixed(1);\n document.getElementById('status').textContent=[\n `主泵运行；各柜 ${branch} L/min；定阻力估算`,\n `备泵运行；假设 ${P.switchSeconds} s 接管，展示接管后稳态`,\n `5 柜隔离；总流量下调，余 7 柜各 ${branch} L/min`,\n `机柜进液升至 ${r.si} ℃；需核验 GPU 温限`\n ][i];\n for(const f of flows){\n  const k=f.loop.kind;f.active=!(k==='pump'&&f.loop.rack!==m.pump)&&!(k==='rack'&&f.loop.rack===5&&i===2);\n  f.loop.flow_lpm=f.active?(k==='primary'?r.primaryFlow:k==='rack'?r.flow/m.active:r.flow):0;\n  f.dots.visible=f.active;\n  if(k==='primary'){f.tube.material.color.set(m.warm?'#ffb0a0':'white');f.dots.material.color.set(m.warm?'#dc6262':P.colors.primary);}\n }\n document.querySelectorAll('#modes button').forEach((b,j)=>b.classList.toggle('active',i===j));restyle();\n}\nP.modes.forEach((m,i)=>{const b=document.createElement('button');b.textContent=m.name;b.onclick=()=>setMode(i);document.getElementById('modes').appendChild(b);});\nwindow.__compute=compute;window.__parameters=P;\nwindow.__setStage(0);setMode(0);\nwindow.__scene=scene;window.__camera=camera;window.__renderer=renderer;window.__controls=controls;window.__model=model;\ndocument.getElementById('cut').onclick=()=>{cut=!cut;shells.forEach(s=>s.visible=!cut);document.getElementById('cut').textContent=cut?'完整视图':'剖切视图';};\ndocument.getElementById('rotate').onclick=()=>controls.autoRotate=!controls.autoRotate;\ndocument.getElementById('pause').onclick=()=>{paused=!paused;document.getElementById('pause').textContent=paused?'继续':'暂停';};\ndocument.getElementById('reset').onclick=()=>window.__focus(null);\ncontrols.addEventListener('start',()=>{controls.autoRotate=false;transition=null;});\nconst raycaster=new THREE.Raycaster(),pointer=new THREE.Vector2();let down=null;\nrenderer.domElement.addEventListener('pointerdown',e=>down=[e.clientX,e.clientY]);\nrenderer.domElement.addEventListener('pointerup',e=>{\n if(!down||Math.hypot(e.clientX-down[0],e.clientY-down[1])>5)return;\n pointer.set(e.clientX/innerWidth*2-1,-e.clientY/innerHeight*2+1);raycaster.setFromCamera(pointer,camera);\n const hit=raycaster.intersectObjects(sprites);if(hit.length)window.__focus(hit[0].object.userData.id);\n});\nwindow.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);if(!focused){camera.position.copy(globalPosition());controls.target.copy(center);}});\nconst clock=new THREE.Clock();\nfunction animate(){\n requestAnimationFrame(animate);const dt=Math.min(clock.getDelta(),.1);\n if(!paused){stageClock+=dt;if(stageClock>=P.stageSeconds)window.__setStage(stageIndex+1);}\n for(const f of flows){\n  if(!f.active)continue;\n  const reference=f.loop.kind==='rack'?200:1800;f.t=(f.t+dt*P.speed*f.loop.flow_lpm/reference)%1;\n  for(let i=0;i<P.particles;i++){\n   const t=(f.t+i/P.particles)%1,p=f.curve.getPointAt(t);matrix.makeTranslation(p.x,p.y,p.z);f.dots.setMatrixAt(i,matrix);\n   if(f.loop.kind==='rack')f.dots.setColorAt(i,new THREE.Color(P.colors.supply).lerp(new THREE.Color(P.colors.hot),t));\n  }\n  f.dots.instanceMatrix.needsUpdate=true;if(f.dots.instanceColor)f.dots.instanceColor.needsUpdate=true;f.dots.computeBoundingSphere();\n }\n if(transition){\n  transition.time+=dt;const t=Math.min(transition.time/P.focusSeconds,1),s=t*t*(3-2*t);\n  camera.position.lerpVectors(transition.from,transition.position,s);controls.target.lerpVectors(transition.targetFrom,transition.target,s);\n  if(t===1)transition=null;\n }\n controls.update();renderer.render(scene,camera);\n}\nanimate();\n}catch(error){showError(error.message);}\n</script>\n</body>\n</html>", "metrics": [{"label": "总热负荷", "value": "1200", "unit": "kW", "note": "以页面实时计算为准"}, {"label": "二次侧流量", "value": "1809.9547511312217", "unit": "L/min", "note": "以页面实时计算为准"}, {"label": "二次侧供回液温差", "value": "10.0", "unit": "K", "note": "以页面实时计算为准"}, {"label": "板换 approach 温差", "value": "14.0", "unit": "K", "note": "以页面实时计算为准"}, {"label": "泵水力功率", "value": "7.54", "unit": "kW", "note": "以页面实时计算为准"}, {"label": "泵功占 IT 负荷", "value": "0.97", "unit": "%", "note": "以页面实时计算为准"}], "suggestions": ["加入泵曲线与支路压降，比较隔离后流量", "增加备泵切换瞬态与供液温度变化", "比较温水工况下板换选型与机柜温限"], "raw": "<<<SUMMARY>>>\n已构建列级 CDU 与成列液冷机柜的交互系统，包含板换、主备泵、调节阀、过滤补液、传感器及供回液主管，支路示意快接、隔离阀和冷板。支持正常、备泵接管、漏液隔离和温水冷却工况，并提供热点聚焦与阶段讲解。本模型为系统级示意与集总参数估算，部件几何采用示意比例；按定热负荷、定设计温差及固定系统阻力计算，不代表瞬态仿真或设备选型结果。\n<<<HTML>>>\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>AIDC 列级 CDU 系统</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;left:12px;top:12px;max-width:300px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;padding:10px;font-size:12px;color:#263343}\n.row{margin:5px 0;line-height:1.5}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px}\nbutton:hover,button.active{border-color:#b11f4b}\n#buttons{display:flex;flex-wrap:wrap;gap:4px}\n#err{display:none;position:absolute;top:45%;left:15%;right:15%;color:#b00020;background:white;padding:20px;text-align:center}\n#hint{position:absolute;bottom:12px;right:12px;background:#ffffffd9;padding:7px;border-radius:6px;font-size:12px}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<div class=\"row\"><b>AIDC 列级 CDU · 系统级示意</b></div>\n<div id=\"modes\" class=\"row\"></div>\n<div id=\"heat\" class=\"row\"></div>\n<div id=\"thermal\" class=\"row\"></div>\n<div id=\"power\" class=\"row\"></div>\n<div id=\"primary\" class=\"row\"></div>\n<div id=\"status\" class=\"row\"></div>\n<div class=\"row\"><span style=\"color:#7c3aed\">● 一次水</span>　<span style=\"color:#0891b2\">● 供液</span>　<span style=\"color:#dc2626\">● 回液</span></div>\n<div class=\"row\">灰：金属设备　深蓝：电子件　编号：部件热点</div>\n<div id=\"stage\" class=\"row\"></div>\n<div id=\"buttons\"><button id=\"cut\">剖切视图</button><button id=\"rotate\">自动旋转</button><button id=\"pause\">暂停</button><button id=\"reset\">全局</button></div>\n</div>\n<div id=\"hint\">拖动旋转 · 滚轮缩放 · 点击编号聚焦；管线与设备为示意连接</div>\n<div id=\"err\"></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nconst P = {\n // 尺寸单位 mm；密度 kg/m³，比热 J/(kg·K)，压差 Pa\n racks:8, rackKW:150, rho:1020, cp:3900, primaryRho:998, primaryCp:4180,\n supplyC:32, primaryC:18, warmC:32, deltaS:10, deltaP:12, designApproach:4,\n pressure:250000, efficiency:.65, switchSeconds:2, normalValve:55, warmValve:95,\n rackW:600,rackH:1900,rackD:850,pitch:760,rackStart:1600,\n cduW:1100,cduH:2100,cduD:950,hxW:380,hxH:800,hxD:340,\n pumpR:125,pumpL:280,tankR:110,tankH:420,filterR:85,filterH:280,\n valveR:70,valveL:120,sensorR:35,sensorH:90,plateW:430,plateH:24,plateD:390,\n plateCount:8,plateStep:180,plateBase:300,supplyY:380,returnY:1500,headerZ:680,\n headerR:45,branchR:18,primaryR:40,particleR:15,particles:30,speed:.038,\n shellOpacity:.12,stageSeconds:5,focusSeconds:.6,tubeSegments:40,radialSegments:8,\n colors:{primary:'#7c3aed',supply:'#0891b2',hot:'#dc2626',al:'#d4d9e0',steel:'#9aa3ab',electronic:'#1f4e79'},\n modes:[\n {name:'① 正常',active:8,pump:1,warm:false,valve:55},\n {name:'② 备泵',active:8,pump:2,warm:false,valve:55},\n {name:'③ 隔离',active:7,pump:1,warm:false,valve:55},\n {name:'④ 温水',active:8,pump:1,warm:true,valve:95}],\n loops:[]\n};\nconst errorBox=document.getElementById('err');\nfunction showError(message){errorBox.style.display='block';errorBox.textContent='模型错误：'+message;}\nwindow.addEventListener('error',e=>showError(e.message));\ntry {\nconst scene=new THREE.Scene();\nscene.background=new THREE.Color('#f7f4ef');\nconst renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));\nrenderer.setSize(innerWidth,innerHeight);\ndocument.body.appendChild(renderer.domElement);\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\nconst controls=new OrbitControls(camera,renderer.domElement);\ncontrols.enableDamping=true;controls.autoRotate=true;controls.autoRotateSpeed=1;\nscene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\nconst light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(2000,5000,3500);scene.add(light);\nconst fill=new THREE.DirectionalLight(0xffffff,.8);fill.position.set(-3000,2000,-2000);scene.add(fill);\nconst model=new THREE.Group();scene.add(model);\nconst parts={},sprites=[],flows=[],shells=[],hotspots=[];\nlet modeIndex=0,stageIndex=0,paused=false,stageClock=0,focused=null,transition=null,cut=false;\nconst V=a=>new THREE.Vector3(...a);\nfunction material(color,opacity=1){return new THREE.MeshStandardMaterial({color,metalness:.2,roughness:.6,transparent:opacity<1,opacity,depthWrite:opacity===1});}\nfunction box(g,w,h,d,x,y,z,color,opacity=1){\n const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material(color,opacity));\n m.position.set(x,y,z);m.userData.baseOpacity=opacity;g.add(m);return m;\n}\nfunction cyl(g,r,h,x,y,z,color,axis='y'){\n const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,16),material(color));\n if(axis==='x')m.rotation.z=Math.PI/2;if(axis==='z')m.rotation.x=Math.PI/2;\n m.position.set(x,y,z);m.userData.baseOpacity=1;g.add(m);return m;\n}\nfunction component(id,label,part,note,x,y,z){\n const g=new THREE.Group();g.name=id;g.position.set(x,y,z);model.add(g);parts[id]=g;\n hotspots.push({id,n:hotspots.length+1,label,part,note});return g;\n}\nconst cdu=new THREE.Group();cdu.name='cdu_shell';model.add(cdu);\nshells.push(box(cdu,P.cduW,P.cduH,P.cduD,0,P.cduH/2,0,P.colors.steel,P.shellOpacity));\nconst hx=component('hx','钎焊板式换热器','板式换热器','隔离两侧介质并把机柜热量传给设施水',-220,1200,0);\nbox(hx,P.hxW,P.hxH,P.hxD,0,0,0,P.colors.al);\nfor(let i=0;i<18;i++)box(hx,P.hxW+8,P.hxH,4,0,0,-P.hxD/2+i*P.hxD/17,P.colors.steel);\nfor(let i=1;i<=2;i++){\n const g=component('pump'+i,'变频电子水泵 '+i,'电子水泵',i===1?'正常运行主泵，为二次侧提供压头':'备用泵，主泵故障后自动接管',i===1?-230:230,300,0);\n cyl(g,P.pumpR,P.pumpL,0,0,0,P.colors.electronic,'z');\n box(g,220,45,300,0,-P.pumpR,0,P.colors.steel);\n}\nconst pv=component('pvalve','一次侧比例调节阀','电子水阀','调节一次侧流量以稳定二次侧供液温度',-620,1150,0);\ncyl(pv,P.valveR,P.valveL,0,0,0,P.colors.steel,'y');box(pv,110,130,100,0,100,0,P.colors.electronic);\nconst filter=component('filter','二次侧过滤器','配套过滤器','截留颗粒，保护冷板及调节元件',400,620,220);\ncyl(filter,P.filterR,P.filterH,0,0,0,P.colors.steel);\nconst tank=component('tank','膨胀 / 补液罐','配套补液罐','容纳热膨胀并维持系统液位',270,1600,-50);\ncyl(tank,P.tankR,P.tankH,0,0,0,P.colors.al);\nconst sensors=component('sensors','供回液温压流传感器','配套传感器','监测两侧主管温度、压力与流量',670,850,P.headerZ);\nfor(let i=0;i<3;i++)cyl(sensors,P.sensorR,P.sensorH,0,i*110,0,P.colors.electronic,'z');\nconst facility=component('facility','设施水接口','一次侧设施水接口','一次侧进水与回水接入设施冷源',-1000,800,0);\nbox(facility,260,450,300,0,0,0,P.colors.steel);\nconst endX=P.rackStart+(P.racks-1)*P.pitch;\nfor(const [id,label,y,color] of [['manifold_s','二次侧供液主管',P.supplyY,P.colors.supply],['manifold_r','二次侧回液主管',P.returnY,P.colors.hot]]){\n const g=component(id,label,'热管理集成模块','向机柜分配冷却液或收集升温回液',(endX+700)/2,y,P.headerZ);\n cyl(g,P.headerR*.95,endX-700+160,0,0,0,color,'x');\n}\nfor(let i=1;i<=P.racks;i++){\n const x=P.rackStart+(i-1)*P.pitch;\n const g=component('rack'+i,'机柜 '+i+' · GPU 冷板','液冷冷板','冷板吸收 GPU 热量，经快接及隔离阀连接主管',x,0,0);\n shells.push(box(g,P.rackW,P.rackH,P.rackD,0,P.rackH/2,0,P.colors.steel,P.shellOpacity));\n for(const sx of [-1,1])box(g,25,P.rackH,25,sx*(P.rackW/2-15),P.rackH/2,P.rackD/2,P.colors.steel);\n for(const y of [P.supplyY,P.returnY]){\n  cyl(g,P.branchR*1.6,60,0,y,P.headerZ-65,P.colors.steel,'z');\n  cyl(g,P.valveR*.55,P.valveL*.65,0,y,P.headerZ-145,P.colors.electronic,'z');\n }\n for(const z of [-125,125])cyl(g,P.branchR,P.plateStep*(P.plateCount-1)+160,0,P.plateBase+P.plateStep*(P.plateCount-1)/2,z,P.colors.supply);\n}\nconst plates=new THREE.InstancedMesh(new THREE.BoxGeometry(P.plateW,P.plateH,P.plateD),material(P.colors.al),P.racks*P.plateCount);\nconst matrix=new THREE.Matrix4();\nfor(let i=0;i<P.racks;i++)for(let j=0;j<P.plateCount;j++){\n matrix.makeTranslation(P.rackStart+i*P.pitch,P.plateBase+j*P.plateStep,0);plates.setMatrixAt(i*P.plateCount+j,matrix);\n plates.setColorAt(i*P.plateCount+j,new THREE.Color('white'));\n}\nplates.instanceMatrix.needsUpdate=true;plates.computeBoundingSphere();model.add(plates);\nconst rv=component('rvalve5','机柜 5 隔离电子水阀','电子水阀','漏液工况关闭支路，停止机柜供回液',P.rackStart+4*P.pitch,P.supplyY,P.headerZ-145);\nbox(rv,100,110,95,0,75,0,P.colors.electronic);\nfunction addLoop(id,label,color,radius,points,closed,kind,rack=0){\n const loop={id,label,color,radius,flow_lpm:0,points,closed,kind,rack};P.loops.push(loop);\n const curve=new THREE.CatmullRomCurve3(points.map(V),closed,'centripetal');\n const tube=new THREE.Mesh(new THREE.TubeGeometry(curve,P.tubeSegments,radius,P.radialSegments,closed),material(color,.55));\n tube.name=id;model.add(tube);\n const dots=new THREE.InstancedMesh(new THREE.SphereGeometry(P.particleR,6,4),material(color),P.particles);\n for(let i=0;i<P.particles;i++){matrix.makeTranslation(...curve.getPointAt(i/P.particles).toArray());dots.setMatrixAt(i,matrix);}\n dots.instanceMatrix.needsUpdate=true;dots.computeBoundingSphere();model.add(dots);\n flows.push({loop,curve,tube,dots,t:0,active:true});\n}\naddLoop('primary','设施水回路',P.colors.primary,P.primaryR,[[-1000,700,0],[-620,700,0],[-620,1150,0],[-220,1100,-190],[-220,1500,-190],[-1000,1500,-190]],true,'primary');\naddLoop('secondary_supply','二次侧供液',P.colors.supply,P.headerR,[[400,620,220],[650,P.supplyY,P.headerZ],[P.rackStart,P.supplyY,P.headerZ],[endX,P.supplyY,P.headerZ]],false,'supply');\naddLoop('secondary_return','二次侧回液',P.colors.hot,P.headerR,[[endX,P.returnY,P.headerZ],[P.rackStart,P.returnY,P.headerZ],[650,P.returnY,P.headerZ],[-220,1400,190],[-220,950,190]],false,'return');\nfor(let i=1;i<=2;i++)addLoop('pump_path'+i,'泵 '+i+' 通路',P.colors.supply,P.headerR,[[-220,950,190],[i===1?-230:230,600,100],[i===1?-230:230,300,160],[400,400,220],[400,620,220]],false,'pump',i);\nfor(let i=1;i<=P.racks;i++){\n const x=P.rackStart+(i-1)*P.pitch;\n addLoop('rack_branch'+i,'机柜 '+i+' 支路',P.colors.supply,P.branchR,[[x,P.supplyY,P.headerZ],[x,P.supplyY,125],[x,P.plateBase,125],[x,P.plateBase,-125],[x,P.returnY,-125],[x,P.returnY,P.headerZ]],false,'rack',i);\n}\n // 供液到回液沿支路渐变；每条回路保留独立参数及动画\nfor(const f of flows){\n const pos=f.tube.geometry.attributes.position,colors=[];\n for(let i=0;i<pos.count;i++){\n  const t=i/(pos.count-1),c=new THREE.Color(f.loop.color);\n  if(f.loop.kind==='rack')c.lerp(new THREE.Color(P.colors.hot),t);\n  if(f.loop.kind==='primary')c.lerp(new THREE.Color(P.colors.hot),Math.max(0,(t-.55)*.8));\n  colors.push(c.r,c.g,c.b);\n }\n f.tube.geometry.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));\n f.tube.material.vertexColors=true;f.tube.material.color.set('white');\n}\nfor(const h of hotspots){\n const g=parts[h.id],b=new THREE.Box3().setFromObject(g,true),p=b.getCenter(new THREE.Vector3());p.y=b.max.y+95;\n const canvas=document.createElement('canvas');canvas.width=64;canvas.height=64;const ctx=canvas.getContext('2d');\n ctx.beginPath();ctx.arc(32,32,29,0,Math.PI*2);ctx.fillStyle='white';ctx.fill();ctx.strokeStyle='#b11f4b';ctx.lineWidth=1;ctx.stroke();\n ctx.fillStyle='#263343';ctx.font='bold 27px Segoe UI';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(h.n,3