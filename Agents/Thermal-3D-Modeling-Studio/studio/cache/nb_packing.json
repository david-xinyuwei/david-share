{"ok": true, "summary": "已构建彩盒、五台装外箱、托盘与高柜四级模型，支持三方案及三级视角切换。标准外箱385×275×340毫米，紧凑外箱365×265×320毫米；每柜分别装3600、8400、3600台。采用朝向枚举的规则排布，非启发式装箱求解器；假定彩盒尺寸为装载包络，未计封箱搭接、重量分布与绑扎，柜载重须另核。", "html": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>包装与装载方案</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;top:12px;left:12px;max-width:300px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;padding:10px;font-size:12px;line-height:1.65}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px;margin:2px 1px}\nbutton:hover,button.active{border-color:#b11f4b}\n#err{position:absolute;top:45%;left:15%;right:15%;text-align:center;color:#b00020;background:#fff}\n#compare{position:absolute;bottom:10px;right:10px;background:rgba(255,255,255,.9);border:1px solid #dedede;border-radius:8px;padding:8px;font-size:12px;max-width:95vw;overflow:auto}\ntable{border-collapse:collapse}td,th{padding:4px 7px;text-align:right;border-bottom:1px solid #eee}\n.small{font-size:11px;color:#666}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<strong>14英寸笔记本 · 包装装载</strong>\n<div id=\"name\"></div>\n<div id=\"count\"></div>\n<div id=\"dims\"></div>\n<div id=\"layout\"></div>\n<div id=\"weight\"></div>\n<div id=\"legend\">白：彩盒　棕：外箱　深木：托盘<br>浅红：未利用空间　银：整机</div>\n<div><button data-s=\"0\">①标准</button><button data-s=\"1\">②地板</button><button data-s=\"2\">③紧凑</button></div>\n<div><button data-v=\"box\">单箱剖视</button><button data-v=\"pallet\">单托盘</button><button data-v=\"container\">整柜</button></div>\n<div><button id=\"cut\">剖切视图</button><button id=\"explode\">爆炸视图</button><button id=\"rotate\">自动旋转</button></div>\n<div id=\"status\" class=\"small\">规则朝向枚举；不含绑扎与重量分布校核</div>\n</div>\n<div id=\"compare\"></div><div id=\"err\" hidden></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nimport { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nconst P = {\n  // 长宽高均为毫米；质量为kg，纸板面密度为kg/m²\n  retail:[355,245,62],compact:[335,235,58],gross:[2.4,2.4,2.25],\n  perCarton:5,gap:10,board:5,boardDensity:.75,\n  pallet:[1200,1000,150],maxHeight:1800,maxLoad:1000,palletMass:22,\n  container:[12032,2352,2698],floorHeight:2600,carbon:1200,\n  pulp:[.18,.18,.12],retailMass:[.26,.26,.23],\n  deck:25,runnerWidth:90,shell:2,bufferHeight:20,laptop:[301,220,14.5],\n  // 包材表观颜色与渲染参数\n  colors:{retail:'#f5f5f4',edge:'#b11f4b',carton:'#c8a165',pallet:'#a16207',buffer:'#ede4d3'},\n  metalness:.85,roughness:.35,plasticRoughness:.6\n};\nconst errorBox=document.getElementById('err');\nfunction showError(message){errorBox.hidden=false;errorBox.textContent='模型错误：'+message;}\nwindow.addEventListener('error',e=>showError(e.message));\ntry {\nconst renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.localClippingEnabled=true;\ndocument.body.prepend(renderer.domElement);\nconst scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\nscene.environment=new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(),.04).texture;\nscene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\nconst light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(3000,7000,5000);scene.add(light);\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\nconst controls=new OrbitControls(camera,renderer.domElement);controls.enableDamping=true;\ncontrols.autoRotate=true;controls.autoRotateSpeed=1;\ncontrols.addEventListener('start',()=>controls.autoRotate=false);\nconst modelGroup=new THREE.Group();scene.add(modelGroup);\nlet scheme=0,view='container',cut=false,exploded=false,laptop=null,slot=null,loadFailed=false;\nconst names=['① 标准托盘装柜','② 地板直接装载','③ 紧凑包装托盘装柜'];\nfunction planar(area,box){\n  return [[box[0],box[1]],[box[1],box[0]]].map(d=>({d,nx:Math.floor(area[0]/d[0]),nz:Math.floor(area[1]/d[1])}))\n  .map(o=>({...o,count:o.nx*o.nz})).sort((a,b)=>b.count-a.count)[0];\n}\nfunction spatial(c,h){\n  return [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]].map(a=>{\n    const d=a.map(i=>c[i]),nx=Math.floor(P.container[0]/d[0]),nz=Math.floor(P.container[1]/d[1]),ny=Math.floor(h/d[2]);\n    return {d,nx,nz,ny,count:nx*nz*ny};\n  }).sort((a,b)=>b.count-a.count)[0];\n}\nfunction compute(s){\n  const r=s===2?P.compact:P.retail,c=[r[0]+2*(P.gap+P.board),r[1]+2*(P.gap+P.board),r[2]*P.perCarton+2*(P.gap+P.board)];\n  const cardboard=2*(c[0]*c[1]+c[0]*c[2]+c[1]*c[2])/1e6*P.boardDensity;\n  const layer=planar(P.pallet,c),caseMass=P.perCarton*P.gross[s]+cardboard;\n  const layers=Math.min(Math.floor((P.maxHeight-P.pallet[2])/c[2]),Math.floor((P.maxLoad-P.palletMass)/(layer.count*caseMass)));\n  const perPallet=layer.count*layers*P.perCarton,packing=planar(P.container,P.pallet);\n  const floor=spatial(c,P.floorHeight),total=s===1?floor.count*P.perCarton:packing.count*perPallet;\n  const utilization=total*r[0]*r[1]*r[2]/(P.container[0]*P.container[1]*P.container[2])*100;\n  const material=(cardboard/P.perCarton+P.pulp[s]+P.retailMass[s]+(s===1?0:P.palletMass/perPallet))*1000;\n  const metrics=[\n    {label:'每箱台数',value:String(P.perCarton),unit:'台',note:'假设彩盒最短边堆叠'},\n    {label:'每托盘台数',value:s===1?'—（地板装载）':String(perPallet),unit:s===1?'':'台',note:'假设规则整层，限重含托盘'},\n    {label:'每柜总台数',value:String(total),unit:'台',note:s===1?'假设六朝向规则排布，堆高≤2600mm':'假设托盘不堆码，未扣绑扎空间'},\n    {label:'集装箱容积利用率(%)',value:utilization.toFixed(2),unit:'%',note:'假设按彩盒包络总体积计算'},\n    {label:'每台包装材料质量(g)',value:material.toFixed(1),unit:'g',note:'假设纸板0.75kg/m²，不计搭接辅材'},\n    {label:'每台海运碳排放(kg CO₂e)',value:(P.carbon/total).toFixed(3),unit:'kg CO₂e',note:'假设全程每柜1200kg CO₂e均摊'}\n  ];\n  return {r,c,cardboard,layer,layers,perPallet,packing,floor,total,metrics,caseMass};\n}\nconst results=[0,1,2].map(compute);\ndocument.getElementById('compare').innerHTML='<table><tr><th>指标</th><th>①标准</th><th>②地板</th><th>③紧凑</th></tr>'+\nresults[0].metrics.map((m,i)=>'<tr><td>'+m.label+'</td>'+results.map(r=>'<td>'+r.metrics[i].value+'</td>').join('')+'</tr>').join('')+\n'</table><div class=\"small\">②涉及侧放，须校核抗压；容积率不等于外箱占柜率。柜限重未给定。</div>';\nconst boxGeo=new THREE.BoxGeometry(1,1,1),matrix=new THREE.Matrix4();\nfunction mat(color,opacity=1){return new THREE.MeshStandardMaterial({color,metalness:0,roughness:P.plasticRoughness,transparent:opacity<1,opacity,depthWrite:opacity===1});}\nfunction cube(parent,d,pos,color,opacity=1,edges=false){\n  const mesh=new THREE.Mesh(boxGeo,mat(color,opacity));mesh.scale.set(d[0],d[2],d[1]);mesh.position.set(...pos);parent.add(mesh);\n  if(edges){const edge=new THREE.LineSegments(new THREE.EdgesGeometry(boxGeo),new THREE.LineBasicMaterial({color:color===P.colors.retail?P.colors.edge:'#927c64'}));mesh.add(edge);}\n  return mesh;\n}\nfunction instances(parent,items,color){\n  if(!items.length)return;\n  const mesh=new THREE.InstancedMesh(boxGeo,mat(color),items.length);\n  items.forEach((a,i)=>{matrix.makeScale(a.d[0],a.d[2],a.d[1]);matrix.setPosition(...a.p);mesh.setMatrixAt(i,matrix);});\n  mesh.instanceMatrix.needsUpdate=true;mesh.computeBoundingSphere();parent.add(mesh);return mesh;\n}\nfunction palletItems(items,x,z){\n  const [l,w,h]=P.pallet,t=P.deck;\n  items.push({d:[l,w,t],p:[x+l/2,h-t/2,z+w/2]},{d:[l,w,t],p:[x+l/2,t/2,z+w/2]});\n  for(let i=0;i<3;i++)items.push({d:[l,P.runnerWidth,h-2*t],p:[x+l/2,h/2,z+P.runnerWidth/2+i*(w-P.runnerWidth)/2]});\n}\nfunction waste(parent,d,p){if(Math.min(...d)>0)cube(parent,d,p,'#e9a5a5',.16);}\nfunction fit(){\n  const b=new THREE.Box3().setFromObject(modelGroup,true),size=b.getSize(new THREE.Vector3()),center=b.getCenter(new THREE.Vector3());\n  const fov=THREE.MathUtils.degToRad(40),angle=Math.min(fov,2*Math.atan(Math.tan(fov/2)*camera.aspect));\n  const distance=size.length()/2/Math.sin(angle/2)*1.12;\n  controls.target.copy(center);camera.position.copy(center).add(new THREE.Vector3(1,.7,1.2).normalize().multiplyScalar(distance));\n  camera.far=Math.max(20000,distance*3);camera.updateProjectionMatrix();controls.update();\n}\nfunction rebuild(){\n  if(laptop)laptop.removeFromParent();slot=null;\n  modelGroup.traverse(o=>{if(o.material){(Array.isArray(o.material)?o.material:[o.material]).forEach(m=>m.dispose());}if(o.geometry&&o.geometry!==boxGeo)o.geometry.dispose();if(o.isInstancedMesh)o.dispose();});\n  modelGroup.clear();const a=results[scheme],{r,c,layer,layers,packing}=a;\n  window.__metrics=a.metrics;\n  document.getElementById('name').textContent=names[scheme];\n  document.getElementById('count').textContent=`每柜 ${a.total} 台；较① ${((a.total/results[0].total-1)*100)>=0?'+':''}${((a.total/results[0].total-1)*100).toFixed(1)}%`;\n  document.getElementById('dims').textContent=`彩盒 ${r.join('×')}；外箱 ${c.join('×')} mm`;\n  document.getElementById('layout').textContent=scheme===1?`柜内 X×Z×Y：${a.floor.nx}×${a.floor.nz}×${a.floor.ny} 箱`:`每层 ${layer.nx}×${layer.nz} 箱 × ${layers} 层；${packing.count} 托/柜`;\n  document.getElementById('weight').textContent=scheme===1?`估计整柜货重 ${(a.floor.count*a.caseMass/1000).toFixed(2)} t`:`单托含托盘 ${(layer.count*layers*a.caseMass+P.palletMass).toFixed(1)} / ${P.maxLoad} kg`;\n  const cases=[],wood=[];\n  if(view==='box'){\n    const shell=new THREE.Group();modelGroup.add(shell);const t=P.board;\n    [[c[0],c[1],t,0,t/2,0],[t,c[1],c[2],-c[0]/2+t/2,c[2]/2,0],[c[0],t,c[2],0,c[2]/2,-c[1]/2+t/2]].forEach(b=>cube(shell,b.slice(0,3),b.slice(3),P.colors.carton));\n    if(!cut){cube(shell,[t,c[1],c[2]],[c[0]/2-t/2,c[2]/2,0],P.colors.carton,.15);cube(shell,[c[0],t,c[2]],[0,c[2]/2,c[1]/2-t/2],P.colors.carton,.15);}\n    for(let i=0;i<P.perCarton;i++){\n      const y=t+P.gap+i*(r[2]+(exploded?35:0)),g=new THREE.Group();g.position.y=y;modelGroup.add(g);\n      if(i<P.perCarton-1){cube(g,r,[0,r[2]/2,0],P.colors.retail,1,true);continue;}\n      const s=P.shell;cube(g,[r[0],r[1],s],[0,s/2,0],P.colors.retail,1,true);\n      for(const sign of [-1,1]){\n        cube(g,[s,r[1],r[2]],[sign*(r[0]-s)/2,r[2]/2,0],P.colors.retail,1,true);\n        cube(g,[r[0],s,r[2]],[0,r[2]/2,sign*(r[1]-s)/2],P.colors.retail,.25,true);\n        const bw=(r[0]-P.laptop[0])/2-s;\n        cube(g,[bw,r[1]-2*s,P.bufferHeight],[sign*(P.laptop[0]/2+bw/2),s+P.bufferHeight/2,0],P.colors.buffer);\n        const bd=(r[1]-P.laptop[1])/2-s;\n        cube(g,[P.laptop[0],bd,P.bufferHeight],[0,s+P.bufferHeight/2,sign*(P.laptop[1]/2+bd/2)],P.colors.buffer);\n      }\n      cube(g,[r[0],s,r[1]],[0,r[1]/2,-r[1]/2],P.colors.retail,1,true);\n      slot=new THREE.Group();slot.position.y=(r[2]-P.laptop[2])/2;g.add(slot);\n      if(laptop)slot.add(laptop);else cube(slot,P.laptop,[0,P.laptop[2]/2,0],'#cfd0cc',.45);\n    }\n  }else{\n    const single=view==='pallet',floor=scheme===1,group=new THREE.Group();modelGroup.add(group);\n    const n=floor?1:(single?1:packing.count);\n    for(let p=0;p<n;p++){\n      const nx=single?1:packing.nx,x=single?0:(p%nx)*packing.d[0],z=single?0:Math.floor(p/nx)*packing.d[1];\n      const dims=floor?a.floor.d:layer.d,xx=floor?(single?Math.floor(P.pallet[0]/dims[0]):a.floor.nx):layer.nx;\n      const zz=floor?(single?Math.floor(P.pallet[1]/dims[1]):a.floor.nz):layer.nz,yy=floor?a.floor.ny:layers,h=floor?dims[2]:c[2];\n      const sub=new THREE.Group();sub.position.set(x,0,z);group.add(sub);\n      if(!floor&&packing.d[0]!==P.pallet[0]&&!single){sub.rotation.y=-Math.PI/2;sub.position.x+=P.pallet[1];}\n      const localCases=[],localWood=[];\n      if(!floor)palletItems(localWood,0,0);\n      for(let j=0;j<yy;j++)for(let k=0;k<zz;k++)for(let i=0;i<xx;i++)localCases.push({d:[dims[0],dims[1],h],p:[(i+.5)*dims[0],(floor?0:P.pallet[2])+(j+.5)*h+(exploded?j*45:0),(k+.5)*dims[1]]});\n      instances(sub,localWood,P.colors.pallet);instances(sub,localCases,P.colors.carton);\n    }\n    if(!single){\n      const [l,w,h]=P.container;\n      const enclosure=cube(modelGroup,P.container,[l/2,h/2,w/2],'#9aa3ab',.12,true);enclosure.visible=!cut;\n      const ux=floor?a.floor.nx*a.floor.d[0]:packing.nx*packing.d[0],uz=floor?a.floor.nz*a.floor.d[1]:packing.nz*packing.d[1];\n      const uy=floor?a.floor.ny*a.floor.d[2]:P.pallet[2]+layers*c[2];\n      waste(modelGroup,[l-ux,w,h],[(l+ux)/2,h/2,w/2]);waste(modelGroup,[ux,w-uz,h],[ux/2,h/2,(w+uz)/2]);waste(modelGroup,[ux,uz,h-uy],[ux/2,(h+uy)/2,uz/2]);\n      if(!floor)for(let k=0;k<packing.nz;k++)for(let i=0;i<packing.nx;i++){\n        const x=i*P.pallet[0],z=k*P.pallet[1],dx=layer.nx*layer.d[0],dz=layer.nz*layer.d[1],hh=layers*c[2];\n        waste(modelGroup,[P.pallet[0]-dx,P.pallet[1],hh],[x+(P.pallet[0]+dx)/2,P.pallet[2]+hh/2,z+P.pallet[1]/2]);\n        waste(modelGroup,[dx,P.pallet[1]-dz,hh],[x+dx/2,P.pallet[2]+hh/2,z+(P.pallet[1]+dz)/2]);\n      }\n      cube(modelGroup,[8,w,12],[l,h, w/2],P.colors.edge);\n    }\n    if(cut){const plane=new THREE.Plane(new THREE.Vector3(0,0,-1),single?P.pallet[1]*.5:P.container[1]*.5);group.traverse(o=>{if(o.material)o.material.clippingPlanes=[plane];});}\n  }\n  document.querySelectorAll('[data-s]').forEach(b=>b.classList.toggle('active',+b.dataset.s===scheme));\n  document.querySelectorAll('[data-v]').forEach(b=>b.classList.toggle('active',b.dataset.v===view));\n  document.getElementById('cut').textContent=cut?'完整视图':'剖切视图';\n  document.getElementById('status').textContent=(loadFailed?'整机素材加载失败，使用半透明包络。':view==='pallet'&&scheme===1?'地板方案：显示1200×1000参考区，无托盘。':'规则排布；柜门为+X端红线。')+(view==='box'?' 适配器仅预留，未建实体。':'');\n  fit();\n}\nwindow.__scene=scene;window.__camera=camera;window.__renderer=renderer;window.__controls=controls;window.__model=modelGroup;\ndocument.querySelectorAll('[data-s]').forEach(b=>b.onclick=()=>{scheme=+b.dataset.s;rebuild();});\ndocument.querySelectorAll('[data-v]').forEach(b=>b.onclick=()=>{view=b.dataset.v;exploded=false;rebuild();});\ndocument.getElementById('cut').onclick=()=>{cut=!cut;rebuild();};\ndocument.getElementById('explode').onclick=()=>{exploded=!exploded;rebuild();};\ndocument.getElementById('rotate').onclick=()=>controls.autoRotate=!controls.autoRotate;\nrebuild();\nnew GLTFLoader().load('/static/assets/notebook/laptop14_closed.glb',g=>{\n  laptop=g.scene;laptop.traverse(o=>{if(!o.isMesh)return;const n=o.name.toLowerCase();\n    o.material=new THREE.MeshStandardMaterial(n.startsWith('keys')?{color:'#2a2b2e',metalness:.1,roughness:.55}:n.startsWith('touchpad')?{color:'#dcdcd8',metalness:.3,roughness:.25}:n.startsWith('hinge_')||n.startsWith('feet')?{color:'#1c1c1e',roughness:.6}:{color:'#cfd0cc',metalness:.85,roughness:.32});\n  });if(slot){slot.clear();slot.add(laptop);}\n},undefined,()=>{loadFailed=true;document.getElementById('status').textContent='整机素材加载失败，使用半透明尺寸包络。';});\nwindow.addEventListener('resize',()=>{renderer.setSize(innerWidth,innerHeight);camera.aspect=innerWidth/innerHeight;fit();});\nrenderer.setAnimationLoop(()=>{controls.update();renderer.render(scene,camera);});\n}catch(error){showError(error.message);}\n</script>\n</body>\n</html>", "metrics": [{"label": "每箱台数", "value": "5", "unit": "台", "note": "假设彩盒最短边堆叠"}, {"label": "每托盘台数", "value": "180", "unit": "台", "note": "假设规则整层，限重含托盘"}, {"label": "每柜总台数", "value": "3600", "unit": "台", "note": "假设托盘不堆码，未扣绑扎空间"}, {"label": "集装箱容积利用率(%)", "value": "25.42", "unit": "%", "note": "假设按彩盒包络总体积计算"}, {"label": "每台包装材料质量(g)", "value": "661.3", "unit": "g", "note": "假设纸板0.75kg/m²，不计搭接辅材"}, {"label": "每台海运碳排放(kg CO₂e)", "value": "0.333", "unit": "kg CO₂e", "note": "假设全程每柜1200kg CO₂e均摊"}], "suggestions": ["加入柜载重与绑扎间隙重新计算", "比较混合朝向与交错码放的装载量", "细化适配器仓并校核紧凑包装缓冲"], "raw": "<<<SUMMARY>>>\n已构建彩盒、五台装外箱、托盘与高柜四级模型，支持三方案及三级视角切换。标准外箱385×275×340毫米，紧凑外箱365×265×320毫米；每柜分别装3600、8400、3600台。采用朝向枚举的规则排布，非启发式装箱求解器；假定彩盒尺寸为装载包络，未计封箱搭接、重量分布与绑扎，柜载重须另核。\n<<<HTML>>>\n<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>包装与装载方案</title>\n<style>\nhtml,body{margin:0;overflow:hidden;height:100%;font-family:\"Segoe UI\",sans-serif}\ncanvas{display:block}\n#panel{position:absolute;top:12px;left:12px;max-width:300px;background:rgba(255,255,255,.88);border:1px solid #dedede;border-radius:8px;padding:10px;font-size:12px;line-height:1.65}\nbutton{background:white;border:1px solid #dedede;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:12px;margin:2px 1px}\nbutton:hover,button.active{border-color:#b11f4b}\n#err{position:absolute;top:45%;left:15%;right:15%;text-align:center;color:#b00020;background:#fff}\n#compare{position:absolute;bottom:10px;right:10px;background:rgba(255,255,255,.9);border:1px solid #dedede;border-radius:8px;padding:8px;font-size:12px;max-width:95vw;overflow:auto}\ntable{border-collapse:collapse}td,th{padding:4px 7px;text-align:right;border-bottom:1px solid #eee}\n.small{font-size:11px;color:#666}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"/static/vendor/three/three.module.js\",\"three/addons/\":\"/static/vendor/three/jsm/\"}}</script>\n</head>\n<body>\n<div id=\"panel\">\n<strong>14英寸笔记本 · 包装装载</strong>\n<div id=\"name\"></div>\n<div id=\"count\"></div>\n<div id=\"dims\"></div>\n<div id=\"layout\"></div>\n<div id=\"weight\"></div>\n<div id=\"legend\">白：彩盒　棕：外箱　深木：托盘<br>浅红：未利用空间　银：整机</div>\n<div><button data-s=\"0\">①标准</button><button data-s=\"1\">②地板</button><button data-s=\"2\">③紧凑</button></div>\n<div><button data-v=\"box\">单箱剖视</button><button data-v=\"pallet\">单托盘</button><button data-v=\"container\">整柜</button></div>\n<div><button id=\"cut\">剖切视图</button><button id=\"explode\">爆炸视图</button><button id=\"rotate\">自动旋转</button></div>\n<div id=\"status\" class=\"small\">规则朝向枚举；不含绑扎与重量分布校核</div>\n</div>\n<div id=\"compare\"></div><div id=\"err\" hidden></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\nimport { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nconst P = {\n  // 长宽高均为毫米；质量为kg，纸板面密度为kg/m²\n  retail:[355,245,62],compact:[335,235,58],gross:[2.4,2.4,2.25],\n  perCarton:5,gap:10,board:5,boardDensity:.75,\n  pallet:[1200,1000,150],maxHeight:1800,maxLoad:1000,palletMass:22,\n  container:[12032,2352,2698],floorHeight:2600,carbon:1200,\n  pulp:[.18,.18,.12],retailMass:[.26,.26,.23],\n  deck:25,runnerWidth:90,shell:2,bufferHeight:20,laptop:[301,220,14.5],\n  // 包材表观颜色与渲染参数\n  colors:{retail:'#f5f5f4',edge:'#b11f4b',carton:'#c8a165',pallet:'#a16207',buffer:'#ede4d3'},\n  metalness:.85,roughness:.35,plasticRoughness:.6\n};\nconst errorBox=document.getElementById('err');\nfunction showError(message){errorBox.hidden=false;errorBox.textContent='模型错误：'+message;}\nwindow.addEventListener('error',e=>showError(e.message));\ntry {\nconst renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.localClippingEnabled=true;\ndocument.body.prepend(renderer.domElement);\nconst scene=new THREE.Scene();scene.background=new THREE.Color('#f7f4ef');\nscene.environment=new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(),.04).texture;\nscene.add(new THREE.HemisphereLight(0xffffff,0x8d8d8d,.6));\nconst light=new THREE.DirectionalLight(0xffffff,1.2);light.position.set(3000,7000,5000);scene.add(light);\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,1,20000);\nconst controls=new OrbitControls(camera,renderer.domElement);controls.enableDamping=true;\ncontrols.autoRotate=true;controls.autoRotateSpeed=1;\ncontrols.addEventListener('start',()=>controls.autoRotate=false);\nconst modelGroup=new THREE.Group();scene.add(modelGroup);\nlet scheme=0,view='container',cut=false,exploded=false,laptop=null,slot=null,loadFailed=false;\nconst names=['① 标准托盘装柜','② 地板直接装载','③ 紧凑包装托盘装柜'];\nfunction planar(area,box){\n  return [[box[0],box[1]],[box[1],box[0]]].map(d=>({d,nx:Math.floor(area[0]/d[0]),nz:Math.floor(area[1]/d[1])}))\n  .map(o=>({...o,count:o.nx*o.nz})).sort((a,b)=>b.count-a.count)[0];\n}\nfunction spatial(c,h){\n  return [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]].map(a=>{\n    const d=a.map(i=>c[i]),nx=Math.floor(P.container[0]/d[0]),nz=Math.floor(P.container[1]/d[1]),ny=Math.floor(h/d[2]);\n    return {d,nx,nz,ny,count:nx*nz*ny};\n  }).sort((a,b)=>b.count-a.count)[0];\n}\nfunction compute(s){\n  const r=s===2?P.compact:P.retail,c=[r[0]+2*(P.gap+P.board),r[1]+2*(P.gap+P.board),r[2]*P.perCarton+2*(P.gap+P.board)];\n  const cardboard=2*(c[0]*c[1]+c[0]*c[2]+c[1]*c[2])/1e6*P.boardDensity;\n  const layer=planar(P.pallet,c),caseMass=P.perCarton*P.gross[s]+cardboard;\n  const layers=Math.min(Math.floor((P.maxHeight-P.pallet[2])/c[2]),Math.floor((P.maxLoad-P.palletMass)/(layer.count*caseMass)));\n  const perPallet=layer.count*layers*P.perCarton,packing=planar(P.container,P.pallet);\n  const floor=spatial(c,P.floorHeight),total=s===1?floor.count*P.perCarton:packing.count*perPallet;\n  const utilization=total*r[0]*r[1]*r[2]/(P.container[0]*P.container[1]*P.container[2])*100;\n  const material=(cardboard/P.perCarton+P.pulp[s]+P.retailMass[s]+(s===1?0:P.palletMass/perPallet))*1000;\n  const metrics=[\n    {label:'每箱台数',value:String(P.perCarton),unit:'台',note:'假设彩盒最短边堆叠'},\n    {label:'每托盘台数',value:s===1?'—（地板装载）':String(perPallet),unit:s===1?'':'台',note:'假设规则整层，限重含托盘'},\n    {label:'每柜总台数',value:String(total),unit:'台',note:s===1?'假设六朝向规则排布，堆高≤2600mm':'假设托盘不堆码，未扣绑扎空间'},\n    {label:'集装箱容积利用率(%)',value:utilization.toFixed(2),unit:'%',note:'假设按彩盒包络总体积计算'},\n    {label:'每台包装材料质量(g)',value:material.toFixed(1),unit:'g',note:'假设纸板0.75kg/m²，不计搭接辅材'},\n    {label:'每台海运碳排放(kg CO₂e)',value:(P.carbon/total).toFixed(3),unit:'kg CO₂e',note:'假设全程每柜1200kg CO₂e均摊'}\n  ];\n  return {r,c,cardboard,layer,layers,perPallet,packing,floor,total,metrics,caseMass};\n}\nconst results=[0,1,2].map(compute);\ndocument.getElementById('compare').innerHTML='<table><tr><th>指标</th><th>①标准</th><th>②地板</th><th>③紧凑</th></tr>'+\nresults[0].metrics.map((m,i)=>'<tr><td>'+m.label+'</td>'+results.map(r=>'<td>'+r.metrics[i].value+'</td>').join('')+'</tr>').join('')+\n'</table><div class=\"small\">②涉及侧放，须校核抗压；容积率不等于外箱占柜率。柜限重未给定。</div>';\nconst boxGeo=new THREE.BoxGeometry(1,1,1),matrix=new THREE.Matrix4();\nfunction mat(color,opacity=1){return new THREE.MeshStandardMaterial({color,metalness:0,roughness:P.plasticRoughness,transparent:opacity<1,opacity,depthWrite:opacity===1});}\nfunction cube(parent,d,pos,color,opacity=1,edges=false){\n  const mesh=new THREE.Mesh(boxGeo,mat(color,opacity));mesh.scale.set(d[0],d[2],d[1]);mesh.position.set(...pos);parent.add(mesh);\n  if(edges){const edge=new THREE.LineSegments(new THREE.EdgesGeometry(boxGeo),new THREE.LineBasicMaterial({color:color===P.colors.retail?P.colors.edge:'#927c64'}));mesh.add(edge);}\n  return mesh;\n}\nfunction instances(parent,items,color){\n  if(!items.length)return;\n  const mesh=new THREE.InstancedMesh(boxGeo,mat(color),items.length);\n  items.forEach((a,i)=>{matrix.makeScale(a.d[0],a.d[2],a.d[1]);matrix.setPosition(...a.p);mesh.setMatrixAt(i,matrix);});\n  mesh.instanceMatrix.needsUpdate=true;mesh.computeBoundingSphere();parent.add(mesh);return mesh;\n}\nfunction palletItems(items,x,z){\n  const [l,w,h]=P.pallet,t=P.deck;\n  items.push({d:[l,w,t],p:[x+l/2,h-t/2,z+w/2]},{d:[l,w,t],p:[x+l/2,t/2,z+w/2]});\n  for(let i=0;i<3;i++)items.push({d:[l,P.runnerWidth,h-2*t],p:[x+l/2,h/2,z+P.r