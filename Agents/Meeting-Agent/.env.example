# Local Web UI path: direct Azure OpenAI Responses API with key authentication.
# HTTPS is required; /openai/v1 is optional.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Deployment name passed as the Responses API model value.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
# The secure launcher reads AZURE_OPENAI_API_KEY into process memory. Never store it here.