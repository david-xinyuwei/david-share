# Hosted Agent runtime. Microsoft Foundry injects these values after deployment.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Standalone CLI compatibility. HTTPS is required; /openai/v1 is optional.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Deployment name passed as the Responses API model value.
AZURE_OPENAI_DEPLOYMENT=<your-deployment>
# Authentication uses DefaultAzureCredential. Do not add credentials to this file.