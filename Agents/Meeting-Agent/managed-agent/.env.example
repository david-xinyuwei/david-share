# Foundry Managed Agent Responses endpoint. Entra authentication is mandatory.
MANAGED_AGENT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/openai/v1/responses
MANAGED_AGENT_NAME=managed-meeting-agent
MANAGED_AGENT_VERSION=<active-version>
MEETING_AGENT_ANALYZER=managed
MEETING_AGENT_SESSION_HOME=<local-session-directory>

# azd deployment inputs. Keep real tenant and resource values in an isolated azd env.
AZURE_AI_MODEL_ENDPOINT=https://<account>.services.ai.azure.com
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_NAME=<project>
AZURE_RESOURCE_GROUP=<resource-group>
AZURE_SUBSCRIPTION_ID=<subscription-id>