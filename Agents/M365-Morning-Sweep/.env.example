# === Graph API (Delegated auth — interactive login) ===
TENANT_ID=your-tenant-id
CLIENT_ID=your-app-registration-client-id

# === Graph API (Service Principal — unattended) ===
USE_SP_AUTH=false
SP_TENANT=your-tenant-id
SP_CLIENT_ID=your-sp-client-id
SP_CLIENT_SECRET=your-sp-client-secret
SP_TARGET_USER=user@yourtenant.onmicrosoft.com

# === Azure OpenAI ===
AOAI_ENDPOINT=https://your-resource.openai.azure.com/
AOAI_KEY=your-aoai-key
AOAI_DEPLOYMENT=gpt-4o
AOAI_API_VERSION=2025-04-01-preview

# === Data Layer (optional — enables AI Search + CosmosDB + Foundry IQ) ===
USE_DATA_LAYER=false
SEARCH_ENDPOINT=https://your-search.search.windows.net
SEARCH_KEY=your-search-key
COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key
FOUNDRY_IQ_KB=morning-sweep-kb

# === Live Dashboard Server ===
PORT=8088
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme
POLL_INTERVAL=15
EMAIL_HOURS=168
