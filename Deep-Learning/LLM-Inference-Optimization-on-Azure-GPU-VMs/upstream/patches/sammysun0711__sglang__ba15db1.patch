 .../srt/layers/attention/aiter_backend.py     | 169 ++++++++-
 .../srt/layers/attention/aiter_utils.py       | 323 +++++++++++++++++-
 python/sglang/srt/models/mimo_v2.py           |  27 +-
 python/sglang/srt/server_args.py              |  29 ++
 5 files changed, 547 insertions(+), 6 deletions(-)

