# Settings for docker/run-role.sh and the rendered launch scripts. Copy to docker/mimo.env,
# fill in the values and copy the same file to every VM. The file is read in two ways, so
# keep it valid for both: docker --env-file (the containers) and `set -a; . docker/mimo.env`
# (the host commands in the README). One NAME=value per line, no spaces around "=",
# no quotes, and leave a value empty rather than writing a placeholder.

# The pushed image, pinned by digest: <registry>/mimo-mi300x@sha256:... as printed in step 3.
IMAGE=

# Path of the model inside the container. run-role.sh mounts $MODELS at /models, read-only.
MODEL_PATH=/models/MiMo-V2.5-Pro

# 1P1D only. Private addresses of the two VMs on the InfiniBand network (ip -br addr).
PREFILL_HOST=
DECODE_HOST=

# 1P1D only. RDMA devices (ibv_devinfo -l) and the GID index Mooncake uses (show_gids; 3 on the measured VMs).
IB_DEVICES=mlx5_ib0,mlx5_ib1,mlx5_ib2,mlx5_ib3,mlx5_ib4,mlx5_ib5,mlx5_ib6,mlx5_ib7
MC_GID_INDEX=3
