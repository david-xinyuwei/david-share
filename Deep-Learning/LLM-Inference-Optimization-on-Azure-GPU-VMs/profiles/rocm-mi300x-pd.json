{
  "schema": 1,
  "profile": "rocm-mi300x-pd",
  "status": "MEASURED",
  "measured_runs": [
    "stage-20260707-ck",
    "stage-20260713-tuned-moe",
    "ladder-20260708-ck"
  ],
  "description": "1P1D on two Azure ND MI300X v5 VMs, the stack measured on 2026-07-07/08/13. Values are copied from the launch scripts whose SHA-256 is recorded in evidence/runs.json; hosts, paths and IB addresses are variables.",
  "variables": {
    "MODEL_PATH": "local path of the MiMo-V2.5-Pro checkpoint",
    "PREFILL_HOST": "address of the prefill VM on the IB network",
    "DECODE_HOST": "address of the decode VM on the IB network",
    "IB_DEVICES": "comma-separated RDMA devices, e.g. mlx5_ib0,...,mlx5_ib7",
    "MC_GID_INDEX": "RoCE/IB GID index Mooncake should use (3 on the measured VMs)"
  },
  "platform_env": {
    "SGLANG_MOE_PADDING": "1",
    "SGLANG_ROCM_FUSED_DECODE_MLA": "1",
    "SGLANG_SET_CPU_AFFINITY": "1",
    "SGLANG_USE_ROCM700A": "1",
    "HSA_NO_SCRATCH_RECLAIM": "1",
    "SGLANG_SPEC_NAN_DETECTION": "1",
    "SGLANG_SPEC_OOB_DETECTION": "1"
  },
  "roles": {
    "prefill": {
      "command": [
        "python3",
        "-u",
        "-m",
        "sglang.launch_server"
      ],
      "args": [
        "--model-path",
        "${MODEL_PATH}",
        "--tp-size",
        "8",
        "--host",
        "0.0.0.0",
        "--port",
        "30000",
        "--trust-remote-code",
        "--disable-radix-cache",
        "--disable-cuda-graph",
        "--mem-fraction-static",
        "0.85",
        "--context-length",
        "262144",
        "--max-running-requests",
        "128",
        "--watchdog-time",
        "1200",
        "--disable-overlap-schedule"
      ]
    },
    "decode": {
      "command": [
        "python3",
        "-u",
        "-m",
        "sglang.launch_server"
      ],
      "args": [
        "--model-path",
        "${MODEL_PATH}",
        "--tp-size",
        "8",
        "--host",
        "0.0.0.0",
        "--port",
        "30001",
        "--trust-remote-code",
        "--mem-fraction-static",
        "0.85",
        "--disable-radix-cache",
        "--context-length",
        "262144",
        "--max-running-requests",
        "128",
        "--disable-overlap-schedule"
      ]
    },
    "router": {
      "command": [
        "python3",
        "-m",
        "sglang_router.launch_router"
      ],
      "args": [
        "--pd-disaggregation",
        "--prefill",
        "http://${PREFILL_HOST}:30000",
        "--decode",
        "http://${DECODE_HOST}:30001",
        "--host",
        "0.0.0.0",
        "--port",
        "40000"
      ]
    },
    "bench-decode": {
      "command": [
        "python3",
        "-m",
        "sglang.bench_serving"
      ],
      "args": [
        "--backend",
        "sglang",
        "--model",
        "${MODEL_PATH}",
        "--host",
        "0.0.0.0",
        "--port",
        "40000",
        "--dataset-name",
        "random",
        "--random-input-len",
        "8192",
        "--random-output-len",
        "1024",
        "--random-range-ratio",
        "1.0",
        "--flush-cache",
        "--seed",
        "12345",
        "--num-prompts",
        "256",
        "--warmup-requests",
        "32",
        "--max-concurrency",
        "${CONCURRENCY}",
        "--pd-separated"
      ]
    },
    "bench-prefill": {
      "command": [
        "python3",
        "-m",
        "sglang.bench_serving"
      ],
      "args": [
        "--backend",
        "sglang",
        "--model",
        "${MODEL_PATH}",
        "--host",
        "0.0.0.0",
        "--port",
        "40000",
        "--dataset-name",
        "random",
        "--random-input-len",
        "${INPUT_LEN}",
        "--random-output-len",
        "1",
        "--random-range-ratio",
        "1.0",
        "--flush-cache",
        "--seed",
        "12345",
        "--num-prompts",
        "16",
        "--warmup-requests",
        "1",
        "--max-concurrency",
        "4",
        "--pd-separated"
      ]
    }
  },
  "techniques": {
    "attention-dispatch": {
      "prefill": {
        "env": {
          "SGLANG_USE_AITER": "1"
        },
        "args": [
          "--attention-backend",
          "aiter"
        ]
      },
      "decode": {
        "env": {
          "SGLANG_USE_AITER": "1"
        },
        "args": [
          "--attention-backend",
          "aiter"
        ]
      }
    },
    "unified-verify": {
      "decode": {
        "env": {
          "SGLANG_AITER_UNIFIED_VERIFY": "1"
        }
      }
    },
    "memory-sizing": {
      "prefill": {
        "args": [
          "--chunked-prefill-size",
          "32768",
          "--page-size",
          "32"
        ]
      },
      "decode": {
        "args": [
          "--chunked-prefill-size",
          "32768",
          "--page-size",
          "32"
        ]
      }
    },
    "fp8-kv-5d": {
      "prefill": {
        "args": [
          "--kv-cache-dtype",
          "fp8_e4m3"
        ]
      },
      "decode": {
        "args": [
          "--kv-cache-dtype",
          "fp8_e4m3"
        ]
      }
    },
    "pd-disaggregation": {
      "prefill": {
        "env": {
          "MC_GID_INDEX": "${MC_GID_INDEX}",
          "MC_TE_METRIC": "1",
          "SGLANG_DISAGGREGATION_THREAD_POOL_SIZE": "12",
          "SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT": "5000",
          "SGLANG_DISAGGREGATION_WAITING_TIMEOUT": "5000"
        },
        "args": [
          "--disaggregation-mode",
          "prefill",
          "--disaggregation-transfer-backend",
          "mooncake",
          "--disaggregation-ib-device",
          "${IB_DEVICES}"
        ]
      },
      "decode": {
        "env": {
          "MC_GID_INDEX": "${MC_GID_INDEX}",
          "MC_TE_METRIC": "1",
          "SGLANG_DISAGGREGATION_THREAD_POOL_SIZE": "12",
          "SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT": "5000",
          "SGLANG_DISAGGREGATION_WAITING_TIMEOUT": "5000"
        },
        "args": [
          "--disaggregation-mode",
          "decode",
          "--disaggregation-transfer-backend",
          "mooncake",
          "--disaggregation-ib-device",
          "${IB_DEVICES}"
        ]
      }
    },
    "eagle-mtp": {
      "prefill": {
        "env": {
          "SGLANG_ENABLE_SPEC_V2": "1"
        },
        "args": [
          "--speculative-algorithm",
          "EAGLE",
          "--speculative-num-steps",
          "3",
          "--speculative-eagle-topk",
          "1",
          "--speculative-num-draft-tokens",
          "4",
          "--enable-multi-layer-eagle"
        ]
      },
      "decode": {
        "env": {
          "SGLANG_ENABLE_SPEC_V2": "1"
        },
        "args": [
          "--speculative-algorithm",
          "EAGLE",
          "--speculative-num-steps",
          "3",
          "--speculative-eagle-topk",
          "1",
          "--speculative-num-draft-tokens",
          "4",
          "--enable-multi-layer-eagle"
        ]
      }
    },
    "simulated-acceptance": {
      "prefill": {
        "env": {
          "SGLANG_SIMULATE_ACC_LEN": "3",
          "SGLANG_SIMULATE_ACC_METHOD": "match-expected"
        }
      },
      "decode": {
        "env": {
          "SGLANG_SIMULATE_ACC_LEN": "3",
          "SGLANG_SIMULATE_ACC_METHOD": "match-expected"
        }
      }
    },
    "ck-a8w8-gemm": {
      "prefill": {
        "env": {
          "SGLANG_USE_AITER_CK_BLOCKSCALE_BPRESHUFFLE": "1"
        }
      },
      "decode": {
        "env": {
          "SGLANG_USE_AITER_CK_BLOCKSCALE_BPRESHUFFLE": "1"
        }
      }
    },
    "tuned-fused-moe": {
      "prefill": {
        "note": "AITER loads aiter/configs/model_configs/mimo_v2_5_pro_b16_tuned_fmoe.csv automatically; ablate with AITER_BYPASS_TUNE_CONFIG=1",
        "ablate_env": {
          "AITER_BYPASS_TUNE_CONFIG": "1"
        }
      },
      "decode": {
        "note": "same table on the decode server",
        "ablate_env": {
          "AITER_BYPASS_TUNE_CONFIG": "1"
        }
      }
    },
    "int8-quick-reduce": {
      "prefill": {
        "env": {
          "ROCM_QUICK_REDUCE_QUANTIZATION": "INT8"
        },
        "ablate_env": {
          "ROCM_QUICK_REDUCE_QUANTIZATION": "NONE"
        }
      },
      "decode": {
        "env": {
          "ROCM_QUICK_REDUCE_QUANTIZATION": "INT8"
        },
        "ablate_env": {
          "ROCM_QUICK_REDUCE_QUANTIZATION": "NONE"
        }
      }
    }
  }
}
