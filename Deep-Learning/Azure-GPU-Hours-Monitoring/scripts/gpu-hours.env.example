# Settings for scripts/configure.sh (Bash syntax: NAME="value").
# Copy this file, fill it in, then run:  ./scripts/configure.sh -c gpu-hours.env
# gpu-hours.env, gpu-hours.outputs.env and gpu-hours-logs/ are git-ignored.

# Subscription that holds the GPU VMs. Empty: the current `az account show` subscription.
SUBSCRIPTION_ID=""

# Log Analytics workspace, created if missing. Use the GPU VMs' region; if WORKSPACE_RG already exists,
# LOCATION must be that resource group's region.
WORKSPACE_RG="rg-gpu-hours"
LOCATION=""                       # for example: eastus, westeurope, swedencentral
WORKSPACE_NAME="law-gpu-hours"
RETENTION_DAYS=90

# GPU VMs, all in VM_RG: a Flexible scale set, a space-separated list of VM names, or both.
VM_RG=""
VMSS_NAME=""
VM_NAMES=""

# Optional. Per-job and per-submitter GPU hours for Azure Machine Learning jobs: the AML workspace resource ID,
# /subscriptions/<subscription-id>/resourceGroups/<group>/providers/Microsoft.MachineLearningServices/workspaces/<name>
AML_WORKSPACE_ID=""

# Optional. Object ID of the identity your platform API queries with; it gets Log Analytics Reader on the workspace.
# For a managed identity or an app registration use its service principal object ID.
READER_OBJECT_ID=""
READER_PRINCIPAL_TYPE="ServicePrincipal"   # ServicePrincipal, User or Group

# 1: onboard the VMs that pass preflight and list the others; 0: stop if any VM is not ready.
SKIP_NOT_READY_VMS=0
# VMs onboarded at the same time.
PARALLEL=5
# Minutes to wait for the first GPU rows from every VM.
WAIT_MINUTES=20
